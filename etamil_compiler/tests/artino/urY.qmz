// __tests/artino/urY.qmz — உரை: text as a value, joined, compared, passed and returned__

பெயர் = "புகை உணரி";
அச்சு பெயர்;
முழு = பெயர் & " 1";
அச்சு முழு;
அச்சு "நீளமான " & முழு & " — அளவு " & 182 & ", தீ " & பொய்;

// __செய்தி(சொல் கருவி, எண்) — a line for the serial port, built from its parts__
செயல் செய்தி(சொல் கருவி, அளவு) {
    திரும்பு கருவி & ": " & அளவு;
}
அச்சு செய்தி("வெப்பம்", 29.5);
அச்சு செய்தி(பெயர், 640);

// __வகை_பெயர்(ந) — text chosen by a number, returned from inside an எனில்__
செயல் வகை_பெயர்(ந) {
    (ந == 1) எனில் { திரும்பு "புகை"; }
    (ந == 2) எனில் { திரும்பு "வெப்பம்"; }
    திரும்பு "தெரியாது";
}
அச்சு வகை_பெயர்(1) & " / " & வகை_பெயர்(2) & " / " & வகை_பெயர்(7);

அச்சு பெயர் == "புகை உணரி";
அச்சு பெயர் != "புகை உணரி";
அச்சு வகை_பெயர்(2) == "வெப்பம்";

// __A parameter is a copy: changing it inside does not reach the caller__
செயல் மாற்று(சொல் உரைக்கு) {
    உரைக்கு = "மாறியது";
    திரும்பு உரைக்கு;
}
அச்சு மாற்று(பெயர்) & " / " & பெயர்;

அச்சு சொல்லாக்கு(1.5) & சொல்லாக்கு(மெய்) & சொல்லாக்கு(-3);
வரி_உரை = "";
அ = 1;
(அ <= 3) சுற்று {
    வரி_உரை = வரி_உரை & அ & " ";
    அ = அ + 1;
}
அச்சு வரி_உரை & "முடிந்தது";
