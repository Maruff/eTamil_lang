// __tests/artino/muDivu.qmz — முடிவு: results, and ? handing a தவறு back to the caller__

// __வகு(அ, ஆ) — a division that says why it cannot be done__
செயல் வகு(அ, ஆ) {
    (ஆ == 0) எனில் { திரும்பு தவறு("பூஜ்ஜியம்"); }
    திரும்பு சரி(அ / ஆ);
}

// __இருமடங்கு_வகு(அ, ஆ) — twice the quotient; ? returns வகு's தவறு unchanged__
செயல் இருமடங்கு_வகு(அ, ஆ) {
    பாதி = வகு(அ, ஆ)?;
    திரும்பு சரி(பாதி * 2);
}

அ = வகு(10, 4);
ஆ = வகு(1, 0);
அச்சு அ;
அச்சு ஆ;
அச்சு சரியா(அ) & " " & தவறா(ஆ) & " " & சரியா(ஆ);
அச்சு மதிப்பு(அ);
அச்சு தவறு_மதிப்பு(ஆ);
அச்சு இயல்பு(ஆ, -1) & " " & இயல்பு(அ, -1);
அச்சு இருமடங்கு_வகு(9, 3);
அச்சு இருமடங்கு_வகு(9, 0);

அச்சு எண்ணாக்கு("42");
அச்சு எண்ணாக்கு(" 3.5 ");
அச்சு எண்ணாக்கு("-0.25");
அச்சு சரியா(எண்ணாக்கு("abc")) & " " & இயல்பு(எண்ணாக்கு("x7"), 0);

உரை_விடை = சரி("புகை");
அச்சு உரை_விடை;
அச்சு மதிப்பு(உரை_விடை) & "!";
தீ_விடை = சரி(பொய்);
அச்சு தீ_விடை;
