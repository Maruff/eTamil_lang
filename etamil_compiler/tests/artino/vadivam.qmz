// __tests/artino/vadivam.qmz — வடிவங்கள்: records, and arrays of texts and records, passed and returned__
இறக்கு "nUlakam/aNi.qmz";
வடிவம் புள்ளி {
    எண் முகவரி,
    சொல் வகை,
    நிலைமை,
    செயல் விளக்கம்(இது) { திரும்பு இது.வகை & " #" & இது.முகவரி; }
    செயல் புதிது(மு, வ) { திரும்பு புள்ளி{முகவரி: மு, வகை: வ, நிலைமை: "N"}; }
}
அ = புள்ளி.புதிது(1, "SMOKE");
அ.நிலைமை = "A";
ஆ = புள்ளி{வகை: "HEAT", ..அ};
அச்சு அ;
அச்சு ஆ.விளக்கம்();
பட்டியல் = [அ, ஆ];
ஒவ்வொரு ப இல் பட்டியல் { அச்சு ப.முகவரி & " " & ப.நிலைமை; }
செயல் மொத்தம்(அணி எண்கள்) { கூட்டல் = 0; ஒவ்வொரு எ இல் எண்கள் { கூட்டல் = கூட்டல் + எ; } திரும்பு கூட்டல்; }
அச்சு மொத்தம்([1, 2, 3]);
செயல் இரட்டி(அணி எண்கள்) { ஒவ்வொரு இ இல் [0, 1, 2] { எண்கள்[இ] = எண்கள்[இ] * 2; } திரும்பு எண்கள்; }
அச்சு இரட்டி([1, 2, 3]);
உரைகள் = ["அ", "ஆ"];
அச்சு உரைகள்;

அச்சு பட்டியல்[1].வகை;
அச்சு பட்டியல்[0].விளக்கம்();
பட்டியல்[0] = புள்ளி.புதிது(7, "FIRE");
அச்சு பட்டியல்;
உரைகள்[1] = "இ";
அச்சு உரைகள்[1] & உரைகள்[0];
பெயர்கள் = அணி_நிரப்பு("-", 3);
பெயர்கள்[2] = "கடைசி";
அச்சு பெயர்கள்;
வடிவம் மண்டலம் {
    சொல் பெயர்,
    புள்ளி தலைமை,
}
ம = மண்டலம்{பெயர்: "கீழ்", தலைமை: அ};
அச்சு ம;
அச்சு ம.தலைமை.முகவரி + 1;
செயல் மாற்று(ப) { ப.நிலைமை = "X"; திரும்பு ப; }
மா = மாற்று(அ);
அச்சு அ.நிலைமை & மா.நிலைமை;
