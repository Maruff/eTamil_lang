// __tests/artino/suRRu.qmz — சுற்று: loops, nested loops, and திரும்பு from inside one__

மொத்தம் = 0;
எண்ணி = 1;
(எண்ணி <= 100) சுற்று {
    மொத்தம் = மொத்தம் + எண்ணி;
    எண்ணி = எண்ணி + 1;
}
அச்சு "1 முதல் 100 வரை: " & மொத்தம்;

அடுக்கு = 1;
(அடுக்கு <= 3) சுற்று {
    நெடு = 1;
    (நெடு <= 3) சுற்று {
        அச்சு அடுக்கு & " x " & நெடு & " = " & அடுக்கு * நெடு;
        நெடு = நெடு + 1;
    }
    அடுக்கு = அடுக்கு + 1;
}

// __மீதி(அ, ஆ) — the remainder, by subtraction: no division, so nothing rounds__
செயல் மீதி(அ, ஆ) {
    (அ >= ஆ) சுற்று { அ = அ - ஆ; }
    திரும்பு அ;
}

// __பகா_எண்ணா(ந) — is ந prime; returns from inside the loop as soon as it knows__
செயல் பகா_எண்ணா(ந) {
    (ந < 2) எனில் { திரும்பு பொய்; }
    வ = 2;
    (வ * வ <= ந) சுற்று {
        (மீதி(ந, வ) == 0) எனில் { திரும்பு பொய்; }
        வ = வ + 1;
    }
    திரும்பு மெய்;
}

ந = 1;
(ந <= 30) சுற்று {
    (பகா_எண்ணா(ந)) எனில் { அச்சு "பகா எண் " & ந; }
    ந = ந + 1;
}
