// __ஆவணம் — filling a document template__
//
// __The real templates are .odt and .docx files, and பொதியை_நிரப்பு opens one,__
// __fills it and writes the new package out. That needs a file to point at, so__
// __this example does the half that stands alone: the XML inside the package.__
//
//   __பொதியை_நிரப்பு("charter.odt", "out.odt", _ODT_வடிவம், மதிப்புகள், தொகுதிகள்);__
//
// __is the whole of the difference for a real one.__

இறக்கு "../../nUlakam/vativam/AvaNam.qmz";

// __What LibreOffice writes for a two-column table with a repeating row. The__
// __{%tr%} rows are the convention the templates already use: everything__
// __between them repeats, once per item.__
படிவம் = "<office:body><table:table>"
       & "<table:table-row><text:p>#</text:p><text:p>நோக்கம்</text:p></table:table-row>"
       & "<table:table-row><text:p>{%tr for o in objectives %}</text:p></table:table-row>"
       & "<table:table-row><text:p>{{ o.no }}</text:p><text:p>{{ o.what }}</text:p></table:table-row>"
       & "<table:table-row><text:p>{%tr endfor %}</text:p></table:table-row>"
       & "</table:table>"
       & "<text:p>திட்டம்: {{ project.name }}</text:p>"
       & "</office:body>";

// __A scalar is named by the dotted path the template writes.__
மதிப்புகள் = [
    {"குறி": "project.name", "மதிப்பு": "பீக் PMO"}
];

// __A group names its loop variable, the fields each row reads, and the rows.__
தொகுதிகள் = [
    {"பெயர்": "o",
     "புலங்கள்": ["no", "what"],
     "வரிசைகள்": [
        {"no": "1", "what": "ஒரே உண்மை"},
        {"no": "2", "what": "தானியங்கு ஆவணங்கள்"}
     ]}
];

ஆவணம் = ஆவணம்_நிரப்பு(படிவம், _ODT_வடிவம், மதிப்புகள், தொகுதிகள்);

அச்சு "=== நிரப்பப்பட்ட ஆவணம் ===";
அச்சு ஆவணம்;
அச்சு "";

// __Two items, so two rows, plus the header. The for and endfor rows are gone__
// __and so is everything they carried — but not the tags that followed them:__
// __</table:table> is still there, which is the bug this convention invites.__
அச்சு "வரிசைகள்: " & (நீளம்(பிரி(ஆவணம், "<table:table-row")) - 1);
அச்சு "அட்டவணை முடிகிறதா: " & ஆவணத்தில்_உள்ளதா(ஆவணம், "</table:table>");


// __A value that looks like markup is escaped, or the document stops being__
// __well-formed XML and LibreOffice calls the file corrupt.__
அபாயம் = ஆவணம்_நிரப்பு("<text:p>{{ x }}</text:p>", _ODT_வடிவம்,
                        [{"குறி": "x", "மதிப்பு": "5 < 10 & rising"}], []);
அச்சு "தப்பிக்கப்பட்டது: " & அபாயம்;
