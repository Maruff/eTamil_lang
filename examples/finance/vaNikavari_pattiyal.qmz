// __வணிகவரி விலைப்பட்டியல் — a GST invoice__
//
// __Line items are records, the invoice is an array of them. GST splits into__
// __CGST and SGST within a state, or IGST across states.__

இறக்கு "../../nUlakam/paNam/paNam.qmz";
இறக்கு "../../nUlakam/atippatY/kaNiqam.qmz";
இறக்கு "../../nUlakam/atippatY/col.qmz";

// வரி_பிரிப்பு(தொகை, விகிதம், மாநிலம்_ஒன்றா)
// __வரி_பிரிப்பு(தொகை, விகிதம், மாநிலம்_ஒன்றா) — split GST into CGST, SGST or IGST__
//
// __Within one state the tax halves into central and state; across states it is one IGST charge. The halves are computed by rounding one and subtracting it from the total, so the two always add back to the tax exactly rather than differing by a paisa.__
செயல் வரி_பிரிப்பு(தொகை, விகிதம், மாநிலம்_ஒன்றா) {
    மொத்த_வரி = சதவீதம்(தொகை, விகிதம்);
    (மாநிலம்_ஒன்றா) எனில் {
        பாதி = வட்டமிடு(மொத்த_வரி / 2, 2);
        திரும்பு {மொத்தம்: மொத்த_வரி, cgst: பாதி, sgst: மொத்த_வரி - பாதி, igst: 0};
    }
    திரும்பு {மொத்தம்: மொத்த_வரி, cgst: 0, sgst: 0, igst: மொத்த_வரி};
}

// __வரிசை_மதிப்பு(உருப்படி) — one invoice line, before tax__
//
// __Quantity times price. The taxable value each rate is applied to, which is why tax is computed per line and not on the invoice total.__
செயல் வரிசை_மதிப்பு(உருப்படி) {
    திரும்பு உருப்படி.அளவு * உருப்படி.விலை;
}

உருப்படிகள் = [
    {விவரம்: "மடிக்கணினி", hsn: "8471", அளவு: 3,  விலை: 54999, விகிதம்: 18},
    {விவரம்: "விசைப்பலகை", hsn: "8471", அளவு: 10, விலை: 1299,  விகிதம்: 18},
    {விவரம்: "அச்சுத்தாள்", hsn: "4802", அளவு: 25, விலை: 320,   விகிதம்: 12}
];

உள்_மாநிலம் = மெய்;

அச்சு "விலைப்பட்டியல் #INV-2026-0417";
அச்சு "GSTIN: 33ABCDE1234F1Z5   தமிழ்நாடு";
அச்சு திரும்பச்செய்("-", 52);

மொத்த_அடிப்படை = 0;
மொத்த_வரி = 0;
_மொத்த_cgst = 0;
_மொத்த_sgst = 0;

ஒவ்வொரு உருப்படி இல் உருப்படிகள் {
    அடிப்படை = வரிசை_மதிப்பு(உருப்படி);
    வரி = வரி_பிரிப்பு(அடிப்படை, உருப்படி.விகிதம், உள்_மாநிலம்);

    மொத்த_அடிப்படை = மொத்த_அடிப்படை + அடிப்படை;
    மொத்த_வரி = மொத்த_வரி + வரி.மொத்தம்;
    _மொத்த_cgst = _மொத்த_cgst + வரி.cgst;
    _மொத்த_sgst = _மொத்த_sgst + வரி.sgst;

    அச்சு உருப்படி.விவரம் & "  [HSN " & உருப்படி.hsn & "]";
    அச்சு "   " & உருப்படி.அளவு & " x " & ரூபாய்(உருப்படி.விலை)
          & "  =  " & ரூபாய்(அடிப்படை)
          & "   (+" & உருப்படி.விகிதம் & "% = " & ரூபாய்(வரி.மொத்தம்) & ")";
}

அச்சு திரும்பச்செய்("-", 52);
அச்சு "அடிப்படைத் தொகை : " & ரூபாய்(மொத்த_அடிப்படை);
அச்சு "CGST            : " & ரூபாய்(_மொத்த_cgst);
அச்சு "SGST            : " & ரூபாய்(_மொத்த_sgst);
அச்சு "மொத்த வரி       : " & ரூபாய்(மொத்த_வரி);
அச்சு திரும்பச்செய்("=", 52);
அச்சு "செலுத்த வேண்டியது: " & ரூபாய்(மொத்த_அடிப்படை + மொத்த_வரி);
