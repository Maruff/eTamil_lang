// __சம்பளம் — a payroll run__
//
// __Employees are records; the payroll is an array of them. Amounts are exact__
// __decimals and formatted with Indian digit grouping.__

இறக்கு "../../nUlakam/paNam/paNam.qmz";
இறக்கு "../../nUlakam/atippatY/kaNiqam.qmz";

// __வரி_கணக்கு(மொத்த_சம்பளம்) — slab tax on annual pay__
செயல் வரி_கணக்கு(ஆண்டு_சம்பளம்) {
    (ஆண்டு_சம்பளம் <= 300000) எனில் { திரும்பு 0; }
    (ஆண்டு_சம்பளம் <= 700000) எனில் {
        திரும்பு சதவீதம்(ஆண்டு_சம்பளம் - 300000, 5);
    }
    (ஆண்டு_சம்பளம் <= 1000000) எனில் {
        திரும்பு 20000 + சதவீதம்(ஆண்டு_சம்பளம் - 700000, 10);
    }
    திரும்பு 50000 + சதவீதம்(ஆண்டு_சம்பளம் - 1000000, 30);
}

// __நிகர_சம்பளம்(ஊழியர்) — take-home after tax and PF__
செயல் நிகர_சம்பளம்(ஊழியர்) {
    ஆண்டு = ஊழியர்.மாத_சம்பளம் * 12;
    ஆண்டு_வரி = வரி_கணக்கு(ஆண்டு);
    மாத_வரி = வட்டமிடு(ஆண்டு_வரி / 12, 2);
    வருங்கால_வைப்பு = சதவீதம்(ஊழியர்.மாத_சம்பளம், 12);
    திரும்பு ஊழியர்.மாத_சம்பளம் - மாத_வரி - வருங்கால_வைப்பு;
}

ஊழியர்கள் = [
    {பெயர்: "ராஜா",   துறை: "பொறியியல்", மாத_சம்பளம்: 85000},
    {பெயர்: "தேவி",   துறை: "விற்பனை",   மாத_சம்பளம்: 62000},
    {பெயர்: "குமார்", துறை: "மனிதவளம்",  மாத_சம்பளம்: 34000},
    {பெயர்: "ஆனந்தி", துறை: "நிதி",      மாத_சம்பளம்: 47500}
];

அச்சு "சம்பளப் பட்டியல் — ஏப்ரல் 2026";
அச்சு "=====================================";

மொத்த_நிகரம் = 0;
ஒவ்வொரு ஊழியர் இல் ஊழியர்கள் {
    நிகரம் = நிகர_சம்பளம்(ஊழியர்);
    மொத்த_நிகரம் = மொத்த_நிகரம் + நிகரம்;
    அச்சு ஊழியர்.பெயர் & " (" & ஊழியர்.துறை & ") — " & ரூபாய்(நிகரம்);
}

அச்சு "=====================================";
அச்சு "மொத்தம்: " & ரூபாய்(மொத்த_நிகரம்);
அச்சு "லட்சத்தில்: " & லட்சம்(மொத்த_நிகரம்);
