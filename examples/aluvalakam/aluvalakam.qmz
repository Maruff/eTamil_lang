// =========================================================================
// __4. இரண்டு வாரம் கழித்து — what actually happened, and what it means__
// =========================================================================
//
// __Friday 9 October. Requirements finished on the 1st, as planned. Design__
// __started on the 5th, as planned, but is only 60% done on the day it was due__
// __to finish. Everything else is waiting.__

இன்று = "2026-10-09";
நடப்புப்_பணிகள் = [];
ஒவ்வொரு ஒரு_பணி இல் பணிகள் {
    புதியது = ஒரு_பணி;
    (ஒரு_பணி.பணி_குறி == "1.1") எனில் {
        புதியது["நடப்பு_நிலை"] = "மூடியது";
        புதியது["நிறைவு"] = 100;
        புதியது["உண்மைத்_தொடக்கம்"] = "2026-09-28";
        புதியது["முடிந்த_நாள்"] = "2026-10-01";
    }
    (ஒரு_பணி.பணி_குறி == "1.2") எனில் {
        புதியது["நடப்பு_நிலை"] = "நடப்பில்";
        புதியது["நிறைவு"] = 60;
        புதியது["உண்மைத்_தொடக்கம்"] = "2026-10-05";
    }
    நடப்புப்_பணிகள் = இணை(நடப்புப்_பணிகள், புதியது);
}
மறுதிட்டம் = மதிப்பு(மறு_அட்டவணையிடு(நடப்புப்_பணிகள், திட்டத்_தொடக்கம், இன்று, நாட்காட்டி));
முன்கணிப்பு = மறுதிட்டம்.திட்ட_முடிவு_நாள்;

// __The milestone's status follows from the forecast: late against baseline is__
// __at risk until the date itself has passed.__
நேரலை_நிலை = "சரியாக";
(முன்கணிப்பு > அடிப்படை_நேரலை) எனில் { நேரலை_நிலை = "இடரில்"; }
மைல்கற்கள் = [மைல்கல்_ஆக்கு("M", அடிப்படை_நேரலை, முன்கணிப்பு, "", நேரலை_நிலை)];
மேல்_பணிகள் = [];
ஒவ்வொரு ஒரு_பணி இல் மறுதிட்டம்.பணிகள் {
    புதியது = ஒரு_பணி;
    புதியது["இறுதி_நாள்"] = ஒரு_பணி.முடிவு_நாள்;
    மேல்_பணிகள் = இணை(மேல்_பணிகள், புதியது);
}
நலம் = திட்ட_நலம்(திட்டத்_தொடக்கம், அடிப்படை_நேரலை, பொய், மைல்கற்கள், மேல்_பணிகள், இன்று);
காலம் = அறிக்கைக்_காலம்("2026-10-02", இன்று);
வேட்பாளர்கள் = அறிக்கை_வேட்பாளர்கள்(மேல்_பணிகள், காலம், இன்று);
நிலைச்_சூழல் = நிலை_அறிக்கைச்_சூழல்("வாசல்", காலம், நலம், வேட்பாளர்கள்);
அறிக்கைப்_படிவம் = "<w:body><w:tr>{{ திட்டம்.பெயர் }} {{ காலம்.தொடக்கம் }}–{{ காலம்.முடிவு }}: "
                  & "{{ நலம்.நிறம் }}, நிறைவு {{ நலம்.நிறைவு }}%, காலம் {{ நலம்.கழிந்தது }}%</w:tr>"
                  & "<w:tr>{%tr for அடுத்தது in அடுத்தவை %}</w:tr><w:tr>அடுத்து: {{ அடுத்தது.விவரம் }}</w:tr><w:tr>{%tr endfor %}</w:tr>"
                  & "<w:tr>{%tr for காரணம் in காரணங்கள் %}</w:tr><w:tr>ஏன்: {{ காரணம்.காரண_உரை }}</w:tr><w:tr>{%tr endfor %}</w:tr></w:body>";

அச்சு "── 4. " & இன்று & " ──";
அச்சு "  நேரலை முன்கணிப்பு: " & முன்கணிப்பு & "  (அடிப்படையை விட " & மைல்கல்_வேறுபாடு(மைல்கற்கள்[0]) & " நாள் பின்)";
அச்சு "  நிறம்: " & நலம்.நிறம்;
அச்சு "  " & ஆவணம்_நிரப்பு(அறிக்கைப்_படிவம், _DOCX_வடிவம், நிலைச்_சூழல்.மதிப்புகள், நிலைச்_சூழல்.தொகுதிகள்);
அச்சு "";

// =========================================================================
// __5. மாற்றக் கோரிக்கை — ACME asks for PDF export after all__
// =========================================================================

வரைவு = மாற்றக்_கோரிக்கை_வரைவு();
மாற்றம் = {மாற்றக்_குறி: "CR-3", நடப்பு_நிலை: "கோரியது"};
தணிக்கைப்_பதிவுகள் = [];
ஒவ்வொரு ஒப்புதல்_படி இல் [["மதிப்பாய்ந்தது", "அருண்"], ["ஒப்புக்கொண்டது", "மீனா"], ["ஏற்றது", "சுதா"]] {
    நகர்வு = மதிப்பு(நிலையை_நகர்த்து(மாற்றம், வரைவு, ஒப்புதல்_படி[0], ஒப்புதல்_படி[1], இன்று));
    மாற்றம் = நகர்வு.புதிய_பதிவு;
    தணிக்கைப்_பதிவுகள் = இணை(தணிக்கைப்_பதிவுகள், நகர்வு.நிகழ்வு);
}
புதிய_வேலை = மதிப்பு(மாற்றத்தைப்_பணிகளாக்கு(மாற்றம்,
