    (சரியா(ஒட்டுகள்_சரியா(ஒட்டுகள்))) எனில் {
        குறி_ = ஒருமுறைக்_குறி("beak-acme", "பணி", "உருவாக்கு",
                              அனுப்பவேண்டியவை(உரிமைகள், அனுப்பும்_பதிவு), "demo-secret");
        (இல்லை வரிசையில்_உள்ளதா(வரிசை_உருப்படிகள், குறி_)) எனில் {
            ஆழம் = 0;
            (ஒரு_பணி.பெற்றோர்_குறி != "") எனில் { ஆழம் = 1; }
            வரிசை_உருப்படிகள் = இணை(வரிசை_உருப்படிகள்,
                அனுப்பு_உருப்படி_ஆக்கு(ஒரு_பணி.பணி_குறி, மதிப்பு(பணியுருப்படி_வகை(வகை_விதிகள், ஒரு_பணி)),
