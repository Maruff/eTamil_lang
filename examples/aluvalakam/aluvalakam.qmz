]);
மைல்கற்கள் = [மைல்கல்_ஆக்கு("M", அடிப்படை_நேரலை, அடிப்படை_நேரலை, "", "சரியாக")];
பிணைப்புகள் = [பிணைப்பு_ஆக்கு("திட்டம்.பெயர்", மெய், "மதிப்பு"),
              பிணைப்பு_ஆக்கு("திட்டம்.அனுசரணையாளர்", மெய், "மதிப்பு"),
              பிணைப்பு_ஆக்கு("திட்டம்.குறிக்கோள்", மெய், "மதிப்பு"),
              பிணைப்பு_ஆக்கு("மைல்கற்கள்", மெய், "பட்டியல்")];
தயார் = வார்ப்புத்_தயார்நிலை(பிணைப்புகள், {"திட்டம்": திட்டத்_தரவு, "மைல்கற்கள்": மைல்கற்கள்});
சாசனம் = சாசனச்_சூழல்(திட்டத்_தரவு, திட்டம்.பணிகள், மைல்கற்கள்);
சாசனப்_படிவம் = "<w:body><w:tr>{{ திட்டம்.பெயர் }} — {{ திட்டம்.வாடிக்கையாளர் }}; அனுசரணை {{ திட்டம்.அனுசரணையாளர் }}; "
                & "முயற்சி {{ முயற்சி.நபர்_நாட்கள் }} நபர்-நாட்கள்</w:tr>"
                & "<w:tr>{%tr for மைல்கல் in மைல்கற்கள் %}</w:tr><w:tr>மைல்கல் {{ மைல்கல்.மைல்கல்_குறி }}: "
                & "{{ மைல்கல்.அடிப்படை_நாள் }}</w:tr><w:tr>{%tr endfor %}</w:tr></w:body>";

அச்சு "── 3. சாசனம் ──";
