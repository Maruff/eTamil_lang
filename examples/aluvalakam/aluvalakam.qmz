// =========================================================================
// __2. அட்டவணை — the plan, on a calendar with Gandhi Jayanti in it__
// =========================================================================
//
// __Durations come from the estimates at eight hours a day; the network is the__
// __team's. A zero-day go-live milestone closes it.__

முன்னோடி_வரைபடம் = {"1.1": [], "1.2": ["1.1"], "1.3": ["1.2"], "1.7": ["1.2"], "1.4": ["1.3", "1.7"]};
பணிகள் = [];
ஒவ்வொரு ஒரு_பணி இல் நோக்கம்.பணிகள் {
    பணிகள் = இணை(பணிகள், அட்டவணைக்கு_அமை(ஒரு_பணி,
        மணியிலிருந்து_நாட்கள்(ஒரு_பணி.மதிப்பீட்டு_மணி, 8), முன்னோடி_வரைபடம்[ஒரு_பணி.பணி_குறி]));
}
நேரலை = பணி_ஆக்கு("M", "", "செய்யவேண்டியது", 0, 0, "");
நேரலை["விவரம்"] = "நேரலை";
பணிகள் = இணை(பணிகள், அட்டவணைக்கு_அமை(நேரலை, 0, ["1.4"]));

திட்டம் = மதிப்பு(மறு_அட்டவணையிடு(பணிகள், திட்டத்_தொடக்கம், திட்டத்_தொடக்கம், நாட்காட்டி));
அடிப்படை_நேரலை = திட்டம்.திட்ட_முடிவு_நாள்;

அச்சு "── 2. அட்டவணை ──";
ஒவ்வொரு ஒரு_பணி இல் திட்டம்.பணிகள் {
    குறியீடு_ = "   ";
    (ஒரு_பணி.கடும்_பாதையா) எனில் { குறியீடு_ = " ★ "; }
    அச்சு " " & குறியீடு_ & ஒரு_பணி.பணி_குறி & "  " & ஒரு_பணி.தொடக்க_நாள் & " → " & ஒரு_பணி.முடிவு_நாள்
          & "  (மிதப்பு " & ஒரு_பணி.மிதப்பு & ")";
}
அச்சு "  நேரலை அடிப்படை நாள்: " & அடிப்படை_நேரலை & "   ★ = கடுமையான பாதை";
