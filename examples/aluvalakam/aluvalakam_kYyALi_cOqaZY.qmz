// __The Azure DevOps this test talks to. Work-item numbers come from the task__
// __code in the title; the milestone's type is "down", so its send fails with__
// __503 and must be scheduled again rather than lost. A create returns revision__
// __1 and an update revision 2.__
செயல் போலி_அனுப்புவி(பணியுருப்படி_வகை, பணியுருப்படி_எண், பெற்றோர்_எண், ஒட்டுகள்) {
    (பணியுருப்படி_வகை == "Feature") எனில் {
        திரும்பு தவறு({ நிலைக்_குறி: 503, செய்தி: "service unavailable", மீண்டும்_முயல்_நொடிகள்: 0 });
    }
    தலைப்பு_உரை = "";
    ஒவ்வொரு ஒன்று இல் ஒட்டுகள் { (ஒன்று["path"] == "/fields/System.Title") எனில் { தலைப்பு_உரை = ஒன்று["value"]; } }
    எண்கள் = {"1.1": 101, "1.2": 102, "1.3": 103, "1.4": 104, "1.7": 107, "1.3.1": 131, "2.1": 201};
    குறி_ = பிரி(தலைப்பு_உரை, " ")[0];
    (பணியுருப்படி_எண் != 0) எனில் { திரும்பு சரி({ பணியுருப்படி_எண்: பணியுருப்படி_எண், திருத்தம்: 2 }); }
    திரும்பு சரி({ பணியுருப்படி_எண்: எண்கள்[குறி_], திருத்தம்: 1 });
}

// __Work item 101 as Azure DevOps now holds it: a developer closed it and renamed it.__
செயல் போலி_பெறுவி(பணியுருப்படி_எண்) {
    திரும்பு சரி({ திருத்தம்: 3, மாற்றியவர்: "priya@acme.com", நிலைப்_பெயர்: "Closed",
                  நிலை_வகைமை: "Completed", முடிந்த_மணி: 32, மீதி_மணி: 0, "தலைப்பு": "1.1 renamed" });
}

