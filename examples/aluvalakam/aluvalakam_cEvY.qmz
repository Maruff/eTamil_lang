// __aluvalakam_cEvY.qmz — சேவை (the project office, as an HTTP service)__
// திட்ட அலுவலகச் சேவை
//
// __Run it:__
//
//   __etamil --vm examples/aluvalakam/aluvalakam_amYppu.qmz     (once: the database)__
//   __etamil --server --port 8095 examples/aluvalakam/aluvalakam_cEvY.qmz__
//
// __Under --vm this stops at the first வழி, which is right: routes run only under__
// __--server. What each route does is in aluvalakam_kYyALi.qmz, and that is where__
// __it is tested; this file is routing, the outbox worker, and the two functions__
// __that make the real Azure DevOps calls.__
//
// __Settings come from the environment: ALUVALAKAM_SECRET keys fingerprints,__
// __ALUVALAKAM_HOOK_TOKEN is the token in the service-hook url, and__
// __AZURE_DEVOPS_ORG, AZURE_DEVOPS_PROJECT and AZURE_DEVOPS_PAT say where to sync.__
// __ALUVALAKAM_TEMPLATES is where the Word templates are, and ALUVALAKAM_OUT where the__
// __filled documents are written before they are sent.__
// __ETAMIL_JWT_SECRET signs the sign-in tokens; without it they are signed with a__
// __per-process secret and do not survive a restart. With no Azure DevOps__
// __settings every send fails with status 0 and the outbox__
// __backs off and, after eight attempts, parks the row — it never pretends to__
// __have sent anything.__

இறக்கு "aluvalakam_kYyALi.qmz";
இறக்கு "../../nUlakam/oruwkiNYppu/ajUr.qmz";

// __களக்_கோப்பு() — the SQLite file__
// களக்_கோப்பு() — தரவுத்தளக் கோப்பு
செயல் களக்_கோப்பு() { திரும்பு சூழல்("ALUVALAKAM_DB", "aluvalakam.db"); }

// __சேவை_விசை() — the key fingerprints and idempotency keys are made with__
// சேவை_விசை() — கைரேகைகளுக்கான விசை
செயல் சேவை_விசை() { திரும்பு சூழல்("ALUVALAKAM_SECRET", "change-me"); }

// __வார்ப்புக்_கோப்பு(பெயர்) — a Word template: ALUVALAKAM_TEMPLATES, or the ones beside this file__
// வார்ப்புக்_கோப்பு(பெயர்) — ஒரு வேர்டு வார்ப்புரு
செயல் வார்ப்புக்_கோப்பு(பெயர்) {
    திரும்பு சூழல்("ALUVALAKAM_TEMPLATES", "examples/aluvalakam/vArppukaL") & "/" & பெயர்;
}

// __ஆவணப்_பெயர்(திட்டக்_குறி, பெயர்) — a filled document's file name__
// ஆவணப்_பெயர்(திட்டக்_குறி, பெயர்) — நிரப்பிய ஆவணத்தின் கோப்புப் பெயர்
//
// __The project code with anything that could climb out of a directory or out of__
// __a quoted header replaced, since the name is used for both.__
செயல் ஆவணப்_பெயர்(திட்டக்_குறி, பெயர்) {
    குறி_ = திட்டக்_குறி;
    ஒவ்வொரு எழுத்து_ இல் ["/", "\\", ".", "\""] { குறி_ = மாற்று(குறி_, எழுத்து_, "_"); }
    திரும்பு குறி_ & "_" & பெயர்;
}

// __விளைவுக்_கோப்பு(கோப்புப்_பெயர்) — where a filled document is written before it is sent__
// விளைவுக்_கோப்பு(கோப்புப்_பெயர்) — நிரப்பிய ஆவணம் அனுப்பும் முன் எழுதப்படும் இடம்
செயல் விளைவுக்_கோப்பு(கோப்புப்_பெயர்) {
    திரும்பு சூழல்("ALUVALAKAM_OUT", சூழல்("TEMP", சூழல்("TMPDIR", "/tmp"))) & "/aluvalakam_" & கோப்புப்_பெயர்;
}

// __ஆவணத்_தலைப்புகள்(பெயர்) — the headers that make a browser save a .docx under this name__
// ஆவணத்_தலைப்புகள்(பெயர்) — வேர்டு கோப்பைப் பதிவிறக்கும் தலைப்புகள்
செயல் ஆவணத்_தலைப்புகள்(பெயர்) {
    திரும்பு { "Content-Type": "application/vnd.openxmlformats-officedocument.wordprocessingml.document",
             "Content-Disposition": "attachment; filename=\"" & பெயர் & "\"" };
}

// __அஜூர்_இணைப்பா() — the Azure DevOps connection, or தவறு when it is not configured__
// அஜூர்_இணைப்பா() — அஜூர் இணைப்பு, அல்லது அமைக்கப்படவில்லை எனில் தவறு
செயல் அஜூர்_இணைப்பா() {
    நிறுவனம் = சூழல்("AZURE_DEVOPS_ORG", "");
    (நிறுவனம் == "") எனில் {
        திரும்பு தவறு({ நிலைக்_குறி: 0, செய்தி: "Azure DevOps is not configured", மீண்டும்_முயல்_நொடிகள்: 0 });
    }
    திரும்பு சரி(அஜூர்_இணைப்பு_ஆக்கு(நிறுவனம், சூழல்("AZURE_DEVOPS_PROJECT", ""), "PAT",
                                    சூழல்("AZURE_DEVOPS_PAT", "")));
}

// __அஜூர்_அனுப்புவி(பணியுருப்படி_வகை, பணியுருப்படி_எண், பெற்றோர்_எண், ஒட்டுகள்) — the real send__
// அஜூர்_அனுப்புவி(பணியுருப்படி_வகை, பணியுருப்படி_எண், பெற்றோர்_எண், ஒட்டுகள்) — உண்மையான அனுப்புதல்
செயல் அஜூர்_அனுப்புவி(பணியுருப்படி_வகை, பணியுருப்படி_எண், பெற்றோர்_எண், ஒட்டுகள்) {
    இணைப்பு_விடை = அஜூர்_இணைப்பா();
    (தவறா(இணைப்பு_விடை)) எனில் { திரும்பு இணைப்பு_விடை; }
    இணைப்பு = மதிப்பு(இணைப்பு_விடை);
    (பணியுருப்படி_எண் == 0 மற்றும் பெற்றோர்_எண் > 0) எனில் {
        ஒட்டுகள் = இணை(ஒட்டுகள், பெற்றோர்_ஒட்டு(பணியுருப்படி_உரலி(இணைப்பு, பெற்றோர்_எண்)));
    }
    விளைவு = இன்மை;
    (பணியுருப்படி_எண் == 0) எனில் {
        விளைவு = பணியுருப்படியை_உருவாக்கு(இணைப்பு, பணியுருப்படி_வகை, ஒட்டுகள்);
    } இன்றேல் {
        விளைவு = பணியுருப்படியைத்_திருத்து(இணைப்பு, பணியுருப்படி_எண், ஒட்டுகள்);
    }
    (தவறா(விளைவு)) எனில் { திரும்பு விளைவு; }
    உள்ளது = மதிப்பு(விளைவு).பதில்_உடல்;
    திரும்பு சரி({ பணியுருப்படி_எண்: உள்ளது["id"], திருத்தம்: உள்ளது["rev"] });
}

// __அஜூர்_பெறுவி(பணியுருப்படி_எண்) — the real fetch, in the shape கொக்கி_கையாள் reads__
// அஜூர்_பெறுவி(பணியுருப்படி_எண்) — உண்மையான பெறுதல்
//
// __A work item does not carry its state's category, so it is looked up in the__
// __same states the outbox maps onto.__
செயல் அஜூர்_பெறுவி(பணியுருப்படி_எண்) {
    இணைப்பு_விடை = அஜூர்_இணைப்பா();
    (தவறா(இணைப்பு_விடை)) எனில் { திரும்பு இணைப்பு_விடை; }
    விளைவு = பணியுருப்படியைப்_பெறு(மதிப்பு(இணைப்பு_விடை), பணியுருப்படி_எண்);
    (தவறா(விளைவு)) எனில் { திரும்பு விளைவு; }
    உள்ளது = மதிப்பு(விளைவு).பதில்_உடல்;
    புலங்கள்_ = உள்ளது["fields"];
    நிலைப்_பெயர் = புலம்_அல்லது(புலங்கள்_, "System.State", "");
    வகைமை = "InProgress";
    ஒவ்வொரு ஒன்று இல் [["New", "Proposed"], ["Active", "InProgress"], ["Resolved", "Resolved"],
                       ["Closed", "Completed"], ["Removed", "Removed"]] {
        (ஒன்று[0] == நிலைப்_பெயர்) எனில் { வகைமை = ஒன்று[1]; }
    }
    மாற்றியவர் = புலம்_அல்லது(புலங்கள்_, "System.ChangedBy", "");
    (வகை(மாற்றியவர்) == "a record") எனில் { மாற்றியவர் = புலம்_அல்லது(மாற்றியவர், "uniqueName", ""); }
    திரும்பு சரி({ திருத்தம்: உள்ளது["rev"], மாற்றியவர்: மாற்றியவர், நிலைப்_பெயர்: நிலைப்_பெயர்,
                  நிலை_வகைமை: வகைமை,
                  முடிந்த_மணி: புலம்_அல்லது(புலங்கள்_, "Microsoft.VSTS.Scheduling.CompletedWork", இன்மை),
                  மீதி_மணி: புலம்_அல்லது(புலங்கள்_, "Microsoft.VSTS.Scheduling.RemainingWork", இன்மை),
                  "தலைப்பு": புலம்_அல்லது(புலங்கள்_, "System.Title", "") });
}

// __On start: the tables.__
தளம்_இணை சீகுலைட், களக்_கோப்பு();
களம்_அமை();

// __Every route but sign-in and the service hook starts with who is asking. A__
// __refusal is already a reply, so the route sends it as it is.__

வழி பதி, "/uLnuzYvu" {
    தளம்_இணை சீகுலைட், களக்_கோப்பு();
    விடை = உள்நுழைவு_கையாள்(request_body);
    பதில் விடை.நிலைக்_குறி, ஜேசான்_ஆக்கு(விடை.விடை_உடல்);
}

வழி பெறு, "/qittam/:kuRi/attavaNY" {
    தளம்_இணை சீகுலைட், களக்_கோப்பு();
    அனுமதி = அனுமதி_பெறு(புலம்_அல்லது(headers, "authorization", ""), படிப்போர்());
    (தவறா(அனுமதி)) எனில் {
        பதில் தவறு_மதிப்பு(அனுமதி).நிலைக்_குறி, ஜேசான்_ஆக்கு(தவறு_மதிப்பு(அனுமதி).விடை_உடல்);
    } இன்றேல் {
        விடை = அட்டவணை_கையாள்(param_kuRi, இன்று());
        பதில் விடை.நிலைக்_குறி, ஜேசான்_ஆக்கு(விடை.விடை_உடல்);
    }
}

வழி பெறு, "/qittam/:kuRi/nalam" {
    தளம்_இணை சீகுலைட், களக்_கோப்பு();
    அனுமதி = அனுமதி_பெறு(புலம்_அல்லது(headers, "authorization", ""), படிப்போர்());
    (தவறா(அனுமதி)) எனில் {
        பதில் தவறு_மதிப்பு(அனுமதி).நிலைக்_குறி, ஜேசான்_ஆக்கு(தவறு_மதிப்பு(அனுமதி).விடை_உடல்);
    } இன்றேல் {
        விடை = நல_கையாள்(param_kuRi, இன்று());
        பதில் விடை.நிலைக்_குறி, ஜேசான்_ஆக்கு(விடை.விடை_உடல்);
    }
}

வழி பெறு, "/qittam/:kuRi/aRikkY" {
    தளம்_இணை சீகுலைட், களக்_கோப்பு();
    அனுமதி = அனுமதி_பெறு(புலம்_அல்லது(headers, "authorization", ""), படிப்போர்());
    (தவறா(அனுமதி)) எனில் {
        பதில் தவறு_மதிப்பு(அனுமதி).நிலைக்_குறி, ஜேசான்_ஆக்கு(தவறு_மதிப்பு(அனுமதி).விடை_உடல்);
    } இன்றேல் {
        விடை = அறிக்கை_கையாள்(param_kuRi, "", இன்று(), வார்ப்புக்_கோப்பு("aRikkY.docx"));
        பதில் விடை.நிலைக்_குறி, ஜேசான்_ஆக்கு(விடை.விடை_உடல்);
    }
}

வழி பெறு, "/qittam/:kuRi/cAcaZam" {
    தளம்_இணை சீகுலைட், களக்_கோப்பு();
    அனுமதி = அனுமதி_பெறு(புலம்_அல்லது(headers, "authorization", ""), படிப்போர்());
    (தவறா(அனுமதி)) எனில் {
        பதில் தவறு_மதிப்பு(அனுமதி).நிலைக்_குறி, ஜேசான்_ஆக்கு(தவறு_மதிப்பு(அனுமதி).விடை_உடல்);
    } இன்றேல் {
        விடை = சாசன_கையாள்(param_kuRi, வார்ப்புக்_கோப்பு("cAcaZam.docx"));
        பதில் விடை.நிலைக்_குறி, ஜேசான்_ஆக்கு(விடை.விடை_உடல்);
    }
}

// __The same two documents as Word files, filled from the templates in__
// __vArppukaL — which are edited in Word, not in this code.__

வழி பெறு, "/qittam/:kuRi/aRikkY/kOppu" {
    தளம்_இணை சீகுலைட், களக்_கோப்பு();
    அனுமதி = அனுமதி_பெறு(புலம்_அல்லது(headers, "authorization", ""), படிப்போர்());
    (தவறா(அனுமதி)) எனில் {
        பதில் தவறு_மதிப்பு(அனுமதி).நிலைக்_குறி, ஜேசான்_ஆக்கு(தவறு_மதிப்பு(அனுமதி).விடை_உடல்);
    } இன்றேல் {
        பெயர்_ = ஆவணப்_பெயர்(param_kuRi, "aRikkY.docx");
        விடை = அறிக்கைக்_கோப்பு_கையாள்(param_kuRi, "", இன்று(), வார்ப்புக்_கோப்பு("aRikkY.docx"), விளைவுக்_கோப்பு(பெயர்_));
        (விடை.நிலைக்_குறி == 200) எனில் {
            பதில்_கோப்பு(200, விடை.விடை_உடல்.கோப்புப்_பாதை, ஆவணத்_தலைப்புகள்(பெயர்_));
        } இன்றேல் {
            பதில் விடை.நிலைக்_குறி, ஜேசான்_ஆக்கு(விடை.விடை_உடல்);
        }
    }
