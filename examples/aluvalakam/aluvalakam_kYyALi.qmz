            }
        }
        ஒவ்வொரு புதிய_பணி இல் ஆனவை {
            முன்னோடிகள் = [];
            ஒவ்வொரு உருப்படி இல் மாற்றம்["உருப்படிகள்"] {
                (உருப்படி.உருப்படிக்_குறி == புதிய_பணி.பணி_குறி) எனில் {
                    முன்னோடிகள் = புலம்_அல்லது(உருப்படி, "முன்னோடிகள்", []);
                }
            }
            அமைந்தது = அட்டவணைக்கு_அமை(புதிய_பணி, மணியிலிருந்து_நாட்கள்(புதிய_பணி.மதிப்பீட்டு_மணி, 8), முன்னோடிகள்);
            பணியைச்_சேமி(திட்டக்_குறி, அமைந்தது);
            புதிய_பணிகள் = இணை(புதிய_பணிகள், அமைந்தது);
        }
        எல்லாம் = திட்டப்_பணிகள்(திட்டக்_குறி);
        ஒவ்வொரு புதிய_பணி இல் புதிய_பணிகள் { வரிசையில்_சேர்(திட்டக்_குறி, புதிய_பணி, எல்லாம், ரகசிய_விசை); }
    }
    திரும்பு விடை_ஆக்கு(200, { மாற்றம்: மாற்றம், புதிய_பணிகள்: புதிய_பணிகள் });
}

// __--- What Azure DevOps sends back --------------------------------------__

// __கொக்கி_கையாள்(வந்த_சீட்டு, உடலுரை, பதிந்த_கைரேகை, ரகசிய_விசை, எங்கள்_அடையாளம், செயல் பெறுவி) — POST a service hook__
// கொக்கி_கையாள்(வந்த_சீட்டு, உடலுரை, பதிந்த_கைரேகை, ரகசிய_விசை, எங்கள்_அடையாளம், செயல் பெறுவி) — ஒரு சேவைக் கொக்கியைக் கையாளும்
//
// __The token in the url is checked first; a wrong one is a 401 with no detail.__
// __The hook names a work item; the task it belongs to is found by the number the__
// __outbox recorded, and the item itself is fetched again with பெறுவி(உருப்படி_எண்), which__
// __returns சரி({திருத்தம், மாற்றியவர், நிலைப்_பெயர், நிலை_வகைமை, முடிந்த_மணி,__
// __மீதி_மணி, தலைப்பு}) — the hook's own body is never trusted for content. What__
// __comes back passes the echo brakes, then field ownership: their status and__
// __progress are applied, an edit to our title is refused and logged.__
செயல் கொக்கி_கையாள்(வந்த_சீட்டு, உடலுரை, பதிந்த_கைரேகை, ரகசிய_விசை, எங்கள்_அடையாளம், செயல் பெறுவி) {
    (இல்லை கொக்கிச்_சீட்டு_சரியா(வந்த_சீட்டு, பதிந்த_கைரேகை, ரகசிய_விசை)) எனில் {
        திரும்பு பிழை_விடை(401, "அனுமதி இல்லை  (not authorised)");
    }
    படித்தது = கொக்கி_நிகழ்வைப்_படி(உடலுரை);
    (தவறா(படித்தது)) எனில் { திரும்பு பிழை_விடை(400, தவறு_மதிப்பு(படித்தது)); }
    உருப்படி_எண் = மதிப்பு(படித்தது).பணியுருப்படி_எண்;

    திட்டக்_குறி = "";
    ஒரு_பணி = இன்மை;
    ஒவ்வொரு திட்டம்_பதிவு இல் எல்லாத்_திட்டங்களும்() {
        ஒவ்வொரு ஒன்று இல் திட்டப்_பணிகள்(திட்டம்_பதிவு["திட்டக்_குறி"]) {
            (புலம்_அல்லது(ஒன்று, "பணியுருப்படி_எண்", 0) == உருப்படி_எண்) எனில் {
                ஒரு_பணி = ஒன்று;
                திட்டக்_குறி = திட்டம்_பதிவு["திட்டக்_குறி"];
            }
        }
    }
    (ஒரு_பணி == இன்மை) எனில் { திரும்பு விடை_ஆக்கு(200, { முடிவு: "தெரியாதது", பணியுருப்படி_எண்: உருப்படி_எண் }); }

    பெற்றது = பெறுவி(உருப்படி_எண்);
    (தவறா(பெற்றது)) எனில் { திரும்பு பிழை_விடை(502, சொல்லாக்கு(தவறு_மதிப்பு(பெற்றது))); }
    உருப்படி = மதிப்பு(பெற்றது);
    வரவுப்_புலங்கள் = { நடப்பு_நிலை: உள்_நிலை(உருப்படி.நிலைப்_பெயர், உருப்படி.நிலை_வகைமை) };
    நிறைவு = மணியிலிருந்து_நிறைவு(உருப்படி.முடிந்த_மணி, உருப்படி.மீதி_மணி);
    (நிறைவு != இன்மை) எனில் { வரவுப்_புலங்கள்["நிறைவு"] = நிறைவு; }
    (உருப்படி["தலைப்பு"] != அனுப்பும்_வடிவம்(ஒரு_பணி)["தலைப்பு"]) எனில் { வரவுப்_புலங்கள்["தலைப்பு"] = உருப்படி["தலைப்பு"]; }
    வரவுக்_கைரேகை = கைரேகை(வரவுப்_புலங்கள், ரகசிய_விசை);
    முடிவு = வரவு_முடிவு(உருப்படி.திருத்தம், புலம்_அல்லது(ஒரு_பணி, "அனுப்பிய_திருத்தம்", 0),
                          உருப்படி.மாற்றியவர், எங்கள்_அடையாளம், வரவுக்_கைரேகை,
                          புலம்_அல்லது(ஒரு_பணி, "பதிந்த_கைரேகை", ""));
    (முடிவு != "ஏற்கலாம்") எனில் { திரும்பு விடை_ஆக்கு(200, { முடிவு: முடிவு, பணியுருப்படி_எண்: உருப்படி_எண் }); }

    பிரிப்பு = வரவைப்_பிரி(இயல்பு_உரிமைகள்(), வரவுப்_புலங்கள்);
    புதியது = ஒரு_பணி;
    ஒவ்வொரு புலப்_பெயர் இல் பிரிப்பு.ஏற்பவை { புதியது[புலப்_பெயர்] = பிரிப்பு.ஏற்பவை[புலப்_பெயர்]; }
    புதியது["பதிந்த_கைரேகை"] = வரவுக்_கைரேகை;
    பணியைச்_சேமி(திட்டக்_குறி, புதியது);
    நிகழ்வைப்_பதி(திட்டக்_குறி & "/" & ஒரு_பணி.பணி_குறி,
                  { நிகழ்வு_வகை: "அஜூர்_வரவு", திருத்தம்: உருப்படி.திருத்தம், ஏற்பவை: பிரிப்பு.ஏற்பவை,
                    மறுப்பவை: பிரிப்பு.மறுப்பவை });
    திரும்பு விடை_ஆக்கு(200, { முடிவு: முடிவு, பணியுருப்படி_எண்: உருப்படி_எண், ஏற்பவை: பிரிப்பு.ஏற்பவை,
                              மறுப்பவை: பிரிப்பு.மறுப்பவை });
}

// __--- Who is asking -----------------------------------------------------__
//
// __Three roles. மேலாளர் — the project manager — may do anything, including move a__
// __change request and rewrite the scope. உறுப்பினர் — a team member — may read__
// __and record progress. பார்வையாளர் — a stakeholder — may only read. A password__
// __is stored only as its bcrypt hash, and a sign-in yields a signed token that__
// __every request after it carries as "Authorization: Bearer <token>".__

// __பயனரை_ஆக்கு(பயனர்_பெயர், கடவுச்சொல், பயனர்_பங்கு) — create or replace a user__
// பயனரை_ஆக்கு(பயனர்_பெயர், கடவுச்சொல், பயனர்_பங்கு) — ஒரு பயனரை உருவாக்கும்
செயல் பயனரை_ஆக்கு(பயனர்_பெயர், கடவுச்சொல், பயனர்_பங்கு) {
    மறையீடு = கடவுச்சொல்_மறை(கடவுச்சொல்);
    (வகை(மறையீடு) == "a result") எனில் {
        (தவறா(மறையீடு)) எனில் { திரும்பு மறையீடு; }
        மறையீடு = மதிப்பு(மறையீடு);
    }
    பயனரைச்_சேமி({ பயனர்_பெயர்: பயனர்_பெயர், மறையீடு: மறையீடு, பயனர்_பங்கு: பயனர்_பங்கு });
    திரும்பு சரி(பயனர்_பெயர்);
}

// __உள்நுழைவு_கையாள்(உடலுரை) — POST a sign-in; the reply carries the token__
// உள்நுழைவு_கையாள்(உடலுரை) — உள்நுழைவு; விடையில் சீட்டு
//
// __{பயனர்_பெயர், கடவுச்சொல்} in; {சீட்டு, பயனர்_பங்கு, நொடிகள்} out, the token good for__
// __eight hours. An unknown user and a wrong password give the same 401, so the__
// __reply does not say which names exist.__
செயல் உள்நுழைவு_கையாள்(உடலுரை) {
    படித்தது = ஜேசான்_படி(உடலுரை);
    (தவறா(படித்தது)) எனில் { திரும்பு பிழை_விடை(400, "செல்லாத ஜேசான்  (invalid JSON)"); }
    கேட்டது = மதிப்பு(படித்தது);
    கிடைத்தது = பயனரைப்_பெறு(சொல்லாக்கு(புலம்_அல்லது(கேட்டது, "பயனர்_பெயர்", "")));
    சரியானதா = சரியா(கிடைத்தது);
    (சரியானதா) எனில் {
        சரியானதா = கடவுச்சொல்_சரியா(சொல்லாக்கு(புலம்_அல்லது(கேட்டது, "கடவுச்சொல்", "")),
                                    மதிப்பு(கிடைத்தது).மறையீடு);
    }
    (இல்லை சரியானதா) எனில் { திரும்பு பிழை_விடை(401, "பெயரோ கடவுச்சொல்லோ தவறு  (wrong name or password)"); }
    பயனர் = மதிப்பு(கிடைத்தது);
    சீட்டு = சீட்டு_ஆக்கு(ஜேசான்_ஆக்கு({ பயனர்_பெயர்: பயனர்.பயனர்_பெயர், பயனர்_பங்கு: பயனர்.பயனர்_பங்கு,
                                     சீட்டுப்_பதிப்பு: புலம்_அல்லது(பயனர், "சீட்டுப்_பதிப்பு", 0) }), 28800);
    திரும்பு விடை_ஆக்கு(200, { சீட்டு: சீட்டு, பயனர்_பங்கு: பயனர்.பயனர்_பங்கு, நொடிகள்: 28800 });
}

// __அனுமதி_பெறு(அனுமதித்_தலைப்பு, பங்குகள்) — who is asking, and may they?__
// அனுமதி_பெறு(அனுமதித்_தலைப்பு, பங்குகள்) — கேட்பவர் யார், அவருக்கு அனுமதி உண்டா
//
// __அனுமதித்_தலைப்பு is the request's Authorization header; பங்குகள் the roles the__
// __route admits. சரி with {பயனர்_பெயர், பயனர்_பங்கு}, or தவறு with the reply to send —__
// __401 for no token or a bad or expired one, 403 for a role the route does not__
// __admit — so a route that is refused needs one line to say so.__
//
// __The role is read from the user's record, not the token, so a change of role__
// __holds from the next request; and a token from before a password reset is__
// __refused, because the reset moved the record's சீட்டுப்_பதிப்பு past it.__
செயல் அனுமதி_பெறு(அனுமதித்_தலைப்பு, பங்குகள்) {
    உரை_ = சொல்லாக்கு(அனுமதித்_தலைப்பு);
    (இல்லை தொடங்குகிறதா(உரை_, "Bearer ")) எனில் {
        திரும்பு தவறு(பிழை_விடை(401, "உள்நுழைய வேண்டும்  (sign in first)"));
    }
    உரிமைகள்_ = சீட்டு_சரிபார்(துண்டு(உரை_, 7, நீளம்(உரை_) - 7));
    (தவறா(உரிமைகள்_)) எனில் { திரும்பு தவறு(பிழை_விடை(401, "சீட்டு செல்லாது  (the token is not valid)")); }
    படித்த_உரிமை = ஜேசான்_படி(மதிப்பு(உரிமைகள்_));
    (தவறா(படித்த_உரிமை)) எனில் { திரும்பு தவறு(பிழை_விடை(401, "சீட்டு செல்லாது  (the token is not valid)")); }
    கோருபவர் = மதிப்பு(படித்த_உரிமை);
    பதிந்தவர் = பயனரைப்_பெறு(சொல்லாக்கு(புலம்_அல்லது(கோருபவர், "பயனர்_பெயர்", "")));
    (தவறா(பதிந்தவர்)) எனில் { திரும்பு தவறு(பிழை_விடை(401, "சீட்டு செல்லாது  (the token is not valid)")); }
    பயனர் = மதிப்பு(பதிந்தவர்);
    (புலம்_அல்லது(பயனர், "சீட்டுப்_பதிப்பு", 0) != புலம்_அல்லது(கோருபவர், "சீட்டுப்_பதிப்பு", 0)) எனில் {
        திரும்பு தவறு(பிழை_விடை(401, "கடவுச்சொல் மாறியது; மீண்டும் உள்நுழைக  (the password changed; sign in again)"));
    }
    (இல்லை உள்ளதா(பங்குகள், பயனர்.பயனர்_பங்கு)) எனில் {
        திரும்பு தவறு(பிழை_விடை(403, "இப்பங்குக்கு அனுமதி இல்லை  (this role may not do that)"));
    }
    திரும்பு சரி({ பயனர்_பெயர்: பயனர்.பயனர்_பெயர், பயனர்_பங்கு: பயனர்.பயனர்_பங்கு });
}

// __படிப்போர்() — the roles that may read__
// படிப்போர்() — படிக்க அனுமதியுள்ள பங்குகள்
செயல் படிப்போர்() { திரும்பு ["மேலாளர்", "உறுப்பினர்", "பார்வையாளர்"]; }

// __பதிவோர்() — the roles that may record progress__
// பதிவோர்() — முன்னேற்றம் பதிய அனுமதியுள்ள பங்குகள்
செயல் பதிவோர்() { திரும்பு ["மேலாளர்", "உறுப்பினர்"]; }

// __மேலாளர்கள்() — the roles that may change the plan__
// மேலாளர்கள்() — திட்டத்தை மாற்ற அனுமதியுள்ள பங்குகள்
செயல் மேலாளர்கள்() { திரும்பு ["மேலாளர்"]; }

// __--- Users -------------------------------------------------------------__
// __A manager adds people, changes what they may do and resets a forgotten__
// __password; the routes admit no one else. No reply carries a password hash.__

// __பயனர்_பட்டியல்_கையாள்() — GET the users: names and roles only__
// பயனர்_பட்டியல்_கையாள்() — பயனர்களின் பெயரும் பங்கும் மட்டும்
செயல் பயனர்_பட்டியல்_கையாள்() {
    விடை = [];
    ஒவ்வொரு ஒருவர் இல் எல்லாப்_பயனர்களும்() {
        விடை = இணை(விடை, { பயனர்_பெயர்: ஒருவர்.பயனர்_பெயர், பயனர்_பங்கு: ஒருவர்.பயனர்_பங்கு });
    }
    திரும்பு விடை_ஆக்கு(200, { பயனர்கள்: விடை });
}

// __கடவுச்சொல்_குறை(கடவுச்சொல்) — what is wrong with a new password, or ""__
// கடவுச்சொல்_குறை(கடவுச்சொல்) — புதிய கடவுச்சொல்லின் குறை; இல்லையெனில் ""
செயல் கடவுச்சொல்_குறை(கடவுச்சொல்) {
    (நீளம்(கடவுச்சொல்) < 12) எனில் { திரும்பு "கடவுச்சொல் குறைந்தது 12 எழுத்து  (a password needs at least 12 characters)"; }
    திரும்பு "";
}

// __பயனர்_சேர்_கையாள்(உடலுரை) — POST a new user: {பயனர்_பெயர், கடவுச்சொல், பயனர்_பங்கு}__
// பயனர்_சேர்_கையாள்(உடலுரை) — புதிய பயனரைச் சேர்க்கும்
//
// __A name already taken is a 409, so adding someone never overwrites someone.__
செயல் பயனர்_சேர்_கையாள்(உடலுரை) {
    படித்தது = ஜேசான்_படி(உடலுரை);
    (தவறா(படித்தது)) எனில் { திரும்பு பிழை_விடை(400, "செல்லாத ஜேசான்  (invalid JSON)"); }
    கேட்டது = மதிப்பு(படித்தது);
    பெயர்_ = சொல்லாக்கு(புலம்_அல்லது(கேட்டது, "பயனர்_பெயர்", ""));
    பங்கு_ = சொல்லாக்கு(புலம்_அல்லது(கேட்டது, "பயனர்_பங்கு", ""));
    கடவுச்சொல்_ = சொல்லாக்கு(புலம்_அல்லது(கேட்டது, "கடவுச்சொல்", ""));
    (பெயர்_ == "") எனில் { திரும்பு பிழை_விடை(400, "பெயர் தேவை  (a name is needed)"); }
    (இல்லை உள்ளதா(படிப்போர்(), பங்கு_)) எனில் { திரும்பு பிழை_விடை(400, "அறியாத பங்கு  (unknown role): " & பங்கு_); }
    குறை = கடவுச்சொல்_குறை(கடவுச்சொல்_);
    (குறை != "") எனில் { திரும்பு பிழை_விடை(400, குறை); }
    (சரியா(பயனரைப்_பெறு(பெயர்_))) எனில் { திரும்பு பிழை_விடை(409, "இப்பெயர் ஏற்கெனவே உள்ளது  (that name is taken)"); }
    ஆக்கியது = பயனரை_ஆக்கு(பெயர்_, கடவுச்சொல்_, பங்கு_);
    (தவறா(ஆக்கியது)) எனில் { திரும்பு பிழை_விடை(500, தவறு_மதிப்பு(ஆக்கியது)); }
    திரும்பு விடை_ஆக்கு(201, { பயனர்_பெயர்: பெயர்_, பயனர்_பங்கு: பங்கு_ });
}

// __பங்கு_மாற்று_கையாள்(பயனர்_பெயர், உடலுரை) — POST a user's new role: {பயனர்_பங்கு}__
// பங்கு_மாற்று_கையாள்(பயனர்_பெயர், உடலுரை) — பயனரின் பங்கை மாற்றும்
//
// __The last manager cannot be made anything else — that would leave no one able__
// __to manage users, this route included.__
செயல் பங்கு_மாற்று_கையாள்(பயனர்_பெயர், உடலுரை) {
    படித்தது = ஜேசான்_படி(உடலுரை);
    (தவறா(படித்தது)) எனில் { திரும்பு பிழை_விடை(400, "செல்லாத ஜேசான்  (invalid JSON)"); }
    புதிய_பங்கு = சொல்லாக்கு(புலம்_அல்லது(மதிப்பு(படித்தது), "பயனர்_பங்கு", ""));
    (இல்லை உள்ளதா(படிப்போர்(), புதிய_பங்கு)) எனில் { திரும்பு பிழை_விடை(400, "அறியாத பங்கு  (unknown role): " & புதிய_பங்கு); }
    கிடைத்தது = பயனரைப்_பெறு(பயனர்_பெயர்);
    (தவறா(கிடைத்தது)) எனில் { திரும்பு பிழை_விடை(404, தவறு_மதிப்பு(கிடைத்தது)); }
    பயனர் = மதிப்பு(கிடைத்தது);
    மேலாளர்_எண்ணிக்கை = 0;
    ஒவ்வொரு ஒருவர் இல் எல்லாப்_பயனர்களும்() {
        (ஒருவர்.பயனர்_பங்கு == "மேலாளர்") எனில் { மேலாளர்_எண்ணிக்கை = மேலாளர்_எண்ணிக்கை + 1; }
    }
    (பயனர்.பயனர்_பங்கு == "மேலாளர்" மற்றும் புதிய_பங்கு != "மேலாளர்" மற்றும் மேலாளர்_எண்ணிக்கை == 1) எனில் {
        திரும்பு பிழை_விடை(409, "கடைசி மேலாளரை மாற்ற முடியாது  (the last manager must stay a manager)");
    }
    பயனர்["பயனர்_பங்கு"] = புதிய_பங்கு;
    பயனரைச்_சேமி(பயனர்);
    திரும்பு விடை_ஆக்கு(200, { பயனர்_பெயர்: பயனர்_பெயர், பயனர்_பங்கு: புதிய_பங்கு });
}

// __கடவுச்சொல்_மாற்று_கையாள்(பயனர்_பெயர், உடலுரை) — POST a user's new password: {கடவுச்சொல்}__
// கடவுச்சொல்_மாற்று_கையாள்(பயனர்_பெயர், உடலுரை) — பயனரின் கடவுச்சொல்லை மாற்றும்
//
// __Every token the user already holds stops working: the reset moves__
// __சீட்டுப்_பதிப்பு on, and அனுமதி_பெறு refuses a token that carries an old one.__
செயல் கடவுச்சொல்_மாற்று_கையாள்(பயனர்_பெயர், உடலுரை) {
    படித்தது = ஜேசான்_படி(உடலுரை);
    (தவறா(படித்தது)) எனில் { திரும்பு பிழை_விடை(400, "செல்லாத ஜேசான்  (invalid JSON)"); }
    கடவுச்சொல்_ = சொல்லாக்கு(புலம்_அல்லது(மதிப்பு(படித்தது), "கடவுச்சொல்", ""));
    குறை = கடவுச்சொல்_குறை(கடவுச்சொல்_);
    (குறை != "") எனில் { திரும்பு பிழை_விடை(400, குறை); }
    கிடைத்தது = பயனரைப்_பெறு(பயனர்_பெயர்);
    (தவறா(கிடைத்தது)) எனில் { திரும்பு பிழை_விடை(404, தவறு_மதிப்பு(கிடைத்தது)); }
    பழையவர் = மதிப்பு(கிடைத்தது);
    ஆக்கியது = பயனரை_ஆக்கு(பயனர்_பெயர், கடவுச்சொல்_, பழையவர்.பயனர்_பங்கு);
    (தவறா(ஆக்கியது)) எனில் { திரும்பு பிழை_விடை(500, தவறு_மதிப்பு(ஆக்கியது)); }
    புதியவர் = மதிப்பு(பயனரைப்_பெறு(பயனர்_பெயர்));
    புதியவர்["சீட்டுப்_பதிப்பு"] = புலம்_அல்லது(பழையவர், "சீட்டுப்_பதிப்பு", 0) + 1;
    பயனரைச்_சேமி(புதியவர்);
    திரும்பு விடை_ஆக்கு(200, { பயனர்_பெயர்: பயனர்_பெயர் });
}

// __--- Scope, documents, commitments ------------------------------------__

// __நோக்க_கையாள்(திட்டக்_குறி, உடலுரை, ரகசிய_விசை) — POST the scope, and rebuild the tasks from it__
// நோக்க_கையாள்(திட்டக்_குறி, உடலுரை, ரகசிய_விசை) — நோக்கத்தைப் பதிந்து பணிகளை மீளமைக்கும்
//
// __The body is {வரிகள், தேர்ந்த_அம்சங்கள், விளைவுகள்} as nOkkam.qmz reads them;__
// __each row and each பணி_சேர் impact may also name its முன்னோடிகள். Refused with__
// __409 once the project is baselined — after that, scope moves by change__
// __request. A task that stays keeps its status, progress and actuals and takes__
// __the new estimate; one that leaves scope is deleted, or cancelled if it is__
// __already a work item, because deleting it here would orphan the item there.__
செயல் நோக்க_கையாள்(திட்டக்_குறி, உடலுரை, ரகசிய_விசை) {
    படித்தது = ஜேசான்_படி(உடலுரை);
    (தவறா(படித்தது)) எனில் {
        திரும்பு பிழை_விடை(400, "உடல் ஒரு ஜேசான் பதிவாக இருக்க வேண்டும்  (the body must be a JSON record)");
    }
    (வகை(மதிப்பு(படித்தது)) != "a record") எனில் {
        திரும்பு பிழை_விடை(400, "உடல் ஒரு ஜேசான் பதிவாக இருக்க வேண்டும்  (the body must be a JSON record)");
    }
    கேட்டது = மதிப்பு(படித்தது);
    கிடைத்தது = திட்டத்தைப்_பெறு(திட்டக்_குறி);
    (தவறா(கிடைத்தது)) எனில் { திரும்பு பிழை_விடை(404, தவறு_மதிப்பு(கிடைத்தது)); }
    (மதிப்பு(கிடைத்தது)["பூட்டியதா"]) எனில் {
        திரும்பு பிழை_விடை(409, "அடிப்படைத் திட்டம் பூட்டியுள்ளது; நோக்கம் மாற்றக் கோரிக்கையால் மட்டுமே மாறும்  "
                                  & "(the baseline is locked; scope changes by change request)");
    }
    வரிகள் = புலம்_அல்லது(கேட்டது, "வரிகள்", []);
    விளைவுகள் = புலம்_அல்லது(கேட்டது, "விளைவுகள்", []);
    நோக்கம் = நோக்கத்தைப்_பயன்படுத்து(வரிகள், புலம்_அல்லது(கேட்டது, "தேர்ந்த_அம்சங்கள்", []), விளைவுகள்);
    (தவறா(நோக்கம்)) எனில் { திரும்பு பிழை_விடை(400, தவறு_மதிப்பு(நோக்கம்)); }

    முன்னோடி_வரைபடம் = {};
    ஒவ்வொரு ஒன்று இல் வரிகள் { முன்னோடி_வரைபடம்[ஒன்று["பகுப்புக்_குறி"]] = புலம்_அல்லது(ஒன்று, "முன்னோடிகள்", []); }
    ஒவ்வொரு ஒன்று இல் விளைவுகள் { முன்னோடி_வரைபடம்[ஒன்று["பகுப்புக்_குறி"]] = புலம்_அல்லது(ஒன்று, "முன்னோடிகள்", []); }
    இருப்பவை = {};
    ஒவ்வொரு ஒன்று இல் திட்டப்_பணிகள்(திட்டக்_குறி) { இருப்பவை[ஒன்று.பணி_குறி] = ஒன்று; }

    புதிய_குறிகள் = {};
    புதியவை = [];
    ஒவ்வொரு ஒரு_பணி இல் மதிப்பு(நோக்கம்).பணிகள் {
        அமைந்தது = அட்டவணைக்கு_அமை(ஒரு_பணி, மணியிலிருந்து_நாட்கள்(ஒரு_பணி.மதிப்பீட்டு_மணி, 8),
                                   புலம்_அல்லது(முன்னோடி_வரைபடம், ஒரு_பணி.பணி_குறி, []));
        (புலம்_உள்ளதா(இருப்பவை, ஒரு_பணி.பணி_குறி)) எனில் {
            பழையது = இருப்பவை[ஒரு_பணி.பணி_குறி];
            ஒவ்வொரு புலப்_பெயர் இல் ["நடப்பு_நிலை", "நிறைவு", "உண்மைத்_தொடக்கம்", "முடிந்த_நாள்",
                                     "பணியுருப்படி_எண்", "அனுப்பிய_திருத்தம்", "பதிந்த_கைரேகை"] {
                (புலம்_உள்ளதா(பழையது, புலப்_பெயர்)) எனில் { அமைந்தது[புலப்_பெயர்] = பழையது[புலப்_பெயர்]; }
            }
        }
        பணியைச்_சேமி(திட்டக்_குறி, அமைந்தது);
        புதிய_குறிகள்[அமைந்தது.பணி_குறி] = மெய்;
        புதியவை = இணை(புதியவை, அமைந்தது);
    }
    நீக்கியவை = [];
    கைவிட்டவை = [];
    ஒவ்வொரு குறி_ இல் இருப்பவை {
        (இல்லை புலம்_உள்ளதா(புதிய_குறிகள், குறி_)) எனில் {
            பழையது = இருப்பவை[குறி_];
            (புலம்_அல்லது(பழையது, "பணியுருப்படி_எண்", 0) != 0) எனில் {
                பழையது["நடப்பு_நிலை"] = "கைவிட்டது";
                பணியைச்_சேமி(திட்டக்_குறி, பழையது);
                கைவிட்டவை = இணை(கைவிட்டவை, குறி_);
                புதியவை = இணை(புதியவை, பழையது);
            } இன்றேல் {
                பணியை_நீக்கு(திட்டக்_குறி, குறி_);
                நீக்கியவை = இணை(நீக்கியவை, குறி_);
            }
        }
    }
    எல்லாம் = திட்டப்_பணிகள்(திட்டக்_குறி);
    ஒவ்வொரு ஒரு_பணி இல் புதியவை { வரிசையில்_சேர்(திட்டக்_குறி, ஒரு_பணி, எல்லாம், ரகசிய_விசை); }
    நிகழ்வைப்_பதி(திட்டக்_குறி, { நிகழ்வு_வகை: "நோக்கம்", பணிகள்: நீளம்(மதிப்பு(நோக்கம்).பணிகள்),
                                 நீக்கியவை: நீக்கியவை, கைவிட்டவை: கைவிட்டவை });
    திரும்பு விடை_ஆக்கு(200, { பணிகள்: நீளம்(மதிப்பு(நோக்கம்).பணிகள்), விலக்குகள்: மதிப்பு(நோக்கம்).விலக்குகள்,
                              நீக்கியவை: நீக்கியவை, கைவிட்டவை: கைவிட்டவை });
}

// __அறிக்கை_வார்ப்பு() — the status report template the service renders__
// அறிக்கை_வார்ப்பு() — சேவை நிரப்பும் நிலை அறிக்கை வார்ப்புரு
//
// __The body of a .docx, the part AvaNam.qmz fills, for the JSON reply. The__
// __document a person opens is filled from vArppukaL/aRikkY.docx instead, which__
// __is edited in Word; this one is here so the JSON route needs no file.__
செயல் அறிக்கை_வார்ப்பு() {
    திரும்பு "<w:body><w:tr>{{ திட்டம்.பெயர் }} — {{ காலம்.தொடக்கம் }} முதல் {{ காலம்.முடிவு }}</w:tr>"
          & "<w:tr>நிலை: {{ நலம்.நிறம் }}; நிறைவு {{ நலம்.நிறைவு }}%, காலம் {{ நலம்.கழிந்தது }}%</w:tr>"
          & "<w:tr>{%tr for சாதனை in சாதனைகள் %}</w:tr><w:tr>சாதனை: {{ சாதனை.விவரம் }}</w:tr><w:tr>{%tr endfor %}</w:tr>"
          & "<w:tr>{%tr for தடை in தடைகள் %}</w:tr><w:tr>தடை: {{ தடை.விவரம் }}</w:tr><w:tr>{%tr endfor %}</w:tr>"
          & "<w:tr>{%tr for அடுத்தது in அடுத்தவை %}</w:tr><w:tr>அடுத்து: {{ அடுத்தது.விவரம் }}</w:tr><w:tr>{%tr endfor %}</w:tr>"
          & "<w:tr>{%tr for காரணம் in காரணங்கள் %}</w:tr><w:tr>ஏன்: {{ காரணம்.காரண_உரை }}</w:tr><w:tr>{%tr endfor %}</w:tr></w:body>";
}

// __பணிக்_குறிகள்(பணிகள்) — the codes of some tasks__
// பணிக்_குறிகள்(பணிகள்) — பணிகளின் குறிகள்
செயல் பணிக்_குறிகள்(பணிகள்) {
    விடை = [];
    ஒவ்வொரு ஒன்று இல் பணிகள் { விடை = இணை(விடை, ஒன்று.பணி_குறி); }
    திரும்பு விடை;
}

// __அறிக்கை_கையாள்(திட்டக்_குறி, முந்தைய_அறிக்கை_நாள், இன்றைய_நாள்) — GET the status report, drafted and rendered__
// அறிக்கை_கையாள்(திட்டக்_குறி, முந்தைய_அறிக்கை_நாள், இன்றைய_நாள்) — நிலை அறிக்கையை வரைந்து நிரப்பித் தரும்
//
// __The period runs from the day after the previous report ("" for the first);__
// __the achievements, blockers and next steps come from the tasks, the colour and__
// __its reasons from the health. Returns them, and the rendered document body.__
செயல் அறிக்கை_கையாள்(திட்டக்_குறி, முந்தைய_அறிக்கை_நாள், இன்றைய_நாள்) {
    பெற்ற_தரவு = அறிக்கைத்_தரவு(திட்டக்_குறி, முந்தைய_அறிக்கை_நாள், இன்றைய_நாள்);
    (தவறா(பெற்ற_தரவு)) எனில் { திரும்பு தவறு_மதிப்பு(பெற்ற_தரவு); }
    அறிக்கை_ = மதிப்பு(பெற்ற_தரவு);
    வேட்பாளர்கள் = அறிக்கை_.வேட்பாளர்கள்;
    திரும்பு விடை_ஆக்கு(200, { காலம்: அறிக்கை_.காலம், நிறம்: அறிக்கை_.நிறம்,
        சாதனைகள்: பணிக்_குறிகள்(வேட்பாளர்கள்.சாதனைகள்), தடைகள்: பணிக்_குறிகள்(வேட்பாளர்கள்.தடைகள்),
        அடுத்தவை: பணிக்_குறிகள்(வேட்பாளர்கள்.அடுத்தவை),
        ஆவண_உடல்: ஆவணம்_நிரப்பு(அறிக்கை_வார்ப்பு(), _DOCX_வடிவம், அறிக்கை_.ஆவணச்_சூழல்.மதிப்புகள்,
                                 அறிக்கை_.ஆவணச்_சூழல்.தொகுதிகள்) });
}

// __அறிக்கைத்_தரவு(திட்டக்_குறி, முந்தைய_அறிக்கை_நாள், இன்றைய_நாள்) — what the report says, before it is rendered__
// அறிக்கைத்_தரவு(திட்டக்_குறி, முந்தைய_அறிக்கை_நாள், இன்றைய_நாள்) — நிரப்பும் முன் அறிக்கையின் தரவு
//
// __சரி with {காலம், நிறம், வேட்பாளர்கள், ஆவணச்_சூழல்}, or தவறு with the 404 to send.__
செயல் அறிக்கைத்_தரவு(திட்டக்_குறி, முந்தைய_அறிக்கை_நாள், இன்றைய_நாள்) {
    நிலைமை = திட்ட_நிலைமை(திட்டக்_குறி, இன்றைய_நாள்);
    (தவறா(நிலைமை)) எனில் { திரும்பு தவறு(பிழை_விடை(404, தவறு_மதிப்பு(நிலைமை))); }
    காலம் = அறிக்கைக்_காலம்(முந்தைய_அறிக்கை_நாள், இன்றைய_நாள்);
    வேட்பாளர்கள் = அறிக்கை_வேட்பாளர்கள்(மதிப்பு(நிலைமை).பணிகள், காலம், இன்றைய_நாள்);
    திரும்பு சரி({ காலம்: காலம், நிறம்: மதிப்பு(நிலைமை).நலம்.நிறம், வேட்பாளர்கள்: வேட்பாளர்கள்,
        ஆவணச்_சூழல்: நிலை_அறிக்கைச்_சூழல்(மதிப்பு(நிலைமை).திட்டம்["பெயர்"], காலம், மதிப்பு(நிலைமை).நலம், வேட்பாளர்கள்) });
}

// __அறிக்கைக்_கோப்பு_கையாள்(திட்டக்_குறி, முந்தைய_அறிக்கை_நாள், இன்றைய_நாள், படிவக்_கோப்பு, விளைவுக்_கோப்பு) — GET the status report as a .docx__
// அறிக்கைக்_கோப்பு_கையாள்(திட்டக்_குறி, முந்தைய_அறிக்கை_நாள், இன்றைய_நாள், படிவக்_கோப்பு, விளைவுக்_கோப்பு) — நிலை அறிக்கை வேர்டு கோப்பாக
செயல் அறிக்கைக்_கோப்பு_கையாள்(திட்டக்_குறி, முந்தைய_அறிக்கை_நாள், இன்றைய_நாள், படிவக்_கோப்பு, விளைவுக்_கோப்பு) {
    பெற்ற_தரவு = அறிக்கைத்_தரவு(திட்டக்_குறி, முந்தைய_அறிக்கை_நாள், இன்றைய_நாள்);
    (தவறா(பெற்ற_தரவு)) எனில் { திரும்பு தவறு_மதிப்பு(பெற்ற_தரவு); }
    திரும்பு கோப்பை_நிரப்பு(படிவக்_கோப்பு, விளைவுக்_கோப்பு, மதிப்பு(பெற்ற_தரவு).ஆவணச்_சூழல்);
}

// __கோப்பை_நிரப்பு(படிவக்_கோப்பு, விளைவுக்_கோப்பு, ஆவணச்_சூழல்) — fill a Word template into a new file__
// கோப்பை_நிரப்பு(படிவக்_கோப்பு, விளைவுக்_கோப்பு, ஆவணச்_சூழல்) — வேர்டு வார்ப்புருவை நிரப்பிப் புதுக் கோப்பாக்கும்
//
// __Only word/document.xml changes; the template's styles, fonts and pictures are__
// __copied across as they are. 200 with {கோப்புப்_பாதை} for the route to send, or 503__
// __when the template is not where the service was told to look.__
செயல் கோப்பை_நிரப்பு(படிவக்_கோப்பு, விளைவுக்_கோப்பு, ஆவணச்_சூழல்) {
    நிரப்பியது = பொதியை_நிரப்பு(படிவக்_கோப்பு, விளைவுக்_கோப்பு, _DOCX_வடிவம், ஆவணச்_சூழல்.மதிப்புகள்,
                                 ஆவணச்_சூழல்.தொகுதிகள்);
    (தவறா(நிரப்பியது)) எனில் { திரும்பு பிழை_விடை(503, "வார்ப்புரு கிடைக்கவில்லை  (the template is not installed)"); }
    திரும்பு விடை_ஆக்கு(200, { கோப்புப்_பாதை: விளைவுக்_கோப்பு });
}

// __சாசன_கையாள்(திட்டக்_குறி) — GET the charter: how ready it is, and the rendered body__
// சாசன_கையாள்(திட்டக்_குறி) — சாசனத் தயார்நிலையும் நிரப்பிய உடலும்
//
// __Readiness first: a charter with a required field missing is reported as not__
// __ready, with the missing paths, and rendered anyway so the gaps can be seen in__
// __place.__
செயல் சாசன_கையாள்(திட்டக்_குறி) {
    பெற்ற_தரவு = சாசனத்_தரவு(திட்டக்_குறி);
    (தவறா(பெற்ற_தரவு)) எனில் { திரும்பு தவறு_மதிப்பு(பெற்ற_தரவு); }
    சாசனம்_ = மதிப்பு(பெற்ற_தரவு);
    வார்ப்பு = "<w:body><w:tr>{{ திட்டம்.பெயர் }} — {{ திட்டம்.வாடிக்கையாளர் }}</w:tr>"
               & "<w:tr>அனுசரணை: {{ திட்டம்.அனுசரணையாளர் }}; குறிக்கோள்: {{ திட்டம்.குறிக்கோள் }}</w:tr>"
               & "<w:tr>முயற்சி: {{ முயற்சி.நபர்_நாட்கள் }} நபர்-நாட்கள்</w:tr></w:body>";
    திரும்பு விடை_ஆக்கு(200, { தயார்நிலை: சாசனம்_.தயார்.சதவீதம், இல்லாதவை: சாசனம்_.தயார்.இல்லாதவை,
        ஆவண_உடல்: ஆவணம்_நிரப்பு(வார்ப்பு, _DOCX_வடிவம், சாசனம்_.ஆவணச்_சூழல்.மதிப்புகள்,
                                 சாசனம்_.ஆவணச்_சூழல்.தொகுதிகள்) });
}

// __சாசனக்_கோப்பு_கையாள்(திட்டக்_குறி, படிவக்_கோப்பு, விளைவுக்_கோப்பு) — GET the charter as a .docx__
// சாசனக்_கோப்பு_கையாள்(திட்டக்_குறி, படிவக்_கோப்பு, விளைவுக்_கோப்பு) — சாசனம் வேர்டு கோப்பாக
//
// __Filled whether or not it is ready, as the JSON body is: an empty field shows__
// __as its placeholder, which is where the gap is.__
செயல் சாசனக்_கோப்பு_கையாள்(திட்டக்_குறி, படிவக்_கோப்பு, விளைவுக்_கோப்பு) {
    பெற்ற_தரவு = சாசனத்_தரவு(திட்டக்_குறி);
    (தவறா(பெற்ற_தரவு)) எனில் { திரும்பு தவறு_மதிப்பு(பெற்ற_தரவு); }
    திரும்பு கோப்பை_நிரப்பு(படிவக்_கோப்பு, விளைவுக்_கோப்பு, மதிப்பு(பெற்ற_தரவு).ஆவணச்_சூழல்);
}

// __சாசனத்_தரவு(திட்டக்_குறி) — how ready the charter is, and what it says__
// சாசனத்_தரவு(திட்டக்_குறி) — சாசனத் தயார்நிலையும் அதன் தரவும்
//
// __சரி with {தயார், ஆவணச்_சூழல்}, or தவறு with the 404 to send.__
செயல் சாசனத்_தரவு(திட்டக்_குறி) {
    கிடைத்தது = திட்டத்தைப்_பெறு(திட்டக்_குறி);
    (தவறா(கிடைத்தது)) எனில் { திரும்பு தவறு(பிழை_விடை(404, தவறு_மதிப்பு(கிடைத்தது))); }
    திட்டம்_பதிவு = மதிப்பு(கிடைத்தது);
    பணிகள் = திட்டப்_பணிகள்(திட்டக்_குறி);
    மைல்கற்கள் = [மைல்கல்_ஆக்கு("நேரலை", திட்டம்_பதிவு["அடிப்படை_முடிவு"], திட்டம்_பதிவு["அடிப்படை_முடிவு"], "", "சரியாக")];
    தயார் = வார்ப்புத்_தயார்நிலை([பிணைப்பு_ஆக்கு("திட்டம்.பெயர்", மெய், "மதிப்பு"),
                                  பிணைப்பு_ஆக்கு("திட்டம்.அனுசரணையாளர்", மெய், "மதிப்பு"),
                                  பிணைப்பு_ஆக்கு("திட்டம்.குறிக்கோள்", மெய், "மதிப்பு"),
                                  பிணைப்பு_ஆக்கு("பணிகள்", மெய், "பட்டியல்")],
                                 { திட்டம்: திட்டம்_பதிவு, பணிகள்: பணிகள் });
    திரும்பு சரி({ தயார்: தயார், ஆவணச்_சூழல்: சாசனச்_சூழல்(திட்டம்_பதிவு, பணிகள், மைல்கற்கள்) });
}

// __வாக்குறுதி_பலகை_கையாள்(இன்றைய_நாள்) — GET the customer-commitment dashboard__
// வாக்குறுதி_பலகை_கையாள்(இன்றைய_நாள்) — வாக்குறுதிப் பலகை
செயல் வாக்குறுதி_பலகை_கையாள்(இன்றைய_நாள்) {
    வாக்குகள் = எல்லா_வாக்குறுதிகளும்();
    வரிகள் = [];
    ஒவ்வொரு ஒன்று இல் வாக்குகள் {
        வரிகள் = இணை(வரிகள், { வாக்குறுதிக்_குறி: ஒன்று.வாக்குறுதிக்_குறி, உரிய_நாள்: உரிய_நாள்(ஒன்று),
            நடப்பு_நிலை: ஒன்று.நடப்பு_நிலை, கடந்ததா: வாக்குறுதி_கடந்ததா(ஒன்று, இன்றைய_நாள்),
            அறிவிப்பு_தேவையா: அறிவிப்பு_தேவையா(ஒன்று, இன்றைய_நாள்),
            அறிவிப்பு_தாமதமா: அறிவிப்பு_தாமதமா(ஒன்று, இன்றைய_நாள்) });
    }
    திரும்பு விடை_ஆக்கு(200, { எண்ணிக்கைகள்: வாக்குறுதி_எண்ணிக்கைகள்(வாக்குகள், இன்றைய_நாள்), வாக்குறுதிகள்: வரிகள் });
}

// __தெரிவிப்பு_கையாள்(வாக்குறுதிக்_குறி, இன்றைய_நாள்) — POST that the customer has been told__
// தெரிவிப்பு_கையாள்(வாக்குறுதிக்_குறி, இன்றைய_நாள்) — வாடிக்கையாளருக்குத் தெரிவித்ததைப் பதியும்
//
// __Only the first notice is dated; telling them again leaves the date alone.__
செயல் தெரிவிப்பு_கையாள்(வாக்குறுதிக்_குறி, இன்றைய_நாள்) {
    ஒவ்வொரு ஒன்று இல் எல்லா_வாக்குறுதிகளும்() {
        (ஒன்று.வாக்குறுதிக்_குறி == வாக்குறுதிக்_குறி) எனில் {
            புதியது = தெரிவித்ததாகப்_பதி(ஒன்று, இன்றைய_நாள்);
            வாக்குறுதியைச்_சேமி(புதியது);
            நிகழ்வைப்_பதி(வாக்குறுதிக்_குறி, { நிகழ்வு_வகை: "தெரிவிப்பு", நாள்: புதியது.தெரிவித்த_நாள் });
            திரும்பு விடை_ஆக்கு(200, புதியது);
        }
    }
    திரும்பு பிழை_விடை(404, "வாக்குறுதி இல்லை: " & வாக்குறுதிக்_குறி);
}

// __--- A project to start from -------------------------------------------__

// __மாதிரித்_திட்டத்தை_விதை(ரகசிய_விசை) — the demo project, saved and queued__
// மாதிரித்_திட்டத்தை_விதை(ரகசிய_விசை) — மாதிரித் திட்டத்தைச் சேமித்து வரிசைப்படுத்தும்
//
// __வாசல், as in aluvalakam.qmz: scope and the SSO feature become tasks, the plan is__
// __baselined, and change request CR-3 waits at requested with the PDF export it__
// __asks for. A second, smaller project gives the portfolio something to add up.__
// __Three demo users, one per role, all with the password demo-password — change__
// __them before the service is reachable by anyone else — and two customer__
// __commitments, one of them slipped.__
செயல் மாதிரித்_திட்டத்தை_விதை(ரகசிய_விசை) {
    நோக்கம் = மதிப்பு(நோக்கத்தைப்_பயன்படுத்து([
        நோக்க_வரி_ஆக்கு("1.1", "தேவைப் பகுப்பாய்வு", 32, "உள்ளே"),
        நோக்க_வரி_ஆக்கு("1.2", "வடிவமைப்பு", 40, "உள்ளே"),
        நோக்க_வரி_ஆக்கு("1.3", "உருவாக்கம்", 120, "உள்ளே"),
        நோக்க_வரி_ஆக்கு("1.4", "சோதனை", 48, "உள்ளே")],
        ["SSO"], [அம்ச_விளைவு_ஆக்கு("SSO", "மணி_கூட்டு", "1.3", 16, ""),
                  அம்ச_விளைவு_ஆக்கு("SSO", "பணி_சேர்", "1.7", 8, "Entra அமைப்பு")]));
    முன்னோடி_வரைபடம் = {"1.1": [], "1.2": ["1.1"], "1.3": ["1.2"], "1.7": ["1.2"], "1.4": ["1.3", "1.7"]};
    பணிகள் = [];
    ஒவ்வொரு ஒரு_பணி இல் நோக்கம்.பணிகள் {
        பணிகள் = இணை(பணிகள், அட்டவணைக்கு_அமை(ஒரு_பணி,
            மணியிலிருந்து_நாட்கள்(ஒரு_பணி.மதிப்பீட்டு_மணி, 8), முன்னோடி_வரைபடம்[ஒரு_பணி.பணி_குறி]));
    }
    நேரலை = பணி_ஆக்கு("M", "", "செய்யவேண்டியது", 0, 0, "");
    நேரலை["விவரம்"] = "நேரலை";
    பணிகள் = இணை(பணிகள், அட்டவணைக்கு_அமை(நேரலை, 0, ["1.4"]));
    விடுமுறைகள் = ["2026-10-02"];
    அடிப்படைத்_திட்டம் = மதிப்பு(மறு_அட்டவணையிடு(பணிகள், "2026-09-28", "2026-09-28",
                                                நாட்காட்டி_ஆக்கு([0, 6], விடுமுறைகள்)));
    திட்டத்தைச்_சேமி({ திட்டக்_குறி: "BK-ACM-0007", பெயர்: "வாசல்", வாடிக்கையாளர்: "ACME",
                       தொடக்க_நாள்: "2026-09-28", அடிப்படை_முடிவு: அடிப்படைத்_திட்டம்.திட்ட_முடிவு_நாள்,
                       விடுமுறைகள்: விடுமுறைகள், மூடியதா: பொய், பூட்டியதா: மெய் });
    ஒவ்வொரு ஒரு_பணி இல் பணிகள் { பணியைச்_சேமி("BK-ACM-0007", ஒரு_பணி); }
    ஒவ்வொரு ஒரு_பணி இல் பணிகள் { வரிசையில்_சேர்("BK-ACM-0007", ஒரு_பணி, பணிகள், ரகசிய_விசை); }
    மாற்றத்தைச்_சேமி({ மாற்றக்_குறி: "CR-3", திட்டக்_குறி: "BK-ACM-0007", நடப்பு_நிலை: "கோரியது",
        உருப்படிகள்: [{ உருப்படிக்_குறி: "1.3.1", பெற்றோர்_குறி: "1.3", விவரம்: "PDF ஏற்றுமதி",
                        மதிப்பீட்டு_மணி: 12, முன்னோடிகள்: ["1.2"], பின்வருபவை: ["1.4"] }] });

    சிறியது = அட்டவணைக்கு_அமை(பணி_ஆக்கு("2.1", "", "நடப்பில்", 90, 400, ""), 50, []);
    சிறியது["விவரம்"] = "அறிக்கைத் தளம்";
    சிறியது["உண்மைத்_தொடக்கம்"] = "2026-08-03";
    திட்டத்தைச்_சேமி({ திட்டக்_குறி: "BK-ACM-0004", பெயர்: "அறிக்கைகள்", வாடிக்கையாளர்: "ACME",
                       தொடக்க_நாள்: "2026-08-03", அடிப்படை_முடிவு: "2026-10-30",
                       விடுமுறைகள்: விடுமுறைகள், மூடியதா: பொய், பூட்டியதா: மெய் });
    பணியைச்_சேமி("BK-ACM-0004", சிறியது);

    பயனரை_ஆக்கு("meena", "demo-password", "மேலாளர்");
    பயனரை_ஆக்கு("arun", "demo-password", "உறுப்பினர்");
    பயனரை_ஆக்கு("ravi", "demo-password", "பார்வையாளர்");
    வாக்குறுதியைச்_சேமி(வாக்குறுதி_ஆக்கு("ACME-PDF", "2026-11-30", "", "உறுதியளித்தது", ""));
    வாக்குறுதியைச்_சேமி(வாக்குறுதி_ஆக்கு("ACME-SSO", "2026-10-15", "", "நழுவியது", ""));
}
