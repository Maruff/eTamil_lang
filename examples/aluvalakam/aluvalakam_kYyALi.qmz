இறக்கு "aluvalakam_kaLam.qmz";

// __--- Replies ------------------------------------------------------------__

// __விடை_ஆக்கு(நிலைக்_குறி, விடை_உடல்) — a reply: status and body__
// விடை_ஆக்கு(நிலைக்_குறி, விடை_உடல்) — நிலைக் குறியும் உடலும் கொண்ட விடை
செயல் விடை_ஆக்கு(நிலைக்_குறி, விடை_உடல்) {
    திரும்பு { நிலைக்_குறி: நிலைக்_குறி, விடை_உடல்: விடை_உடல் };
}

// __பிழை_விடை(நிலைக்_குறி, செய்தி) — a refusal, one shape for every failure__
// பிழை_விடை(நிலைக்_குறி, செய்தி) — எல்லாத் தோல்விக்கும் ஒரே வடிவ மறுப்பு
செயல் பிழை_விடை(நிலைக்_குறி, செய்தி) {
    திரும்பு விடை_ஆக்கு(நிலைக்_குறி, { பிழைச்_செய்தி: செய்தி });
}

// __--- The project as of today --------------------------------------------__

// __திட்ட_நாட்காட்டி(திட்டம்_பதிவு) — the project's working calendar__
// திட்ட_நாட்காட்டி(திட்டம்_பதிவு) — திட்டத்தின் வேலை நாட்காட்டி
செயல் திட்ட_நாட்காட்டி(திட்டம்_பதிவு) {
    திரும்பு நாட்காட்டி_ஆக்கு([0, 6], திட்டம்_பதிவு["விடுமுறைகள்"]);
}

// __திட்ட_நிலைமை(திட்டக்_குறி, இன்றைய_நாள்) — schedule, milestone and health, computed once__
// திட்ட_நிலைமை(திட்டக்_குறி, இன்றைய_நாள்) — அட்டவணை, மைல்கல், நலம் — ஒரே முறை கணக்கிடும்
//
// __சரி({திட்டம், அட்டவணை, மைல்கல், நலம், பணிகள்}). The go-live milestone's status__
// __is derived, not stored: on track while the forecast holds the baseline, at__
// __risk once it slips, and delayed once the baseline date has passed with the__
// __project still open. பணிகள் are the scheduled tasks, each due on its finish.__
செயல் திட்ட_நிலைமை(திட்டக்_குறி, இன்றைய_நாள்) {
    கிடைத்தது = திட்டத்தைப்_பெறு(திட்டக்_குறி);
    (தவறா(கிடைத்தது)) எனில் { திரும்பு கிடைத்தது; }
    திட்டம்_பதிவு = மதிப்பு(கிடைத்தது);
    அட்டவணை_விடை = மறு_அட்டவணையிடு(திட்டப்_பணிகள்(திட்டக்_குறி), திட்டம்_பதிவு["தொடக்க_நாள்"],
                                   இன்றைய_நாள், திட்ட_நாட்காட்டி(திட்டம்_பதிவு));
    (தவறா(அட்டவணை_விடை)) எனில் { திரும்பு அட்டவணை_விடை; }
    அட்டவணை = மதிப்பு(அட்டவணை_விடை);
    அடிப்படை = திட்டம்_பதிவு["அடிப்படை_முடிவு"];
    முன்கணிப்பு = அட்டவணை.திட்ட_முடிவு_நாள்;
    மைல்_நிலை = "சரியாக";
    (முன்கணிப்பு > அடிப்படை) எனில் { மைல்_நிலை = "இடரில்"; }
    (முன்கணிப்பு > அடிப்படை மற்றும் இன்றைய_நாள் > அடிப்படை) எனில் { மைல்_நிலை = "தாமதம்"; }
    மைல்கல் = மைல்கல்_ஆக்கு("நேரலை", அடிப்படை, முன்கணிப்பு, "", மைல்_நிலை);
    பணிகள் = [];
    ஒவ்வொரு ஒரு_பணி இல் அட்டவணை.பணிகள் {
        புதியது = ஒரு_பணி;
        புதியது["இறுதி_நாள்"] = ஒரு_பணி.முடிவு_நாள்;
        பணிகள் = இணை(பணிகள், புதியது);
    }
    நலம் = திட்ட_நலம்(திட்டம்_பதிவு["தொடக்க_நாள்"], அடிப்படை, திட்டம்_பதிவு["மூடியதா"],
                     [மைல்கல்], பணிகள், இன்றைய_நாள்);
    திரும்பு சரி({ திட்டம்: திட்டம்_பதிவு, அட்டவணை: அட்டவணை, மைல்கல்: மைல்கல்,
                  நலம்: நலம், பணிகள்: பணிகள் });
}

// __அட்டவணை_கையாள்(திட்டக்_குறி, இன்றைய_நாள்) — GET the schedule__
// அட்டவணை_கையாள்(திட்டக்_குறி, இன்றைய_நாள்) — அட்டவணையைத் தரும்
செயல் அட்டவணை_கையாள்(திட்டக்_குறி, இன்றைய_நாள்) {
    நிலைமை = திட்ட_நிலைமை(திட்டக்_குறி, இன்றைய_நாள்);
    (தவறா(நிலைமை)) எனில் { திரும்பு பிழை_விடை(404, தவறு_மதிப்பு(நிலைமை)); }
    வரிகள் = [];
    ஒவ்வொரு ஒரு_பணி இல் மதிப்பு(நிலைமை).பணிகள் {
        வரிகள் = இணை(வரிகள், { பணி_குறி: ஒரு_பணி.பணி_குறி, விவரம்: புலம்_அல்லது(ஒரு_பணி, "விவரம்", ""),
                               தொடக்க_நாள்: ஒரு_பணி.தொடக்க_நாள், முடிவு_நாள்: ஒரு_பணி.முடிவு_நாள்,
                               மிதப்பு: ஒரு_பணி.மிதப்பு, கடும்_பாதையா: ஒரு_பணி.கடும்_பாதையா,
                               நங்கூரம்: ஒரு_பணி.நங்கூரம் });
    }
    திரும்பு விடை_ஆக்கு(200, { திட்டக்_குறி: திட்டக்_குறி,
        அடிப்படை_முடிவு: மதிப்பு(நிலைமை).மைல்கல்.அடிப்படை_நாள்,
        முன்கணிப்பு: மதிப்பு(நிலைமை).மைல்கல்.முன்கணிப்பு_நாள், பணிகள்: வரிகள் });
}

// __நல_கையாள்(திட்டக்_குறி, இன்றைய_நாள்) — GET the health, with its reasons__
// நல_கையாள்(திட்டக்_குறி, இன்றைய_நாள்) — நலத்தையும் காரணங்களையும் தரும்
செயல் நல_கையாள்(திட்டக்_குறி, இன்றைய_நாள்) {
    நிலைமை = திட்ட_நிலைமை(திட்டக்_குறி, இன்றைய_நாள்);
    (தவறா(நிலைமை)) எனில் { திரும்பு பிழை_விடை(404, தவறு_மதிப்பு(நிலைமை)); }
    விடை = மதிப்பு(நிலைமை).நலம்;
    விடை["மைல்கல்_நிலை"] = மதிப்பு(நிலைமை).மைல்கல்.நடப்பு_நிலை;
    விடை["நேரலை_முன்கணிப்பு"] = மதிப்பு(நிலைமை).மைல்கல்.முன்கணிப்பு_நாள்;
    திரும்பு விடை_ஆக்கு(200, விடை);
}

// __பல_திட்ட_கையாள்(இன்றைய_நாள்) — GET the portfolio__
// பல_திட்ட_கையாள்(இன்றைய_நாள்) — திட்டத் தொகுப்பின் நிலவரம்
செயல் பல_திட்ட_கையாள்(இன்றைய_நாள்) {
    சுருக்கங்கள் = [];
    ஒவ்வொரு திட்டம்_பதிவு இல் எல்லாத்_திட்டங்களும்() {
        நிலைமை = திட்ட_நிலைமை(திட்டம்_பதிவு["திட்டக்_குறி"], இன்றைய_நாள்);
        (சரியா(நிலைமை)) எனில் {
            சுருக்கங்கள் = இணை(சுருக்கங்கள், திட்டச்_சுருக்கம்(திட்டம்_பதிவு["திட்டக்_குறி"],
                திட்டம்_பதிவு["வாடிக்கையாளர்"], மதிப்பு(நிலைமை).நலம், மதிப்பு(நிலைமை).பணிகள்));
        }
    }
    திரும்பு விடை_ஆக்கு(200, { மொத்தம்: பல_திட்ட_நிலவரம்(சுருக்கங்கள்),
        வாடிக்கையாளர்கள்: வாடிக்கையாளர்_வாரியாக(சுருக்கங்கள்), திட்டங்கள்: சுருக்கங்கள் });
}

// __--- The outbox ---------------------------------------------------------__

// __பணியின்_ஆழம்(பணிகள், ஒரு_பணி) — how many ancestors a task has__
// பணியின்_ஆழம்(பணிகள், ஒரு_பணி) — ஒரு பணிக்கு எத்தனை முன்னோர்
செயல் பணியின்_ஆழம்(பணிகள், ஒரு_பணி) {
    ஆழம் = 0;
    பெற்றோர் = ஒரு_பணி.பெற்றோர்_குறி;
    (பெற்றோர் != "" மற்றும் ஆழம் < 50) சுற்று {
        ஆழம் = ஆழம் + 1;
        அடுத்தது = "";
        ஒவ்வொரு ஒன்று இல் பணிகள் { (ஒன்று.பணி_குறி == பெற்றோர்) எனில் { அடுத்தது = ஒன்று.பெற்றோர்_குறி; } }
        பெற்றோர் = அடுத்தது;
    }
    திரும்பு ஆழம்;
}

// __அனுப்பும்_வடிவம்(ஒரு_பணி) — a task as the fields that go to Azure DevOps__
// அனுப்பும்_வடிவம்(ஒரு_பணி) — அஜூருக்குச் செல்லும் புலங்களுடன் பணி
செயல் அனுப்பும்_வடிவம்(ஒரு_பணி) {
    புதியது = ஒரு_பணி;
    புதியது["தலைப்பு"] = ஒரு_பணி.பணி_குறி & " " & புலம்_அல்லது(ஒரு_பணி, "விவரம்", "");
    திரும்பு புதியது;
}

// __வரிசையில்_சேர்(திட்டக்_குறி, ஒரு_பணி, பணிகள், ரகசிய_விசை) — queue a task for Azure DevOps__
// வரிசையில்_சேர்(திட்டக்_குறி, ஒரு_பணி, பணிகள், ரகசிய_விசை) — ஒரு பணியை அஜூருக்கு வரிசைப்படுத்தும்
//
// __The key is the fingerprint of what this side owns, so a change to a field__
// __Azure DevOps owns — progress — queues nothing, and queueing the same state__
// __twice is one row. மெய் when a row was queued.__
செயல் வரிசையில்_சேர்(திட்டக்_குறி, ஒரு_பணி, பணிகள், ரகசிய_விசை) {
    தொகுப்பு_புலங்கள் = அனுப்பவேண்டியவை(இயல்பு_உரிமைகள்(), அனுப்பும்_வடிவம்(ஒரு_பணி));
    குறி_ = ஒருமுறைக்_குறி(திட்டக்_குறி, "பணி", ஒரு_பணி.பணி_குறி, தொகுப்பு_புலங்கள், ரகசிய_விசை);
    (வரிசையில்_உள்ளதா(வரிசை_உருப்படிகள்(), குறி_)) எனில் { திரும்பு பொய்; }
    உருப்படி = அனுப்பு_உருப்படி_ஆக்கு(ஒரு_பணி.பணி_குறி, "பணி", "ஒத்திசை",
                                    பணியின்_ஆழம்(பணிகள், ஒரு_பணி), குறி_);
    உருப்படி["திட்டக்_குறி"] = திட்டக்_குறி;
