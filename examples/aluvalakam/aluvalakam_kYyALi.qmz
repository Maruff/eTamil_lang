                (ஒரு_பணி.கால_அளவு == 0) எனில் { வகை_ = "Feature"; }
                விளைவு = அனுப்புவி(வகை_, எண்_இப்போது, பெற்றோர்_எண், ஒட்டுகள்);
                (சரியா(விளைவு)) எனில் {
