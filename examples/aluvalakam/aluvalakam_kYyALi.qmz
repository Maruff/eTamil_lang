// __aluvalakam_kYyALi.qmz — கையாளி (what each request to the project office does)__
// திட்ட அலுவலகச் சேவையின் ஒவ்வொரு கோரிக்கையும் செய்வது
//
// __The service's behaviour, as plain functions. Each handler takes what the__
// __request carries and returns {நிலைக்_குறி, விடை_உடல்} — the HTTP status and the__
// __record to send as JSON — so aluvalakam_cEvY.qmz is only routing, and every__
// __handler can be run and tested under --vm against a real SQLite file.__
//
// __Two things a test cannot do are passed in rather than called: today's date,__
// __and Azure DevOps. The server passes இன்று() and functions that make the real__
// __REST calls; a test passes a fixed date and functions that answer as Azure__
// __DevOps would. Nothing in this file reads the clock or opens a socket.__
//
// __The connection is the caller's to open; see aluvalakam_kaLam.qmz.__

இறக்கு "../../nUlakam/nAtkAtti/vElYnAL.qmz";
இறக்கு "../../nUlakam/qittam/paNi.qmz";
இறக்கு "../../nUlakam/qittam/attavaNY.qmz";
இறக்கு "../../nUlakam/qittam/maRu_attavaNY.qmz";
இறக்கு "../../nUlakam/qittam/nalam.qmz";
இறக்கு "../../nUlakam/qittam/mARRak_kOrikkY.qmz";
இறக்கு "../../nUlakam/qittam/nOkkam.qmz";
இறக்கு "../../nUlakam/qittam/pala_qittam.qmz";
இறக்கு "../../nUlakam/oruwkiNYppu/varYpatam.qmz";
இறக்கு "../../nUlakam/oruwkiNYppu/pula_urimY.qmz";
இறக்கு "../../nUlakam/oruwkiNYppu/kYrEkY.qmz";
இறக்கு "../../nUlakam/oruwkiNYppu/ottu.qmz";
இறக்கு "../../nUlakam/oruwkiNYppu/varavu.qmz";
இறக்கு "../../nUlakam/oruwkiNYppu/aZuppu_varicY.qmz";
இறக்கு "aluvalakam_kaLam.qmz";

// __--- Replies ------------------------------------------------------------__

// __விடை_ஆக்கு(நிலைக்_குறி, விடை_உடல்) — a reply: status and body__
// விடை_ஆக்கு(நிலைக்_குறி, விடை_உடல்) — நிலைக் குறியும் உடலும் கொண்ட விடை
செயல் விடை_ஆக்கு(நிலைக்_குறி, விடை_உடல்) {
    திரும்பு { நிலைக்_குறி: நிலைக்_குறி, விடை_உடல்: விடை_உடல் };
}

// __பிழை_விடை(நிலைக்_குறி, செய்தி) — a refusal, one shape for every failure__
// பிழை_விடை(நிலைக்_குறி, செய்தி) — எல்லாத் தோல்விக்கும் ஒரே வடிவ மறுப்பு
செயல் பிழை_விடை(நிலைக்_குறி, செய்தி) {
    திரும்பு விடை_ஆக்கு(நிலைக்_குறி, { பிழைச்_செய்தி: செய்தி });
}

// __--- The project as of today --------------------------------------------__

// __திட்ட_நாட்காட்டி(திட்டம்_பதிவு) — the project's working calendar__
// திட்ட_நாட்காட்டி(திட்டம்_பதிவு) — திட்டத்தின் வேலை நாட்காட்டி
செயல் திட்ட_நாட்காட்டி(திட்டம்_பதிவு) {
    திரும்பு நாட்காட்டி_ஆக்கு([0, 6], திட்டம்_பதிவு["விடுமுறைகள்"]);
}

// __திட்ட_நிலைமை(திட்டக்_குறி, இன்றைய_நாள்) — schedule, milestone and health, computed once__
// திட்ட_நிலைமை(திட்டக்_குறி, இன்றைய_நாள்) — அட்டவணை, மைல்கல், நலம் — ஒரே முறை கணக்கிடும்
//
// __சரி({திட்டம், அட்டவணை, மைல்கல், நலம், பணிகள்}). The go-live milestone's status__
// __is derived, not stored: on track while the forecast holds the baseline, at__
// __risk once it slips, and delayed once the baseline date has passed with the__
// __project still open. பணிகள் are the scheduled tasks, each due on its finish.__
செயல் திட்ட_நிலைமை(திட்டக்_குறி, இன்றைய_நாள்) {
    கிடைத்தது = திட்டத்தைப்_பெறு(திட்டக்_குறி);
    (தவறா(கிடைத்தது)) எனில் { திரும்பு கிடைத்தது; }
    திட்டம்_பதிவு = மதிப்பு(கிடைத்தது);
    அட்டவணை_விடை = மறு_அட்டவணையிடு(திட்டப்_பணிகள்(திட்டக்_குறி), திட்டம்_பதிவு["தொடக்க_நாள்"],
                                   இன்றைய_நாள், திட்ட_நாட்காட்டி(திட்டம்_பதிவு));
    (தவறா(அட்டவணை_விடை)) எனில் { திரும்பு அட்டவணை_விடை; }
    அட்டவணை = மதிப்பு(அட்டவணை_விடை);
    அடிப்படை = திட்டம்_பதிவு["அடிப்படை_முடிவு"];
    முன்கணிப்பு = அட்டவணை.திட்ட_முடிவு_நாள்;
    மைல்_நிலை = "சரியாக";
    (முன்கணிப்பு > அடிப்படை) எனில் { மைல்_நிலை = "இடரில்"; }
    (முன்கணிப்பு > அடிப்படை மற்றும் இன்றைய_நாள் > அடிப்படை) எனில் { மைல்_நிலை = "தாமதம்"; }
    மைல்கல் = மைல்கல்_ஆக்கு("நேரலை", அடிப்படை, முன்கணிப்பு, "", மைல்_நிலை);
    பணிகள் = [];
    ஒவ்வொரு ஒரு_பணி இல் அட்டவணை.பணிகள் {
        புதியது = ஒரு_பணி;
        புதியது["இறுதி_நாள்"] = ஒரு_பணி.முடிவு_நாள்;
        பணிகள் = இணை(பணிகள், புதியது);
    }
    நலம் = திட்ட_நலம்(திட்டம்_பதிவு["தொடக்க_நாள்"], அடிப்படை, திட்டம்_பதிவு["மூடியதா"],
                     [மைல்கல்], பணிகள், இன்றைய_நாள்);
    திரும்பு சரி({ திட்டம்: திட்டம்_பதிவு, அட்டவணை: அட்டவணை, மைல்கல்: மைல்கல்,
                  நலம்: நலம், பணிகள்: பணிகள் });
}

// __அட்டவணை_கையாள்(திட்டக்_குறி, இன்றைய_நாள்) — GET the schedule__
// அட்டவணை_கையாள்(திட்டக்_குறி, இன்றைய_நாள்) — அட்டவணையைத் தரும்
செயல் அட்டவணை_கையாள்(திட்டக்_குறி, இன்றைய_நாள்) {
    நிலைமை = திட்ட_நிலைமை(திட்டக்_குறி, இன்றைய_நாள்);
    (தவறா(நிலைமை)) எனில் { திரும்பு பிழை_விடை(404, தவறு_மதிப்பு(நிலைமை)); }
    வரிகள் = [];
    ஒவ்வொரு ஒரு_பணி இல் மதிப்பு(நிலைமை).பணிகள் {
        வரிகள் = இணை(வரிகள், { பணி_குறி: ஒரு_பணி.பணி_குறி, விவரம்: புலம்_அல்லது(ஒரு_பணி, "விவரம்", ""),
                               தொடக்க_நாள்: ஒரு_பணி.தொடக்க_நாள், முடிவு_நாள்: ஒரு_பணி.முடிவு_நாள்,
                               மிதப்பு: ஒரு_பணி.மிதப்பு, கடும்_பாதையா: ஒரு_பணி.கடும்_பாதையா,
                               நங்கூரம்: ஒரு_பணி.நங்கூரம் });
    }
    திரும்பு விடை_ஆக்கு(200, { திட்டக்_குறி: திட்டக்_குறி,
        அடிப்படை_முடிவு: மதிப்பு(நிலைமை).மைல்கல்.அடிப்படை_நாள்,
        முன்கணிப்பு: மதிப்பு(நிலைமை).மைல்கல்.முன்கணிப்பு_நாள், பணிகள்: வரிகள் });
}

// __நல_கையாள்(திட்டக்_குறி, இன்றைய_நாள்) — GET the health, with its reasons__
// நல_கையாள்(திட்டக்_குறி, இன்றைய_நாள்) — நலத்தையும் காரணங்களையும் தரும்
செயல் நல_கையாள்(திட்டக்_குறி, இன்றைய_நாள்) {
    நிலைமை = திட்ட_நிலைமை(திட்டக்_குறி, இன்றைய_நாள்);
    (தவறா(நிலைமை)) எனில் { திரும்பு பிழை_விடை(404, தவறு_மதிப்பு(நிலைமை)); }
    விடை = மதிப்பு(நிலைமை).நலம்;
    விடை["மைல்கல்_நிலை"] = மதிப்பு(நிலைமை).மைல்கல்.நடப்பு_நிலை;
    விடை["நேரலை_முன்கணிப்பு"] = மதிப்பு(நிலைமை).மைல்கல்.முன்கணிப்பு_நாள்;
    திரும்பு விடை_ஆக்கு(200, விடை);
}

// __பல_திட்ட_கையாள்(இன்றைய_நாள்) — GET the portfolio__
// பல_திட்ட_கையாள்(இன்றைய_நாள்) — திட்டத் தொகுப்பின் நிலவரம்
செயல் பல_திட்ட_கையாள்(இன்றைய_நாள்) {
    சுருக்கங்கள் = [];
    ஒவ்வொரு திட்டம்_பதிவு இல் எல்லாத்_திட்டங்களும்() {
        நிலைமை = திட்ட_நிலைமை(திட்டம்_பதிவு["திட்டக்_குறி"], இன்றைய_நாள்);
        (சரியா(நிலைமை)) எனில் {
            சுருக்கங்கள் = இணை(சுருக்கங்கள், திட்டச்_சுருக்கம்(திட்டம்_பதிவு["திட்டக்_குறி"],
                திட்டம்_பதிவு["வாடிக்கையாளர்"], மதிப்பு(நிலைமை).நலம், மதிப்பு(நிலைமை).பணிகள்));
        }
    }
    திரும்பு விடை_ஆக்கு(200, { மொத்தம்: பல_திட்ட_நிலவரம்(சுருக்கங்கள்),
        வாடிக்கையாளர்கள்: வாடிக்கையாளர்_வாரியாக(சுருக்கங்கள்), திட்டங்கள்: சுருக்கங்கள் });
}

// __--- The outbox ---------------------------------------------------------__

// __பணியின்_ஆழம்(பணிகள், ஒரு_பணி) — how many ancestors a task has__
// பணியின்_ஆழம்(பணிகள், ஒரு_பணி) — ஒரு பணிக்கு எத்தனை முன்னோர்
செயல் பணியின்_ஆழம்(பணிகள், ஒரு_பணி) {
    ஆழம் = 0;
    பெற்றோர் = ஒரு_பணி.பெற்றோர்_குறி;
    (பெற்றோர் != "" மற்றும் ஆழம் < 50) சுற்று {
        ஆழம் = ஆழம் + 1;
        அடுத்தது = "";
        ஒவ்வொரு ஒன்று இல் பணிகள் { (ஒன்று.பணி_குறி == பெற்றோர்) எனில் { அடுத்தது = ஒன்று.பெற்றோர்_குறி; } }
        பெற்றோர் = அடுத்தது;
    }
    திரும்பு ஆழம்;
}

// __அனுப்பும்_வடிவம்(ஒரு_பணி) — a task as the fields that go to Azure DevOps__
// அனுப்பும்_வடிவம்(ஒரு_பணி) — அஜூருக்குச் செல்லும் புலங்களுடன் பணி
செயல் அனுப்பும்_வடிவம்(ஒரு_பணி) {
    புதியது = ஒரு_பணி;
    புதியது["தலைப்பு"] = ஒரு_பணி.பணி_குறி & " " & புலம்_அல்லது(ஒரு_பணி, "விவரம்", "");
    திரும்பு புதியது;
}

// __வரிசையில்_சேர்(திட்டக்_குறி, ஒரு_பணி, பணிகள், ரகசிய_விசை) — queue a task for Azure DevOps__
// வரிசையில்_சேர்(திட்டக்_குறி, ஒரு_பணி, பணிகள், ரகசிய_விசை) — ஒரு பணியை அஜூருக்கு வரிசைப்படுத்தும்
//
// __The key is the fingerprint of what this side owns, so a change to a field__
// __Azure DevOps owns — progress — queues nothing, and queueing the same state__
// __twice is one row. மெய் when a row was queued.__
செயல் வரிசையில்_சேர்(திட்டக்_குறி, ஒரு_பணி, பணிகள், ரகசிய_விசை) {
    தொகுப்பு_புலங்கள் = அனுப்பவேண்டியவை(இயல்பு_உரிமைகள்(), அனுப்பும்_வடிவம்(ஒரு_பணி));
    குறி_ = ஒருமுறைக்_குறி(திட்டக்_குறி, "பணி", ஒரு_பணி.பணி_குறி, தொகுப்பு_புலங்கள், ரகசிய_விசை);
    (வரிசையில்_உள்ளதா(வரிசை_உருப்படிகள்(), குறி_)) எனில் { திரும்பு பொய்; }
    உருப்படி = அனுப்பு_உருப்படி_ஆக்கு(ஒரு_பணி.பணி_குறி, "பணி", "ஒத்திசை",
                                    பணியின்_ஆழம்(பணிகள், ஒரு_பணி), குறி_);
    உருப்படி["திட்டக்_குறி"] = திட்டக்_குறி;
    வரிசை_உருப்படியைச்_சேமி(உருப்படி);
    திரும்பு மெய்;
}

// __வரிசைக்_காலத்தை_மீட்டமை() — make every waiting row due now__
// வரிசைக்_காலத்தை_மீட்டமை() — காத்திருக்கும் எல்லா வரிசைகளையும் இப்போதே அனுப்பத் தயாராக்கும்
//
// __Run when the service starts. The worker times backoff against the process's__
// __own clock, which starts again at zero, so a row's next attempt from before a__
// __restart means nothing now; making it due at once is the only honest reading.__
செயல் வரிசைக்_காலத்தை_மீட்டமை() {
    ஒவ்வொரு உருப்படி இல் வரிசை_உருப்படிகள்() {
        (உருப்படி.நடப்பு_நிலை == "காத்திருப்பு") எனில் {
            புதியது = உருப்படி;
            புதியது["அடுத்த_முயற்சி"] = 0;
            வரிசை_உருப்படியைச்_சேமி(புதியது);
        }
    }
}

// __வரிசையை_அனுப்பு(இப்போது, நடுக்கம், செயல் அனுப்புவி) — send what is due, parents first__
// வரிசையை_அனுப்பு(இப்போது, நடுக்கம், செயல் அனுப்புவி) — அனுப்ப வேண்டியவற்றைப் பெற்றோர் முதலாக அனுப்பும்
//
// __அனுப்புவி(பணியுருப்படி_வகை, பணியுருப்படி_எண், பெற்றோர்_எண், ஒட்டுகள்) makes the__
// __call — a create when பணியுருப்படி_எண் is 0, an update otherwise — and returns__
// __சரி({பணியுருப்படி_எண், திருத்தம்}) or ajUr.qmz's one failure shape. Each row re-reads its__
// __task, so what is sent is what the task says now. A child whose parent has no__
// __work item yet waits for a later round. {அனுப்பியவை, தோல்விகள், தள்ளியவை}.__
செயல் வரிசையை_அனுப்பு(இப்போது, நடுக்கம், செயல் அனுப்புவி) {
    அனுப்பியவை = 0;
    தோல்விகள் = 0;
    தள்ளியவை = 0;
    வகையின்_நிலைகள் = [{"name": "New", "category": "Proposed"}, {"name": "Active", "category": "InProgress"},
                       {"name": "Resolved", "category": "Resolved"}, {"name": "Closed", "category": "Completed"},
                       {"name": "Removed", "category": "Removed"}];
    புல_வரைபடம் = {"தலைப்பு": "System.Title", "விவரம்": "System.Description",
                   "மதிப்பீட்டு_மணி": "Microsoft.VSTS.Scheduling.OriginalEstimate"};
    ஒவ்வொரு உருப்படி இல் அனுப்பத்_தயாரானவை(வரிசை_உருப்படிகள்(), இப்போது) {
        பணிகள் = திட்டப்_பணிகள்(உருப்படி["திட்டக்_குறி"]);
        ஒரு_பணி = இன்மை;
        பெற்றோர்_எண் = 0;
        ஒவ்வொரு ஒன்று இல் பணிகள் { (ஒன்று.பணி_குறி == உருப்படி.பொருள்_குறி) எனில் { ஒரு_பணி = ஒன்று; } }
        ஒவ்வொரு ஒன்று இல் பணிகள் {
            (ஒரு_பணி != இன்மை மற்றும் ஒன்று.பணி_குறி == புலம்_அல்லது(ஒரு_பணி, "பெற்றோர்_குறி", "")) எனில் {
                பெற்றோர்_எண் = புலம்_அல்லது(ஒன்று, "பணியுருப்படி_எண்", 0);
            }
        }
        (ஒரு_பணி == இன்மை) எனில் {
            வரிசை_உருப்படியைச்_சேமி(தோல்வியைப்_பதி(உருப்படி, 404, "பணி இல்லை", இப்போது, நடுக்கம், 0));
            தோல்விகள் = தோல்விகள் + 1;
        } இன்றேல் {
            (ஒரு_பணி.பெற்றோர்_குறி != "" மற்றும் பெற்றோர்_எண் == 0) எனில் {
                தள்ளியவை = தள்ளியவை + 1;
            } இன்றேல் {
                எண்_இப்போது = புலம்_அல்லது(ஒரு_பணி, "பணியுருப்படி_எண்", 0);
                ஒட்டுகள் = பணி_ஒட்டுகள்(அனுப்பும்_வடிவம்(ஒரு_பணி), புல_வரைபடம்,
                                        புலம்_அல்லது(ஒரு_பணி, "அனுப்பிய_திருத்தம்", 0));
                ஒட்டுகள் = இணை(ஒட்டுகள், புல_ஒட்டு("System.State",
                    மதிப்பு(வெளி_நிலை(ஒரு_பணி.நடப்பு_நிலை, வகையின்_நிலைகள்))));
                வகை_ = "User Story";
                (ஒரு_பணி.பெற்றோர்_குறி != "") எனில் { வகை_ = "Task"; }
                (ஒரு_பணி.கால_அளவு == 0) எனில் { வகை_ = "Feature"; }
                விளைவு = அனுப்புவி(வகை_, எண்_இப்போது, பெற்றோர்_எண், ஒட்டுகள்);
                (சரியா(விளைவு)) எனில் {
                    புதியது = ஒரு_பணி;
                    புதியது["பணியுருப்படி_எண்"] = மதிப்பு(விளைவு).பணியுருப்படி_எண்;
                    புதியது["அனுப்பிய_திருத்தம்"] = மதிப்பு(விளைவு).திருத்தம்;
                    பணியைச்_சேமி(உருப்படி["திட்டக்_குறி"], புதியது);
                    வரிசை_உருப்படியைச்_சேமி(அனுப்பியதாகப்_பதி(உருப்படி));
                    அனுப்பியவை = அனுப்பியவை + 1;
                } இன்றேல் {
                    தோல்வி = தவறு_மதிப்பு(விளைவு);
                    வரிசை_உருப்படியைச்_சேமி(தோல்வியைப்_பதி(உருப்படி, தோல்வி.நிலைக்_குறி,
                        சொல்லாக்கு(தோல்வி.செய்தி), இப்போது, நடுக்கம், தோல்வி.மீண்டும்_முயல்_நொடிகள்));
                    தோல்விகள் = தோல்விகள் + 1;
                }
            }
        }
    }
    திரும்பு { அனுப்பியவை: அனுப்பியவை, தோல்விகள்: தோல்விகள், தள்ளியவை: தள்ளியவை };
}

// __--- Changes to the plan -------------------------------------------------__

// __முன்னேற்ற_கையாள்(திட்டக்_குறி, பணிக்_குறி, உடலுரை, இன்றைய_நாள், ரகசிய_விசை) — POST progress on a task__
// முன்னேற்ற_கையாள்(திட்டக்_குறி, பணிக்_குறி, உடலுரை, இன்றைய_நாள், ரகசிய_விசை) — ஒரு பணியின் முன்னேற்றத்தைப் பதியும்
//
// __The body is a JSON record of the fields to change. On a baselined project only__
// __the fields paNi.qmz lets move are accepted — anything else is a 409 that names__
// __the field, because it needs a change request. A status with no percentage__
// __takes the one the status implies. The change is audited and, when it touches__
// __a field this side owns, queued for Azure DevOps.__
செயல் முன்னேற்ற_கையாள்(திட்டக்_குறி, பணிக்_குறி, உடலுரை, இன்றைய_நாள், ரகசிய_விசை) {
    படித்தது = ஜேசான்_படி(உடலுரை);
    (தவறா(படித்தது) அல்லது வகை(மதிப்பு(படித்தது)) != "a record") எனில் {
        திரும்பு பிழை_விடை(400, "உடல் ஒரு ஜேசான் பதிவாக இருக்க வேண்டும்  (the body must be a JSON record)");
    }
    மாற்றங்கள் = மதிப்பு(படித்தது);
    கிடைத்தது = திட்டத்தைப்_பெறு(திட்டக்_குறி);
    (தவறா(கிடைத்தது)) எனில் { திரும்பு பிழை_விடை(404, தவறு_மதிப்பு(கிடைத்தது)); }
    பணிகள் = திட்டப்_பணிகள்(திட்டக்_குறி);
    ஒரு_பணி = இன்மை;
    ஒவ்வொரு ஒன்று இல் பணிகள் { (ஒன்று.பணி_குறி == பணிக்_குறி) எனில் { ஒரு_பணி = ஒன்று; } }
    (ஒரு_பணி == இன்மை) எனில் { திரும்பு பிழை_விடை(404, "பணி இல்லை: " & பணிக்_குறி); }
    (மதிப்பு(கிடைத்தது)["பூட்டியதா"]) எனில் {
        பூட்டு = பூட்டிய_மாற்றம்_சரியா(மாற்றங்கள்);
        (தவறா(பூட்டு)) எனில் { திரும்பு பிழை_விடை(409, தவறு_மதிப்பு(பூட்டு)); }
    }
    (புலம்_உள்ளதா(மாற்றங்கள், "நடப்பு_நிலை")) எனில் {
        (இல்லை உள்ளதா(பணி_நிலைகள்(), மாற்றங்கள்["நடப்பு_நிலை"])) எனில் {
            திரும்பு பிழை_விடை(400, "அறியாத பணி நிலை: " & சொல்லாக்கு(மாற்றங்கள்["நடப்பு_நிலை"]));
        }
        (இல்லை புலம்_உள்ளதா(மாற்றங்கள், "நிறைவு")) எனில் {
            மாற்றங்கள்["நிறைவு"] = நிலைக்கான_நிறைவு(மாற்றங்கள்["நடப்பு_நிலை"], ஒரு_பணி.நிறைவு);
        }
    }
    புதியது = ஒரு_பணி;
    ஒவ்வொரு புலப்_பெயர் இல் மாற்றங்கள் { புதியது[புலப்_பெயர்] = மாற்றங்கள்[புலப்_பெயர்]; }
    பணியைச்_சேமி(திட்டக்_குறி, புதியது);
    நிகழ்வைப்_பதி(திட்டக்_குறி & "/" & பணிக்_குறி,
                  { நிகழ்வு_வகை: "முன்னேற்றம்", மாற்றங்கள்: மாற்றங்கள், நாள்: இன்றைய_நாள் });
    வரிசைப்பட்டதா = வரிசையில்_சேர்(திட்டக்_குறி, புதியது, பணிகள், ரகசிய_விசை);
    திரும்பு விடை_ஆக்கு(200, { பணி: புதியது, வரிசைப்பட்டதா: வரிசைப்பட்டதா });
}

// __மாற்ற_நகர்வு_கையாள்(மாற்றக்_குறி, உடலுரை, இன்றைய_நாள், ரகசிய_விசை) — POST a move of a change request__
// மாற்ற_நகர்வு_கையாள்(மாற்றக்_குறி, உடலுரை, இன்றைய_நாள், ரகசிய_விசை) — மாற்றக் கோரிக்கையை அடுத்த நிலைக்கு நகர்த்தும்
//
// __The body is {புதிய_நிலை, செய்தவர்}. A move the lifecycle does not allow is a__
// __409. On approval the request's items become tasks, with durations from their__
// __estimates and the predecessors they name; the tasks each item's__
// __பின்வருபவை lists are made to wait for it; and the new work is queued.__
செயல் மாற்ற_நகர்வு_கையாள்(மாற்றக்_குறி, உடலுரை, இன்றைய_நாள், ரகசிய_விசை) {
    படித்தது = ஜேசான்_படி(உடலுரை);
    (தவறா(படித்தது)) எனில் { திரும்பு பிழை_விடை(400, "செல்லாத ஜேசான்  (invalid JSON)"); }
    கேட்டது = மதிப்பு(படித்தது);
    (இல்லை புலம்_உள்ளதா(கேட்டது, "புதிய_நிலை") அல்லது இல்லை புலம்_உள்ளதா(கேட்டது, "செய்தவர்")) எனில் {
        திரும்பு பிழை_விடை(400, "புதிய_நிலை, செய்தவர் இரண்டும் தேவை  (புதிய_நிலை and செய்தவர் are required)");
    }
    கிடைத்தது = மாற்றத்தைப்_பெறு(மாற்றக்_குறி);
    (தவறா(கிடைத்தது)) எனில் { திரும்பு பிழை_விடை(404, தவறு_மதிப்பு(கிடைத்தது)); }
    நகர்வு = நிலையை_நகர்த்து(மதிப்பு(கிடைத்தது), மாற்றக்_கோரிக்கை_வரைவு(), கேட்டது["புதிய_நிலை"],
                             கேட்டது["செய்தவர்"], இன்றைய_நாள்);
    (தவறா(நகர்வு)) எனில் { திரும்பு பிழை_விடை(409, தவறு_மதிப்பு(நகர்வு)); }
    மாற்றம் = மதிப்பு(நகர்வு).புதிய_பதிவு;
    மாற்றத்தைச்_சேமி(மாற்றம்);
    நிகழ்வைப்_பதி(மாற்றக்_குறி, மதிப்பு(நகர்வு).நிகழ்வு);

    புதிய_பணிகள் = [];
    (மாற்றம்.நடப்பு_நிலை == "ஏற்றது") எனில் {
        திட்டக்_குறி = மாற்றம்["திட்டக்_குறி"];
        ஆனவை = மதிப்பு(மாற்றத்தைப்_பணிகளாக்கு(மாற்றம், மாற்றம்["உருப்படிகள்"]));
        இருப்பவை = திட்டப்_பணிகள்(திட்டக்_குறி);
        ஒவ்வொரு உருப்படி இல் மாற்றம்["உருப்படிகள்"] {
            ஒவ்வொரு பின்_குறி இல் புலம்_அல்லது(உருப்படி, "பின்வருபவை", []) {
                ஒவ்வொரு ஒன்று இல் இருப்பவை {
                    (ஒன்று.பணி_குறி == பின்_குறி) எனில் {
                        காத்திருப்பவை = ஒன்று;
                        காத்திருப்பவை["முன்னோடிகள்"] = இணை(ஒன்று.முன்னோடிகள், உருப்படி.உருப்படிக்_குறி);
                        பணியைச்_சேமி(திட்டக்_குறி, காத்திருப்பவை);
                    }
                }
            }
        }
        ஒவ்வொரு புதிய_பணி இல் ஆனவை {
            முன்னோடிகள் = [];
            ஒவ்வொரு உருப்படி இல் மாற்றம்["உருப்படிகள்"] {
                (உருப்படி.உருப்படிக்_குறி == புதிய_பணி.பணி_குறி) எனில் {
                    முன்னோடிகள் = புலம்_அல்லது(உருப்படி, "முன்னோடிகள்", []);
                }
            }
            அமைந்தது = அட்டவணைக்கு_அமை(புதிய_பணி, மணியிலிருந்து_நாட்கள்(புதிய_பணி.மதிப்பீட்டு_மணி, 8), முன்னோடிகள்);
            பணியைச்_சேமி(திட்டக்_குறி, அமைந்தது);
            புதிய_பணிகள் = இணை(புதிய_பணிகள், அமைந்தது);
        }
        எல்லாம் = திட்டப்_பணிகள்(திட்டக்_குறி);
        ஒவ்வொரு புதிய_பணி இல் புதிய_பணிகள் { வரிசையில்_சேர்(திட்டக்_குறி, புதிய_பணி, எல்லாம், ரகசிய_விசை); }
    }
    திரும்பு விடை_ஆக்கு(200, { மாற்றம்: மாற்றம், புதிய_பணிகள்: புதிய_பணிகள் });
}

// __--- What Azure DevOps sends back --------------------------------------__

// __கொக்கி_கையாள்(வந்த_சீட்டு, உடலுரை, பதிந்த_கைரேகை, ரகசிய_விசை, எங்கள்_அடையாளம், செயல் பெறுவி) — POST a service hook__
// கொக்கி_கையாள்(வந்த_சீட்டு, உடலுரை, பதிந்த_கைரேகை, ரகசிய_விசை, எங்கள்_அடையாளம், செயல் பெறுவி) — ஒரு சேவைக் கொக்கியைக் கையாளும்
//
// __The token in the url is checked first; a wrong one is a 401 with no detail.__
// __The hook names a work item; the task it belongs to is found by the number the__
// __outbox recorded, and the item itself is fetched again with பெறுவி(உருப்படி_எண்), which__
// __returns சரி({திருத்தம், மாற்றியவர், நிலைப்_பெயர், நிலை_வகைமை, முடிந்த_மணி,__
// __மீதி_மணி, தலைப்பு}) — the hook's own body is never trusted for content. What__
// __comes back passes the echo brakes, then field ownership: their status and__
// __progress are applied, an edit to our title is refused and logged.__
செயல் கொக்கி_கையாள்(வந்த_சீட்டு, உடலுரை, பதிந்த_கைரேகை, ரகசிய_விசை, எங்கள்_அடையாளம், செயல் பெறுவி) {
    (இல்லை கொக்கிச்_சீட்டு_சரியா(வந்த_சீட்டு, பதிந்த_கைரேகை, ரகசிய_விசை)) எனில் {
        திரும்பு பிழை_விடை(401, "அனுமதி இல்லை  (not authorised)");
    }
    படித்தது = கொக்கி_நிகழ்வைப்_படி(உடலுரை);
    (தவறா(படித்தது)) எனில் { திரும்பு பிழை_விடை(400, தவறு_மதிப்பு(படித்தது)); }
    உருப்படி_எண் = மதிப்பு(படித்தது).பணியுருப்படி_எண்;

    திட்டக்_குறி = "";
    ஒரு_பணி = இன்மை;
    ஒவ்வொரு திட்டம்_பதிவு இல் எல்லாத்_திட்டங்களும்() {
        ஒவ்வொரு ஒன்று இல் திட்டப்_பணிகள்(திட்டம்_பதிவு["திட்டக்_குறி"]) {
            (புலம்_அல்லது(ஒன்று, "பணியுருப்படி_எண்", 0) == உருப்படி_எண்) எனில் {
                ஒரு_பணி = ஒன்று;
                திட்டக்_குறி = திட்டம்_பதிவு["திட்டக்_குறி"];
            }
        }
    }
    (ஒரு_பணி == இன்மை) எனில் { திரும்பு விடை_ஆக்கு(200, { முடிவு: "தெரியாதது", பணியுருப்படி_எண்: உருப்படி_எண் }); }

    பெற்றது = பெறுவி(உருப்படி_எண்);
    (தவறா(பெற்றது)) எனில் { திரும்பு பிழை_விடை(502, சொல்லாக்கு(தவறு_மதிப்பு(பெற்றது))); }
    உருப்படி = மதிப்பு(பெற்றது);
    வரவுப்_புலங்கள் = { நடப்பு_நிலை: உள்_நிலை(உருப்படி.நிலைப்_பெயர், உருப்படி.நிலை_வகைமை) };
    நிறைவு = மணியிலிருந்து_நிறைவு(உருப்படி.முடிந்த_மணி, உருப்படி.மீதி_மணி);
    (நிறைவு != இன்மை) எனில் { வரவுப்_புலங்கள்["நிறைவு"] = நிறைவு; }
    (உருப்படி["தலைப்பு"] != அனுப்பும்_வடிவம்(ஒரு_பணி)["தலைப்பு"]) எனில் { வரவுப்_புலங்கள்["தலைப்பு"] = உருப்படி["தலைப்பு"]; }
    வரவுக்_கைரேகை = கைரேகை(வரவுப்_புலங்கள், ரகசிய_விசை);
    முடிவு = வரவு_முடிவு(உருப்படி.திருத்தம், புலம்_அல்லது(ஒரு_பணி, "அனுப்பிய_திருத்தம்", 0),
                          உருப்படி.மாற்றியவர், எங்கள்_அடையாளம், வரவுக்_கைரேகை,
                          புலம்_அல்லது(ஒரு_பணி, "பதிந்த_கைரேகை", ""));
    (முடிவு != "ஏற்கலாம்") எனில் { திரும்பு விடை_ஆக்கு(200, { முடிவு: முடிவு, பணியுருப்படி_எண்: உருப்படி_எண் }); }

    பிரிப்பு = வரவைப்_பிரி(இயல்பு_உரிமைகள்(), வரவுப்_புலங்கள்);
    புதியது = ஒரு_பணி;
    ஒவ்வொரு புலப்_பெயர் இல் பிரிப்பு.ஏற்பவை { புதியது[புலப்_பெயர்] = பிரிப்பு.ஏற்பவை[புலப்_பெயர்]; }
    புதியது["பதிந்த_கைரேகை"] = வரவுக்_கைரேகை;
    பணியைச்_சேமி(திட்டக்_குறி, புதியது);
    நிகழ்வைப்_பதி(திட்டக்_குறி & "/" & ஒரு_பணி.பணி_குறி,
                  { நிகழ்வு_வகை: "அஜூர்_வரவு", திருத்தம்: உருப்படி.திருத்தம், ஏற்பவை: பிரிப்பு.ஏற்பவை,
                    மறுப்பவை: பிரிப்பு.மறுப்பவை });
    திரும்பு விடை_ஆக்கு(200, { முடிவு: முடிவு, பணியுருப்படி_எண்: உருப்படி_எண், ஏற்பவை: பிரிப்பு.ஏற்பவை,
                              மறுப்பவை: பிரிப்பு.மறுப்பவை });
}

// __--- A project to start from -------------------------------------------__

// __மாதிரித்_திட்டத்தை_விதை(ரகசிய_விசை) — the demo project, saved and queued__
// மாதிரித்_திட்டத்தை_விதை(ரகசிய_விசை) — மாதிரித் திட்டத்தைச் சேமித்து வரிசைப்படுத்தும்
//
// __வாசல், as in aluvalakam.qmz: scope and the SSO feature become tasks, the plan is__
// __baselined, and change request CR-3 waits at requested with the PDF export it__
// __asks for. A second, smaller project gives the portfolio something to add up.__
செயல் மாதிரித்_திட்டத்தை_விதை(ரகசிய_விசை) {
    நோக்கம் = மதிப்பு(நோக்கத்தைப்_பயன்படுத்து([
        நோக்க_வரி_ஆக்கு("1.1", "தேவைப் பகுப்பாய்வு", 32, "உள்ளே"),
        நோக்க_வரி_ஆக்கு("1.2", "வடிவமைப்பு", 40, "உள்ளே"),
        நோக்க_வரி_ஆக்கு("1.3", "உருவாக்கம்", 120, "உள்ளே"),
        நோக்க_வரி_ஆக்கு("1.4", "சோதனை", 48, "உள்ளே")],
        ["SSO"], [அம்ச_விளைவு_ஆக்கு("SSO", "மணி_கூட்டு", "1.3", 16, ""),
                  அம்ச_விளைவு_ஆக்கு("SSO", "பணி_சேர்", "1.7", 8, "Entra அமைப்பு")]));
    முன்னோடி_வரைபடம் = {"1.1": [], "1.2": ["1.1"], "1.3": ["1.2"], "1.7": ["1.2"], "1.4": ["1.3", "1.7"]};
    பணிகள் = [];
    ஒவ்வொரு ஒரு_பணி இல் நோக்கம்.பணிகள் {
        பணிகள் = இணை(பணிகள், அட்டவணைக்கு_அமை(ஒரு_பணி,
            மணியிலிருந்து_நாட்கள்(ஒரு_பணி.மதிப்பீட்டு_மணி, 8), முன்னோடி_வரைபடம்[ஒரு_பணி.பணி_குறி]));
    }
    நேரலை = பணி_ஆக்கு("M", "", "செய்யவேண்டியது", 0, 0, "");
    நேரலை["விவரம்"] = "நேரலை";
    பணிகள் = இணை(பணிகள், அட்டவணைக்கு_அமை(நேரலை, 0, ["1.4"]));
    விடுமுறைகள் = ["2026-10-02"];
    அடிப்படைத்_திட்டம் = மதிப்பு(மறு_அட்டவணையிடு(பணிகள், "2026-09-28", "2026-09-28",
                                                நாட்காட்டி_ஆக்கு([0, 6], விடுமுறைகள்)));
    திட்டத்தைச்_சேமி({ திட்டக்_குறி: "BK-ACM-0007", பெயர்: "வாசல்", வாடிக்கையாளர்: "ACME",
                       தொடக்க_நாள்: "2026-09-28", அடிப்படை_முடிவு: அடிப்படைத்_திட்டம்.திட்ட_முடிவு_நாள்,
                       விடுமுறைகள்: விடுமுறைகள், மூடியதா: பொய், பூட்டியதா: மெய் });
    ஒவ்வொரு ஒரு_பணி இல் பணிகள் { பணியைச்_சேமி("BK-ACM-0007", ஒரு_பணி); }
    ஒவ்வொரு ஒரு_பணி இல் பணிகள் { வரிசையில்_சேர்("BK-ACM-0007", ஒரு_பணி, பணிகள், ரகசிய_விசை); }
    மாற்றத்தைச்_சேமி({ மாற்றக்_குறி: "CR-3", திட்டக்_குறி: "BK-ACM-0007", நடப்பு_நிலை: "கோரியது",
        உருப்படிகள்: [{ உருப்படிக்_குறி: "1.3.1", பெற்றோர்_குறி: "1.3", விவரம்: "PDF ஏற்றுமதி",
                        மதிப்பீட்டு_மணி: 12, முன்னோடிகள்: ["1.2"], பின்வருபவை: ["1.4"] }] });

    சிறியது = அட்டவணைக்கு_அமை(பணி_ஆக்கு("2.1", "", "நடப்பில்", 90, 400, ""), 50, []);
    சிறியது["விவரம்"] = "அறிக்கைத் தளம்";
    சிறியது["உண்மைத்_தொடக்கம்"] = "2026-08-03";
    திட்டத்தைச்_சேமி({ திட்டக்_குறி: "BK-ACM-0004", பெயர்: "அறிக்கைகள்", வாடிக்கையாளர்: "ACME",
                       தொடக்க_நாள்: "2026-08-03", அடிப்படை_முடிவு: "2026-10-30",
                       விடுமுறைகள்: விடுமுறைகள், மூடியதா: பொய், பூட்டியதா: மெய் });
    பணியைச்_சேமி("BK-ACM-0004", சிறியது);
}
