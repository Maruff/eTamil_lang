செயல் வரிசையை_அனுப்பு(இப்போது, நடுக்கம், செயல் அனுப்புவி) {
    அனுப்பியவை = 0;
    தோல்விகள் = 0;
    தள்ளியவை = 0;
    வகையின்_நிலைகள் = [{"name": "New", "category": "Proposed"}, {"name": "Active", "category": "InProgress"},
                       {"name": "Resolved", "category": "Resolved"}, {"name": "Closed", "category": "Completed"},
                       {"name": "Removed", "category": "Removed"}];
