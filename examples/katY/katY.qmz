// __examples/katY/katY.qmz — கடை: an online shop's pricing and GST__
//
// __Definitions only; katY_kAttu.qmz runs them and katY_cEvY.qmz serves them.__
//
// __GST is computed **per line**, not on the invoice total, because an order can__
// __mix rates — 5% on a saree and 18% on a phone case — and taxing the sum at__
// __one rate would be wrong on both. Each line's tax is split into CGST/SGST or__
// __IGST and the splits are accumulated, which is what a GST return expects.__
//
// __Note how many of these names are also keywords: விலை, இருப்பு, வரி, சரக்கு,__
// __விலைப்பட்டியல். They are the words a shop actually uses, and they keep the__
// __spelling written here — before roadmap item 2 they would have been stored as__
// __Price, Balance, Tax, Goods and Invoice.__

இறக்கு "../../nUlakam/paNam/paNam.qmz";
இறக்கு "../../nUlakam/atippatY/kaNiqam.qmz";
இறக்கு "../../nUlakam/atippatY/col.qmz";
இறக்கு "../../nUlakam/kaNakkiyal/vari.qmz";

// __--- Accounts -------------------------------------------------------------__
// __A shop's books. The codes are what the ledger posts against.__

// __கணக்கு_வங்கி() — the bank account code, 1000__
//
// __The shop's chart of accounts as functions rather than bare strings, so a mistyped code is a name the compiler does not know instead of a posting that lands nowhere. The numbering follows the usual convention: 1000s assets, 2000s liabilities, 3000s equity, 4000s income, 5000s expense.__
செயல் கணக்கு_வங்கி()          { திரும்பு "1000"; }
// __கணக்கு_வாடிக்கையாளர்() — trade receivables, 1100__
//
// __What customers owe on a credit sale. An asset, so a sale debits it and a receipt credits it.__
செயல் கணக்கு_வாடிக்கையாளர்() { திரும்பு "1100"; }
// __கணக்கு_சரக்கிருப்பு() — inventory, 1200__
//
// __Goods held for sale. Credited when something is sold, against cost of goods sold — the second of the two entries a sale produces.__
செயல் கணக்கு_சரக்கிருப்பு()   { திரும்பு "1200"; }
// __கணக்கு_வரி_செலுத்த() — GST payable, 2100__
//
// __A liability, not income: the tax on a sale is collected for the government and held. Keeping it in its own account is what makes the return a query rather than a reconstruction.__
செயல் கணக்கு_வரி_செலுத்த()    { திரும்பு "2100"; }
// __கணக்கு_மூலதனம்() — owner's capital, 3000__
//
// __What the owner put in. Equity, so it carries a credit balance like the liabilities it ranks behind.__
செயல் கணக்கு_மூலதனம்()        { திரும்பு "3000"; }
// __கணக்கு_விற்பனை() — sales, 4000__
//
// __Income, and the tax-exclusive figure only. Posting the invoice total here would overstate revenue by the GST and understate the liability by the same amount, leaving the ledger balanced and both numbers wrong.__
செயல் கணக்கு_விற்பனை()        { திரும்பு "4000"; }
// __கணக்கு_விற்ற_செலவு() — cost of goods sold, 5000__
//
// __The other half of a sale: inventory leaves at cost and arrives here. Recording the revenue without this is what makes a shop look profitable while its stock quietly empties.__
செயல் கணக்கு_விற்ற_செலவு()    { திரும்பு "5000"; }

// __கடை_கணக்குகள்() — the shop's whole chart of accounts__
//
// __Built through கணக்கு_ஆக்கு so every account is validated against the five IFRS roots as it is created. Seven accounts is enough for a shop that sells, collects and owes tax, and small enough to read in one screen.__
செயல் கடை_கணக்குகள்() {
    திரும்பு [
        மதிப்பு(கணக்கு_ஆக்கு(கணக்கு_வங்கி(), "வங்கி", "சொத்து", "நடப்பு")),
        மதிப்பு(கணக்கு_ஆக்கு(கணக்கு_வாடிக்கையாளர்(), "வாடிக்கையாளர்கள்", "சொத்து", "நடப்பு")),
        மதிப்பு(கணக்கு_ஆக்கு(கணக்கு_சரக்கிருப்பு(), "சரக்கிருப்பு", "சொத்து", "நடப்பு")),
        மதிப்பு(கணக்கு_ஆக்கு(கணக்கு_வரி_செலுத்த(), "வணிகவரி செலுத்தவேண்டியது", "பொறுப்பு", "நடப்பு")),
        மதிப்பு(கணக்கு_ஆக்கு(கணக்கு_மூலதனம்(), "மூலதனம்", "பங்கு", "மூலதனம்")),
        மதிப்பு(கணக்கு_ஆக்கு(கணக்கு_விற்பனை(), "விற்பனை", "வருவாய்", "இயக்கம்")),
        மதிப்பு(கணக்கு_ஆக்கு(கணக்கு_விற்ற_செலவு(), "விற்ற பொருளின் செலவு", "செலவு", "இயக்கம்"))
    ];
}

// __--- The cart -------------------------------------------------------------__

// __வண்டி_ஒரு_வரிசை(...) — one line of a cart__
செயல் வண்டி_ஒரு_வரிசை(சரக்கு_குறி, பெயர், அலகு_விலை, அளவு, வரி_விகிதம்) {
    திரும்பு {
        சரக்கு_குறி: சரக்கு_குறி,
        பெயர்: பெயர்,
        அலகு_விலை: அலகு_விலை,
        அளவு: அளவு,
        வரி_விகிதம்: வரி_விகிதம்
    };
}

// __ஒரு_வரிசை_அடிப்படை(ஒரு_வரிசை) — the line's value before tax__
செயல் ஒரு_வரிசை_அடிப்படை(ஒரு_வரிசை) {
    திரும்பு ஒரு_வரிசை.அலகு_விலை * ஒரு_வரிசை.அளவு;
}

// __வண்டி_கணக்கு(வரிசைகள், உள்_மாநிலமா) — what the customer owes, and how the__
// __tax divides.__
//
// __உள்_மாநிலமா decides the split, not the amount: within a state the tax is__
// __half CGST and half SGST; across states the whole of it is IGST. Getting this__
// __wrong misfiles the return even when the total is right.__
செயல் வண்டி_கணக்கு(வண்டி_வரிசைகள், உள்_மாநிலமா) {
    அடிப்படை_மொத்தம் = 0;
    _cgst_மொத்தம் = 0;
    _sgst_மொத்தம் = 0;
    _igst_மொத்தம் = 0;

    ஒவ்வொரு ஒரு_வரிசை இல் வண்டி_வரிசைகள் {
        வரிசை_அடிப்படை = ஒரு_வரிசை_அடிப்படை(ஒரு_வரிசை);
        வரிசை_வரி = வட்டமிடு(சதவீதம்(வரிசை_அடிப்படை, ஒரு_வரிசை.வரி_விகிதம்), 2);
        பிரிப்பு = மாநில_பிரிப்பு(வரிசை_வரி, உள்_மாநிலமா);

        அடிப்படை_மொத்தம் = அடிப்படை_மொத்தம் + வரிசை_அடிப்படை;
        _cgst_மொத்தம் = _cgst_மொத்தம் + பிரிப்பு.cgst;
        _sgst_மொத்தம் = _sgst_மொத்தம் + பிரிப்பு.sgst;
        _igst_மொத்தம் = _igst_மொத்தம் + பிரிப்பு.igst;
    }

    வரி_மொத்தம் = _cgst_மொத்தம் + _sgst_மொத்தம் + _igst_மொத்தம்;
    திரும்பு {
        அடிப்படை: அடிப்படை_மொத்தம்,
        cgst: _cgst_மொத்தம்,
        sgst: _sgst_மொத்தம்,
        igst: _igst_மொத்தம்,
        வரி: வரி_மொத்தம்,
        செலுத்தவேண்டியது: அடிப்படை_மொத்தம் + வரி_மொத்தம்
    };
}

// __--- The invoice ----------------------------------------------------------__

// __விலைப்பட்டியல்_அச்சிடு(விலைப்பட்டியல்_எண், வாடிக்கையாளர்_பெயர், நாள், வண்டி_வரிசைகள், கணக்கு) — print a GST invoice__
//
// __Per-line tax, then the totals, which is the shape a GST invoice legally has to take: an order mixing 5% and 18% cannot be taxed on its sum, and the lines are where the rates live.__
செயல் விலைப்பட்டியல்_அச்சிடு(விலைப்பட்டியல்_எண், வாடிக்கையாளர்_பெயர்,
                                நாள், வண்டி_வரிசைகள், கணக்கு) {
    அச்சு "====================================================";
    அச்சு "  விலைப்பட்டியல் " & விலைப்பட்டியல்_எண் & "        " & நாள்;
    அச்சு "  வாடிக்கையாளர்: " & வாடிக்கையாளர்_பெயர்;
    அச்சு "====================================================";
    அச்சு "  பொருள்                அளவு      விலை       தொகை";
    அச்சு "----------------------------------------------------";

    ஒவ்வொரு ஒரு_வரிசை இல் வண்டி_வரிசைகள் {
        அச்சு "  " & இடமிருந்து_நிரப்பு(ஒரு_வரிசை.பெயர், 20, " ")
              & "  " & இடமிருந்து_நிரப்பு(சொல்லாக்கு(ஒரு_வரிசை.அளவு), 4, " ")
              & "  " & இடமிருந்து_நிரப்பு(ரூபாய்(ஒரு_வரிசை.அலகு_விலை), 12, " ")
              & "  " & ரூபாய்(ஒரு_வரிசை_அடிப்படை(ஒரு_வரிசை))
              & "   (" & ஒரு_வரிசை.வரி_விகிதம் & "%)";
    }

    அச்சு "----------------------------------------------------";
    அச்சு "  வரிக்கு முன்                    " & ரூபாய்(கணக்கு.அடிப்படை);
    (கணக்கு.igst > 0) எனில் {
        அச்சு "  IGST                            " & ரூபாய்(கணக்கு.igst);
    }
    இன்றேல் {
        அச்சு "  CGST                            " & ரூபாய்(கணக்கு.cgst);
        அச்சு "  SGST                            " & ரூபாய்(கணக்கு.sgst);
    }
    அச்சு "====================================================";
    அச்சு "  செலுத்தவேண்டியது                " & ரூபாய்(கணக்கு.செலுத்தவேண்டியது);
    அச்சு "====================================================";
}
