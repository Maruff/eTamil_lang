// __வரி சேவை — a routed tax API__
//
// __Run it:   etamil --server --port 8080 examples/api/vari_cEvY.qmz__
// __Try it:   curl http://localhost:8080/vari__
//           __curl http://localhost:8080/__
//
// __Everything outside a வழி block is a prelude: imports and functions are__
// __compiled into every handler, so routes can use them.__

இறக்கு "../../nUlakam/paNam/paNam.qmz";
இறக்கு "../../nUlakam/atippatY/kaNiqam.qmz";

// __வரி_கணக்கு(ஆண்டு_வருமானம்) — income tax under the new regime slabs__
//
// __A ladder, not a single rate on the whole income: nothing to 3 lakh, 5% on the next 4, 20% above 7. Each band is charged only on the part of the income that falls inside it, which is why crossing a threshold never leaves someone worse off than before.__
செயல் வரி_கணக்கு(ஆண்டு_வருமானம்) {
    (ஆண்டு_வருமானம் <= 300000) எனில் { திரும்பு 0; }
    (ஆண்டு_வருமானம் <= 700000) எனில் {
        திரும்பு சதவீதம்(ஆண்டு_வருமானம் - 300000, 5);
    }
    திரும்பு 20000 + சதவீதம்(ஆண்டு_வருமானம் - 700000, 20);
}

வழி பெறு, "/" {
    பதில் 200, "eTamil வரி சேவை — /vari ஐ முயற்சிக்கவும்";
}

வழி பெறு, "/vari" {
    வருமானம் = 950000;
    வரி = வரி_கணக்கு(வருமானம்);
    பதில் 200, "வருமானம் " & ரூபாய்(வருமானம்) & " → வரி " & ரூபாய்(வரி);
}

வழி பெறு, "/nalam" {
    பதில் 200, "சரி";
}
