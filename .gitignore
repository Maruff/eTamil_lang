.claude/

# Rust build artifacts
etamil_compiler/target/
etamil_lsp/target/
scripts/bench/compare/rust/target/

# Benchmark build artifacts
scripts/bench/compare/csharp/bin/
scripts/bench/compare/csharp/obj/
*.exe
*.pdb
*.class

# Compiled binaries
etamil_program
*.o
*.s
*.ll

# Databases created by the examples
*.db
*.db-journal
*.sqlite

# Build logs and intermediate output
build_output.txt
output.bin

# CSV data files (optional - comment out if you want to include them)
*.csv

# IDE and editor files
.vs/
.vscode/
.idea/
*.swp
*.swo
*~

# OS files
.DS_Store
Thumbs.db

# Logs
*.log

# Temporary files
*.tmp
*.bak

# Test outputs
test_output/
*.test

# Environment files
.env
.env.local

# Release packages. These are published as GitHub release assets, never
# committed: a binary in git history is permanent and every clone pays for it.
dist/

# Written by the io_samples examples when they run. run_parity.sh runs each
# example beside itself so that a relative data-file path resolves, unlike
# run_examples.sh which runs in a temp directory — so a parity run leaves
# these behind. input.txt, numbers.txt, sample.txt and tamil_sample.txt are
# inputs and stay tracked.
examples/io_samples/data.txt
examples/io_samples/output.txt
examples/io_samples/transactions.csv

# Python bytecode from scripts/. Reappears after every run of the
# generators and the parity checks.
__pycache__/

# Written by examples/crypto_samples/maRYyAkkam.qmz when it runs.
*.enc

# --- Android app ---
# The JNI shim's own Rust build directory, alongside the compiler's above.
android/rust/target/
# Gradle's build output and local state. The APK is a release asset or a CI
# artifact, never a commit, for the same reason dist/ is not committed.
android/build/
android/app/build/
android/.gradle/
android/local.properties
# Produced by cargo-ndk on the way to an APK. One .so per ABI, several
# megabytes each, and rebuilt from the Rust source every time — nothing a
# clone should be paying to download.
android/app/src/main/jniLibs/

# Python packaging output for the Pygments lexer. `pip install .` writes both,
# and the staged-artifact mess in the old OneDrive clone started exactly here.
eTamil_Pygments/build/
eTamil_Pygments/*.egg-info/

# Staged for `cargo publish` only — see scripts/vendor_for_publish.py.
# Generated from the originals one directory up on every publish, so it is
# never committed and can never drift from them.
etamil_compiler/nUlakam/
etamil_compiler/LICENSE

# tree-sitter build artifacts. src/parser.c IS committed — consumers build
# from it without needing the CLI — but the compiled objects are not.
tree-sitter-etamil/node_modules/
tree-sitter-etamil/build/
tree-sitter-etamil/*.wasm
# What MSVC leaves beside the grammar when `tree-sitter test` compiles it on
# Windows.
tree-sitter-etamil/*.obj
tree-sitter-etamil/*.lib
tree-sitter-etamil/*.exp
eTamil_HighlightJS/node_modules/
