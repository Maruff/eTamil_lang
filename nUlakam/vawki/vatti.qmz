// __nUlakam/vawki/vatti.qmz — வட்டி (interest)__
// வட்டி
//
// __Rates are written the way சதவீதம் in kaNiqam.qmz already expects them: as a__
// __number out of a hundred. 8.5% per annum is 8.5 — not 8.5%, and not 0.085.__
//
// __Worth saying plainly, because the language has a % literal and 8.5% is__
// __0.085. Passing that here gives an answer a hundred times too small and__
// __nothing complains, since the type checker cannot tell one number from__
// __another. The suite beside this file pins it.__
//
// __Nothing here holds a rate. A rate is an argument, so the figures a bank__
// __actually charges live in a table and change without this file changing.__
//
// __A note on names: அசல் (principal), தொகை (amount) and முறை (times) are all__
// __keywords, so the natural word for each is unavailable on its own. Compounds__
// __lex as ordinary identifiers, which is why the parameters read as they do.__

இறக்கு "../atippatY/kaNiqam.qmz";

// __--- day-count conventions ------------------------------------------------__
//
// __A year is not a fixed number of days, and which fiction is used changes the__
// __interest. Actual/365 is the Indian norm for rupee lending; Actual/360 turns__
// __up in foreign-currency facilities. The caller says which, because getting it__
// __wrong is a difference in money and not something to guess at.__

உண்மை_365 = 365;
உண்மை_360 = 360;

// __நாட்கள்(தொடக்க_நாள், முடிவு_நாள்) — actual days between two ISO dates__
// நாட்கள்(தொடக்க_நாள், முடிவு_நாள்) — இரு நாள்களுக்கு இடையே உள்ள உண்மையான நாட்கள்
செயல் நாட்கள்(தொடக்க_நாள், முடிவு_நாள்) {
    திரும்பு நாள்_வேறுபாடு(தொடக்க_நாள், முடிவு_நாள்);
}

// __ஆண்டுப்_பங்கு(எத்தனை_நாட்கள், ஆண்டு_நாட்கள்) — the year fraction__
// ஆண்டுப்_பங்கு(எத்தனை_நாட்கள், ஆண்டு_நாட்கள்) — ஆண்டில் இது எவ்வளவு பங்கு
செயல் ஆண்டுப்_பங்கு(எத்தனை_நாட்கள், ஆண்டு_நாட்கள்) {
    திரும்பு எத்தனை_நாட்கள் / ஆண்டு_நாட்கள்;
}

// __--- powers ---------------------------------------------------------------__
//
// __அடுக்கு(அடிப்படை, எத்தனை_முறை) — a base raised a whole number of times.__
// அடுக்கு(அடிப்படை, எத்தனை_முறை) — ஓர் அடிப்படையை முழு எண் முறை பெருக்கும்
//
// __By repeated multiplication, not a floating-point pow. Every number here is a__
// __fixed-point decimal, and the reason for that is that money must not drift;__
// __borrowing a float to raise 1.00708333 to the power of 240 would put the__
// __drift back at exactly the step that compounds it.__
செயல் அடுக்கு(அடிப்படை, எத்தனை_முறை) {
    (எத்தனை_முறை <= 0) எனில் { திரும்பு 1; }
    விடை = 1;
    எண்ணி = 0;
    (எண்ணி < எத்தனை_முறை) சுற்று {
        விடை = விடை * அடிப்படை;
        எண்ணி = எண்ணி + 1;
    }
    திரும்பு விடை;
}

// __--- simple interest ------------------------------------------------------__
//
// எளிய_வட்டி(அசல்_தொகை, ஆண்டு_விகிதம், எத்தனை_நாட்கள், ஆண்டு_நாட்கள்)
//
// __Rounded to the paisa, because that is the unit a bank posts.__
// எளிய_வட்டி(அசல்_தொகை, ஆண்டு_விகிதம், எத்தனை_நாட்கள், ஆண்டு_நாட்கள்) — கூட்டாத எளிய வட்டி
செயல் எளிய_வட்டி(அசல்_தொகை, ஆண்டு_விகிதம், எத்தனை_நாட்கள், ஆண்டு_நாட்கள்) {
    ஆண்டுக்_கணக்கு = சதவீதம்(அசல்_தொகை, ஆண்டு_விகிதம்);
    திரும்பு வட்டமிடு(ஆண்டுக்_கணக்கு * எத்தனை_நாட்கள் / ஆண்டு_நாட்கள், 2);
}

// __நாளாந்த_வட்டி(அசல்_தொகை, ஆண்டு_விகிதம், ஆண்டு_நாட்கள்) — one day's interest__
// நாளாந்த_வட்டி(அசல்_தொகை, ஆண்டு_விகிதம், ஆண்டு_நாட்கள்) — ஒரு நாளுக்கான வட்டி
//
// __Deliberately not rounded. A day's interest on a small balance is often a__
// __fraction of a paisa, and rounding each day before adding them up loses more__
// __than it tidies. Round the total, once, when it is posted.__
செயல் நாளாந்த_வட்டி(அசல்_தொகை, ஆண்டு_விகிதம், ஆண்டு_நாட்கள்) {
    திரும்பு சதவீதம்(அசல்_தொகை, ஆண்டு_விகிதம்) / ஆண்டு_நாட்கள்;
}

// __--- compound interest ----------------------------------------------------__
//
// கூட்டு_வட்டி(அசல்_தொகை, ஆண்டு_விகிதம், ஆண்டுகள், ஆண்டுக்கு_எத்தனை)
//
// __ஆண்டுக்கு_எத்தனை is how often it compounds in a year: 4 for a quarterly__
// __deposit, which is what most Indian term deposits do, 12 for monthly.__
//
// __Answers the interest alone rather than the maturity value, so it reads the__
// __same way எளிய_வட்டி does.__
// கூட்டு_வட்டி(அசல்_தொகை, ஆண்டு_விகிதம், ஆண்டுகள், ஆண்டுக்கு_எத்தனை) — வட்டிக்கும் வட்டி சேரும் கணக்கு
செயல் கூட்டு_வட்டி(அசல்_தொகை, ஆண்டு_விகிதம், ஆண்டுகள், ஆண்டுக்கு_எத்தனை) {
    ஒரு_முறை_விகிதம் = ஆண்டு_விகிதம் / (ஆண்டுக்கு_எத்தனை * 100);
    எத்தனை_முறைகள் = ஆண்டுக்கு_எத்தனை * ஆண்டுகள்;
    வளர்ச்சி = அடுக்கு(1 + ஒரு_முறை_விகிதம், எத்தனை_முறைகள்);
    திரும்பு வட்டமிடு(அசல்_தொகை * வளர்ச்சி - அசல்_தொகை, 2);
}

// முதிர்வுத்_தொகை(அசல்_தொகை, ஆண்டு_விகிதம், ஆண்டுகள், ஆண்டுக்கு_எத்தனை)
// __முதிர்வுத்_தொகை(அசல்_தொகை, ஆண்டு_விகிதம், ஆண்டுகள், ஆண்டுக்கு_எத்தனை) — what a deposit is worth at maturity__
// முதிர்வுத்_தொகை(அசல்_தொகை, ஆண்டு_விகிதம், ஆண்டுகள், ஆண்டுக்கு_எத்தனை) — முதிர்வில் வைப்புத்தொகை எவ்வளவாகும்
//
// __Principal plus compound interest, so the compounding frequency matters: the same nominal rate paid quarterly and annually gives different money, and quoting one while computing the other is the commonest error in a deposit schedule.__
செயல் முதிர்வுத்_தொகை(அசல்_தொகை, ஆண்டு_விகிதம், ஆண்டுகள், ஆண்டுக்கு_எத்தனை) {
    திரும்பு அசல்_தொகை
           + கூட்டு_வட்டி(அசல்_தொகை, ஆண்டு_விகிதம், ஆண்டுகள், ஆண்டுக்கு_எத்தனை);
}
