// __nUlakam/vawki/kataZ.qmz — கடன் (loans): the instalment, and the schedule__
// கடன்: மாதத் தவணையும் அட்டவணையும்
//
// __Rates are per annum and written as a number out of a hundred, as everywhere__
// __else here: 9.25% is 9.25.__
//
// __The schedule is the part worth getting right. An instalment is rounded to__
// __the paisa, twelve or two hundred and forty of them are paid, and the sum of__
// __the rounded parts does not equal the loan. Every bank resolves that in the__
// __last instalment, and so does this: the final row is whatever actually clears__
// __the balance. A schedule that ends owing four paise is not a rounding detail,__
// __it is an account that will not close.__

இறக்கு "vatti.qmz";
இறக்கு "../atippatY/kaNiqam.qmz";

// __மாத_விகிதம்(ஆண்டு_விகிதம்) — the monthly rate as a fraction__
// மாத_விகிதம்(ஆண்டு_விகிதம்) — ஆண்டு வீதத்தை மாத வீதப் பின்னமாக்கும்
செயல் மாத_விகிதம்(ஆண்டு_விகிதம்) {
    திரும்பு ஆண்டு_விகிதம் / 1200;
}

// __மாதத்_தவணை(கடன்_தொகை, ஆண்டு_விகிதம், எத்தனை_மாதங்கள்) — the EMI__
// மாதத்_தவணை(கடன்_தொகை, ஆண்டு_விகிதம், எத்தனை_மாதங்கள்) — மாதந்தோறும் கட்ட வேண்டிய தவணை
//
//        __P · i · (1+i)^n__
//   __E = ─────────────────__
//         __(1+i)^n − 1__
//
// __A rate of zero is not a special case anyone writes down, and it is the one__
// __that divides by zero: with no interest the instalment is simply the loan__
// __spread evenly.__
// மாதத்_தவணை(கடன்_தொகை, ஆண்டு_விகிதம், எத்தனை_மாதங்கள்) — கடனுக்கான சமமான மாதத் தவணை
செயல் மாதத்_தவணை(கடன்_தொகை, ஆண்டு_விகிதம், எத்தனை_மாதங்கள்) {
    (எத்தனை_மாதங்கள் <= 0) எனில் { திரும்பு 0; }

    வட்டி_விகிதம் = மாத_விகிதம்(ஆண்டு_விகிதம்);
    (வட்டி_விகிதம் == 0) எனில் {
        திரும்பு வட்டமிடு(கடன்_தொகை / எத்தனை_மாதங்கள், 2);
    }

    வளர்ச்சி = அடுக்கு(1 + வட்டி_விகிதம், எத்தனை_மாதங்கள்);
    திரும்பு வட்டமிடு(கடன்_தொகை * வட்டி_விகிதம் * வளர்ச்சி / (வளர்ச்சி - 1), 2);
}

// தவணை_அட்டவணை(கடன்_தொகை, ஆண்டு_விகிதம், எத்தனை_மாதங்கள்)
//
// __One record per instalment: {மாதம், தவணை, வட்டி, அசலுக்கு, மீதம்}.__
//
// __Interest is taken on the balance that stood at the start of the month and__
// __rounded to the paisa, because that is the figure posted to the account. What__
// __is left of the instalment reduces the balance. The last row pays whatever__
// __remains, which is why it is rarely equal to the others.__
// தவணை_அட்டவணை(கடன்_தொகை, ஆண்டு_விகிதம், எத்தனை_மாதங்கள்) — மாதம்வாரியாக அசலும் வட்டியும்
செயல் தவணை_அட்டவணை(கடன்_தொகை, ஆண்டு_விகிதம், எத்தனை_மாதங்கள்) {
    தவணை = மாதத்_தவணை(கடன்_தொகை, ஆண்டு_விகிதம், எத்தனை_மாதங்கள்);
    வட்டி_விகிதம் = மாத_விகிதம்(ஆண்டு_விகிதம்);

    அட்டவணை = [];
    மீதி_தொகை = கடன்_தொகை;
    மாதம் = 1;

    (மாதம் <= எத்தனை_மாதங்கள்) சுற்று {
        மாத_வட்டி = வட்டமிடு(மீதி_தொகை * வட்டி_விகிதம், 2);

        (மாதம் == எத்தனை_மாதங்கள்) எனில் {
            // __The last one closes the account: whatever is owed, plus the__
            // __interest on it, and not a paisa more or less.__
            இந்தத்_தவணை = மீதி_தொகை + மாத_வட்டி;
            அசலுக்கு = மீதி_தொகை;
        }
        இன்றேல் {
            இந்தத்_தவணை = தவணை;
            அசலுக்கு = தவணை - மாத_வட்டி;
        }

        மீதி_தொகை = வட்டமிடு(மீதி_தொகை - அசலுக்கு, 2);
        அட்டவணை = இணை(அட்டவணை, {"மாதம்": மாதம்,
                                  "தவணை": இந்தத்_தவணை,
                                  "வட்டி": மாத_வட்டி,
                                  "அசலுக்கு": அசலுக்கு,
                                  "மீதம்": மீதி_தொகை});
        மாதம் = மாதம் + 1;
    }

    திரும்பு அட்டவணை;
}

// __மொத்த_வட்டி(அட்டவணை) — what the borrowing cost, over the whole term__
// மொத்த_வட்டி(அட்டவணை) — முழுக் காலத்திற்கும் கடனுக்கான செலவு
செயல் மொத்த_வட்டி(அட்டவணை) {
    கூட்டல் = 0;
    ஒவ்வொரு வரிசைப்_பதிவு இல் அட்டவணை {
        கூட்டல் = கூட்டல் + வரிசைப்_பதிவு["வட்டி"];
    }
    திரும்பு வட்டமிடு(கூட்டல், 2);
}

// __மொத்தத்_திருப்பி(அட்டவணை) — every instalment added up__
// மொத்தத்_திருப்பி(அட்டவணை) — எல்லாத் தவணைகளின் கூட்டுத்தொகை
செயல் மொத்தத்_திருப்பி(அட்டவணை) {
    கூட்டல் = 0;
    ஒவ்வொரு வரிசைப்_பதிவு இல் அட்டவணை {
        கூட்டல் = கூட்டல் + வரிசைப்_பதிவு["தவணை"];
    }
    திரும்பு வட்டமிடு(கூட்டல், 2);
}

// __முன்கூட்டியே_அடைத்தால்(அட்டவணை, எத்தனாவது_மாதம்) — what is owed to settle__
// முன்கூட்டியே_அடைத்தால்(அட்டவணை, எத்தனாவது_மாதம்) — அம்மாதத்தில் முடிக்கக் கட்ட வேண்டியது
// __after that instalment has been paid__
//
// __The balance in that row is what closing the loan then would cost, before any__
// __charge the lender adds for the privilege. That charge is a term of the__
// __contract, not arithmetic, so it is not here.__
செயல் முன்கூட்டியே_அடைத்தால்(அட்டவணை, எத்தனாவது_மாதம்) {
    ஒவ்வொரு வரிசைப்_பதிவு இல் அட்டவணை {
        (வரிசைப்_பதிவு["மாதம்"] == எத்தனாவது_மாதம்) எனில் {
            திரும்பு வரிசைப்_பதிவு["மீதம்"];
        }
    }
    திரும்பு 0;
}
