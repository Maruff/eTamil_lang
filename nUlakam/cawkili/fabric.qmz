// __nUlakam/cawkili/fabric.qmz — Hyperledger Fabric, through a REST gateway__
// ஹைப்பர்லெட்ஜர் ஃபேப்ரிக், ஓர் ஓய்வு நுழைவாயில் வழியாக
//
// __Fabric's own peer Gateway speaks gRPC, which eTamil does not. Fronting a__
// __network with a REST gateway is an ordinary deployment — Firefly does it, and__
// __Hyperledger's own fabric-rest-sample is a reference for writing one — and__
// __that is what this talks to. The alternative is months of HTTP/2 and protobuf__
// __to reach the same ledger.__
//
// __Gateways do not agree on their paths, so the paths are configuration rather__
// __than something baked in here. Give நுழைவு the shape yours uses.__
//
// __Two operations, and the difference between them is the whole of Fabric:__
//
//   __மதிப்பிடு   ask a peer, change nothing. A query. No consensus, no__
//               __ordering, no commit — and no guarantee another peer would__
//               __answer the same.__
//   __சமர்ப்பி    propose, collect endorsements, order, commit. A write. It can__
//               __fail after apparently succeeding, which is why the conflict__
//               __handling below exists.__
//
// __Identity is an X.509 certificate and an ECDSA key — வளைவு_கையொப்பம் signs__
// __with exactly the curve Fabric's default MSP uses. Whether the gateway wants__
// __that signature, a bearer token, or a client certificate over mutual TLS is__
// __again its business, so headers are configuration too.__

இறக்கு "../vativam/jEcAZ.qmz";
இறக்கு "../atippatY/poruL.qmz";

// __நுழைவு(முகவரிப்_பாதை, சேனல், நிரல்பொருள், தலைப்புகள்) — a gateway to talk to__
// நுழைவு(முகவரிப்_பாதை, சேனல், நிரல்பொருள், தலைப்புகள்) — பேசுவதற்கான நுழைவாயிலை அமைக்கும்
//
// __நிரல்பொருள் is the chaincode name. The two path templates carry {channel}__
// __and {chaincode}, which are filled in per call.__
செயல் நுழைவு(முகவரிப்_பாதை, சேனல், நிரல்பொருள், தலைப்புகள்) {
    திரும்பு {"முகவரிப்_பாதை": முகவரிப்_பாதை,
              "சேனல்": சேனல்,
              "நிரல்பொருள்": நிரல்பொருள்,
              "தலைப்புகள்": தலைப்புகள்,
              "வினவல்_பாதை": "/channels/{channel}/chaincodes/{chaincode}/query",
              "எழுதும்_பாதை": "/channels/{channel}/chaincodes/{chaincode}/invoke"};
}

// __பாதையை_அமை(நுழைவு, வினவல், எழுதும்) — different gateway, different paths__
// பாதையை_அமை(நுழைவு, வினவல், எழுதும்) — ஒவ்வொரு நுழைவாயிலுக்கும் பாதைகள் வேறு
செயல் பாதையை_அமை(நுழைவுப்_பொருள், வினவல், எழுதும்) {
    திரும்பு {"முகவரிப்_பாதை": நுழைவுப்_பொருள்["முகவரிப்_பாதை"],
              "சேனல்": நுழைவுப்_பொருள்["சேனல்"],
              "நிரல்பொருள்": நுழைவுப்_பொருள்["நிரல்பொருள்"],
              "தலைப்புகள்": நுழைவுப்_பொருள்["தலைப்புகள்"],
              "வினவல்_பாதை": வினவல்,
              "எழுதும்_பாதை": எழுதும்};
}

// __முழு_முகவரி(நுழைவுப்_பொருள், பாதைப்_படிவம்) — build the gateway URL for one call__
// முழு_முகவரி(நுழைவுப்_பொருள், பாதைப்_படிவம்) — ஒரு அழைப்புக்கான முழு முகவரியைக் கட்டும்
//
// __Substitutes the channel and chaincode into a path template. Kept as a template rather than concatenation so every route in this module reads the same way and a missing segment is visible in the template rather than hidden in string joins.__
செயல் முழு_முகவரி(நுழைவுப்_பொருள், பாதைப்_படிவம்) {
    பாதை = மாற்று(பாதைப்_படிவம், "{channel}", நுழைவுப்_பொருள்["சேனல்"]);
    பாதை = மாற்று(பாதை, "{chaincode}", நுழைவுப்_பொருள்["நிரல்பொருள்"]);
    திரும்பு நுழைவுப்_பொருள்["முகவரிப்_பாதை"] & பாதை;
}

// __உடலைக்_கட்டு(செயற்பெயர், அளபுருக்கள்) — the JSON body of a chaincode invocation__
// உடலைக்_கட்டு(செயற்பெயர், அளபுருக்கள்) — நிரல்பொருள் அழைப்புக்கான ஜேசான் உடல்
//
// __Fabric expects the function name and an array of string arguments, which is the shape every chaincode sees regardless of what it does. Built through ஜேசான்_ஆக்கு, so escaping is handled once and not per call site.__
செயல் உடலைக்_கட்டு(செயற்பெயர், அளபுருக்கள்) {
    திரும்பு ஜேசான்_ஆக்கு({"function": செயற்பெயர், "args": அளபுருக்கள்});
}

// __--- what came back -------------------------------------------------------__
//
// __A gateway answers a chaincode failure with a non-2xx and a body explaining__
// __it. That is an answer, not a transport failure, so it is unwrapped here into__
// __something a program can look at rather than reported as though the network__
// __broke.__
செயல் விடையைப்_படி(வலைப்_பதில்) {
    (தவறா(வலைப்_பதில்)) எனில் {
        திரும்பு தவறு({"வகைப்பாடு": "வலை", "விவரம்": மதிப்பு(வலைப்_பதில்)});
    }

    ப = மதிப்பு(வலைப்_பதில்);
    நிலைக்_குறி = ப["நிலைக்_குறி"];
    உடற்_பாடம் = ப["உடலுரை"];

    (நிலைக்_குறி >= 200 மற்றும் நிலைக்_குறி < 300) எனில் {
        திரும்பு சரி(உடற்_பாடம்);
    }
    திரும்பு தவறு({"வகைப்பாடு": "நிரல்பொருள்", "நிலைக்_குறி": நிலைக்_குறி,
                   "விவரம்": உடற்_பாடம்});
}

// __--- reading --------------------------------------------------------------__
//
// __மதிப்பிடு(நுழைவு, செயற்பெயர், அளபுருக்கள்) — a query. Nothing is written,__
// மதிப்பிடு(நுழைவு, செயற்பெயர், அளபுருக்கள்) — வினவல் மட்டும்; ஒன்றும் எழுதப்படுவதில்லை
// __nothing is ordered, and no conflict can arise.__
செயல் மதிப்பிடு(நுழைவுப்_பொருள், செயற்பெயர், அளபுருக்கள்) {
    திரும்பு விடையைப்_படி(
        வலை_பதி(முழு_முகவரி(நுழைவுப்_பொருள், நுழைவுப்_பொருள்["வினவல்_பாதை"]),
                 உடலைக்_கட்டு(செயற்பெயர், அளபுருக்கள்),
                 நுழைவுப்_பொருள்["தலைப்புகள்"]));
}

// __--- writing --------------------------------------------------------------__
//
// __சமர்ப்பி(நுழைவு, செயற்பெயர், அளபுருக்கள்) — one attempt at a write.__
// சமர்ப்பி(நுழைவு, செயற்பெயர், அளபுருக்கள்) — எழுதுவதற்கான ஒரு முயற்சி
//
// __Use மீண்டும்_சமர்ப்பி unless you have a reason not to: a single attempt is__
// __correct only for a transaction you would rather fail than retry.__
செயல் சமர்ப்பி(நுழைவுப்_பொருள், செயற்பெயர், அளபுருக்கள்) {
    திரும்பு விடையைப்_படி(
        வலை_பதி(முழு_முகவரி(நுழைவுப்_பொருள், நுழைவுப்_பொருள்["எழுதும்_பாதை"]),
                 உடலைக்_கட்டு(செயற்பெயர், அளபுருக்கள்),
                 நுழைவுப்_பொருள்["தலைப்புகள்"]));
}

// __மோதலா(பிழை) — is this the read-write conflict, or a real failure?__
// மோதலா(பிழை) — இது படிப்பு-எழுத்து மோதலா, அல்லது உண்மையான தோல்வியா
//
// __The one Fabric error worth knowing by name. Two transactions that read the__
// __same key and both write it cannot both commit: the second is rejected at__
// __validation with MVCC_READ_CONFLICT, after endorsement and ordering have__
// __already succeeded. It means "someone got there first", not "this was wrong",__
// __and the answer is to read again and redo the work.__
//
// __Retrying anything else would be retrying something that failed for a reason.__
செயல் மோதலா(பிழை) {
    (வகை(பிழை) != "a record") எனில் { திரும்பு பொய்; }
    விவரம் = புலம்_அல்லது(பிழை, "விவரம்", "");
    (வகை(விவரம்) != "a string") எனில் { திரும்பு பொய்; }
    திரும்பு நீளம்(பிரி(விவரம், "MVCC_READ_CONFLICT")) > 1
            அல்லது நீளம்(பிரி(விவரம், "PHANTOM_READ_CONFLICT")) > 1;
}

// மீண்டும்_சமர்ப்பி(நுழைவு, செயற்பெயர், அளபுருக்கள், எத்தனை_முறை)
//
// __Submit, and on a read-write conflict try again — up to the given number of__
// __attempts. Bounded, because a key under constant contention would otherwise__
// __retry until something else broke.__
//
// __Only a conflict is retried. A chaincode that rejected the transaction will__
// __reject it again, and retrying a business failure turns one refusal into__
// __several.__
// மீண்டும்_சமர்ப்பி(நுழைவு, செயற்பெயர், அளபுருக்கள், எத்தனை_முறை) — மோதல் வந்தால் மீண்டும் முயலும்
செயல் மீண்டும்_சமர்ப்பி(நுழைவுப்_பொருள், செயற்பெயர், அளபுருக்கள், எத்தனை_முறை) {
    முயற்சி = 0;
    கடைசி = தவறு({"வகைப்பாடு": "முயற்சி", "விவரம்": "no attempt was made"});

    (முயற்சி < எத்தனை_முறை) சுற்று {
        விளைவு = சமர்ப்பி(நுழைவுப்_பொருள், செயற்பெயர், அளபுருக்கள்);
        (சரியா(விளைவு)) எனில் { திரும்பு விளைவு; }

        கடைசி = விளைவு;
        (மோதலா(தவறு_மதிப்பு(விளைவு)) == பொய்) எனில் { திரும்பு விளைவு; }
        முயற்சி = முயற்சி + 1;
    }
    திரும்பு கடைசி;
}
