// SPDX-License-Identifier: AGPL-3.0-or-later
// Copyright (C) 2026 Mohammed Maruff (Esan Maruff) <esan@etamil.in>
// __nUlakam/jEcAZ.qmz — ஜேசான் (JSON), written in eTamil__
//
// __Both directions live here rather than in the host, because the language__
// __already has the one capability a JSON parser needs: a record key can be__
// __computed at runtime, so `பொருள்[சாவி] = மதிப்பு` builds a record from data__
// __rather than from names written in the source. Layer 0 stays thin.__
//
//   __ஜேசான்_ஆக்கு(மதிப்பு)  -> JSON text__
//   __ஜேசான்_படி(உரை)        -> சரி(மதிப்பு) or தவறு(செய்தி)__
//
// __Two things to know. Record fields come out in sorted order, because that is__
// __the order ஒவ்வொரு walks a record — the output is therefore stable run to__
// __run, which matters when a response is compared in a test. And `\uXXXX`__
// __escapes are not decoded; the six escapes JSON uses in practice are.__

இறக்கு "col.qmz";

// __--- Serializing ----------------------------------------------------------__

// __எழுத்து_மறை(எழுத்து) — one letter, escaped for a JSON string.__
//
// __"\r\n" is one letter, not two, so it needs an arm of its own: without it__
// __a Windows line ending inside a string falls through unescaped and the__
// __output carries a raw control character, which no JSON reader accepts.__
செயல் எழுத்து_மறை(ஒரு_எழுத்து) {
    (ஒரு_எழுத்து == "\"") எனில் { திரும்பு "\\\""; }
    (ஒரு_எழுத்து == "\\") எனில் { திரும்பு "\\\\"; }
    (ஒரு_எழுத்து == "\n") எனில் { திரும்பு "\\n"; }
    (ஒரு_எழுத்து == "\t") எனில் { திரும்பு "\\t"; }
    (ஒரு_எழுத்து == "\r") எனில் { திரும்பு "\\r"; }
    (ஒரு_எழுத்து == "\r\n") எனில் { திரும்பு "\\r\\n"; }
    திரும்பு ஒரு_எழுத்து;
}

// __ஜேசான்_சரம்(சரம்) — a quoted, escaped JSON string__
செயல் ஜேசான்_சரம்(சரம்) {
    விடை = "\"";
    ஒவ்வொரு ஒரு_எழுத்து இல் சொல்லாக்கு(சரம்) {
        விடை = விடை & எழுத்து_மறை(ஒரு_எழுத்து);
    }
    திரும்பு விடை & "\"";
}

// __ஜேசான்_ஆக்கு(மதிப்பு) — any value as JSON text__
செயல் ஜேசான்_ஆக்கு(ஒரு_மதிப்பு) {
    வகைப்_பெயர் = வகை(ஒரு_மதிப்பு);

    // __இன்மை prints as "nil" for people; JSON needs the word null.__
    (வகைப்_பெயர் == "nil") எனில் { திரும்பு "null"; }
    (வகைப்_பெயர் == "a boolean") எனில் { திரும்பு சொல்லாக்கு(ஒரு_மதிப்பு); }
    (வகைப்_பெயர் == "a number") எனில் { திரும்பு சொல்லாக்கு(ஒரு_மதிப்பு); }
    (வகைப்_பெயர் == "a string") எனில் { திரும்பு ஜேசான்_சரம்(ஒரு_மதிப்பு); }

    (வகைப்_பெயர் == "an array") எனில் {
        விடை = "[";
        முதலா = மெய்;
        ஒவ்வொரு உறுப்பு இல் ஒரு_மதிப்பு {
            (இல்லை முதலா) எனில் { விடை = விடை & ","; }
            விடை = விடை & ஜேசான்_ஆக்கு(உறுப்பு);
            முதலா = பொய்;
        }
        திரும்பு விடை & "]";
    }

    (வகைப்_பெயர் == "a record") எனில் {
        விடை = "{";
        முதலா = மெய்;
        ஒவ்வொரு சாவி இல் ஒரு_மதிப்பு {
            (இல்லை முதலா) எனில் { விடை = விடை & ","; }
            விடை = விடை & ஜேசான்_சரம்(சாவி) & ":" & ஜேசான்_ஆக்கு(ஒரு_மதிப்பு[சாவி]);
            முதலா = பொய்;
        }
        திரும்பு விடை & "}";
    }

    // __சரி/தவறு have no JSON spelling. Rendering one as null would hide a__
    // __failure inside a successful-looking response, so refuse it plainly.__
    திரும்பு "null";
}

// __--- Reading --------------------------------------------------------------__

// __ஜே_எழுத்து(உரை, இடம்) — the character at a position, or "" past the end.__
//
// __மற்றும் evaluates both sides, so `(இ < நீளம் மற்றும் உரை[இ] == "x")` still__
// __indexes out of bounds on the last step. Every read goes through here__
// __instead.__
செயல் ஜே_எழுத்து(மூல_உரை, ஒரு_இடம்) {
    திரும்பு எழுத்து(மூல_உரை, ஒரு_இடம்);
}

// __ஜே_வெண்மை(உரை, இடம்) — skip whitespace, returning the next position__
//
// __The text is read letter by letter, and "\r\n" is one letter — the rule__
// __that makes நீளம்("வணக்கம்") 5 also joins a carriage return to the line__
// __feed after it. A Windows line ending therefore matches neither the "\r"__
// __arm nor the "\n" one and needs its own. Without it whitespace ends at__
// __the first line break of a pretty-printed document, and ஜே_சோடி below__
// __blames a field name it never reached.__
செயல் ஜே_வெண்மை(மூல_உரை, தொடக்க_இடம்) {
    நடப்பு_இடம் = தொடக்க_இடம்;
    தொடரவா = மெய்;
    (தொடரவா) சுற்று {
        ஒரு_எழுத்து = ஜே_எழுத்து(மூல_உரை, நடப்பு_இடம்);
        (ஒரு_எழுத்து == " " அல்லது ஒரு_எழுத்து == "\n"
         அல்லது ஒரு_எழுத்து == "\t" அல்லது ஒரு_எழுத்து == "\r"
         அல்லது ஒரு_எழுத்து == "\r\n") எனில் {
            நடப்பு_இடம் = நடப்பு_இடம் + 1;
        }
        இன்றேல் { தொடரவா = பொய்; }
    }
    திரும்பு நடப்பு_இடம்;
}

// __ஜே_விடுவி(எழுத்து) — the character an escape names__
செயல் ஜே_விடுவி(ஒரு_எழுத்து) {
    (ஒரு_எழுத்து == "n") எனில் { திரும்பு "\n"; }
    (ஒரு_எழுத்து == "t") எனில் { திரும்பு "\t"; }
    (ஒரு_எழுத்து == "r") எனில் { திரும்பு "\r"; }
    (ஒரு_எழுத்து == "\"") எனில் { திரும்பு "\""; }
    (ஒரு_எழுத்து == "\\") எனில் { திரும்பு "\\"; }
    (ஒரு_எழுத்து == "/") எனில் { திரும்பு "/"; }
    திரும்பு ஒரு_எழுத்து;
}

// __Each reader returns சரி({கிடைத்த_மதிப்பு, அடுத்த_இடம்}) or தவறு(செய்தி),__
// __so a caller both gets the value and knows where to carry on from.__

// __ஜே_சரம்(மூல_உரை, தொடக்க_இடம்) — parse one JSON string literal__
//
// __Every parser here takes the text and a position and returns சரி with the value and the position after it, which is what lets them nest without a shared cursor. It handles the six escapes JSON uses in practice; a unicode escape is passed through rather than decoded. An unterminated string is தவறு, not a truncated value.__
செயல் ஜே_சரம்(மூல_உரை, தொடக்க_இடம்) {
    நடப்பு_இடம் = தொடக்க_இடம் + 1;   // __past the opening quote__
    விடை = "";
    ஓட்ட_நிலை = "ஓடு";

    (ஓட்ட_நிலை == "ஓடு") சுற்று {
        ஒரு_எழுத்து = ஜே_எழுத்து(மூல_உரை, நடப்பு_இடம்);
        (ஒரு_எழுத்து == "") எனில் {
            திரும்பு தவறு("முடிவடையாத சரம்  (unterminated string)");
        }
        இன்றேல் {
            (ஒரு_எழுத்து == "\"") எனில் {
                நடப்பு_இடம் = நடப்பு_இடம் + 1;
                ஓட்ட_நிலை = "முடிந்தது";
            }
            இன்றேல் {
                (ஒரு_எழுத்து == "\\") எனில் {
                    அடுத்த_எழுத்து = ஜே_எழுத்து(மூல_உரை, நடப்பு_இடம் + 1);
                    விடை = விடை & ஜே_விடுவி(அடுத்த_எழுத்து);
                    நடப்பு_இடம் = நடப்பு_இடம் + 2;
                }
                இன்றேல் {
                    விடை = விடை & ஒரு_எழுத்து;
                    நடப்பு_இடம் = நடப்பு_இடம் + 1;
                }
            }
        }
    }

    திரும்பு சரி({கிடைத்த_மதிப்பு: விடை, அடுத்த_இடம்: நடப்பு_இடம்});
}

// __ஜே_எண்(மூல_உரை, தொடக்க_இடம்) — parse one JSON number__
//
// __Accepts the sign, decimal point and exponent JSON allows, and stops at the first character that cannot continue a number — so the caller's delimiter is still there to be read. JSON has one numeric type and eTamil's எண் covers it.__
செயல் ஜே_எண்(மூல_உரை, தொடக்க_இடம்) {
    நடப்பு_இடம் = தொடக்க_இடம்;
    சேகரம் = "";
    தொடரவா = மெய்;

    (தொடரவா) சுற்று {
        ஒரு_எழுத்து = ஜே_எழுத்து(மூல_உரை, நடப்பு_இடம்);
        (ஒரு_எழுத்து != "" மற்றும் கொண்டுள்ளதா("-+.0123456789eE", ஒரு_எழுத்து)) எனில் {
            சேகரம் = சேகரம் & ஒரு_எழுத்து;
            நடப்பு_இடம் = நடப்பு_இடம் + 1;
        }
        இன்றேல் { தொடரவா = பொய்; }
    }

    (நீளம்(சேகரம்) == 0) எனில் {
        திரும்பு தவறு("ஒரு மதிப்பு எதிர்பார்க்கப்பட்டது  (expected a value)");
    }

    எண்_விளைவு = எண்ணாக்கு(சேகரம்);
    (தவறா(எண்_விளைவு)) எனில் {
        திரும்பு தவறு("செல்லாத எண்: " & சேகரம் & "  (not a number)");
    }
    திரும்பு சரி({கிடைத்த_மதிப்பு: மதிப்பு(எண்_விளைவு), அடுத்த_இடம்: நடப்பு_இடம்});
}

// __ஜே_அணி(மூல_உரை, தொடக்க_இடம்) — parse one JSON array__
//
// __Recurses through ஜே_மதிப்பு for each element, so arrays of objects of arrays work without anything special. A trailing comma is an error: JSON does not allow one, and accepting it here would produce documents that other parsers reject.__
செயல் ஜே_அணி(மூல_உரை, தொடக்க_இடம்) {
    நடப்பு_இடம் = ஜே_வெண்மை(மூல_உரை, தொடக்க_இடம் + 1);
    விடை = [];

    (ஜே_எழுத்து(மூல_உரை, நடப்பு_இடம்) == "]") எனில் {
        திரும்பு சரி({கிடைத்த_மதிப்பு: விடை, அடுத்த_இடம்: நடப்பு_இடம் + 1});
    }

    ஓட்ட_நிலை = "ஓடு";
    (ஓட்ட_நிலை == "ஓடு") சுற்று {
        உறுப்பு_விளைவு = ஜே_மதிப்பு(மூல_உரை, நடப்பு_இடம்);
        (தவறா(உறுப்பு_விளைவு)) எனில் { திரும்பு உறுப்பு_விளைவு; }

        கூறு = மதிப்பு(உறுப்பு_விளைவு);
        விடை = இணை(விடை, கூறு.கிடைத்த_மதிப்பு);
        நடப்பு_இடம் = ஜே_வெண்மை(மூல_உரை, கூறு.அடுத்த_இடம்);

        அடுத்த_எழுத்து = ஜே_எழுத்து(மூல_உரை, நடப்பு_இடம்);
        (அடுத்த_எழுத்து == ",") எனில் {
            நடப்பு_இடம் = ஜே_வெண்மை(மூல_உரை, நடப்பு_இடம் + 1);
        }
        இன்றேல் {
            (அடுத்த_எழுத்து == "]") எனில் {
                நடப்பு_இடம் = நடப்பு_இடம் + 1;
                ஓட்ட_நிலை = "முடிந்தது";
            }
            இன்றேல் {
                திரும்பு தவறு("',' அல்லது ']' எதிர்பார்க்கப்பட்டது  (expected ',' or ']')");
            }
        }
    }

    திரும்பு சரி({கிடைத்த_மதிப்பு: விடை, அடுத்த_இடம்: நடப்பு_இடம்});
}

// __ஜே_சோடி — one "சாவி": மதிப்பு pair, kept separate so the object loop below__
// __stays readable without an `else if`.__
செயல் ஜே_சோடி(மூல_உரை, தொடக்க_இடம்) {
    (ஜே_எழுத்து(மூல_உரை, தொடக்க_இடம்) != "\"") எனில் {
        திரும்பு தவறு("புலப் பெயர் ஒரு சரமாக இருக்க வேண்டும்  (a field name must be a string)");
    }

    சாவி_விளைவு = ஜே_சரம்(மூல_உரை, தொடக்க_இடம்);
    (தவறா(சாவி_விளைவு)) எனில் { திரும்பு சாவி_விளைவு; }
    சாவி_கூறு = மதிப்பு(சாவி_விளைவு);

    பிரிப்பு_இடம் = ஜே_வெண்மை(மூல_உரை, சாவி_கூறு.அடுத்த_இடம்);
    (ஜே_எழுத்து(மூல_உரை, பிரிப்பு_இடம்) != ":") எனில் {
        திரும்பு தவறு("':' எதிர்பார்க்கப்பட்டது  (expected ':')");
    }

    மதிப்பு_விளைவு = ஜே_மதிப்பு(மூல_உரை, பிரிப்பு_இடம் + 1);
    (தவறா(மதிப்பு_விளைவு)) எனில் { திரும்பு மதிப்பு_விளைவு; }
    மதிப்பு_கூறு = மதிப்பு(மதிப்பு_விளைவு);

    திரும்பு சரி({
        சாவிப்_பெயர்: சாவி_கூறு.கிடைத்த_மதிப்பு,
        கிடைத்த_மதிப்பு: மதிப்பு_கூறு.கிடைத்த_மதிப்பு,
        அடுத்த_இடம்: மதிப்பு_கூறு.அடுத்த_இடம்
    });
}

// __ஜே_பொருள்(மூல_உரை, தொடக்க_இடம்) — parse one JSON object__
//
// __The function this module exists to prove possible: the key is read from the text and used as a computed record key, building a record whose fields were never written in the source. That is the one host capability a JSON parser needs, and having it is why layer 0 stays thin.__
செயல் ஜே_பொருள்(மூல_உரை, தொடக்க_இடம்) {
    நடப்பு_இடம் = ஜே_வெண்மை(மூல_உரை, தொடக்க_இடம் + 1);
    விடை = {};

    (ஜே_எழுத்து(மூல_உரை, நடப்பு_இடம்) == "}") எனில் {
        திரும்பு சரி({கிடைத்த_மதிப்பு: விடை, அடுத்த_இடம்: நடப்பு_இடம் + 1});
    }

    ஓட்ட_நிலை = "ஓடு";
    (ஓட்ட_நிலை == "ஓடு") சுற்று {
        சோடி_விளைவு = ஜே_சோடி(மூல_உரை, நடப்பு_இடம்);
        (தவறா(சோடி_விளைவு)) எனில் { திரும்பு சோடி_விளைவு; }

        கூறு = மதிப்பு(சோடி_விளைவு);
        // __The key is data, so the field name is computed rather than written.__
        விடை[கூறு.சாவிப்_பெயர்] = கூறு.கிடைத்த_மதிப்பு;
        நடப்பு_இடம் = ஜே_வெண்மை(மூல_உரை, கூறு.அடுத்த_இடம்);

        அடுத்த_எழுத்து = ஜே_எழுத்து(மூல_உரை, நடப்பு_இடம்);
        (அடுத்த_எழுத்து == ",") எனில் {
            நடப்பு_இடம் = ஜே_வெண்மை(மூல_உரை, நடப்பு_இடம் + 1);
        }
        இன்றேல் {
            (அடுத்த_எழுத்து == "}") எனில் {
                நடப்பு_இடம் = நடப்பு_இடம் + 1;
                ஓட்ட_நிலை = "முடிந்தது";
            }
            இன்றேல் {
                திரும்பு தவறு("',' அல்லது '}' எதிர்பார்க்கப்பட்டது  (expected ',' or '}')");
            }
        }
    }

    திரும்பு சரி({கிடைத்த_மதிப்பு: விடை, அடுத்த_இடம்: நடப்பு_இடம்});
}

// __ஜே_மதிப்பு(மூல_உரை, தொடக்க_இடம்) — parse any JSON value, whatever comes next__
//
// __Dispatches on the first non-space character to string, number, array, object, true, false or null. The recursive heart of the parser: every container calls back into this, which is how arbitrary nesting is handled without a stack of its own.__
செயல் ஜே_மதிப்பு(மூல_உரை, தொடக்க_இடம்) {
    நடப்பு_இடம் = ஜே_வெண்மை(மூல_உரை, தொடக்க_இடம்);
    ஒரு_எழுத்து = ஜே_எழுத்து(மூல_உரை, நடப்பு_இடம்);

    (ஒரு_எழுத்து == "") எனில் {
        திரும்பு தவறு("எதிர்பாராத உள்ளீட்டு முடிவு  (unexpected end of input)");
    }
    (ஒரு_எழுத்து == "{") எனில் { திரும்பு ஜே_பொருள்(மூல_உரை, நடப்பு_இடம்); }
    (ஒரு_எழுத்து == "[") எனில் { திரும்பு ஜே_அணி(மூல_உரை, நடப்பு_இடம்); }
    (ஒரு_எழுத்து == "\"") எனில் { திரும்பு ஜே_சரம்(மூல_உரை, நடப்பு_இடம்); }

    (துண்டு(மூல_உரை, நடப்பு_இடம், 4) == "true") எனில் {
        திரும்பு சரி({கிடைத்த_மதிப்பு: மெய், அடுத்த_இடம்: நடப்பு_இடம் + 4});
    }
    (துண்டு(மூல_உரை, நடப்பு_இடம், 5) == "false") எனில் {
        திரும்பு சரி({கிடைத்த_மதிப்பு: பொய், அடுத்த_இடம்: நடப்பு_இடம் + 5});
    }
    (துண்டு(மூல_உரை, நடப்பு_இடம், 4) == "null") எனில் {
        திரும்பு சரி({கிடைத்த_மதிப்பு: இன்மை, அடுத்த_இடம்: நடப்பு_இடம் + 4});
    }

    திரும்பு ஜே_எண்(மூல_உரை, நடப்பு_இடம்);
}

// __ஜேசான்_படி(உரை) — parse JSON text into a value, or explain why it will not__
செயல் ஜேசான்_படி(மூல_உரை) {
    விளைவு = ஜே_மதிப்பு(மூல_உரை, 0);
    (தவறா(விளைவு)) எனில் { திரும்பு விளைவு; }

    கூறு = மதிப்பு(விளைவு);
    மீதி_இடம் = ஜே_வெண்மை(மூல_உரை, கூறு.அடுத்த_இடம்);

    // __Trailing text means the input was not one JSON value. Accepting it__
    // __would quietly read half a request body as though it were the whole one.__
    (மீதி_இடம் < நீளம்(மூல_உரை)) எனில் {
        திரும்பு தவறு("ஜேசான் முடிந்த பின் கூடுதல் உரை  (trailing text after the JSON value)");
    }

    திரும்பு சரி(கூறு.கிடைத்த_மதிப்பு);
}
