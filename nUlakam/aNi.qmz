// __nUlakam/aNi.qmz — அணி (array) helpers__
//
// __The last three take a செயல் as a value — map, filter and fold. They were__
// __missing until functions were values; the rule each one applies is now an__
// __argument instead of a loop written out again by every caller.__

// __உள்ளதா(அணி, மதிப்பு) — does the array contain this value?__
செயல் உள்ளதா(பட்டியல், தேடல்) {
    ஒவ்வொரு உறுப்பு இல் பட்டியல் {
        (உறுப்பு == தேடல்) எனில் { திரும்பு மெய்; }
    }
    திரும்பு பொய்;
}

// __இடம்_காண்(அணி, மதிப்பு) — first position, or -1__
செயல் இடம்_காண்(பட்டியல், தேடல்) {
    எண்ணி = 0;
    மொத்தம் = நீளம்(பட்டியல்);
    (எண்ணி < மொத்தம்) சுற்று {
        (பட்டியல்[எண்ணி] == தேடல்) எனில் { திரும்பு எண்ணி; }
        எண்ணி = எண்ணி + 1;
    }
    திரும்பு 0 - 1;
}

// __தலைகீழ்(அணி) — reverse an array, returning a new one__
செயல் தலைகீழ்(பட்டியல்) {
    விடை = [];
    எண்ணி = நீளம்(பட்டியல்);
    (எண்ணி > 0) சுற்று {
        எண்ணி = எண்ணி - 1;
        விடை = இணை(விடை, பட்டியல்[எண்ணி]);
    }
    திரும்பு விடை;
}

// __வெட்டு(அணி, தொடக்கம், அளவு) — slice__
செயல் வெட்டு(பட்டியல், தொடக்கம், அளவு) {
    விடை = [];
    எண்ணி = தொடக்கம்;
    முடிவு = தொடக்கம் + அளவு;
    மொத்தம் = நீளம்(பட்டியல்);
    (எண்ணி < முடிவு மற்றும் எண்ணி < மொத்தம்) சுற்று {
        விடை = இணை(விடை, பட்டியல்[எண்ணி]);
        எண்ணி = எண்ணி + 1;
    }
    திரும்பு விடை;
}

// __புலம்_எடு(வரிசைகள், புலம்) — pluck one field from every record.__
// __This is the column-from-rows operation a result set needs.__
செயல் புலம்_எடு(வரிசைகள், புலம்) {
    விடை = [];
    ஒவ்வொரு ஒரு_பதிவு இல் வரிசைகள் {
        விடை = இணை(விடை, ஒரு_பதிவு[புலம்]);
    }
    திரும்பு விடை;
}

// காலியா(அணி)
// __காலியா(பட்டியல்) — does this array hold nothing?__
//
// __Named rather than written as a length test at each call site, because நீளம்(x) == 0 and நீளம்(x) < 1 both appear in code that means this, and one of them is wrong for a value that is not an array at all.__
செயல் காலியா(பட்டியல்) {
    திரும்பு நீளம்(பட்டியல்) == 0;
}

// __புலத்தால்_வடிகட்டு(பட்டியல், புலம், மதிப்பு) — the records whose புலம் is மதிப்பு__
//
// __Written out once per ledger before this existed. The field is named as text__
// __rather than reached with a dot, which is what makes one function serve every__
// __caller: `பதிவு.கணக்கு_குறி` can only ever filter on கணக்கு_குறி.__
செயல் புலத்தால்_வடிகட்டு(பட்டியல், புலம், மதிப்பு) {
    விடை = [];
    ஒவ்வொரு ஒரு_பதிவு இல் பட்டியல் {
        (ஒரு_பதிவு[புலம்] == மதிப்பு) எனில் {
            விடை = இணை(விடை, ஒரு_பதிவு);
        }
    }
    திரும்பு விடை;
}

// __ஒவ்வொன்றுக்கும்(அணி, செயல்) — map: the செயல் applied to every item, in order__
செயல் ஒவ்வொன்றுக்கும்(அணி பட்டியல், செயல் மாற்றம்) அணி {
    விடை = [];
    ஒவ்வொரு உருப்படி இல் பட்டியல் {
        விடை = இணை(விடை, மாற்றம்(உருப்படி));
    }
    திரும்பு விடை;
}

// __வடிகட்டு(அணி, செயல்) — filter: the items the செயல் answers true for__
செயல் வடிகட்டு(அணி பட்டியல், செயல் ஏற்பது) அணி {
    விடை = [];
    ஒவ்வொரு உருப்படி இல் பட்டியல் {
        (ஏற்பது(உருப்படி)) எனில் { விடை = இணை(விடை, உருப்படி); }
    }
    திரும்பு விடை;
}

// __மடி(அணி, தொடக்கம், செயல்) — fold: combine every item into one value,__
// __left to right, starting from தொடக்கம். The செயல் takes what has been__
// __gathered so far and the next item.__
செயல் மடி(அணி பட்டியல், தொடக்கம், செயல் சேர்ப்பது) {
    திரட்டு = தொடக்கம்;
    ஒவ்வொரு உருப்படி இல் பட்டியல் {
        திரட்டு = சேர்ப்பது(திரட்டு, உருப்படி);
    }
    திரும்பு திரட்டு;
}
