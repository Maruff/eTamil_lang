// __nUlakam/cuwkam/cuwkam.qmz — சுங்கம் (customs) and trade documents__
// சுங்கமும் வணிக ஆவணங்களும்
//
// __The centre of this file is the duty cascade, because the order duties are__
// __applied in is the thing implementations get wrong.__
//
// __Basic customs duty is charged on the assessable value. The surcharge is__
// __charged on the duty — not on the value. And IGST is charged on the value__
// __*plus* the duty and the surcharge, not on the value alone. Compute IGST on__
// __the assessable value and every bill of entry understates the tax, by more__
// __the higher the duty rate.__
//
// __No rate is in this file. Duty by tariff heading is set by notification and__
// __amended; rates belong in vari_vikiqam, which is effective-dated for exactly__
// __this reason.__
//
// __சரக்கு, கட்டணம் and விலக்கு are keywords, so the words this module wants are__
// __unavailable alone.__

இறக்கு "../atippatY/kaNiqam.qmz";
இறக்கு "../atippatY/poruL.qmz";
இறக்கு "../atippatY/col.qmz";

// __--- assessable value -----------------------------------------------------__
//
// மதிப்பிடத்தக்க_மதிப்பு(பொருள்_விலை, கப்பற்_கட்டணம், காப்பீட்டுக்_கட்டணம்)
//
// __Duty is charged on the goods delivered to the border, not on the invoice__
// __alone: cost, insurance and freight. An importer who computes duty on the__
// __invoice value alone underpays on every consignment that had to be shipped.__
// மதிப்பிடத்தக்க_மதிப்பு(பொருள்_விலை, கப்பற்_கட்டணம், காப்பீட்டுக்_கட்டணம்) — சுங்கம் கணக்கிடும் அடிப்படை மதிப்பு
செயல் மதிப்பிடத்தக்க_மதிப்பு(பொருள்_விலை, கப்பற்_கட்டணம், காப்பீட்டுக்_கட்டணம்) {
    திரும்பு வட்டமிடு(பொருள்_விலை + கப்பற்_கட்டணம் + காப்பீட்டுக்_கட்டணம், 2);
}

// __--- the cascade ----------------------------------------------------------__
//
// சுங்கக்_கணக்கு(மதிப்பு, அடிப்படை_விகிதம், மேலதிக_விகிதம், ஜிஎஸ்டி_விகிதம்)
//
// __Each duty on the base the law gives it, in order:__
//
//   __basic         on the assessable value__
//   __surcharge     on the basic duty — not on the value__
//   __IGST          on the value plus basic plus surcharge__
//
// __Answers every step, because a bill of entry has to show them separately and__
// __because a total nobody can reconstruct is a total nobody can check.__
// சுங்கக்_கணக்கு(மதிப்பு, அடிப்படை_விகிதம், மேலதிக_விகிதம், ஜிஎஸ்டி_விகிதம்) — வரிகள் ஒன்றன்மேல் ஒன்றாக ஏறும் வரிசைக் கணக்கு
செயல் சுங்கக்_கணக்கு(மதிப்பு, அடிப்படை_விகிதம், மேலதிக_விகிதம், ஜிஎஸ்டி_விகிதம்) {
    அடிப்படைக்_கட்டணம் = வட்டமிடு(சதவீதம்(மதிப்பு, அடிப்படை_விகிதம்), 2);

    // __On the duty, not on the value. This is the step most often written__
    // __against the wrong base, and the answer looks plausible either way.__
    மேலதிகச்_சுங்கம் = வட்டமிடு(சதவீதம்(அடிப்படைக்_கட்டணம், மேலதிக_விகிதம்), 2);

    // __The duty-inclusive value: IGST is charged on what the goods cost to land__
    // __including what has already been charged on them.__
    ஜிஎஸ்டி_அடிப்படை = மதிப்பு + அடிப்படைக்_கட்டணம் + மேலதிகச்_சுங்கம்;
    ஜிஎஸ்டி = வட்டமிடு(சதவீதம்(ஜிஎஸ்டி_அடிப்படை, ஜிஎஸ்டி_விகிதம்), 2);

    மொத்தச்_சுங்கம் = வட்டமிடு(அடிப்படைக்_கட்டணம் + மேலதிகச்_சுங்கம் + ஜிஎஸ்டி, 2);

    திரும்பு {"மதிப்பு": வட்டமிடு(மதிப்பு, 2),
              "அடிப்படை": அடிப்படைக்_கட்டணம்,
              "மேலதிகம்": மேலதிகச்_சுங்கம்,
              "ஜிஎஸ்டி_அடிப்படை": வட்டமிடு(ஜிஎஸ்டி_அடிப்படை, 2),
              "ஜிஎஸ்டி": ஜிஎஸ்டி,
              "மொத்தம்": மொத்தச்_சுங்கம்,
              "இறங்கு_விலை": வட்டமிடு(மதிப்பு + மொத்தச்_சுங்கம், 2)};
}

// __--- tariff headings ------------------------------------------------------__
//
// __தலைப்பு_சரியா(குறியீட்டெண்) — is this a well-formed tariff heading?__
// தலைப்பு_சரியா(குறியீட்டெண்) — இது சரியான வடிவத்தில் உள்ள வரித் தலைப்பா
//
// __A heading is digits, and its length says how specific it is: two for the__
// __chapter, four for the heading, six for the international subheading, eight__
// __for the Indian tariff item. Anything else is not a heading — and a code with__
// __a stray space or dash is the ordinary way a spreadsheet mangles one.__
//
// __Whether a well-formed code *exists* in the tariff is a question for the__
// __tariff, which is data.__
செயல் தலைப்பு_சரியா(குறியீட்டெண்) {
    நீளம்_மதிப்பு = நீளம்(குறியீட்டெண்);
    (நீளம்_மதிப்பு != 2 மற்றும் நீளம்_மதிப்பு != 4
     மற்றும் நீளம்_மதிப்பு != 6 மற்றும் நீளம்_மதிப்பு != 8) எனில் {
        திரும்பு பொய்;
    }
    திரும்பு எண்களே(குறியீட்டெண்);
}

// __எண்களே(பாடம்) — is every character of this string a digit?__
// எண்களே(பாடம்) — இந்தச் சரத்தின் ஒவ்வொரு எழுத்தும் இலக்கமா
//
// __Used on tariff and HS codes, which are digit strings and not numbers: 0810 must keep its leading zero, so it is carried as text and validated here rather than parsed. An empty string answers பொய், because nothing is not a code.__
செயல் எண்களே(பாடம்) {
    இடம்_எண் = 0;
    (இடம்_எண் < நீளம்(பாடம்)) சுற்று {
        எழுத்தொன்று = பாடம்[இடம்_எண்];
        (எழுத்தொன்று < "0" அல்லது எழுத்தொன்று > "9") எனில் { திரும்பு பொய்; }
        இடம்_எண் = இடம்_எண் + 1;
    }
    திரும்பு நீளம்(பாடம்) > 0;
}

// __அத்தியாயம்(குறியீட்டெண்) — the chapter a heading belongs to__
// அத்தியாயம்(குறியீட்டெண்) — இந்தத் தலைப்பு சேரும் அத்தியாயம்
செயல் அத்தியாயம்(குறியீட்டெண்) {
    திரும்பு முதல்_இரண்டு(குறியீட்டெண்);
}

// __பொருந்துமா(குறியீட்டெண், தலைப்புக்_குறி) — does a code fall under a heading?__
// பொருந்துமா(குறியீட்டெண், தலைப்புக்_குறி) — இந்தக் குறியீடு அந்தத் தலைப்பின் கீழ் வருமா
//
// __An eight-digit item falls under its six-digit subheading, its four-digit__
// __heading and its chapter. This is how a rate stated at chapter level is found__
// __for a specific item, and it is a prefix test rather than equality.__
செயல் பொருந்துமா(குறியீட்டெண், தலைப்புக்_குறி) {
    (நீளம்(தலைப்புக்_குறி) > நீளம்(குறியீட்டெண்)) எனில் { திரும்பு பொய்; }
    திரும்பு தொடங்குகிறதா(குறியீட்டெண், தலைப்புக்_குறி);
}

// __--- the e-way bill -------------------------------------------------------__
//
// __தேவையா(மதிப்பு, வரம்புத்_தொகை) — does this consignment need one at all?__
// தேவையா(மதிப்பு, வரம்புத்_தொகை) — இந்தச் சரக்குக்கு வழிச்சீட்டு தேவையா
//
// __Below the threshold there is nothing to generate. The threshold is a state__
// __rule and is passed rather than assumed.__
செயல் தேவையா(மதிப்பு, வரம்புத்_தொகை) {
    திரும்பு மதிப்பு > வரம்புத்_தொகை;
}

// செல்லுபடி_நாட்கள்(தூரம், ஒரு_நாள்_தூரம்)
//
// __Validity is one day per so many kilometres, and always at least one day.__
// __The distance band is a rule and is passed in; what is structural is the__
// __rounding — a journey that spills a single kilometre past a band gets the__
// __extra day, so this rounds up and never down.__
//
// __Rounding down is the failure that matters: a bill that expires while the__
// __lorry is still moving means the goods are in transit without one.__
// செல்லுபடி_நாட்கள்(தூரம், ஒரு_நாள்_தூரம்) — தூரத்திற்கு ஏற்ப வழிச்சீட்டு செல்லுபடியாகும் நாட்கள்
செயல் செல்லுபடி_நாட்கள்(தூரம், ஒரு_நாள்_தூரம்) {
    (ஒரு_நாள்_தூரம் <= 0) எனில் { திரும்பு 1; }
    (தூரம் <= 0) எனில் { திரும்பு 1; }
    நாட்கள் = மேல்(தூரம் / ஒரு_நாள்_தூரம்);
    (நாட்கள் < 1) எனில் { திரும்பு 1; }
    திரும்பு நாட்கள்;
}

// __வழிச்சீட்டு_சரிபார்(விவரங்கள்) — is this complete enough to generate?__
// வழிச்சீட்டு_சரிபார்(விவரங்கள்) — வழிச்சீட்டு உருவாக்கப் போதுமான விவரங்கள் உள்ளனவா
//
// __An e-way bill is refused for a missing field, and finding out at the portal__
// __with a lorry waiting is worse than finding out here. Answers the list of__
// __what is missing rather than a yes or no, because the useful answer to__
// __"is this valid" is "no, and here is what to fix".__
செயல் வழிச்சீட்டு_சரிபார்(விவரங்கள்) {
    குறைகள் = [];

    ஒவ்வொரு தேவைப்_புலம் இல் ["அனுப்புநர்_ஜிஎஸ்டி", "பெறுநர்_ஜிஎஸ்டி",
                                 "தலைப்பு", "மதிப்பு", "தூரம்"] {
        (புலம்_உள்ளதா(விவரங்கள், தேவைப்_புலம்) == பொய்) எனில் {
            குறைகள் = இணை(குறைகள், தேவைப்_புலம் & " இல்லை (missing)");
        }
    }

    தலைப்பு_மதிப்பு = புலம்_அல்லது(விவரங்கள், "தலைப்பு", "");
    (நீளம்(தலைப்பு_மதிப்பு) > 0 மற்றும் தலைப்பு_சரியா(தலைப்பு_மதிப்பு) == பொய்) எனில் {
        குறைகள் = இணை(குறைகள், "தலைப்பு சரியில்லை (not a tariff heading): "
                                & தலைப்பு_மதிப்பு);
    }

    மதிப்பு_மதிப்பு = புலம்_அல்லது(விவரங்கள், "மதிப்பு", 0);
    (மதிப்பு_மதிப்பு <= 0) எனில் {
        குறைகள் = இணை(குறைகள், "மதிப்பு பூஜ்யத்திற்கு மேல் இருக்க வேண்டும் "
                                & "(the value must be positive)");
    }

    // __Part B carries the vehicle. Without it the bill exists and the goods__
    // __may not move, which is a different thing from an invalid bill — so it__
    // __is reported as its own state rather than as an error.__
    வாகனம் = புலம்_அல்லது(விவரங்கள், "வாகனம்", "");

    திரும்பு {"சரியா": நீளம்(குறைகள்) == 0,
              "குறைகள்": குறைகள்,
              "பகுதி_பி_உள்ளதா": நீளம்(வாகனம்) > 0};
}

// __--- GSTIN ----------------------------------------------------------------__
//
// __ஜிஎஸ்டி_எண்_சரியா(எண்) — the shape of a GSTIN__
// ஜிஎஸ்டி_எண்_சரியா(எண்) — ஜிஎஸ்டி எண்ணின் வடிவம் சரியாக உள்ளதா
//
// __Fifteen characters: two digits of state code, ten of PAN, one entity digit,__
// __a letter, and a check character. This checks the shape and the state code__
// __only. The check digit is a published algorithm and worth adding; claiming to__
// __validate a GSTIN without it would be the more dangerous half-measure, so__
// __what this does is named honestly — the shape, not the number.__
செயல் ஜிஎஸ்டி_எண்_சரியா(எண்_மதிப்பு) {
    (நீளம்(எண்_மதிப்பு) != 15) எனில் { திரும்பு பொய்; }
    திரும்பு எண்களே(துண்டு(எண்_மதிப்பு, 0, 2));
}

// __ஜிஎஸ்டி_மாநிலம்(எண்) — the state code a GSTIN begins with__
// ஜிஎஸ்டி_மாநிலம்(எண்) — ஜிஎஸ்டி எண் தொடங்கும் மாநிலக் குறி
செயல் ஜிஎஸ்டி_மாநிலம்(எண்_மதிப்பு) {
    திரும்பு முதல்_இரண்டு(எண்_மதிப்பு);
}

// __முதல்_இரண்டு(குறியீட்டு_உரை) — the leading two characters, or "" if there are not two__
// முதல்_இரண்டு(குறியீட்டு_உரை) — முதல் இரண்டு எழுத்துகள்; இரண்டு இல்லையெனில் வெற்றுச் சரம்
//
// __Both codes this module reads are positional: the first two digits of an HS__
// __code are its chapter, and the first two of a GSTIN are the state. Same slice,__
// __two different questions, and the answer to "which two characters" belongs in__
// __one place.__
செயல் முதல்_இரண்டு(குறியீட்டு_உரை) {
    (நீளம்(குறியீட்டு_உரை) < 2) எனில் { திரும்பு ""; }
    திரும்பு துண்டு(குறியீட்டு_உரை, 0, 2);
}
