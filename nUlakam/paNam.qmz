// __nUlakam/paNam.qmz — பணம் (money) formatting__
//
// __Indian digit grouping: the last three digits, then groups of two, so__
// __12345678.5 reads as 1,23,45,678.50 — not the 12,345,678.50 that a__
// __western formatter would give you.__

இறக்கு "col.qmz";
இறக்கு "kaNiqam.qmz";

// __குழுக்கள்(இலக்கங்கள்) — apply the 3-then-2s grouping to a digit string__
செயல் குழுக்கள்(இலக்கங்கள்) {
    மொத்தம் = நீளம்(இலக்கங்கள்);
    (மொத்தம் <= 3) எனில் { திரும்பு இலக்கங்கள்; }

    விடை = துண்டு(இலக்கங்கள், மொத்தம் - 3, 3);
    மீதம் = துண்டு(இலக்கங்கள், 0, மொத்தம் - 3);

    (நீளம்(மீதம்) > 0) சுற்று {
        எஞ்சியது = நீளம்(மீதம்);
        (எஞ்சியது <= 2) எனில் {
            விடை = மீதம் & "," & விடை;
            மீதம் = "";
        }
        இன்றேல் {
            விடை = துண்டு(மீதம், எஞ்சியது - 2, 2) & "," & விடை;
            மீதம் = துண்டு(மீதம், 0, எஞ்சியது - 2);
        }
    }
    திரும்பு விடை;
}

// __காசு_வடிவம்(தொகை) — group and show exactly two decimal places__
செயல் காசு_வடிவம்(தொகை) {
    வட்டம் = வட்டமிடு(தொகை, 2);

    எதிர்மறை = பொய்;
    (வட்டம் < 0) எனில் {
        எதிர்மறை = மெய்;
        வட்டம் = 0 - வட்டம்;
    }

    முழு = தரை(வட்டம்);
    காசு = வட்டமிடு((வட்டம் - முழு) * 100, 0);

    விடை = குழுக்கள்(சொல்லாக்கு(முழு)) & "." & இடமிருந்து_நிரப்பு(சொல்லாக்கு(காசு), 2, "0");

    (எதிர்மறை) எனில் { திரும்பு "-" & விடை; }
    திரும்பு விடை;
}

// __ரூபாய்(தொகை) — format an amount as rupees, with the sign and Indian digit grouping__
செயல் ரூபாய்(தொகை) {
    திரும்பு "₹" & காசு_வடிவம்(தொகை);
}

// __காசாக(தொகை) — round to the paisa, which is what a ledger stores__
செயல் காசாக(தொகை) {
    திரும்பு வட்டமிடு(தொகை, 2);
}

// __லட்சம்(தொகை) / கோடி(தொகை) — express in lakhs or crores__
செயல் லட்சம்(தொகை) {
    திரும்பு வட்டமிடு(தொகை / 100000, 2);
}

// __கோடி(தொகை) — an amount expressed in crore__
//
// __Ten million to the crore, rounded to two places. The unit Indian financial reporting actually uses: a balance sheet in crore is read at a glance and the same figure in millions is converted in the reader's head, badly.__
செயல் கோடி(தொகை) {
    திரும்பு வட்டமிடு(தொகை / 10000000, 2);
}
