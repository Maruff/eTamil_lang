// __இரண்டை_இணை(முதல், இரண்டாம்) — fuse two rankings, trusting them equally__
// இரு தரவரிசைகளைச் சம நம்பிக்கையுடன் இணைக்கும்

இறக்கு "../coRpiri.qmz";
இறக்கு "../eNNikkY.qmz";
இறக்கு "../coRqEtal.qmz";
இறக்கு "../qaravaricY.qmz";
இறக்கு "../qicYyaZ.qmz";
இறக்கு "../oRRumY.qmz";
இறக்கு "../iNYppu.qmz";
இறக்கு "../matakkY.qmz";
இறக்கு "../quNtAkkam.qmz";
இறக்கு "../kELvi.qmz";
இறக்கு "../aLavItu.qmz";
இறக்கு "../urYyAkkam.qmz";
இறக்கு "../utpoqippu.qmz";

// __The common case, named so the equal weights do not have to be written out__
// __at every call site.__
// வழக்கமான நிலை; சம எடைகளை ஒவ்வொரு இடத்திலும் எழுத வேண்டியதில்லை
அச்சு நீளம்(இரண்டை_இணை([{"குறி": "a", "மதிப்பெண்": 9.1}],
                        [{"குறி": "b", "மதிப்பெண்": 0.82}]));

// __Fusing a ranking with nothing leaves it as it was.__
// ஒன்றுமில்லாததுடன் இணைத்தால் அதுவே
அச்சு நீளம்(இரண்டை_இணை([{"குறி": "a", "மதிப்பெண்": 9.1}], []));
