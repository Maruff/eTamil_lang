பட்டியல் = [{"குறி": "a", "மதிப்பெண்": 1.0},
             {"குறி": "b", "மதிப்பெண்": 4.5},
             {"குறி": "c", "மதிப்பெண்": 2.2}];

// __Descending, because every caller wants the best first and a list sorted__
// __the other way would be reversed at each of them.__
// இறங்கு வரிசை; ஒவ்வொரு அழைப்பாளரும் சிறந்ததையே முதலில் விரும்புகிறார்
ஒவ்வொரு ஒன்று இல் வரிசைப்படுத்து(பட்டியல்) { அச்சு ஒன்று["குறி"]; }
