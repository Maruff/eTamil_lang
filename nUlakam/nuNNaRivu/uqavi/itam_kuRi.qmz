// __இடம்_குறி(பட்டியல், அடையாளப்_புலம், தேடல்) — where an item sits in the list, counting from one__
// ஒரு உருப்படியின் இடம்; இல்லையெனில் ஒன்று குறை

இறக்கு "../coRpiri.qmz";
இறக்கு "../eNNikkY.qmz";
இறக்கு "../coRqEtal.qmz";
இறக்கு "../qaravaricY.qmz";
இறக்கு "../qicYyaZ.qmz";
இறக்கு "../oRRumY.qmz";
இறக்கு "../iNYppu.qmz";
இறக்கு "../matakkY.qmz";
இறக்கு "../quNtAkkam.qmz";
இறக்கு "../kELvi.qmz";
இறக்கு "../aLavItu.qmz";
இறக்கு "../urYyAkkam.qmz";
இறக்கு "../utpoqippu.qmz";

தரவரிசை = [{"குறி": "a", "மதிப்பெண்": 9.0},
             {"குறி": "b", "மதிப்பெண்": 4.0}];

// __From one, because a rank of one is first and every measurement built on it__
// __divides by the rank.__
// ஒன்றிலிருந்து; அளவீடுகள் இடத்தால் வகுக்கின்றன
அச்சு இடம்_குறி(தரவரிசை, "குறி", "a");
அச்சு இடம்_குறி(தரவரிசை, "குறி", "b");

// __Not found is -1, which is distinguishable from every real position.__
// கிடைக்கவில்லையெனில் -1
அச்சு இடம்_குறி(தரவரிசை, "குறி", "z");
