// __nUlakam/nuNNaRivu/eNNikkY.qmz — எண்ணிக்கை, counting terms across documents__
// எண்ணிக்கை: ஆவணங்களில் பதங்களை எண்ணுதல்
//
// __Word-based relevance rests on two counts and nothing else: how often a term__
// __occurs in one document, and how many documents contain it at all. The first__
// __says the document is about the term; the second says whether the term__
// __distinguishes anything. This file produces both and stops there, so that__
// __the scoring in coRqEtal.qmz is a formula over numbers already gathered.__
//
// __An indexed document is a record with a குறி (its identifier) and a பதங்கள்__
// __array of terms, as coRpiri.qmz produces. Nothing here looks at the original__
// __text, which is what lets the same counts serve any tokenizer.__

இறக்கு "../atippatY/aNi.qmz";
இறக்கு "../atippatY/poruL.qmz";

// __ஆவணம்_ஆக்கு(குறி, பதங்கள்_பட்டியல்) — an indexed document__
// ஆவணம்_ஆக்கு(குறி, பதங்கள்_பட்டியல்) — குறியீட்டில் சேர்க்கும் ஓர் ஆவணம்
செயல் ஆவணம்_ஆக்கு(குறி, பதங்கள்_பட்டியல்) {
    திரும்பு { குறி: குறி, பதங்கள்: பதங்கள்_பட்டியல் };
}

// __பத_அதிர்வெண்(பதங்கள்_பட்டியல்) — how many times each term occurs__
// பத_அதிர்வெண்(பதங்கள்_பட்டியல்) — ஒவ்வொரு பதமும் எத்தனை முறை வருகிறது
//
// __A record from term to count. Repeated terms are what separates a document__
// __about arrays from one that mentions an array once in passing, so this__
// __counts rather than deduplicating.__
செயல் பத_அதிர்வெண்(பதங்கள்_பட்டியல்) {
    விடை = {};
    ஒவ்வொரு பதம் இல் பதங்கள்_பட்டியல் {
        (புலம்_உள்ளதா(விடை, பதம்)) எனில் {
            விடை[பதம்] = விடை[பதம்] + 1;
        } இன்றேல் {
            விடை[பதம்] = 1;
        }
    }
    திரும்பு விடை;
}

// __எத்தனை_முறை(அதிர்வெண், பதம்) — the count for one term, or zero__
// எத்தனை_முறை(அதிர்வெண், பதம்) — ஒரு பதத்தின் எண்ணிக்கை; இல்லையெனில் பூஜ்ஜியம்
//
// __Zero rather than an error. A query term absent from a document is the__
// __ordinary case, not a fault, and scoring has to keep going.__
செயல் எத்தனை_முறை(அதிர்வெண், பதம்) {
    திரும்பு புலம்_அல்லது(அதிர்வெண், பதம், 0);
}

// __ஆவண_அதிர்வெண்(ஆவணங்கள்) — how many documents contain each term__
// ஆவண_அதிர்வெண்(ஆவணங்கள்) — ஒவ்வொரு பதமும் எத்தனை ஆவணங்களில் வருகிறது
//
// __Counts documents, not occurrences: a term repeated forty times in one__
// __document still contributes one. That is the whole point of the measure —__
// __it asks how widespread a word is, and a single verbose document should not__
// __be able to make a rare word look common.__
செயல் ஆவண_அதிர்வெண்(ஆவணங்கள்) {
    விடை = {};
    ஒவ்வொரு ஆவணம் இல் ஆவணங்கள் {
        ஒவ்வொரு பதம் இல் தனித்தவை_உள்ளூர்(ஆவணம்.பதங்கள்) {
            (புலம்_உள்ளதா(விடை, பதம்)) எனில் {
                விடை[பதம்] = விடை[பதம்] + 1;
            } இன்றேல் {
                விடை[பதம்] = 1;
            }
        }
    }
    திரும்பு விடை;
}

// __தனித்தவை_உள்ளூர்(பட்டியல்) — distinct values, kept local to this file__
// தனித்தவை_உள்ளூர்(பட்டியல்) — வேறுபட்ட மதிப்புகள்; இக்கோப்புக்கே உரியது
//
// __coRpiri.qmz has தனிப்பதங்கள், but importing it here would tie counting to__
// __a particular tokenizer. Counting should work on any array of terms,__
// __whoever produced them.__
செயல் தனித்தவை_உள்ளூர்(பட்டியல்) {
    விடை = [];
    ஒவ்வொரு உறுப்பு இல் பட்டியல் {
        (உள்ளதா(விடை, உறுப்பு) == பொய்) எனில் {
            விடை = இணை(விடை, உறுப்பு);
        }
    }
    திரும்பு விடை;
}

// __சராசரி_ஆவண_நீளம்(ஆவணங்கள்) — mean term count across the collection__
// சராசரி_ஆவண_நீளம்(ஆவணங்கள்) — தொகுப்பின் சராசரிப் பத எண்ணிக்கை
//
// __Needed so that length can be normalised away. Without it, long documents__
// __win every search simply by containing more words, and the longest file in__
// __a library answers every question.__
செயல் சராசரி_ஆவண_நீளம்(ஆவணங்கள்) {
    மொத்தம் = நீளம்(ஆவணங்கள்);
    (மொத்தம் == 0) எனில் { திரும்பு 0; }
    கூட்டல் = 0;
    ஒவ்வொரு ஆவணம் இல் ஆவணங்கள் {
        கூட்டல் = கூட்டல் + நீளம்(ஆவணம்.பதங்கள்);
    }
    திரும்பு கூட்டல் / மொத்தம்;
}

// __குறியீட்டு_ஆக்கு(ஆவணங்கள்) — everything scoring needs, gathered once__
// குறியீட்டு_ஆக்கு(ஆவணங்கள்) — மதிப்பெண் இடத் தேவையான அனைத்தையும் ஒரே முறை தொகுக்கும்
//
// __Built once and reused for every question. Recomputing document frequencies__
// __per query is the difference between a search that answers while somebody__
// __is still looking at the screen and one that does not.__
செயல் குறியீட்டு_ஆக்கு(ஆவணங்கள்) {
    திரும்பு {
        ஆவணங்கள்: ஆவணங்கள்,
        மொத்த_ஆவணங்கள்: நீளம்(ஆவணங்கள்),
        ஆவண_அதிர்வெண்: ஆவண_அதிர்வெண்(ஆவணங்கள்),
        சராசரி_நீளம்: சராசரி_ஆவண_நீளம்(ஆவணங்கள்)
    };
}
