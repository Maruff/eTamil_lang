// __nUlakam/nErativari/varumAZam.qmz — வருமானம், head by head__
//
// __Income tax is not charged on income. It is charged on **total income**, and__
// __the distance between the two is most of the Act. Money is first sorted into__
// __five heads, each computed by its own rules; losses move between them only__
// __where the statute allows; the result is gross total income; Chapter VI-A__
// __deductions come off that in kazivukaL.qmz; and only then is there an amount__
// __a rate can be applied to.__
//
// __This module does the first two steps. Every statutory figure — the standard__
// __deduction, the thirty per cent on house property, the interest ceiling on a__
// __self-occupied house, the holding period that makes a gain long-term — is a__
// __**parameter**, because every one of them has been amended and a number__
// __written into a library is a number that will be wrong one April.__
//
// __What is *not* a parameter is the architecture: that a long-term capital loss__
// __can only ever meet a long-term capital gain, that a house property loss__
// __stops at a ceiling when it leaves its own head. That is the shape of the__
// __law rather than its dials, and it is what ஈட்டு_விதிகள் encodes.__
//
// __A note on field names. Almost every natural word here is a keyword in this__
// __language — வருமானம், வரி, விலக்கு, இழப்பு, தொகை, நிகர, வாடகை — and a__
// __keyword used as a bare record key is stored under its *token* name, so the__
// __field read back is not the field written. Every record in this directory__
// __therefore uses **quoted** keys and bracket access. It reads a little heavier__
// __and it cannot go silently wrong.__
//
// __Rates are a number out of a hundred: 30% is 30.__

இறக்கு "../atippatY/kaNiqam.qmz";
இறக்கு "../atippatY/poruL.qmz";

// =========================================================================
// __சம்பளம் — salary__
// =========================================================================
//
// சம்பள_வருமானம்(மொத்தச்_சம்பளத்_தொகை, விலக்குப்_பெற்றவை, நியமக்_கழிவு,
//                  தொழில்_வரித்_தொகை)
//
// __Gross salary, less the allowances that are exempt, less the standard__
// __deduction, less professional tax actually paid.__
//
// __The standard deduction is **capped at the salary itself** — the Act says the__
// __stated amount "or the amount of the salary, whichever is less". Someone who__
// __worked one month does not get a negative salary income, and a library that__
// __subtracts the full figure regardless manufactures a loss under a head that__
// __cannot have one.__
செயல் சம்பள_வருமானம்(மொத்தச்_சம்பளத்_தொகை, விலக்குப்_பெற்றவை,
                        நியமக்_கழிவு, தொழில்_வரித்_தொகை) {
    வரிக்குரியது = மொத்தச்_சம்பளத்_தொகை - விலக்குப்_பெற்றவை;
    (வரிக்குரியது <= 0) எனில் { திரும்பு 0; }

    பயன்படும்_கழிவு = சிறியது(நியமக்_கழிவு, வரிக்குரியது);
    விடை = வரிக்குரியது - பயன்படும்_கழிவு - தொழில்_வரித்_தொகை;
    (விடை < 0) எனில் { திரும்பு 0; }
    திரும்பு வட்டமிடு(விடை, 2);
}

// =========================================================================
// __வீட்டுச் சொத்து — house property__
// =========================================================================
//
// நிகர_ஆண்டு_மதிப்பீடு(மொத்த_ஆண்டு_மதிப்பு, செலுத்திய_நகர்_வரி)
//
// __Net annual value is gross annual value less municipal taxes. Two words in__
// __that sentence do the work: **paid**, and **municipal**.__
//
// __Paid, because the deduction is for tax actually borne during the year. A__
// __municipal demand raised and not settled reduces nothing, which makes this__
// __one of the few places in the computation that is not on accrual.__
//
// __Municipal, because the deduction is for the tax on the property and not for__
// __anything else the owner spends on it. Repairs, insurance and collection__
// __charges are not deductible here at all; they are inside the thirty per cent.__
செயல் நிகர_ஆண்டு_மதிப்பீடு(மொத்த_ஆண்டு_மதிப்பு, செலுத்திய_நகர்_வரி) {
    திரும்பு குறையாக்_கழி(மொத்த_ஆண்டு_மதிப்பு, செலுத்திய_நகர்_வரி);
}

// வாடகைச்_சொத்து_வருமானம்(நிகர_ஆண்டு_மதிப்பு, நியம_விகிதம்,
//                           கடன்_வட்டித்_தொகை)
//
// __Net annual value, less a flat percentage of it, less interest on borrowed__
// __capital.__
//
// __The percentage is of **net** annual value, not of gross rent. Taking thirty__
// __per cent of the rent received is the commonest error in this head, and it__
// __overstates the deduction by thirty per cent of the municipal taxes every__
// __time.__
//
// __The flat deduction is unconditional and it is not a reimbursement: an owner__
// __who spent nothing on repairs still gets it, and one who spent more than it__
// __gets no more. It is a statutory estimate, which is why no expense record is__
// __asked for here.__
//
// __The answer may be negative, and that is not an error. A let property whose__
// __interest exceeds its rent produces a loss under this head, and that loss is__
// __real; what happens to it is வீட்டு_இழப்பை_ஈடுசெய்'s business.__
செயல் வாடகைச்_சொத்து_வருமானம்(நிகர_ஆண்டு_மதிப்பு, நியம_விகிதம்,
                                 கடன்_வட்டித்_தொகை) {
    நியமக்_கழிவு = சதவீதம்(நிகர_ஆண்டு_மதிப்பு, நியம_விகிதம்);
    திரும்பு வட்டமிடு(நிகர_ஆண்டு_மதிப்பு - நியமக்_கழிவு - கடன்_வட்டித்_தொகை, 2);
}

// சொந்த_வீட்டு_வருமானம்(கடன்_வட்டித்_தொகை, வட்டி_உச்ச_வரம்பு)
//
// __A house you live in has no gross annual value, so there is nothing for the__
// __flat percentage to apply to and the head can only ever produce a loss —__
// __interest, capped.__
//
// __Pass 0 as the ceiling for none. The answer is negative or zero by__
// __construction, and returning it signed rather than as a magnitude keeps the__
// __arithmetic in மொத்த_வருமானம் honest: a loss that has to be remembered to be__
// __subtracted is a loss that will be added.__
செயல் சொந்த_வீட்டு_வருமானம்(கடன்_வட்டித்_தொகை, வட்டி_உச்ச_வரம்பு) {
    அனுமதித்தது = கடன்_வட்டித்_தொகை;
    (வட்டி_உச்ச_வரம்பு > 0 மற்றும் கடன்_வட்டித்_தொகை > வட்டி_உச்ச_வரம்பு) எனில் {
        அனுமதித்தது = வட்டி_உச்ச_வரம்பு;
    }
    திரும்பு 0 - வட்டமிடு(அனுமதித்தது, 2);
}

// வீட்டு_இழப்பை_ஈடுசெய்(வீட்டு_இழப்புத்_தொகை, ஈட்டு_உச்ச_வரம்பு)
//
// __A house property loss may be set against income under other heads, but only__
// __up to a ceiling; the rest is carried forward, where it may be set only__
// __against house property income.__
//
// __Answers {"ஈடுசெய்தது", "முன்_கொண்டுசெல்வது"} because both halves matter and__
// __the second is the one that gets dropped. A loss that exceeded the ceiling__
// __and was silently truncated is a deduction the assessee is entitled to in a__
// __later year and will never claim.__
//
// __Pass the loss as a positive magnitude.__
செயல் வீட்டு_இழப்பை_ஈடுசெய்(வீட்டு_இழப்புத்_தொகை, ஈட்டு_உச்ச_வரம்பு) {
    (வீட்டு_இழப்புத்_தொகை <= 0) எனில் {
        திரும்பு {"ஈடுசெய்தது": 0, "முன்_கொண்டுசெல்வது": 0};
    }
    இப்போது = வீட்டு_இழப்புத்_தொகை;
    (ஈட்டு_உச்ச_வரம்பு > 0 மற்றும் வீட்டு_இழப்புத்_தொகை > ஈட்டு_உச்ச_வரம்பு) எனில் {
        இப்போது = ஈட்டு_உச்ச_வரம்பு;
    }
    திரும்பு {"ஈடுசெய்தது": வட்டமிடு(இப்போது, 2),
              "முன்_கொண்டுசெல்வது": வட்டமிடு(வீட்டு_இழப்புத்_தொகை - இப்போது, 2)};
}

// =========================================================================
// __மூலதன ஆதாயம் — capital gains__
// =========================================================================
//
// குறுகிய_காலமா(வைத்திருந்த_நாட்கள், எல்லை_நாட்கள்)
//
// __Short-term or long-term is decided by the period of holding alone, and the__
// __threshold differs by asset — twelve months for listed equity, twenty-four__
// __for immovable property, thirty-six for the rest at various times. Hence a__
// __parameter rather than a constant.__
செயல் குறுகிய_காலமா(வைத்திருந்த_நாட்கள், எல்லை_நாட்கள்) {
    திரும்பு வைத்திருந்த_நாட்கள் <= எல்லை_நாட்கள்;
}

// குறியீட்டுச்_செலவு(கொள்முதல்_மதிப்பு, கொள்முதல்_குறியீடு, விற்ற_ஆண்டு_குறியீடு)
//
// __Indexed cost of acquisition: cost × index of the year of transfer ÷ index of__
// __the year of acquisition. Indexation is what makes a long-term gain a gain__
// __rather than a measure of inflation.__
//
// __A zero or missing acquisition index is a தவறு rather than a division that__
// __produces an infinity, and rather than a quiet fallback to unindexed cost —__
// __which would understate the cost, overstate the gain and look perfectly__
// __reasonable on the face of the return.__
//
// __Indexation is not available for every long-term asset: the statute denies it__
// __where a concessional rate applies instead. That is the caller's decision and__
// __this function does not know about it.__
செயல் குறியீட்டுச்_செலவு(கொள்முதல்_மதிப்பு, கொள்முதல்_குறியீடு,
                            விற்ற_ஆண்டு_குறியீடு) {
    (கொள்முதல்_குறியீடு <= 0) எனில் {
        திரும்பு தவறு("கொள்முதல் ஆண்டின் குறியீடு இல்லை  "
                       & "(no cost inflation index for the year of acquisition)");
    }
    திரும்பு சரி(வட்டமிடு(கொள்முதல்_மதிப்பு * விற்ற_ஆண்டு_குறியீடு
                            / கொள்முதல்_குறியீடு, 2));
}

// மூலதன_ஆதாயம்(விற்ற_மதிப்பு, மாற்றல்_செலவுகள், கொள்முதல்_மதிப்பு,
//                மேம்பாட்டுச்_செலவு)
//
// __Full value of consideration, less the expenditure on the transfer, less the__
// __cost of acquisition and of improvement.__
//
// __Transfer expenses come off the consideration and not off the cost. The__
// __difference is invisible in the gain and decisive when the cost is indexed__
// __and the transfer expense is not: brokerage on a sale is a cost of this__
// __year's transaction and has no earlier year to be indexed from.__
செயல் மூலதன_ஆதாயம்(விற்ற_மதிப்பு, மாற்றல்_செலவுகள், கொள்முதல்_மதிப்பு,
                     மேம்பாட்டுச்_செலவு) {
    நிகர_ஈட்டம் = விற்ற_மதிப்பு - மாற்றல்_செலவுகள்;
    திரும்பு வட்டமிடு(நிகர_ஈட்டம் - கொள்முதல்_மதிப்பு - மேம்பாட்டுச்_செலவு, 2);
}

// விலக்கிய_ஆதாயம்(ஆதாயத்_தொகை, விலக்கு_எல்லை)
//
// __The shape of a threshold exemption on a gain: the first slice is not__
// __charged, and the remainder is charged in full. Long-term equity gains are__
// __stated this way.__
//
// __This is a threshold, not a cliff. Everything above the line stays taxable__
// __and nothing below it becomes taxable — the opposite of தகுதிக்குள்_பங்களிப்பு__
// __in Uqiyam.qmz, where crossing the line removes the charge entirely. The two__
// __shapes look alike in a rate table and behave in opposite directions.__
செயல் விலக்கிய_ஆதாயம்(ஆதாயத்_தொகை, விலக்கு_எல்லை) {
    திரும்பு குறையாக்_கழி(ஆதாயத்_தொகை, விலக்கு_எல்லை);
}

// =========================================================================
// __ஈட்டு விதிகள் — which loss may meet which income__
// =========================================================================
//
// __ஈட்டு_விதிகள்() — the restriction table, as pairs of {loss kind, income kind}__
//
// __These are the pairs the statute *permits*. Anything not listed is refused,__
// __which is the right default: a set-off wrongly allowed reduces tax and will__
// __not be questioned by the person it benefits.__
//
// __The asymmetries are the point, and each one is a rule somebody has been__
// __caught by:__
//
//   __A **long-term** capital loss meets only a long-term gain. A short-term__
//   __loss meets either. Loss flows downward from the concessional rate to the__
//   __ordinary one and never back up.__
//
//   __A **speculative** business loss meets only speculative income, and an__
//   __ordinary business loss cannot be set against salary at all. Both__
//   __restrictions exist to stop a manufactured loss from sheltering a salary.__
//
//   __A **house property** loss may go anywhere, subject to the ceiling that__
//   __வீட்டு_இழப்பை_ஈடுசெய் applies.__
//
// __The kinds are strings so that the table is data. The set of kinds is the__
// __law's, not this library's, and extending it is adding rows here.__
செயல் ஈட்டு_விதிகள்() {
    திரும்பு [
        {"இழப்பு_வகை": "வீட்டுச்_சொத்து", "வருமான_வகை": "சம்பளம்"},
        {"இழப்பு_வகை": "வீட்டுச்_சொத்து", "வருமான_வகை": "வீட்டுச்_சொத்து"},
        {"இழப்பு_வகை": "வீட்டுச்_சொத்து", "வருமான_வகை": "தொழில்"},
        {"இழப்பு_வகை": "வீட்டுச்_சொத்து", "வருமான_வகை": "ஊகத்_தொழில்"},
        {"இழப்பு_வகை": "வீட்டுச்_சொத்து", "வருமான_வகை": "குறுகிய_ஆதாயம்"},
        {"இழப்பு_வகை": "வீட்டுச்_சொத்து", "வருமான_வகை": "நீண்ட_ஆதாயம்"},
        {"இழப்பு_வகை": "வீட்டுச்_சொத்து", "வருமான_வகை": "பிற"},

        {"இழப்பு_வகை": "தொழில்", "வருமான_வகை": "வீட்டுச்_சொத்து"},
        {"இழப்பு_வகை": "தொழில்", "வருமான_வகை": "தொழில்"},
        {"இழப்பு_வகை": "தொழில்", "வருமான_வகை": "ஊகத்_தொழில்"},
        {"இழப்பு_வகை": "தொழில்", "வருமான_வகை": "குறுகிய_ஆதாயம்"},
        {"இழப்பு_வகை": "தொழில்", "வருமான_வகை": "நீண்ட_ஆதாயம்"},
        {"இழப்பு_வகை": "தொழில்", "வருமான_வகை": "பிற"},

        {"இழப்பு_வகை": "ஊகத்_தொழில்", "வருமான_வகை": "ஊகத்_தொழில்"},

        {"இழப்பு_வகை": "குறுகிய_ஆதாயம்", "வருமான_வகை": "குறுகிய_ஆதாயம்"},
        {"இழப்பு_வகை": "குறுகிய_ஆதாயம்", "வருமான_வகை": "நீண்ட_ஆதாயம்"},

        {"இழப்பு_வகை": "நீண்ட_ஆதாயம்", "வருமான_வகை": "நீண்ட_ஆதாயம்"},

        {"இழப்பு_வகை": "பிற", "வருமான_வகை": "சம்பளம்"},
        {"இழப்பு_வகை": "பிற", "வருமான_வகை": "வீட்டுச்_சொத்து"},
        {"இழப்பு_வகை": "பிற", "வருமான_வகை": "தொழில்"},
        {"இழப்பு_வகை": "பிற", "வருமான_வகை": "ஊகத்_தொழில்"},
        {"இழப்பு_வகை": "பிற", "வருமான_வகை": "குறுகிய_ஆதாயம்"},
        {"இழப்பு_வகை": "பிற", "வருமான_வகை": "நீண்ட_ஆதாயம்"},
        {"இழப்பு_வகை": "பிற", "வருமான_வகை": "பிற"}
    ];
}

// ஈடுசெய்ய_முடியுமா(இழப்பு_வகை, வருமான_வகை)
// __ஈடுசெய்ய_முடியுமா(இழப்பு_வகை, வருமான_வகை) — may a loss of this head be set off against that head?__
//
// __Consults the rules table rather than encoding them here, because the Act permits some pairings and forbids others for reasons that are policy and not arithmetic — a speculation loss against business income is not allowed, and no principle predicts that.__
செயல் ஈடுசெய்ய_முடியுமா(இழப்பு_வகை, வருமான_வகை) {
    ஒவ்வொரு ஒரு_விதி இல் ஈட்டு_விதிகள்() {
        (ஒரு_விதி["இழப்பு_வகை"] == இழப்பு_வகை
         மற்றும் ஒரு_விதி["வருமான_வகை"] == வருமான_வகை) எனில் {
            திரும்பு மெய்;
        }
    }
    திரும்பு பொய்;
}

// __தலைப்பு_ஆக்கு(வருமான_வகை, தொகை_மதிப்பு) — one head's figure__
//
// __A negative amount is a loss under that head. Keeping both in one shape lets__
// __a computation carry the signs through instead of maintaining a separate list__
// __of losses, which is where the two get out of step.__
செயல் தலைப்பு_ஆக்கு(வருமான_வகை, தொகை_மதிப்பு) {
    திரும்பு {"வருமான_வகை": வருமான_வகை, "தொகை": வட்டமிடு(தொகை_மதிப்பு, 2)};
}

// ஈட்டைச்_செய்(இழப்பு_வகை, இழப்புத்_தொகை, தலைப்புகள்)
//
// __Apply one loss against the heads that will take it, in the order given, and__
// __answer {"தலைப்புகள்", "ஈடுசெய்தது", "எஞ்சியது"}.__
//
// __The order matters and it is the caller's, deliberately. An assessee with a__
// __loss and a choice of income to set it against is better off sheltering the__
// __income taxed at the highest rate, and no library can know which that is__
// __without knowing the whole return. What this guarantees is that nothing__
// __forbidden happens and that the arithmetic reconciles: set off plus remaining__
// __equals the loss you started with.__
//
// __Pass the loss as a positive magnitude.__
செயல் ஈட்டைச்_செய்(இழப்பு_வகை, இழப்புத்_தொகை, தலைப்புகள்) {
    மீதம் = இழப்புத்_தொகை;
    ஈடுசெய்தது = 0;
    விடைத்_தலைப்புகள் = [];

    ஒவ்வொரு ஒரு_தலைப்பு இல் தலைப்புகள் {
        இந்தத்_தொகை = ஒரு_தலைப்பு["தொகை"];
        இந்த_வகை = ஒரு_தலைப்பு["வருமான_வகை"];

        // __Only positive income absorbs a loss, and only where the table says__
        // __this kind of loss may go.__
        (மீதம் > 0 மற்றும் இந்தத்_தொகை > 0
         மற்றும் ஈடுசெய்ய_முடியுமா(இழப்பு_வகை, இந்த_வகை)) எனில் {
            பயன்பட்டது = சிறியது(மீதம், இந்தத்_தொகை);
            இந்தத்_தொகை = வட்டமிடு(இந்தத்_தொகை - பயன்பட்டது, 2);
            மீதம் = வட்டமிடு(மீதம் - பயன்பட்டது, 2);
            ஈடுசெய்தது = வட்டமிடு(ஈடுசெய்தது + பயன்பட்டது, 2);
        }
        விடைத்_தலைப்புகள் = இணை(விடைத்_தலைப்புகள்,
                                 தலைப்பு_ஆக்கு(இந்த_வகை, இந்தத்_தொகை));
    }
    திரும்பு {"தலைப்புகள்": விடைத்_தலைப்புகள்,
              "ஈடுசெய்தது": ஈடுசெய்தது,
              "எஞ்சியது": மீதம்};
}

// =========================================================================
// __மொத்த வருமானம் — gross total income__
// =========================================================================
//
// __மொத்த_வருமானம்(தலைப்புகள்) — the heads added up__
//
// __Losses still sitting in the list are added as the negatives they are, so a__
// __set-off that ஈட்டைச்_செய் refused cannot leak into the total by being__
// __forgotten. Whether a loss *should* still be there is the caller's problem;__
// __this one only refuses to lose it.__
//
// __Gross total income cannot be negative. Where the heads sum below zero the__
// __answer is nil and the losses are carried forward — the Act has no concept of__
// __negative total income, and a negative figure entering the slab engine would__
// __produce a refund out of nothing.__
செயல் மொத்த_வருமானம்(தலைப்புகள்) {
    கூட்டல் = 0;
    ஒவ்வொரு ஒரு_தலைப்பு இல் தலைப்புகள் {
        கூட்டல் = கூட்டல் + ஒரு_தலைப்பு["தொகை"];
    }
    (கூட்டல் < 0) எனில் { திரும்பு 0; }
    திரும்பு வட்டமிடு(கூட்டல், 2);
}

// __தலைப்பைத்_தேடு(தலைப்புகள், வருமான_வகை) — one head's figure, or nil__
//
// __Answers a தவறு when the head is absent rather than zero, because a head with__
// __no income and a head that was never computed are different things and only__
// __one of them is a finished return.__
செயல் தலைப்பைத்_தேடு(தலைப்புகள், வருமான_வகை) {
    ஒவ்வொரு ஒரு_தலைப்பு இல் தலைப்புகள் {
        (ஒரு_தலைப்பு["வருமான_வகை"] == வருமான_வகை) எனில் {
            திரும்பு சரி(ஒரு_தலைப்பு["தொகை"]);
        }
    }
    திரும்பு தவறு("தலைப்பு இல்லை  (no such head in the computation): "
                   & வருமான_வகை);
}

// __இழப்புத்_தலைப்புகள்(தலைப்புகள்) — every head still showing a loss__
//
// __What has to be carried forward, and the list a return cannot be filed__
// __without looking at.__
செயல் இழப்புத்_தலைப்புகள்(தலைப்புகள்) {
    விடை = [];
    ஒவ்வொரு ஒரு_தலைப்பு இல் தலைப்புகள் {
        (ஒரு_தலைப்பு["தொகை"] < 0) எனில் {
            விடை = இணை(விடை, ஒரு_தலைப்பு);
        }
    }
    திரும்பு விடை;
}
