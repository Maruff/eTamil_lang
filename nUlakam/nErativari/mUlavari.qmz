// __nUlakam/nErativari/mUlavari.qmz — மூலவரி, tax deducted at source__
//
// __Tax deducted at source is not a tax. It is a collection mechanism, and the__
// __person it falls on is not the person who owes anything: the payer deducts,__
// __deposits, and is personally liable for the whole amount plus interest if the__
// __deduction was short — while the payee's actual liability may well be nil.__
//
// __That asymmetry is why the arithmetic here is worth getting right. An__
// __under-deduction costs the deductor money that cannot be recovered from__
// __anybody, and an over-deduction costs the payee a year's use of the money and__
// __a refund claim.__
//
// __Three rules do most of the damage.__
//
// __**The threshold is not an exemption.** Once the year's aggregate crosses the__
// __limit, tax is deducted on the **whole aggregate** — including the earlier__
// __payments that were individually below it. Deducting only on the excess is__
// __the commonest error in this whole area, and it is always an under-deduction.__
//
// __**There are two thresholds, and either one triggers.** A single payment__
// __limit and an annual aggregate limit, and a payment can breach the first__
// __while the year is nowhere near the second.__
//
// __**Part of a month is a month.** Interest for late deduction or late payment__
// __is charged by the month, and a single day's delay into a new month costs a__
// __full month's interest. It is charged from the date the tax was deductible,__
// __not from the date it was due to be deposited.__
//
// __Rates, thresholds and the no-PAN floor are all parameters. They are stated__
// __per section and amended constantly; vari_vikiqam.qmz is where they live.__

இறக்கு "../atippatY/kaNiqam.qmz";
இறக்கு "../atippatY/poruL.qmz";

// =========================================================================
// __ஒரு பிரிவு — a section__
// =========================================================================
//
// பிரிவு_ஆக்கு(பிரிவுக்_குறி, விவரம், பிடித்த_வீதம், ஒரு_முறை_எல்லை,
//               ஆண்டு_எல்லை)
//
// __Pass 0 for a threshold that does not exist. A section with neither — tax__
// __deducted on the first rupee — is written with both as 0 and behaves__
// __correctly: பிடிக்க_வேண்டுமா then says yes to any positive payment.__
செயல் பிரிவு_ஆக்கு(பிரிவுக்_குறி, விவரம், பிடித்த_வீதம், ஒரு_முறை_எல்லை,
                     ஆண்டு_எல்லை) {
    திரும்பு {"பிரிவு": பிரிவுக்_குறி,
              "விவரம்": விவரம்,
              "வீதம்": பிடித்த_வீதம்,
              "ஒரு_முறை_எல்லை": ஒரு_முறை_எல்லை,
              "ஆண்டு_எல்லை": ஆண்டு_எல்லை};
}

// =========================================================================
// __எப்போது பிடிக்க வேண்டும் — when to deduct__
// =========================================================================
//
// பிடிக்க_வேண்டுமா(ஒரு_பிரிவு, இந்தத்_தொகை, முன்பு_செலுத்தியது)
//
// __முன்பு_செலுத்தியது is what has already been paid to this payee under this__
// __section this year, before the payment being considered.__
//
// __Either threshold triggers, and the aggregate one is tested **including** the__
// __current payment. A year of eight payments of twenty thousand under a section__
// __with a single-payment limit of thirty thousand and an annual limit of a lakh__
// __crosses on the sixth, not on any single one of them.__
செயல் பிடிக்க_வேண்டுமா(ஒரு_பிரிவு, இந்தத்_தொகை, முன்பு_செலுத்தியது) {
    (இந்தத்_தொகை <= 0) எனில் { திரும்பு பொய்; }

    ஒரு_முறை = ஒரு_பிரிவு["ஒரு_முறை_எல்லை"];
    ஆண்டு = ஒரு_பிரிவு["ஆண்டு_எல்லை"];

    // __No thresholds at all: deduct on everything.__
    (ஒரு_முறை <= 0 மற்றும் ஆண்டு <= 0) எனில் { திரும்பு மெய்; }

    (ஒரு_முறை > 0 மற்றும் இந்தத்_தொகை > ஒரு_முறை) எனில் { திரும்பு மெய்; }
    (ஆண்டு > 0 மற்றும் முன்பு_செலுத்தியது + இந்தத்_தொகை > ஆண்டு) எனில் {
        திரும்பு மெய்;
    }
    திரும்பு பொய்;
}

// பிடித்த_அடிப்படை(ஒரு_பிரிவு, இந்தத்_தொகை, முன்பு_செலுத்தியது,
//                    முன்பு_பிடித்தது)
//
// __What this payment's deduction is computed on — and it is not always this__
// __payment.__
//
// __When the annual aggregate is what has just been crossed, the base is the__
// __**whole aggregate to date**, and credit is given for whatever was already__
// __deducted. So the payment that crosses the line carries the deduction for__
// __every payment before it, and a twenty-thousand rupee invoice can attract tax__
// __on a lakh and twenty thousand. Deductors who bill monthly meet this once a__
// __year, in the month it happens, and it is never a welcome surprise.__
//
// __முன்பு_பிடித்தது is what has already been deducted this year under this__
// __section, so that a year which crossed the single-payment limit earlier does__
// __not pay twice on the same money.__
செயல் பிடித்த_அடிப்படை(ஒரு_பிரிவு, இந்தத்_தொகை, முன்பு_செலுத்தியது,
                         முன்பு_பிடித்தது) {
    (இல்லை பிடிக்க_வேண்டுமா(ஒரு_பிரிவு, இந்தத்_தொகை, முன்பு_செலுத்தியது)) எனில் {
        திரும்பு {"அடிப்படை": 0, "முழு_ஆண்டா": பொய்};
    }

    ஆண்டு = ஒரு_பிரிவு["ஆண்டு_எல்லை"];
    ஒரு_முறை = ஒரு_பிரிவு["ஒரு_முறை_எல்லை"];

    // __The aggregate limit is breached, so the whole year is in charge. This__
    // __also covers the case where it was breached in an earlier payment: the__
    // __credit for முன்பு_பிடித்தது is what keeps that from double counting.__
    (ஆண்டு > 0 மற்றும் முன்பு_செலுத்தியது + இந்தத்_தொகை > ஆண்டு) எனில் {
        திரும்பு {"அடிப்படை": வட்டமிடு(முன்பு_செலுத்தியது + இந்தத்_தொகை, 2),
                  "முழு_ஆண்டா": மெய்,
                  "முன்பு_பிடித்தது": முன்பு_பிடித்தது};
    }

    // __Only the single-payment limit is breached: this payment alone.__
    (ஒரு_முறை > 0 மற்றும் இந்தத்_தொகை > ஒரு_முறை) எனில் {
        திரும்பு {"அடிப்படை": வட்டமிடு(இந்தத்_தொகை, 2), "முழு_ஆண்டா": பொய்};
    }

    திரும்பு {"அடிப்படை": வட்டமிடு(இந்தத்_தொகை, 2), "முழு_ஆண்டா": பொய்};
}

// =========================================================================
// __வீதம் — the rate that applies__
// =========================================================================
//
// பயன்படும்_வீதம்(பிரிவு_வீதம், பான்_உள்ளதா, பான்_இல்லா_தளம்,
//                  சான்று_உள்ளதா, சான்று_வீதம்)
//
// __Three things can change a section's rate, and they do not compose the way__
// __you would guess.__
//
// __**No PAN** (section 206AA) means the higher of the section rate and a__
// __statutory floor. Higher, not the floor — a section whose rate already__
// __exceeds the floor is unaffected, and replacing its rate with the floor would__
// __be an under-deduction.__
//
// __**A certificate** under section 197 for lower or nil deduction replaces the__
// __rate entirely, including with zero.__
//
// __A certificate does not survive a missing PAN. The floor applies regardless,__
// __which is the one interaction between the two, and the reason the order here__
// __is certificate first and floor second rather than the other way round.__
செயல் பயன்படும்_வீதம்(பிரிவு_வீதம், பான்_உள்ளதா, பான்_இல்லா_தளம்,
                        சான்று_உள்ளதா, சான்று_வீதம்) {
    பயன்_வீதம் = பிரிவு_வீதம்;
    (சான்று_உள்ளதா) எனில் { பயன்_வீதம் = சான்று_வீதம்; }

    (இல்லை பான்_உள்ளதா) எனில் {
        (பான்_இல்லா_தளம் > பயன்_வீதம்) எனில் { பயன்_வீதம் = பான்_இல்லா_தளம்; }
    }
    திரும்பு பயன்_வீதம்;
}

// வரி_நீக்கிய_அடிப்படை(விலைப்பட்டியல்_மொத்தம், வணிகவரித்_தொகை, நீக்கவா)
//
// __Whether tax is deducted on the invoice including GST or excluding it depends__
// __on the section, and where the GST is shown separately the department's own__
// __circular says to exclude it. Where it is not shown separately there is__
// __nothing to exclude and the whole invoice is the base.__
//
// __A flag rather than an inference, because "shown separately" is a fact about__
// __the document and not about the numbers.__
செயல் வரி_நீக்கிய_அடிப்படை(விலைப்பட்டியல்_மொத்தம், வணிகவரித்_தொகை, நீக்கவா) {
    (இல்லை நீக்கவா) எனில் { திரும்பு வட்டமிடு(விலைப்பட்டியல்_மொத்தம், 2); }
    விடை = விலைப்பட்டியல்_மொத்தம் - வணிகவரித்_தொகை;
    (விடை < 0) எனில் { திரும்பு 0; }
    திரும்பு வட்டமிடு(விடை, 2);
}

// =========================================================================
// __பிடித்தம் — the deduction__
// =========================================================================
//
// பிடித்தத்_தொகை(ஒரு_பிரிவு, இந்தத்_தொகை, முன்பு_செலுத்தியது,
//                  முன்பு_பிடித்தது, பயன்_வீதம்)
//
// __The whole thing for one payment. Answers {"அடிப்படை", "வீதம்", "பிடித்தம்",__
// "முழு_ஆண்டா"}.
//
// __The credit for earlier deductions is taken **after** the rate is applied to__
// __the aggregate, not before — so the answer is the tax on the year to date__
// __less the tax already taken, and never negative. A year in which the rate__
// __fell mid-year can produce a computed liability lower than what has already__
// __been deducted, and the answer to that is to deduct nothing further, not to__
// __refund from the payer's own pocket.__
செயல் பிடித்தத்_தொகை(ஒரு_பிரிவு, இந்தத்_தொகை, முன்பு_செலுத்தியது,
                       முன்பு_பிடித்தது, பயன்_வீதம்) {
    விவரங்கள் = பிடித்த_அடிப்படை(ஒரு_பிரிவு, இந்தத்_தொகை,
                                  முன்பு_செலுத்தியது, முன்பு_பிடித்தது);
    அடிப்படை_மதிப்பு = விவரங்கள்["அடிப்படை"];
    (அடிப்படை_மதிப்பு <= 0) எனில் {
        திரும்பு {"அடிப்படை": 0, "வீதம்": பயன்_வீதம், "பிடித்தம்": 0,
                  "முழு_ஆண்டா": பொய்};
    }

    கணக்கிட்டது = சதவீதம்(அடிப்படை_மதிப்பு, பயன்_வீதம்);
    (விவரங்கள்["முழு_ஆண்டா"]) எனில் {
        கணக்கிட்டது = கணக்கிட்டது - முன்பு_பிடித்தது;
    }
    (கணக்கிட்டது < 0) எனில் { கணக்கிட்டது = 0; }

    திரும்பு {"அடிப்படை": அடிப்படை_மதிப்பு,
              "வீதம்": பயன்_வீதம்,
              "பிடித்தம்": வட்டமிடு(கணக்கிட்டது, 2),
              "முழு_ஆண்டா": விவரங்கள்["முழு_ஆண்டா"]};
}

// ஆண்டுப்_பிடித்தம்(ஒரு_பிரிவு, செலுத்தல்கள், பயன்_வீதம்)
//
// __A whole year of payments to one payee, run in order, so that the payment__
// __which crosses the aggregate carries the catch-up. Answers each payment's__
// __deduction and the year's totals.__
//
// __Running the year is the only way to get this right. Applying the rate to the__
// __year's total at the end gives the same grand total and the wrong month for__
// __every deduction, and the month is what the quarterly return and the interest__
// __computation are about.__
செயல் ஆண்டுப்_பிடித்தம்(ஒரு_பிரிவு, செலுத்தல்கள், பயன்_வீதம்) {
    ஓடும்_செலுத்தல் = 0;
    ஓடும்_பிடித்தம் = 0;
    வரிசைகள் = [];

    ஒவ்வொரு ஒரு_தொகை இல் செலுத்தல்கள் {
        விளைவு = பிடித்தத்_தொகை(ஒரு_பிரிவு, ஒரு_தொகை, ஓடும்_செலுத்தல்,
                                 ஓடும்_பிடித்தம், பயன்_வீதம்);
        வரிசைகள் = இணை(வரிசைகள், {"செலுத்திய_தொகை": ஒரு_தொகை,
                                    "அடிப்படை": விளைவு["அடிப்படை"],
                                    "பிடித்தம்": விளைவு["பிடித்தம்"],
                                    "முழு_ஆண்டா": விளைவு["முழு_ஆண்டா"]});
        ஓடும்_செலுத்தல் = வட்டமிடு(ஓடும்_செலுத்தல் + ஒரு_தொகை, 2);
        ஓடும்_பிடித்தம் = வட்டமிடு(ஓடும்_பிடித்தம் + விளைவு["பிடித்தம்"], 2);
    }

    திரும்பு {"வரிசைகள்": வரிசைகள்,
              "மொத்தச்_செலுத்தல்": ஓடும்_செலுத்தல்,
              "மொத்தப்_பிடித்தம்": ஓடும்_பிடித்தம்};
}

// =========================================================================
// __தாமதம் — interest for default__
// =========================================================================
//
// முழு_மாதங்கள்(நாட்களின்_எண்ணிக்கை)
//
// __Part of a month counts as a whole month, so twenty-eight days is one month__
// __and thirty-two is two. This is the rule that makes a one-day delay cost a__
// __month's interest.__
//
// __It divides by thirty and rounds up, which is right whenever the delay is__
// __counted in days. Where real dates are available the statute counts__
// __**calendar** months, and February will disagree with this by a day — so a__
// __caller holding dates should count the calendar months itself and pass the__
// __interest functions that number instead.__
செயல் முழு_மாதங்கள்(நாட்களின்_எண்ணிக்கை) {
    திரும்பு வட்ட_மாதங்கள்(நாட்களின்_எண்ணிக்கை);
}

// பிடிக்காத_வட்டி(பிடிக்க_வேண்டியது, மாத_வீதம், மாதங்கள்)
//
// __Interest for failing to deduct, at the lower monthly rate, running from the__
// __date the tax was **deductible** — not from the date it would have been due__
// __for deposit. The clock starts at the invoice, and a deductor who discovers__
// __the default a year later owes twelve months.__
செயல் பிடிக்காத_வட்டி(பிடிக்க_வேண்டியது, மாத_வீதம், மாதங்கள்) {
    திரும்பு வட்டித்_தொகை(பிடிக்க_வேண்டியது, மாத_வீதம், மாதங்கள்);
}

// செலுத்தாத_வட்டி(பிடித்த_தொகை, மாத_வீதம், மாதங்கள்)
//
// __Interest for deducting and not depositing, at the higher monthly rate. The__
// __rate is higher because the money is the government's and is being held: this__
// __is not a late payment of the deductor's own liability but a failure to hand__
// __over somebody else's tax.__
செயல் செலுத்தாத_வட்டி(பிடித்த_தொகை, மாத_வீதம், மாதங்கள்) {
    திரும்பு வட்டித்_தொகை(பிடித்த_தொகை, மாத_வீதம், மாதங்கள்);
}

// =========================================================================
// __சம்பளப் பிடித்தம் — TDS on salary__
// =========================================================================
//
// சம்பள_பிடித்தம்(ஆண்டு_வரி, மீதி_மாதங்கள், ஏற்கனவே_பிடித்தது)
//
// __Salary is the one section where the deduction is not a percentage of the__
// __payment. The employer estimates the employee's tax for the whole year and__
// __spreads what is left of it over the months remaining, so the rate is__
// __whatever that division produces and changes whenever the estimate does.__
//
// __Which is why a mid-year change — a declared investment, a bonus, a switch of__
// __regime — changes every remaining month rather than being settled in one.__
// __The last month absorbs the rounding, the same way the last instalment of a__
// __loan does; that is the caller's business, and re-running this each month__
// __with the current estimate produces it naturally.__
செயல் சம்பள_பிடித்தம்(ஆண்டு_வரி, மீதி_மாதங்கள், ஏற்கனவே_பிடித்தது) {
    (மீதி_மாதங்கள் <= 0) எனில் { திரும்பு 0; }
    மீதி_வரி = ஆண்டு_வரி - ஏற்கனவே_பிடித்தது;
    (மீதி_வரி <= 0) எனில் { திரும்பு 0; }
    திரும்பு வட்டமிடு(மீதி_வரி / மீதி_மாதங்கள், 2);
}

// __வட்டித்_தொகை(அடிப்படை, மாத_வீதம், மாதங்கள்) — simple interest, by the month__
//
// __Both s.201(1A) interests are this; what differs between them is the rate the__
// __caller passes and the date the months are counted from, which is the__
// __caller's business and not the arithmetic's.__
செயல் வட்டித்_தொகை(அடிப்படை, மாத_வீதம், மாதங்கள்) {
    (அடிப்படை <= 0 அல்லது மாதங்கள் <= 0) எனில் { திரும்பு 0; }
    திரும்பு வட்டமிடு(சதவீதம்(அடிப்படை, மாத_வீதம்) * மாதங்கள், 2);
}
