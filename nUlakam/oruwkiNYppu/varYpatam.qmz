// __nUlakam/oruwkiNYppu/varYpatam.qmz — வரைபடம் (mapping tasks to Azure DevOps work items)__
// பணிகளை அஜூர் டெவ்ஆப்ஸ் பணியுருப்படிகளாக வரைதல்
//
// __A PMO task and an Azure DevOps work item describe the same piece of work in__
// __two vocabularies, and every integration is mostly a dictionary between them:__
// __which status is which state, which priority is which number, which kind of__
// __task becomes which work-item type.__
//
// __States are the hard part, because they are not fixed. Every Azure DevOps__
// __process — Agile, Scrum, CMMI, or a team's own inherited one — names its__
// __states differently, but every state belongs to one of five fixed__
// __categories: Proposed, InProgress, Resolved, Completed and Removed. So the__
// __outbound map tries a short list of likely names and falls back to the__
// __category, and the inbound map reads the category and ignores the name. A__
// __team that renames "Active" to "Doing" breaks neither direction.__
//
// __Task statuses are the five in qittam/paNi.qmz. A work-item type's states are__
// __passed as Azure DevOps returns them from__
// ___apis/wit/workitemtypes/{type}/states: records with "name" and "category".__

இறக்கு "../atippatY/kaNiqam.qmz";
இறக்கு "../atippatY/col.qmz";

// __வெளி_நிலை_வேட்பாளர்கள்(பணி_நிலை) — the state names to try, in order, for a task status__
// வெளி_நிலை_வேட்பாளர்கள்(பணி_நிலை) — ஒரு பணி நிலைக்கு முயல வேண்டிய வெளி நிலைப் பெயர்கள்
//
// __The first name the work-item type actually has wins. The lists cover the__
// __stock processes and the "Ready for …" states teams add for a test gate. An__
// __unknown status has no candidates, and வெளி_நிலை then falls back on category.__
செயல் வெளி_நிலை_வேட்பாளர்கள்(பணி_நிலை) {
    (பணி_நிலை == "செய்யவேண்டியது") எனில் { திரும்பு ["New", "To Do", "Proposed", "Active"]; }
    (பணி_நிலை == "நடப்பில்") எனில் { திரும்பு ["Under Development", "In Progress", "Doing", "Active", "Committed"]; }
    (பணி_நிலை == "தீர்ந்தது") எனில் { திரும்பு ["Ready for UAT", "Resolved", "Ready for QA", "Ready for Prod"]; }
    (பணி_நிலை == "மூடியது") எனில் { திரும்பு ["Closed", "Done", "Completed"]; }
    (பணி_நிலை == "கைவிட்டது") எனில் { திரும்பு ["Removed", "Deferred", "Cut"]; }
    திரும்பு [];
}

// __நிலையின்_வகைமை(பணி_நிலை) — the Azure DevOps state category a task status belongs to__
// நிலையின்_வகைமை(பணி_நிலை) — பணி நிலைக்குரிய அஜூர் நிலை வகைமை
செயல் நிலையின்_வகைமை(பணி_நிலை) {
    (பணி_நிலை == "செய்யவேண்டியது") எனில் { திரும்பு "Proposed"; }
    (பணி_நிலை == "தீர்ந்தது") எனில் { திரும்பு "Resolved"; }
    (பணி_நிலை == "மூடியது") எனில் { திரும்பு "Completed"; }
    (பணி_நிலை == "கைவிட்டது") எனில் { திரும்பு "Removed"; }
    திரும்பு "InProgress";
}

// __வெளி_நிலை(பணி_நிலை, வகையின்_நிலைகள்) — the state to send for a task status__
// வெளி_நிலை(பணி_நிலை, வகையின்_நிலைகள்) — ஒரு பணி நிலைக்கு அனுப்ப வேண்டிய வெளி நிலை
//
// __The first candidate name the type has; failing that, the type's first state__
// __in the status's category; failing that, தவறு. The last case is real — a__
// __type with no Resolved state cannot represent "resolved" at all — and the__
// __error names the status so someone can add a state or change the map.__
செயல் வெளி_நிலை(பணி_நிலை, வகையின்_நிலைகள்) {
    ஒவ்வொரு பெயர் இல் வெளி_நிலை_வேட்பாளர்கள்(பணி_நிலை) {
        ஒவ்வொரு ஒரு_நிலை இல் வகையின்_நிலைகள் {
            (ஒரு_நிலை["name"] == பெயர்) எனில் { திரும்பு சரி(பெயர்); }
        }
    }
    வகைமை = நிலையின்_வகைமை(பணி_நிலை);
    ஒவ்வொரு ஒரு_நிலை இல் வகையின்_நிலைகள் {
        (ஒரு_நிலை["category"] == வகைமை) எனில் { திரும்பு சரி(ஒரு_நிலை["name"]); }
    }
    திரும்பு தவறு(பணி_நிலை & " நிலைக்கு இவ்வகையில் பொருந்தும் நிலை இல்லை  (this work-item type has no state for "
                   & பணி_நிலை & ", category " & வகைமை & ")");
}

// __உள்_நிலை(வெளி_நிலைப்_பெயர், வகைமை) — the task status for a state that came in__
// உள்_நிலை(வெளி_நிலைப்_பெயர், வகைமை) — வந்த வெளி நிலைக்குரிய பணி நிலை
//
// __Read from the category, with one exception: an InProgress state whose name__
// __begins "Ready" is a test gate and counts as resolved, because teams add__
// __"Ready for UAT" under InProgress so that their board shows it as work still__
// __in hand. Only under InProgress — a backlog state called "Ready" under__
// __Proposed means refined and waiting, and stays to do. Anything unrecognised is__
// __in progress — someone is doing something to it, the least wrong guess.__
செயல் உள்_நிலை(வெளி_நிலைப்_பெயர், வகைமை) {
    (வகைமை == "InProgress" மற்றும் தொடங்குகிறதா(வெளி_நிலைப்_பெயர், "Ready")) எனில் {
        திரும்பு "தீர்ந்தது";
    }
    (வகைமை == "Proposed") எனில் { திரும்பு "செய்யவேண்டியது"; }
    (வகைமை == "Resolved") எனில் { திரும்பு "தீர்ந்தது"; }
    (வகைமை == "Completed") எனில் { திரும்பு "மூடியது"; }
    (வகைமை == "Removed") எனில் { திரும்பு "கைவிட்டது"; }
    திரும்பு "நடப்பில்";
}

// __முன்னுரிமை_எண்(முன்னுரிமை) — a task priority as Microsoft.VSTS.Common.Priority__
// முன்னுரிமை_எண்(முன்னுரிமை) — முன்னுரிமையை அஜூர் எண்ணாக்கும்
//
// __மிக_உயர் 1, உயர் 2, நடுத்தர 3, குறைவு 4. Unset or unknown is 3: sending 1__
// __for a priority nobody chose would put it at the top of someone's board.__
செயல் முன்னுரிமை_எண்(முன்னுரிமை) {
    (முன்னுரிமை == "மிக_உயர்") எனில் { திரும்பு 1; }
    (முன்னுரிமை == "உயர்") எனில் { திரும்பு 2; }
    (முன்னுரிமை == "குறைவு") எனில் { திரும்பு 4; }
    திரும்பு 3;
}

// __எண்ணிலிருந்து_முன்னுரிமை(அஜூர்_எண்) — Microsoft.VSTS.Common.Priority as a task priority__
// எண்ணிலிருந்து_முன்னுரிமை(அஜூர்_எண்) — அஜூர் எண்ணை முன்னுரிமையாக்கும்
செயல் எண்ணிலிருந்து_முன்னுரிமை(அஜூர்_எண்) {
    (அஜூர்_எண் == 1) எனில் { திரும்பு "மிக_உயர்"; }
    (அஜூர்_எண் == 2) எனில் { திரும்பு "உயர்"; }
    (அஜூர்_எண் == 4) எனில் { திரும்பு "குறைவு"; }
    திரும்பு "நடுத்தர";
}

// __வகை_விதி_ஆக்கு(பொருத்தப்_புலம், பொருத்த_மதிப்பு, பணியுருப்படி_வகை, வரிசை_எண்) — one work-item type rule__
// வகை_விதி_ஆக்கு(பொருத்தப்_புலம், பொருத்த_மதிப்பு, பணியுருப்படி_வகை, வரிசை_எண்) — பணியுருப்படி வகைக்கான ஒரு விதி
//
// __"A record whose பொருத்தப்_புலம் equals பொருத்த_மதிப்பு becomes a__
// __பணியுருப்படி_வகை." An empty பொருத்தப்_புலம் matches everything and is the__
// __default. Lower வரிசை_எண் is tried first, so the default takes the largest.__
செயல் வகை_விதி_ஆக்கு(பொருத்தப்_புலம், பொருத்த_மதிப்பு, பணியுருப்படி_வகை, வரிசை_எண்) {
    திரும்பு { பொருத்தப்_புலம்: பொருத்தப்_புலம், பொருத்த_மதிப்பு: பொருத்த_மதிப்பு,
              பணியுருப்படி_வகை: பணியுருப்படி_வகை, வரிசை_எண்: வரிசை_எண் };
}

// __பணியுருப்படி_வகை(விதிகள், ஒரு_பதிவு) — the work-item type a record becomes__
// பணியுருப்படி_வகை(விதிகள், ஒரு_பதிவு) — ஒரு பதிவு எந்தப் பணியுருப்படி வகையாகும்
//
// __The first rule, by வரிசை_எண், that matches. With no default rule and no__
// __match it is தவறு, because guessing a type creates the item in the wrong__
// __place on the board and moving it later loses its history.__
செயல் பணியுருப்படி_வகை(விதிகள், ஒரு_பதிவு) {
    ஒவ்வொரு ஒரு_விதி இல் புலத்தால்_வரிசையாக்கு(விதிகள், "வரிசை_எண்", பொய்) {
        (ஒரு_விதி.பொருத்தப்_புலம் == "") எனில் { திரும்பு சரி(ஒரு_விதி.பணியுருப்படி_வகை); }
        (புலம்_அல்லது(ஒரு_பதிவு, ஒரு_விதி.பொருத்தப்_புலம், இன்மை) == ஒரு_விதி.பொருத்த_மதிப்பு) எனில் {
            திரும்பு சரி(ஒரு_விதி.பணியுருப்படி_வகை);
        }
    }
    திரும்பு தவறு("பொருந்தும் பணியுருப்படி வகை இல்லை  (no work-item type rule matches)");
}

// __மணியிலிருந்து_நிறைவு(முடிந்த_மணி, மீதி_மணி) — percentage complete from CompletedWork and RemainingWork__
// மணியிலிருந்து_நிறைவு(முடிந்த_மணி, மீதி_மணி) — முடிந்த, மீதி மணிகளிலிருந்து நிறைவு
//
// __Azure DevOps has no percentage field; the team records hours done and hours__
// __left, and the percentage is done ÷ (done + left). With RemainingWork empty__
// __there is no figure, and இன்மை says so: hours logged against a blank remainder__
// __would otherwise read as 100%, finished, when nobody said how much is left.__
// __An empty CompletedWork beside a real remainder is work not yet started, 0.__
செயல் மணியிலிருந்து_நிறைவு(முடிந்த_மணி, மீதி_மணி) {
    (மீதி_மணி == இன்மை அல்லது மீதி_மணி == "") எனில் { திரும்பு இன்மை; }
    முடிந்தவை = முடிந்த_மணி;
    (முடிந்தவை == இன்மை அல்லது முடிந்தவை == "") எனில் { முடிந்தவை = 0; }
    மொத்தம் = முடிந்தவை + மீதி_மணி;
    (மொத்தம் <= 0) எனில் { திரும்பு இன்மை; }
    திரும்பு வட்டமிடு(முடிந்தவை * 100 / மொத்தம், 0);
}
