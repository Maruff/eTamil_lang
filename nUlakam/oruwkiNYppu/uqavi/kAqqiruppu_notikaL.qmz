// __காத்திருப்பு_நொடிகள்(முயற்சிகள், நடுக்கம், மீண்டும்_முயல்_நொடிகள்) — how long to wait before the next attempt__
// அடுத்த முயற்சிக்கு முன் காத்திருக்கும் நொடிகள்

இறக்கு "../mItci.qmz";

// __Two to the power of the attempts already made, with a jitter of 1: 2, 4, 8.__
// ஏற்கனவே செய்த முயற்சிகளுக்கு இரண்டின் அடுக்கு
அச்சு காத்திருப்பு_நொடிகள்(1, 1, 0);
அச்சு காத்திருப்பு_நொடிகள்(2, 1, 0);
அச்சு காத்திருப்பு_நொடிகள்(3, 1, 0);

// __The jitter spreads clients out: 8 seconds times 0.9 is 7, times 1.2 is 10.__
// நடுக்கம் வாடிக்கையாளர்களைப் பரவலாக்கும்
அச்சு காத்திருப்பு_நொடிகள்(3, 0.9, 0);
அச்சு காத்திருப்பு_நொடிகள்(3, 1.2, 0);

// __A jitter outside 0.7 to 1.3 is held to it, so a slip that passed 0 or 5__
// __gives 6 or 10 seconds, not a hammer or a stall.__
// 0.7–1.3-க்கு வெளியே உள்ள நடுக்கம் அதற்குள் கட்டுப்படுத்தப்படும்
அச்சு காத்திருப்பு_நொடிகள்(3, 0, 0);
அச்சு காத்திருப்பு_நொடிகள்(3, 5, 0);

// __Retry-After wins over all of it: the service has said when.__
// சேவை சொன்ன காத்திருப்பு எல்லாவற்றையும் வெல்லும்; சேவையே நேரம் சொல்லிவிட்டது
அச்சு காத்திருப்பு_நொடிகள்(3, 1.2, 30);
