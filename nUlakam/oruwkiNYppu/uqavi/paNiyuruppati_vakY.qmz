// __பணியுருப்படி_வகை(விதிகள், ஒரு_பதிவு) — the work-item type a record becomes__
// ஒரு பதிவு எந்தப் பணியுருப்படி வகையாகும்

இறக்கு "../varYpatam.qmz";

// __Listed out of order on purpose: the order number decides, not the list.__
// வேண்டுமென்றே வரிசை மாற்றிப் பட்டியலிட்டது; வரிசை எண்ணே தீர்மானிக்கும்
விதிகள் = [
    வகை_விதி_ஆக்கு("", "", "Task", 999),
    வகை_விதி_ஆக்கு("பணி_வகை", "பிழை", "Bug", 10),
    வகை_விதி_ஆக்கு("பணி_வகை", "மைல்கல்", "Feature", 20)
];
அச்சு பணியுருப்படி_வகை(விதிகள், { "தலைப்பு": "உள்நுழைவுப் பிழை", "பணி_வகை": "பிழை" });
அச்சு பணியுருப்படி_வகை(விதிகள், { "தலைப்பு": "முதல் வெளியீடு", "பணி_வகை": "மைல்கல்" });

// __A record with no பணி_வகை at all falls to the default.__
// பணி_வகை இல்லாத பதிவு இயல்பு விதிக்குச் செல்லும்
அச்சு பணியுருப்படி_வகை(விதிகள், { "தலைப்பு": "கூட்டக் குறிப்பு" });

// __Without a default, no match is an error rather than a guess: an item made__
// __as the wrong type sits in the wrong place, and moving it loses its history.__
// இயல்பு விதி இல்லையெனில் ஊகிப்பதில்லை; தவறு தரும்
இயல்பில்லா_விதிகள் = [விதிகள்[1], விதிகள்[2]];
அச்சு தவறா(பணியுருப்படி_வகை(இயல்பில்லா_விதிகள், { "பணி_வகை": "ஆய்வு" }));
