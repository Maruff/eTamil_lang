// __nUlakam/oruwkiNYppu/ajUr.qmz — அஜூர் (the Azure DevOps REST client)__
// அஜூர் டெவ்ஆப்ஸ் இணைய இடைமுகம்
//
// __Four calls do nearly all of a PMO's work with Azure DevOps: read a work__
// __item, create one, update one, and run a WIQL query. Each is a URL, a method,__
// __an authorisation header and a JSON body, and each can fail in the same small__
// __set of ways. This file builds the four and gives every failure one shape:__
//
//   __தவறு({நிலைக்_குறி, செய்தி, மீண்டும்_முயல்_நொடிகள்})__
//
// __with நிலைக்_குறி 0 when there was no response at all, and 400 for a patch__
// __ஒட்டுகள்_சரியா refused before sending — a request that will never succeed,__
// __which the outbox parks rather than retries. That shape is exactly__
// __what aZuppu_varicY.qmz's தோல்வியைப்_பதி takes, so the worker's error path is__
// __one line whatever went wrong. A 412 from an update is the /rev test in__
// __ottu.qmz refusing a stale write; the answer is to fetch the item again and__
// __rebuild the patch, not to retry the same one.__
//
// __Authentication is a personal access token (as Basic, with an empty user) or__
// __an Entra ID access token (as Bearer) — whichever the connection was made__
// __with. The token is only ever placed in a header.__

இறக்கு "../atippatY/col.qmz";
இறக்கு "../vativam/kuRiyAkkam.qmz";
இறக்கு "ottu.qmz";

// __அஜூர்_பதிப்பு() — the REST api-version every call sends__
// அஜூர்_பதிப்பு() — ஒவ்வோர் அழைப்பும் அனுப்பும் இடைமுகப் பதிப்பு
செயல் அஜூர்_பதிப்பு() { திரும்பு "7.1"; }

// __அஜூர்_இணைப்பு_ஆக்கு(நிறுவன_உரலி, திட்டப்_பெயர், சீட்டு_வகை, அணுகல்_சீட்டு) — one connection__
// அஜூர்_இணைப்பு_ஆக்கு(நிறுவன_உரலி, திட்டப்_பெயர், சீட்டு_வகை, அணுகல்_சீட்டு) — ஓர் இணைப்பை உருவாக்கும்
//
// __நிறுவன_உரலி is https://dev.azure.com/<organisation>, with or without a__
// __trailing slash. சீட்டு_வகை is "PAT" or "Bearer".__
செயல் அஜூர்_இணைப்பு_ஆக்கு(நிறுவன_உரலி, திட்டப்_பெயர், சீட்டு_வகை, அணுகல்_சீட்டு) {
    அடி = நிறுவன_உரலி;
    (முடிகிறதா(அடி, "/")) எனில் { அடி = துண்டு(அடி, 0, நீளம்(அடி) - 1); }
    திரும்பு { அடி_உரலி: அடி, திட்டப்_பெயர்: திட்டப்_பெயர்,
              சீட்டு_வகை: சீட்டு_வகை, அணுகல்_சீட்டு: அணுகல்_சீட்டு };
}

// __அஜூர்_தலைப்புகள்(இணைப்பு, உள்ளடக்க_வகை) — the request headers for a connection__
// அஜூர்_தலைப்புகள்(இணைப்பு, உள்ளடக்க_வகை) — ஓர் இணைப்புக்கான கோரிக்கைத் தலைப்புகள்
//
// __உள்ளடக்க_வகை is the body's type: application/json for a query,__
// __application/json-patch+json for a create or update, "" for a read.__
செயல் அஜூர்_தலைப்புகள்(இணைப்பு, உள்ளடக்க_வகை) {
    அனுமதி = "Bearer " & இணைப்பு.அணுகல்_சீட்டு;
    (இணைப்பு.சீட்டு_வகை == "PAT") எனில் {
        அனுமதி = "Basic " & அறுபத்துநான்கு_ஆக்கு(":" & இணைப்பு.அணுகல்_சீட்டு);
    }
    தலைப்புகள் = { "Authorization": அனுமதி, "Accept": "application/json" };
    (உள்ளடக்க_வகை != "") எனில் { தலைப்புகள்["Content-Type"] = உள்ளடக்க_வகை; }
    திரும்பு தலைப்புகள்;
}

// __திட்ட_உரலி(இணைப்பு, பாதை) — a project-scoped API url__
// திட்ட_உரலி(இணைப்பு, பாதை) — திட்டத்துக்குரிய இடைமுக உரலி
//
// __பாதை follows _apis/. A leading slash is dropped, so "/wit/wiql" and__
// __"wit/wiql" give the same url rather than one with _apis//wit in it. Spaces in__
// __the project name are escaped; Azure DevOps project names cannot hold the__
// __other characters that would need it.__
செயல் திட்ட_உரலி(இணைப்பு, பாதை) {
    திட்டம் = மாற்று(இணைப்பு.திட்டப்_பெயர், " ", "%20");
    (தொடங்குகிறதா(பாதை, "/")) சுற்று { பாதை = துண்டு(பாதை, 1, நீளம்(பாதை) - 1); }
    இணைப்புக்குறி = "?";
    (கொண்டுள்ளதா(பாதை, "?")) எனில் { இணைப்புக்குறி = "&"; }
    திரும்பு இணைப்பு.அடி_உரலி & "/" & திட்டம் & "/_apis/" & பாதை
             & இணைப்புக்குறி & "api-version=" & அஜூர்_பதிப்பு();
}

// __பணியுருப்படி_உரலி(இணைப்பு, பணியுருப்படி_எண்) — the url of one work item__
// பணியுருப்படி_உரலி(இணைப்பு, பணியுருப்படி_எண்) — ஒரு பணியுருப்படியின் உரலி
செயல் பணியுருப்படி_உரலி(இணைப்பு, பணியுருப்படி_எண்) {
    திரும்பு திட்ட_உரலி(இணைப்பு, "wit/workitems/" & சொல்லாக்கு(பணியுருப்படி_எண்));
}

// __அஜூர்_அனுப்பு(கோரிக்கை_முறை, இலக்கு_உரலி, உடலுரை, தலைப்புகள்) — send one request, and give every failure one shape__
// அஜூர்_அனுப்பு(கோரிக்கை_முறை, இலக்கு_உரலி, உடலுரை, தலைப்புகள்) — ஒரு கோரிக்கையை அனுப்பும்
//
// __சரி({நிலைக்_குறி, பதில்_உடல்}) with the JSON body read, for any 2xx. Otherwise the__
// __தவறு shape at the top of this file; மீண்டும்_முயல்_நொடிகள் is Retry-After__
// __when the service sent one, else 0.__
செயல் அஜூர்_அனுப்பு(கோரிக்கை_முறை, இலக்கு_உரலி, உடலுரை, தலைப்புகள்) {
    விடை = வலை_அனுப்பு(கோரிக்கை_முறை, இலக்கு_உரலி, உடலுரை, தலைப்புகள்);
    (தவறா(விடை)) எனில் {
        திரும்பு தவறு({ நிலைக்_குறி: 0, செய்தி: தவறு_மதிப்பு(விடை), மீண்டும்_முயல்_நொடிகள்: 0 });
    }
    வந்த_பதில் = மதிப்பு(விடை);
    குறி = வந்த_பதில்.நிலைக்_குறி;
    (குறி >= 200 மற்றும் குறி < 300) எனில் {
        பதில்_உடல் = இன்மை;
        (வந்த_பதில்.உடலுரை != "") எனில் { பதில்_உடல் = இயல்பு(ஜேசான்_படி(வந்த_பதில்.உடலுரை), வந்த_பதில்.உடலுரை); }
        திரும்பு சரி({ நிலைக்_குறி: குறி, பதில்_உடல்: பதில்_உடல் });
    }
    காத்திரு = எண்ணாக்கு(புலம்_அல்லது(வந்த_பதில்.தலைப்புகள், "retry-after",
                          புலம்_அல்லது(வந்த_பதில்.தலைப்புகள், "Retry-After", "0")));
    திரும்பு தவறு({ நிலைக்_குறி: குறி, செய்தி: வந்த_பதில்.உடலுரை,
                   மீண்டும்_முயல்_நொடிகள்: இயல்பு(காத்திரு, 0) });
}

// __பணியுருப்படியைப்_பெறு(இணைப்பு, பணியுருப்படி_எண்) — read one work item, with its relations__
// பணியுருப்படியைப்_பெறு(இணைப்பு, பணியுருப்படி_எண்) — ஒரு பணியுருப்படியைப் படிக்கும்
செயல் பணியுருப்படியைப்_பெறு(இணைப்பு, பணியுருப்படி_எண்) {
    திரும்பு அஜூர்_அனுப்பு("GET",
        திட்ட_உரலி(இணைப்பு, "wit/workitems/" & சொல்லாக்கு(பணியுருப்படி_எண்) & "?$expand=relations"),
        இன்மை, அஜூர்_தலைப்புகள்(இணைப்பு, ""));
}

// __பணியுருப்படியை_உருவாக்கு(இணைப்பு, பணியுருப்படி_வகை, ஒட்டுகள்) — create a work item__
// பணியுருப்படியை_உருவாக்கு(இணைப்பு, பணியுருப்படி_வகை, ஒட்டுகள்) — ஒரு பணியுருப்படியை உருவாக்கும்
//
// __ஒட்டுகள் is an ottu.qmz patch without a /rev test — there is no revision yet.__
// __It is checked with ஒட்டுகள்_சரியா first; a malformed patch is refused with__
// __status 400 and never sent.__
செயல் பணியுருப்படியை_உருவாக்கு(இணைப்பு, பணியுருப்படி_வகை, ஒட்டுகள்) {
    சரிபார்ப்பு = ஒட்டுகள்_சரியா(ஒட்டுகள்);
    (தவறா(சரிபார்ப்பு)) எனில் {
        திரும்பு தவறு({ நிலைக்_குறி: 400, செய்தி: தவறு_மதிப்பு(சரிபார்ப்பு), மீண்டும்_முயல்_நொடிகள்: 0 });
    }
    திரும்பு அஜூர்_அனுப்பு("POST",
        திட்ட_உரலி(இணைப்பு, "wit/workitems/$" & மாற்று(பணியுருப்படி_வகை, " ", "%20")),
        ஜேசான்_ஆக்கு(ஒட்டுகள்), அஜூர்_தலைப்புகள்(இணைப்பு, "application/json-patch+json"));
}

// __பணியுருப்படியைத்_திருத்து(இணைப்பு, பணியுருப்படி_எண், ஒட்டுகள்) — update a work item__
// பணியுருப்படியைத்_திருத்து(இணைப்பு, பணியுருப்படி_எண், ஒட்டுகள்) — ஒரு பணியுருப்படியைத் திருத்தும்
//
// __Checked with ஒட்டுகள்_சரியா first, like a create.__
செயல் பணியுருப்படியைத்_திருத்து(இணைப்பு, பணியுருப்படி_எண், ஒட்டுகள்) {
    சரிபார்ப்பு = ஒட்டுகள்_சரியா(ஒட்டுகள்);
    (தவறா(சரிபார்ப்பு)) எனில் {
        திரும்பு தவறு({ நிலைக்_குறி: 400, செய்தி: தவறு_மதிப்பு(சரிபார்ப்பு), மீண்டும்_முயல்_நொடிகள்: 0 });
    }
    திரும்பு அஜூர்_அனுப்பு("PATCH", பணியுருப்படி_உரலி(இணைப்பு, பணியுருப்படி_எண்),
        ஜேசான்_ஆக்கு(ஒட்டுகள்), அஜூர்_தலைப்புகள்(இணைப்பு, "application/json-patch+json"));
}

// __வினாவை_ஓட்டு(இணைப்பு, வினா_உரை) — run a WIQL query and return the ids__
// வினாவை_ஓட்டு(இணைப்பு, வினா_உரை) — வினாவை இயக்கி எண்களைத் தரும்
//
// __சரி with the list of work-item ids, in the query's order. WIQL returns ids__
// __only; fetch each item with பணியுருப்படியைப்_பெறு.__
செயல் வினாவை_ஓட்டு(இணைப்பு, வினா_உரை) {
    விடை = அஜூர்_அனுப்பு("POST", திட்ட_உரலி(இணைப்பு, "wit/wiql"),
        ஜேசான்_ஆக்கு({ "query": வினா_உரை }), அஜூர்_தலைப்புகள்(இணைப்பு, "application/json"));
    (தவறா(விடை)) எனில் { திரும்பு விடை; }
    எண்கள் = [];
    ஒவ்வொரு ஒன்று இல் புலம்_அல்லது(மதிப்பு(விடை).பதில்_உடல், "workItems", []) {
        எண்கள் = இணை(எண்கள், ஒன்று["id"]);
    }
    திரும்பு சரி(எண்கள்);
}
