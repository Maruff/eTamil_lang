// __nUlakam/upi/vilAcam.qmz — UPI virtual payment addresses, and the pay link__
// ஒருங்கிணைந்த பணப்பரிமாற்ற முகவரிகளும் கட்டண இணைப்பும்
//
// __What this is, and what it is not.__
//
// __A VPA and the upi:// link are public, specified, and checkable without__
// __anyone's permission — a QR sticker in a shop is that link and nothing more.__
// __This builds and checks them.__
//
// __Moving money is not public. That needs a payment service provider or a bank__
// __to sponsor you and NPCI to certify you, and no library substitutes for__
// __either. What this gives you is everything up to the moment a request leaves__
// __for your PSP: an address you have checked, a link you have built, an amount__
// __in the only form UPI accepts.__
//
// __Amounts are the reason a fixed-point language matters here. UPI takes rupees__
// __and paise, two decimal places and no more, and 0.1 + 0.2 being exactly 0.3__
// __is the difference between a request accepted and one rejected.__

இறக்கு "../atippatY/col.qmz";
இறக்கு "../atippatY/poruL.qmz";

// __--- the address ----------------------------------------------------------__
//
// __A VPA is name@handle: ravi@okaxis, 9876543210@ybl, a merchant's own. The__
// __handle is the PSP. Neither half may be empty and there is exactly one @,__
// __which is the check that catches a typed address; the rest is the PSP's__
// __business, and refusing an address it would have accepted is worse than__
// __passing one it will reject with a clear message.__
// முகவரி_சரியா(வி_பி_ஏ) — இது முறையான பணப்பரிமாற்ற முகவரியா
செயல் முகவரி_சரியா(வி_பி_ஏ) {
    (நீளம்(வி_பி_ஏ) == 0) எனில் { திரும்பு பொய்; }

    பகுதிகள் = பிரி(வி_பி_ஏ, "@");
    (நீளம்(பகுதிகள்) != 2) எனில் { திரும்பு பொய்; }

    பெயர்ப்_பகுதி = பகுதிகள்[0];
    கைப்_பகுதி = பகுதிகள்[1];

    (நீளம்(பெயர்ப்_பகுதி) == 0 அல்லது நீளம்(கைப்_பகுதி) == 0) எனில் {
        திரும்பு பொய்;
    }

    // __A space is the one character that certainly does not belong, and the one__
    // __a person typing an address most often leaves in.__
    (கொண்டுள்ளதா(வி_பி_ஏ, " ")) எனில் { திரும்பு பொய்; }

    திரும்பு மெய்;
}

// __கை_பகுதி(வி_பி_ஏ) — the handle, which says which PSP holds the account__
// கை_பகுதி(வி_பி_ஏ) — முகவரியின் பின் பகுதி; கணக்கை வைத்திருப்பவரைக் குறிக்கும்
செயல் கை_பகுதி(வி_பி_ஏ) {
    (முகவரி_சரியா(வி_பி_ஏ) == பொய்) எனில் { திரும்பு ""; }
    திரும்பு பிரி(வி_பி_ஏ, "@")[1];
}

// __--- the amount -----------------------------------------------------------__
//
// __தொகை_சரியா(தொகை_மதிப்பு) — is this an amount UPI will take?__
// தொகை_சரியா(தொகை_மதிப்பு) — இதைப் பணப்பரிமாற்றம் ஏற்குமா
//
// __Positive, and not more than two decimal places. The second is the one that__
// __bites: an amount computed as a third of something arrives with a tail of__
// __digits, the PSP rejects it, and the rejection reads like the payment failed__
// __rather than like the request was malformed.__
செயல் தொகை_சரியா(தொகை_மதிப்பு) {
    (தொகை_மதிப்பு <= 0) எனில் { திரும்பு பொய்; }
    திரும்பு வட்டமிடு(தொகை_மதிப்பு, 2) == தொகை_மதிப்பு;
}

// __தொகை_உரை(தொகை_மதிப்பு) — the amount as UPI wants it written__
// தொகை_உரை(தொகை_மதிப்பு) — பணப்பரிமாற்றம் எதிர்பார்க்கும் வடிவத்தில் தொகை
//
// __Always two decimal places. A decimal normalises 249.50 to 249.5, and while__
// __most apps accept that, the spec writes rupees and paise and some payment__
// __service providers hold you to it. Padding costs nothing; being rejected at a__
// __counter for a missing zero costs a sale.__
செயல் தொகை_உரை(தொகை_மதிப்பு) {
    வட்டமிட்டது = சொல்லாக்கு(வட்டமிடு(தொகை_மதிப்பு, 2));
    பகுதிகள் = பிரி(வட்டமிட்டது, ".");

    (நீளம்(பகுதிகள்) == 1) எனில் { திரும்பு வட்டமிட்டது & ".00"; }
    (நீளம்(பகுதிகள்[1]) == 1) எனில் { திரும்பு வட்டமிட்டது & "0"; }
    திரும்பு வட்டமிட்டது;
}

// __--- percent-encoding -----------------------------------------------------__
//
// __A payee's name and a note go into a query string, and a shop called "Raja &__
// __Sons" would otherwise end the parameter at the ampersand. Only what has to__
// __be escaped is escaped: over-escaping produces a link that works and displays__
// __wrongly in the payer's app.__
// உரை_மறை(மூலப்_பாடம்) — இணைப்பில் பாதுகாப்பாக வைக்க உரையை விடுவிக்கும்
செயல் உரை_மறை(மூலப்_பாடம்) {
    வெளியே = மாற்று(மூலப்_பாடம், "%", "%25");
    வெளியே = மாற்று(வெளியே, "&", "%26");
    வெளியே = மாற்று(வெளியே, "=", "%3D");
    வெளியே = மாற்று(வெளியே, "?", "%3F");
    வெளியே = மாற்று(வெளியே, "#", "%23");
    வெளியே = மாற்று(வெளியே, " ", "%20");
    திரும்பு வெளியே;
}

// __--- the link -------------------------------------------------------------__
//
// __பணம்_இணைப்பு(விவரங்கள்) — the upi:// link behind every payment QR__
// பணம்_இணைப்பு(பெறுநர், பெயர், தொகை, குறிப்பு) — கட்டணம் செலுத்தும் இணைப்பைக் கட்டும்
//
// __விவரங்கள் carries what the spec names:__
//   __pa  the payee address, required__
//   __pn  the payee name, required__
//   __am  the amount — leave it out and the payer types one, which is what a__
//       __donation box wants and a bill does not__
//   __tn  a note shown to the payer__
//   __tr  your reference, which is what you reconcile against later__
//   __mc  the merchant category code, for a registered merchant__
//
// __Answers a தவறு rather than a link when the address or amount is wrong. A__
// __malformed link becomes a QR that a shop prints, sticks to a counter, and__
// __discovers is unscannable one customer at a time.__
// பணம்_இணைப்பு(விவரங்கள்) — செலுத்துவோர் திறக்கக்கூடிய பணம் செலுத்தும் இணைப்பை உருவாக்கும்
செயல் பணம்_இணைப்பு(விவரங்கள்) {
    முகவரி = புலம்_அல்லது(விவரங்கள், "pa", "");
    (முகவரி_சரியா(முகவரி) == பொய்) எனில் {
        திரும்பு தவறு("செல்லாத முகவரி  (not a valid VPA): " & முகவரி);
    }

    பெயர் = புலம்_அல்லது(விவரங்கள், "pn", "");
    (நீளம்(பெயர்) == 0) எனில் {
        திரும்பு தவறு("பெறுநர் பெயர் தேவை  (a payee name is required)");
    }

    இணைப்பு = "upi://pay?pa=" & உரை_மறை(முகவரி) & "&pn=" & உரை_மறை(பெயர்);

    தொகை_மதிப்பு = புலம்_அல்லது(விவரங்கள், "am", 0);
    (தொகை_மதிப்பு != 0) எனில் {
        (தொகை_சரியா(தொகை_மதிப்பு) == பொய்) எனில் {
            திரும்பு தவறு("செல்லாத தொகை  (an amount must be positive and "
                           & "no more than two decimal places): " & தொகை_மதிப்பு);
        }
        இணைப்பு = இணைப்பு & "&am=" & தொகை_உரை(தொகை_மதிப்பு);
    }

    // __The currency is always INR. It is written anyway, because the spec says__
    // __so and a payer's app is entitled to insist.__
    இணைப்பு = இணைப்பு & "&cu=INR";

    இணைப்பு = விருப்பத்தைச்_சேர்(இணைப்பு, "tn", புலம்_அல்லது(விவரங்கள், "tn", ""));
    இணைப்பு = விருப்பத்தைச்_சேர்(இணைப்பு, "tr", புலம்_அல்லது(விவரங்கள், "tr", ""));
    இணைப்பு = விருப்பத்தைச்_சேர்(இணைப்பு, "mc", புலம்_அல்லது(விவரங்கள், "mc", ""));

    திரும்பு சரி(இணைப்பு);
}

// __விருப்பத்தைச்_சேர்(இணைப்பு, பெயர், மதிப்பீடு) — append one optional parameter to a UPI link__
// விருப்பத்தைச்_சேர்(இணைப்பு, பெயர், மதிப்பீடு) — இணைப்புடன் ஒரு விருப்ப அளபுருவைச் சேர்க்கும்
//
// __An empty value is dropped rather than written as an empty parameter, because some UPI apps treat a present-but-blank field as a value and refuse the link. The value is percent-encoded; a payee name with a space is otherwise a link that ends at the space.__
செயல் விருப்பத்தைச்_சேர்(இணைப்பு, பெயர், மதிப்பீடு) {
    (நீளம்(சொல்லாக்கு(மதிப்பீடு)) == 0) எனில் { திரும்பு இணைப்பு; }
    திரும்பு இணைப்பு & "&" & பெயர் & "=" & உரை_மறை(சொல்லாக்கு(மதிப்பீடு));
}

// __--- reading one back -----------------------------------------------------__
//
// __இணைப்பைப்_படி(இணைப்பு) — the parameters of a upi:// link, as a record__
// இணைப்பைப்_படி(இணைப்பு) — கட்டண இணைப்பின் அளபுருக்களைப் பதிவேடாகப் படிக்கும்
//
// __For checking what was printed on a sticker, and for a payer app reading what__
// __it was handed. Values are left percent-encoded: decoding needs the reverse__
// __of உரை_மறை and every escape a payer's app might have used, which is more__
// __than this claims to do.__
செயல் இணைப்பைப்_படி(இணைப்பு) {
    (தொடங்குகிறதா(இணைப்பு, "upi://pay?") == பொய்) எனில் {
        திரும்பு தவறு("upi://pay? இல் தொடங்கவில்லை  (not a UPI pay link)");
    }

    வினவல் = துண்டு(இணைப்பு, 10, நீளம்(இணைப்பு) - 10);
    விடை = {};
    ஒவ்வொரு இணை_பகுதி இல் பிரி(வினவல், "&") {
        இரண்டு = பிரி(இணை_பகுதி, "=");
        (நீளம்(இரண்டு) == 2) எனில் {
            விடை[இரண்டு[0]] = இரண்டு[1];
        }
    }
    திரும்பு சரி(விடை);
}
