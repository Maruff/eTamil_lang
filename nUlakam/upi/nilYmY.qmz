// __nUlakam/upi/nilYmY.qmz — where a UPI payment has got to__
//
// __The whole of this file exists for one rule:__
//
//   __PENDING IS NOT FAILURE.__
//
// __A UPI request that has not answered yet may still succeed. The payer's bank__
// __may be slow, the switch may be retrying, the answer may arrive in an hour.__
// __Treating that as a failure is how a merchant ships goods and refunds a__
// __payment that then lands, or charges a customer twice for one order — and it__
// __is the most common way a UPI integration loses money, because the wrong__
// __behaviour is the one that feels safe.__
//
// __So the states are named, the moves between them are checked, and the two__
// __questions worth asking are asked separately:__
//
//   __பணம்_வந்ததா   may I ship? Only a settled success says yes.__
//   __சரிபார்க்கவா   must I ask again? Anything unsettled says yes.__
//
// __A state that is neither is unsettled, and unsettled is not a refusal.__

இறக்கு "../atippatY/aNi.qmz";

// __The states, as the switch reports them.__
தொடங்கியது = "INITIATED";   // __sent, nothing heard__
நிலுவையில் = "PENDING";     // __accepted, not settled — the dangerous one__
வெற்றியானது = "SUCCESS";     // __settled, money moved__
தோல்வியானது = "FAILURE";     // __settled, money did not move__
திருப்பியது = "REVERSED";    // __it moved and then came back__

// __நிலைமைகள்() — every state, for a program that wants to check its own table__
செயல் நிலைமைகள்() {
    திரும்பு [தொடங்கியது, நிலுவையில், வெற்றியானது, தோல்வியானது, திருப்பியது];
}

// __அறியப்பட்டதா(நிலைமை) — is this one of ours?__
//
// __A switch that answers something unrecognised must not be guessed at. An__
// __unknown state is not a failure and is certainly not a success.__
செயல் அறியப்பட்டதா(நிலைமை) {
    ஒவ்வொரு ஒன்று இல் நிலைமைகள்() {
        (ஒன்று == நிலைமை) எனில் { திரும்பு மெய்; }
    }
    திரும்பு பொய்;
}

// __--- the two questions ----------------------------------------------------__

// __பணம்_வந்ததா(நிலைமை) — has the money actually arrived?__
//
// __The only state that says yes is SUCCESS. Not PENDING, however long it has__
// __been pending; not INITIATED; and not REVERSED, which arrived and left again.__
// __Everything a merchant does on the strength of a payment hangs on this__
// __answer, so it is deliberately the narrowest question in the file.__
செயல் பணம்_வந்ததா(நிலைமை) {
    திரும்பு நிலைமை == வெற்றியானது;
}

// __சரிபார்க்கவா(நிலைமை) — must this be asked about again?__
//
// __Anything not settled. A pending payment is reconciled until the switch says__
// __one way or the other; abandoning it is how a real payment ends up recorded__
// __as a failure.__
செயல் சரிபார்க்கவா(நிலைமை) {
    (அறியப்பட்டதா(நிலைமை) == பொய்) எனில் { திரும்பு மெய்; }
    திரும்பு நிலைமை == தொடங்கியது அல்லது நிலைமை == நிலுவையில்;
}

// __முடிந்ததா(நிலைமை) — is this settled, either way?__
செயல் முடிந்ததா(நிலைமை) {
    திரும்பு சரிபார்க்கவா(நிலைமை) == பொய்;
}

// __--- the moves ------------------------------------------------------------__
//
// __நகர்வு_சரியா(இருந்து, வரை) — may a payment move between these?__
//
// __Settled means settled: a success does not become a failure because a later__
// __poll was confused, and a failure does not quietly become a success. The one__
// __move out of SUCCESS is REVERSED, which is a new event and not a correction.__
//
// __Enforcing this is what stops a late or duplicated callback from rewriting__
// __history — and callbacks do arrive late, and out of order.__
செயல் நகர்வு_சரியா(இருந்து, வரை) {
    (அறியப்பட்டதா(இருந்து) == பொய் அல்லது அறியப்பட்டதா(வரை) == பொய்) எனில் {
        திரும்பு பொய்;
    }
    (இருந்து == வரை) எனில் { திரும்பு மெய்; }

    (இருந்து == தொடங்கியது) எனில் {
        திரும்பு வரை == நிலுவையில் அல்லது வரை == வெற்றியானது
                அல்லது வரை == தோல்வியானது;
    }
    (இருந்து == நிலுவையில்) எனில் {
        திரும்பு வரை == வெற்றியானது அல்லது வரை == தோல்வியானது;
    }
    (இருந்து == வெற்றியானது) எனில் {
        திரும்பு வரை == திருப்பியது;
    }
    // __FAILURE and REVERSED are the end of the story.__
    திரும்பு பொய்;
}

// __நகர்த்து(இருந்து, வரை) — the new state, or a தவறு saying why not__
//
// __A result rather than a boolean, so that refusing an impossible move is__
// __something a caller has to handle rather than something it can overlook.__
செயல் நகர்த்து(இருந்து, வரை) {
    (அறியப்பட்டதா(வரை) == பொய்) எனில் {
        திரும்பு தவறு("தெரியாத நிலைமை  (unknown state): " & வரை);
    }
    (நகர்வு_சரியா(இருந்து, வரை) == பொய்) எனில் {
        திரும்பு தவறு("இந்த நகர்வு அனுமதிக்கப்படவில்லை  (that move is not allowed): "
                       & இருந்து & " → " & வரை);
    }
    திரும்பு சரி(வரை);
}
