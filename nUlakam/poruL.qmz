// __nUlakam/poruL.qmz — பொருள் (record) helpers__
//
// __Indexing a record by a field it does not have is an error, which is right__
// __for a field a program expects and wrong for one it merely allows. A query__
// __string with no `status` in it is an ordinary request, not a fault, and an__
// __HTTP handler that crashes on the absence of an optional parameter is__
// __unusable — so reading one needs a way to say "or this instead".__
//
// __ஒவ்வொரு over a record yields its field names, so the rest of this file__
// __is ordinary eTamil.__
//
// __The parameter is named பதிவேடு rather than the plainer பொருள் because that__
// __word is the record type keyword and is hard reserved — it cannot be a name.__

// __புலம்_உள்ளதா(பதிவேடு, பெயர்) and புலம்_அல்லது(பதிவேடு, பெயர், மாற்று) are__
// __host builtins now.__
//
// __Both were written here, in eTamil, like everything else in this file.__
// __Neither could be: asking whether a record has a field meant walking its__
// __field names, because that is the only thing the language offers from the__
// __inside, and reading one meant walking them twice. That made a record__
// __unusable as a map — n lookups over n keys cost 0.12 seconds at a hundred__
// __keys and 61.6 seconds at eight hundred, and building a word-frequency__
// __map over a corpus never finished at all.__
//
// __The host does one hash lookup. A function defined here would shadow the__
// __builtin, so they are gone rather than delegating — see col.qmz, where__
// __பிரி and ஒன்றிணை left for the same reason.__

// __புலங்கள்(பதிவேடு) — the field names, as an array__
செயல் புலங்கள்(பதிவேடு) {
    விடை = [];
    ஒவ்வொரு புலப்_பெயர் இல் பதிவேடு {
        விடை = இணை(விடை, புலப்_பெயர்);
    }
    திரும்பு விடை;
}

// __மதிப்பீடுகள்(பதிவேடு) — the values, in the same order as புலங்கள்__
//
// __Not மதிப்புகள்: மதிப்பு is the builtin that opens a result, and a name__
// __that close to it reads as though this were the plural of that.__
செயல் மதிப்பீடுகள்(பதிவேடு) {
    விடை = [];
    ஒவ்வொரு புலப்_பெயர் இல் பதிவேடு {
        விடை = இணை(விடை, பதிவேடு[புலப்_பெயர்]);
    }
    திரும்பு விடை;
}

// __காலியா_பதிவேடு(பதிவேடு) — no fields at all?__
செயல் காலியா_பதிவேடு(பதிவேடு) {
    திரும்பு நீளம்(பதிவேடு) == 0;
}
