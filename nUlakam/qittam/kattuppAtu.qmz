// __nUlakam/qittam/kattuppAtu.qmz — கட்டுப்பாட்டுக் கணக்கு (control accounts,__
// கட்டுப்பாட்டுக் கணக்கும் நிதித் தொகுதியும்
// __the time-phased budget, and reserves)__
//
// __The control account is where project structure meets the ledger: a WBS node__
// __designated as the level at which scope, budget, actual cost and schedule are__
// __integrated and performance is measured. It has one owner, one code, and that__
// __code is a real account in the accounting system, so an invoice can be booked__
// __straight to it instead of to one undifferentiated "project" account.__
//
// __If that mapping is not designed before the first invoice arrives it gets__
// __improvised later, and the improvisation is always the same: a spreadsheet in__
// __which someone reconciles project codes to cost centres every month. That__
// __spreadsheet is where project cost control quietly dies.__
//
// __A budget is not a total. It is a total *distributed across periods*, because__
// __a project with the right total and the wrong phasing reports an alarming__
// __variance every month while being perfectly on track. Planned value — the PV__
// __of earned value analysis — is read off that distribution and nowhere else.__

இறக்கு "pakuppu.qmz";

// __--- The control account -------------------------------------------------__

// கட்டுப்பாட்டுக்_கணக்கு_ஆக்கு(கணக்குக்_குறி, கணு_குறி, உரிமையாளர்)
//
// __கணக்குக்_குறி is the code the ledger knows. கணு_குறி is the WBS node it sits__
// __on. Keeping them as separate fields rather than one identifier is what lets__
// __the accounting structure and the work structure be renamed independently,__
// __which they will be.__
// கட்டுப்பாட்டுக்_கணக்கு_ஆக்கு(கணக்குக்_குறி, கணு_குறி, உரிமையாளர்) — ஒரு கட்டுப்பாட்டுக் கணக்கை உருவாக்கும்
செயல் கட்டுப்பாட்டுக்_கணக்கு_ஆக்கு(கணக்குக்_குறி, கணு_குறி, உரிமையாளர்) {
    திரும்பு {
        கணக்குக்_குறி: கணக்குக்_குறி,
        கணு_குறி: கணு_குறி,
        உரிமையாளர்: உரிமையாளர்
    };
}

// ஒரே_கணக்கா(கணக்குகள், கணுக்கள், கணு_குறி)
//
// __Exactly one control account must lie on the path from a work package to the__
// __root. Two means the package's cost is counted twice; none means it is__
// __counted nowhere. Neither shows up in a tree view, and both show up in the__
// __totals, which is the worst possible combination.__
// ஒரே_கணக்கா(கணக்குகள், கணுக்கள், கணு_குறி) — இக்கணு ஒரே ஒரு கட்டுப்பாட்டுக் கணக்கின் கீழ் வருகிறதா
செயல் ஒரே_கணக்கா(கணக்குகள், கணுக்கள், கணு_குறி) {
    திரும்பு பாதையில்_கணக்குகள்(கணக்குகள், கணுக்கள், கணு_குறி) == 1;
}

// __பாதையில்_கணக்குகள்(கணக்குகள், கணுக்கள், கணு_குறி) — how many control accounts lie on the path to the root__
// பாதையில்_கணக்குகள்(கணக்குகள், கணுக்கள், கணு_குறி) — மூலம் வரையிலான பாதையில் எத்தனை கட்டுப்பாட்டுக் கணக்குகள்
//
// __Walks up the parent chain counting as it goes. More than one is the error worth finding: a WBS branch controlled at two levels has its cost counted twice in the roll-up, and the totals still look plausible because every individual number is right.__
செயல் பாதையில்_கணக்குகள்(கணக்குகள், கணுக்கள், கணு_குறி) {
    (கணு_குறி == "") எனில் { திரும்பு 0; }
    எண்ணிக்கை = 0;
    ஒவ்வொரு ஒரு_கணக்கு இல் கணக்குகள் {
        (ஒரு_கணக்கு.கணு_குறி == கணு_குறி) எனில் { எண்ணிக்கை = எண்ணிக்கை + 1; }
    }
    விடை = கணு_தேடு(கணுக்கள், கணு_குறி);
    (தவறா(விடை)) எனில் { திரும்பு எண்ணிக்கை; }
    திரும்பு எண்ணிக்கை
           + பாதையில்_கணக்குகள்(கணக்குகள், கணுக்கள்,
                                 மதிப்பு(விடை).பெற்றோர்_குறி);
}

// __கட்டமைப்பை_சரிபார்(கணக்குகள், கணுக்கள்) — every work package, checked__
// கட்டமைப்பை_சரிபார்(கணக்குகள், கணுக்கள்) — ஒவ்வொரு வேலைத் தொகுப்பையும் சரிபார்க்கும்
செயல் கட்டமைப்பை_சரிபார்(கணக்குகள், கணுக்கள்) {
    ஒவ்வொரு ஒரு_கணு இல் வேலைத்_தொகுப்புகள்(கணுக்கள்) {
        எத்தனை = பாதையில்_கணக்குகள்(கணக்குகள், கணுக்கள், ஒரு_கணு.கணு_குறி);
        (எத்தனை != 1) எனில் {
            திரும்பு தவறு(ஒரு_கணு.கணு_குறி & ": பாதையில் "
                          & எத்தனை & " கட்டுப்பாட்டுக் கணக்குகள், ஒன்று வேண்டும்");
        }
    }
    திரும்பு சரி(மெய்);
}

// __--- The time-phased budget ---------------------------------------------__

// __காலப்_பகிர்வு(காலம்_எண், காலத்_தொகை) — one period's slice of the budget__
// காலப்_பகிர்வு(காலம்_எண், காலத்_தொகை) — ஒரு காலத்துக்கான நிதிப் பங்கு
//
// __A time-phased budget is a list of these. Held as period number and amount rather than as dates, because the phasing is relative to the project and survives the start date moving.__
செயல் காலப்_பகிர்வு(காலம்_எண், காலத்_தொகை) {
    திரும்பு { காலம்_எண்: காலம்_எண், காலத்_தொகை: காலத்_தொகை };
}

// __திரட்டிய_நிதி(பகிர்வுகள், காலம்_வரை) — the S-curve read at one period__
// திரட்டிய_நிதி(பகிர்வுகள், காலம்_வரை) — சொன்ன காலம் வரை திரட்டிய நிதி
//
// __This is planned value. It is cumulative by definition: PV at period 10 is__
// __everything scheduled to be complete by then, not period 10's slice.__
செயல் திரட்டிய_நிதி(பகிர்வுகள், காலம்_வரை) {
    ஓடும்_கூட்டல் = 0;
    ஒவ்வொரு ஒரு_பகிர்வு இல் பகிர்வுகள் {
        (ஒரு_பகிர்வு.காலம்_எண் <= காலம்_வரை) எனில் {
            ஓடும்_கூட்டல் = ஓடும்_கூட்டல் + ஒரு_பகிர்வு.காலத்_தொகை;
        }
    }
    திரும்பு ஓடும்_கூட்டல்;
}

// __மொத்த_நிதி(பகிர்வுகள்) — the phased budget added back up__
// மொத்த_நிதி(பகிர்வுகள்) — காலவாரியாகப் பகிர்ந்த நிதியின் கூட்டுத்தொகை
//
// __Must equal the budget at completion. The check that phasing has not quietly changed the total: moving money between periods is replanning, and creating or losing some is an error.__
செயல் மொத்த_நிதி(பகிர்வுகள்) {
    ஓடும்_கூட்டல் = 0;
    ஒவ்வொரு ஒரு_பகிர்வு இல் பகிர்வுகள் {
        ஓடும்_கூட்டல் = ஓடும்_கூட்டல் + ஒரு_பகிர்வு.காலத்_தொகை;
    }
    திரும்பு ஓடும்_கூட்டல்;
}

// __--- Reserves ------------------------------------------------------------__

// நிதித்_தொகுதி_ஆக்கு(அடிப்படை_நிதி, தற்செயல்_இருப்பு, மேலாண்மை_இருப்பு)
//
// __Two reserves, and the distinction is not bureaucratic. Contingency reserve__
// __covers *identified* risks, sits inside the performance measurement baseline__
// __and is the project manager's to spend. Management reserve covers the__
// __unknown, sits outside the baseline and belongs to the sponsor.__
//
// __Performance is measured against the baseline. If management reserve were__
// __inside it, drawing on the reserve would improve reported performance, which__
// __is exactly backwards — and is how a project 30% over budget reports itself__
// __as on plan.__
// நிதித்_தொகுதி_ஆக்கு(அடிப்படை_நிதி, தற்செயல்_இருப்பு, மேலாண்மை_இருப்பு) — நிதித் தொகுதியை உருவாக்கும்
செயல் நிதித்_தொகுதி_ஆக்கு(அடிப்படை_நிதி, தற்செயல்_இருப்பு, மேலாண்மை_இருப்பு) {
    திரும்பு {
        அடிப்படை_நிதி: அடிப்படை_நிதி,
        தற்செயல்_இருப்பு: தற்செயல்_இருப்பு,
        மேலாண்மை_இருப்பு: மேலாண்மை_இருப்பு
    };
}

// __அளவீட்டு_அடிப்படை(தொகுதி) — the performance measurement baseline__
// அளவீட்டு_அடிப்படை(தொகுதி) — செயல்திறன் அளவீட்டுக்கான அடிப்படை
செயல் அளவீட்டு_அடிப்படை(தொகுதி) {
    திரும்பு தொகுதி.அடிப்படை_நிதி + தொகுதி.தற்செயல்_இருப்பு;
}

// __அனுமதித்த_நிதி(தொகுதி) — baseline plus management reserve__
// அனுமதித்த_நிதி(தொகுதி) — அடிப்படையுடன் மேலாண்மை இருப்பும் சேர்த்தது
செயல் அனுமதித்த_நிதி(தொகுதி) {
    திரும்பு அளவீட்டு_அடிப்படை(தொகுதி) + தொகுதி.மேலாண்மை_இருப்பு;
}

// இருப்பை_விடுவி(தொகுதி, விடுவிக்கும்_தொகை)
//
// __Releasing management reserve moves value into the baseline; it does not__
// __create any. The total authorised funding is unchanged by the transfer, which__
// __is the property the test asserts. A release larger than the reserve is a__
// __தவறு rather than a silent overdraft.__
// இருப்பை_விடுவி(தொகுதி, விடுவிக்கும்_தொகை) — மேலாண்மை இருப்பிலிருந்து ஒரு தொகையை விடுவிக்கும்
செயல் இருப்பை_விடுவி(தொகுதி, விடுவிக்கும்_தொகை) {
    (விடுவிக்கும்_தொகை <= 0) எனில் {
        திரும்பு தவறு("விடுவிப்புத் தொகை பூஜ்யம் அல்லது எதிர்மறை");
    }
    (விடுவிக்கும்_தொகை > தொகுதி.மேலாண்மை_இருப்பு) எனில் {
        திரும்பு தவறு("மேலாண்மை இருப்பு " & தொகுதி.மேலாண்மை_இருப்பு
                      & " மட்டுமே; " & விடுவிக்கும்_தொகை & " கேட்கப்பட்டது");
    }
    திரும்பு சரி({
        அடிப்படை_நிதி: தொகுதி.அடிப்படை_நிதி + விடுவிக்கும்_தொகை,
        தற்செயல்_இருப்பு: தொகுதி.தற்செயல்_இருப்பு,
        மேலாண்மை_இருப்பு: தொகுதி.மேலாண்மை_இருப்பு - விடுவிக்கும்_தொகை
    });
}
