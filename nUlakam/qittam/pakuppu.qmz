// __nUlakam/qittam/pakuppu.qmz — வேலைப் பகுப்பு (the work breakdown structure)__
// வேலைப் பகுப்புக் கட்டமைப்பு
//
// __The WBS is the one artefact everything else on a project hangs off: the__
// __schedule, the budget, the responsibility assignment and the risk register__
// __are all indexed by it. Get its shape wrong and every derived number is__
// __wrong in the same way.__
//
// __It is stored flat — a list of nodes, each naming its parent — rather than as__
// __nested records. Three reasons, and they are the reasons a database would do__
// __the same. A nested record cannot be indexed by code without walking it; a__
// __flat list can. Re-parenting a node is a field assignment rather than a__
// __structural rebuild. And the roll-up, which is the operation that actually__
// __matters, is a fold over a filtered list either way.__
//
// __The root's parent code is the empty string.__
//
// __Field names are compound because அளவு, நிலை, மதிப்பு and பொருள் are keywords__
// __in this language; see celavu/README.md for why that matters for records.__

// கணு_ஆக்கு(கணு_குறி, பெற்றோர்_குறி, கணு_பெயர், கணு_நிதி)
//
// __கணு_நிதி is the budget *entered at this node*. For a parent it is the figure__
// __the planner wrote down; for a leaf it is the work package estimate. The two__
// __are reconciled by நூறு_விதி_சரியா, not by construction — a WBS that cannot__
// __be built in a violating state cannot be checked, and the check is the point.__
// கணு_ஆக்கு(கணு_குறி, பெற்றோர்_குறி, கணு_பெயர், கணு_நிதி) — பகுப்புக் கட்டமைப்பில் ஒரு கணுவை உருவாக்கும்
செயல் கணு_ஆக்கு(கணு_குறி, பெற்றோர்_குறி, கணு_பெயர், கணு_நிதி) {
    திரும்பு {
        கணு_குறி: கணு_குறி,
        பெற்றோர்_குறி: பெற்றோர்_குறி,
        கணு_பெயர்: கணு_பெயர்,
        கணு_நிதி: கணு_நிதி
    };
}

// __கணு_தேடு(கணுக்கள், கணு_குறி) — find one WBS node by its code__
// கணு_தேடு(கணுக்கள், கணு_குறி) — குறியைக் கொண்டு ஒரு கணுவைத் தேடும்
//
// __சரி with the node, or தவறு naming the code. The WBS is what the schedule, the budget and the responsibility matrix all key on, so a code that resolves to nothing is a break between two of them and not a lookup miss to shrug at.__
செயல் கணு_தேடு(கணுக்கள், கணு_குறி) {
    ஒவ்வொரு ஒரு_கணு இல் கணுக்கள் {
        (ஒரு_கணு.கணு_குறி == கணு_குறி) எனில் { திரும்பு சரி(ஒரு_கணு); }
    }
    திரும்பு தவறு("கணு காணவில்லை: " & கணு_குறி);
}

// __சேய்கள்(கணுக்கள், பெற்றோர்_குறி) — the immediate children of one node__
// சேய்கள்(கணுக்கள், பெற்றோர்_குறி) — ஒரு கணுவின் நேரடிச் சேய்கள்
//
// __One level, not the whole subtree. Rolling a cost up the WBS means summing children whose own totals are already rolled up, and a function that returned every descendant would double-count at every level above the leaves.__
செயல் சேய்கள்(கணுக்கள், பெற்றோர்_குறி) {
    விடை_பட்டி = [];
    ஒவ்வொரு ஒரு_கணு இல் கணுக்கள் {
        (ஒரு_கணு.பெற்றோர்_குறி == பெற்றோர்_குறி) எனில் {
            விடை_பட்டி = இணை(விடை_பட்டி, ஒரு_கணு);
        }
    }
    திரும்பு விடை_பட்டி;
}

// __மூலங்கள்(கணுக்கள்) — the top-level nodes__
// மூலங்கள்(கணுக்கள்) — மேல்மட்டக் கணுக்கள்
//
// __The children of the empty parent, which is how a root is recorded: a node with no parent rather than a parent that is absent. That keeps the tree in one flat list with no special case for the top.__
செயல் மூலங்கள்(கணுக்கள்) { திரும்பு சேய்கள்(கணுக்கள், ""); }

// __இலைக்_கணுவா(கணுக்கள், கணு_குறி) — a leaf is a work package__
// இலைக்_கணுவா(கணுக்கள், கணு_குறி) — இலைக் கணுவே வேலைத் தொகுப்பு
//
// __The WBS decomposes deliverables, and it stops at the level where a single__
// __owner can be held to a cost and a duration. That level is defined by having__
// __no children, not by depth: one branch may reach it at level three and__
// __another at level five.__
செயல் இலைக்_கணுவா(கணுக்கள், கணு_குறி) {
    திரும்பு நீளம்(சேய்கள்(கணுக்கள், கணு_குறி)) == 0;
}

// __வேலைத்_தொகுப்புகள்(கணுக்கள்) — the work packages, the leaves of the tree__
// வேலைத்_தொகுப்புகள்(கணுக்கள்) — மரத்தின் இலைகளான வேலைத் தொகுப்புகள்
//
// __The only nodes that carry estimates, get scheduled and are assigned to someone. Everything above them is a summary, and a budget entered against a summary node is the classic way a WBS stops adding up.__
செயல் வேலைத்_தொகுப்புகள்(கணுக்கள்) {
    விடை_பட்டி = [];
    ஒவ்வொரு ஒரு_கணு இல் கணுக்கள் {
        (இலைக்_கணுவா(கணுக்கள், ஒரு_கணு.கணு_குறி)) எனில் {
            விடை_பட்டி = இணை(விடை_பட்டி, ஒரு_கணு);
        }
    }
    திரும்பு விடை_பட்டி;
}

// __--- Rolling up ---------------------------------------------------------__

// __உள்_கூட்டல்(கணுக்கள், கணு_குறி) — the subtree's budget, from its leaves__
// உள்_கூட்டல்(கணுக்கள், கணு_குறி) — உட்கிளையின் நிதி, அதன் இலைகளிலிருந்து
//
// __Deliberately sums *leaves* rather than the node's own figure, so that it__
// __answers what the work actually adds up to. Comparing it with the entered__
// __figure is how a 100% rule violation is found.__
செயல் உள்_கூட்டல்(கணுக்கள், கணு_குறி) {
    (இலைக்_கணுவா(கணுக்கள், கணு_குறி)) எனில் {
        விடை = கணு_தேடு(கணுக்கள், கணு_குறி);
        (தவறா(விடை)) எனில் { திரும்பு 0; }
        திரும்பு மதிப்பு(விடை).கணு_நிதி;
    }
    ஓடும்_கூட்டல் = 0;
    ஒவ்வொரு ஒரு_சேய் இல் சேய்கள்(கணுக்கள், கணு_குறி) {
        ஓடும்_கூட்டல் = ஓடும்_கூட்டல் + உள்_கூட்டல்(கணுக்கள், ஒரு_சேய்.கணு_குறி);
    }
    திரும்பு ஓடும்_கூட்டல்;
}

// __ஆழம்(கணுக்கள், கணு_குறி) — a root is at depth 0__
// ஆழம்(கணுக்கள், கணு_குறி) — கணுவின் ஆழம்; மூலம் பூஜ்ஜியம்
செயல் ஆழம்(கணுக்கள், கணு_குறி) {
    விடை = கணு_தேடு(கணுக்கள், கணு_குறி);
    (தவறா(விடை)) எனில் { திரும்பு 0; }
    பெற்றோர் = மதிப்பு(விடை).பெற்றோர்_குறி;
    (பெற்றோர் == "") எனில் { திரும்பு 0; }
    திரும்பு 1 + ஆழம்(கணுக்கள், பெற்றோர்);
}

// __--- The 100% rule ------------------------------------------------------__

// நூறு_விதி_சரியா(கணுக்கள், கணு_குறி)
//
// __The rule: the work at any level of decomposition is 100% of the work of its__
// __parent — no more and no less. A parent whose entered budget exceeds its__
// __children's has work nobody has been assigned; one whose children exceed it__
// __has work counted twice. Both are invisible in a tree view and both are found__
// __by this comparison.__
//
// __A leaf satisfies it trivially, having nothing below it to disagree with.__
// நூறு_விதி_சரியா(கணுக்கள், கணு_குறி) — சேய்களின் நிதி பெற்றோரின் நிதிக்குச் சமமா
செயல் நூறு_விதி_சரியா(கணுக்கள், கணு_குறி) {
    (இலைக்_கணுவா(கணுக்கள், கணு_குறி)) எனில் { திரும்பு மெய்; }
    விடை = கணு_தேடு(கணுக்கள், கணு_குறி);
    (தவறா(விடை)) எனில் { திரும்பு பொய்; }
    சேய்_கூட்டல் = 0;
    ஒவ்வொரு ஒரு_சேய் இல் சேய்கள்(கணுக்கள், கணு_குறி) {
        சேய்_கூட்டல் = சேய்_கூட்டல் + ஒரு_சேய்.கணு_நிதி;
    }
    திரும்பு மதிப்பு(விடை).கணு_நிதி == சேய்_கூட்டல்;
}

// __விதியை_சரிபார்(கணுக்கள்) — the first violation, or சரி__
// விதியை_சரிபார்(கணுக்கள்) — முதல் மீறல்; இல்லையெனில் சரி
//
// __Returns the offending node rather than a boolean, because "the WBS does not__
// __balance" is not actionable and "ப2 is entered at 400 but its children total__
// __350" is.__
செயல் விதியை_சரிபார்(கணுக்கள்) {
    ஒவ்வொரு ஒரு_கணு இல் கணுக்கள் {
        (இல்லை நூறு_விதி_சரியா(கணுக்கள், ஒரு_கணு.கணு_குறி)) எனில் {
            சேய்_கூட்டல் = 0;
            ஒவ்வொரு ஒரு_சேய் இல் சேய்கள்(கணுக்கள், ஒரு_கணு.கணு_குறி) {
                சேய்_கூட்டல் = சேய்_கூட்டல் + ஒரு_சேய்.கணு_நிதி;
            }
            திரும்பு தவறு(ஒரு_கணு.கணு_குறி & ": உள்ளிட்டது "
                          & ஒரு_கணு.கணு_நிதி & ", சேய்கள் " & சேய்_கூட்டல்);
        }
    }
    திரும்பு சரி(மெய்);
}
