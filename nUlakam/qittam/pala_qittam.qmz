// __nUlakam/qittam/pala_qittam.qmz — பல திட்டம் (the portfolio: many projects at once)__
// திட்டத் தொகுப்பின் நிலவரம்
//
// __A PMO is asked about projects one at a time and about the portfolio all the__
// __time: how many are red, how far through the book of work are we, which__
// __client has the most in trouble. Each project's own figures come from__
// __nalam.qmz; this file folds them.__
//
// __The portfolio percentage is weighted by effort, the same way a project's is:__
// __a finished forty-hour project moves it more than a finished four-hour one,__
// __and an average of percentages would let a portfolio of tiny green projects__
// __hide one large red one. Cancelled tasks weigh nothing, as in paNi.qmz.__

இறக்கு "paNi.qmz";

// __திட்டச்_சுருக்கம்(திட்டக்_குறி, வாடிக்கையாளர், நலம்_விடை, பணிகள்) — one project, reduced to its portfolio line__
// திட்டச்_சுருக்கம்(திட்டக்_குறி, வாடிக்கையாளர், நலம்_விடை, பணிகள்) — ஒரு திட்டத்தின் தொகுப்பு வரி
//
// __நலம்_விடை is what திட்ட_நலம் returned for the project; பணிகள் are the same__
// __tasks it was given, read here for their hours. The line keeps நிறம்,__
// __நிறைவு and நிலுவைப்_பணிகள் from the health and adds மொத்த_மணி.__
செயல் திட்டச்_சுருக்கம்(திட்டக்_குறி, வாடிக்கையாளர், நலம்_விடை, பணிகள்) {
    மணிகள் = 0;
    ஒவ்வொரு ஒரு_பணி இல் பணிகள் {
        (ஒரு_பணி.நடப்பு_நிலை != "கைவிட்டது") எனில் { மணிகள் = மணிகள் + ஒரு_பணி.மதிப்பீட்டு_மணி; }
    }
    திரும்பு { திட்டக்_குறி: திட்டக்_குறி, வாடிக்கையாளர்: வாடிக்கையாளர்,
              நிறம்: நலம்_விடை.நிறம், நிறைவு: நலம்_விடை.நிறைவு,
              நிலுவைப்_பணிகள்: நலம்_விடை.நிலுவைப்_பணிகள், மொத்த_மணி: மணிகள் };
}

// __பல_திட்ட_நிலவரம்(சுருக்கங்கள்) — the portfolio's figures__
// பல_திட்ட_நிலவரம்(சுருக்கங்கள்) — திட்டத் தொகுப்பின் எண்ணிக்கைகள்
//
// __{திட்டங்கள், பச்சை, மஞ்சள், சிவப்பு, மூடியது, நிறைவு, மொத்த_மணி,__
// __நிலுவைப்_பணிகள்}. நிறைவு is weighted by each project's hours and falls back__
// __to the plain mean when no project has any. Closed projects are counted, but__
// __left out of நிறைவு and மொத்த_மணி, because a portfolio's progress and load__
// __are about the work still open.__
செயல் பல_திட்ட_நிலவரம்(சுருக்கங்கள்) {
    எண்ணிக்கை = { பச்சை: 0, மஞ்சள்: 0, சிவப்பு: 0, மூடியது: 0 };
    எடைக்_கூட்டல் = 0;
    மணிக்_கூட்டல் = 0;
    வெறுங்_கூட்டல் = 0;
    திறந்தவை = 0;
    நிலுவை_மொத்தம் = 0;
    ஒவ்வொரு சுருக்கம் இல் சுருக்கங்கள் {
        (புலம்_உள்ளதா(எண்ணிக்கை, சுருக்கம்.நிறம்)) எனில் {
            எண்ணிக்கை[சுருக்கம்.நிறம்] = எண்ணிக்கை[சுருக்கம்.நிறம்] + 1;
        }
        நிலுவை_மொத்தம் = நிலுவை_மொத்தம் + சுருக்கம்.நிலுவைப்_பணிகள்;
        (சுருக்கம்.நிறம் != "மூடியது") எனில் {
            எடைக்_கூட்டல் = எடைக்_கூட்டல் + சுருக்கம்.நிறைவு * சுருக்கம்.மொத்த_மணி;
            மணிக்_கூட்டல் = மணிக்_கூட்டல் + சுருக்கம்.மொத்த_மணி;
            வெறுங்_கூட்டல் = வெறுங்_கூட்டல் + சுருக்கம்.நிறைவு;
            திறந்தவை = திறந்தவை + 1;
        }
    }
    நிறைவு = 0;
    (திறந்தவை > 0) எனில் { நிறைவு = வட்டமிடு(வெறுங்_கூட்டல் / திறந்தவை, 0); }
    (மணிக்_கூட்டல் > 0) எனில் { நிறைவு = வட்டமிடு(எடைக்_கூட்டல் / மணிக்_கூட்டல், 0); }
    திரும்பு { திட்டங்கள்: நீளம்(சுருக்கங்கள்), பச்சை: எண்ணிக்கை.பச்சை, மஞ்சள்: எண்ணிக்கை.மஞ்சள்,
              சிவப்பு: எண்ணிக்கை.சிவப்பு, மூடியது: எண்ணிக்கை.மூடியது, நிறைவு: நிறைவு,
              மொத்த_மணி: மணிக்_கூட்டல், நிலுவைப்_பணிகள்: நிலுவை_மொத்தம் };
}

// __வாடிக்கையாளர்_வாரியாக(சுருக்கங்கள்) — the same figures, one set per client__
// வாடிக்கையாளர்_வாரியாக(சுருக்கங்கள்) — வாடிக்கையாளர் வாரியான எண்ணிக்கைகள்
//
// __A list of {வாடிக்கையாளர், நிலவரம்}, clients in the order they first appear,__
// __each நிலவரம் exactly what பல_திட்ட_நிலவரம் gives for that client's projects.__
செயல் வாடிக்கையாளர்_வாரியாக(சுருக்கங்கள்) {
    வரிசை_பெயர்கள் = [];
    குழுக்கள் = {};
    ஒவ்வொரு சுருக்கம் இல் சுருக்கங்கள் {
        (இல்லை புலம்_உள்ளதா(குழுக்கள், சுருக்கம்.வாடிக்கையாளர்)) எனில் {
            குழுக்கள்[சுருக்கம்.வாடிக்கையாளர்] = [];
            வரிசை_பெயர்கள் = இணை(வரிசை_பெயர்கள், சுருக்கம்.வாடிக்கையாளர்);
        }
        குழுக்கள்[சுருக்கம்.வாடிக்கையாளர்] = இணை(குழுக்கள்[சுருக்கம்.வாடிக்கையாளர்], சுருக்கம்);
    }
    விடை_பட்டி = [];
    ஒவ்வொரு பெயர்_ஒன்று இல் வரிசை_பெயர்கள் {
        விடை_பட்டி = இணை(விடை_பட்டி, { வாடிக்கையாளர்: பெயர்_ஒன்று,
                                       நிலவரம்: பல_திட்ட_நிலவரம்(குழுக்கள்[பெயர்_ஒன்று]) });
    }
    திரும்பு விடை_பட்டி;
}
