// __பெற்றோர்_முன்_வரிசை(பதிவுகள், குறிப்_புலம், பெற்றோர்_புலம்) — order a flat tree parents first__
// பெற்றோரை முதலில் வைத்து வரிசைப்படுத்தும்

இறக்கு "../paNi.qmz";

// __Tasks from an approved change request, listed children first. Creating them__
// __in this order would fail: S.1.1 needs S.1's new id.__
// குழந்தைகள் முதலில் உள்ள பட்டியல்; இவ்வரிசையில் உருவாக்க முடியாது
பணிகள் = [பணி_ஆக்கு("S.1.1", "S.1", "செய்யவேண்டியது", 0, 8, ""),
          பணி_ஆக்கு("S.1", "S", "செய்யவேண்டியது", 0, 16, ""),
          பணி_ஆக்கு("S", "", "செய்யவேண்டியது", 0, 0, ""),
          பணி_ஆக்கு("S.2", "S", "செய்யவேண்டியது", 0, 4, "")];
ஒவ்வொரு ஒரு_பணி இல் மதிப்பு(பெற்றோர்_முன்_வரிசை(பணிகள், "பணி_குறி", "பெற்றோர்_குறி")) {
    அச்சு ஒரு_பணி.பணி_குறி;
}

// __Note S.2 comes out before S.1. The list is walked in passes, and S.1 was__
// __passed over before S was placed, so the order is by pass, not the input's.__
// ஒவ்வொரு கடப்பிலும் வைக்கக்கூடியவை வைக்கப்படும்; ஆகவே வரிசை உள்ளீட்டு வரிசையல்ல

// __A parent outside the list already exists elsewhere, so its child is a root.__
// பட்டியலுக்கு வெளியே உள்ள பெற்றோர் ஏற்கனவே உள்ளது; குழந்தை வேராகும்
உள்ளவை = [பணி_ஆக்கு("E.9.1", "E.9", "செய்யவேண்டியது", 0, 8, "")];
அச்சு நீளம்(மதிப்பு(பெற்றோர்_முன்_வரிசை(உள்ளவை, "பணி_குறி", "பெற்றோர்_குறி")));

// __Two tasks that each name the other as parent have no order, and are refused.__
// ஒன்றையொன்று பெற்றோராகக் கொண்டவை வரிசைப்பட முடியாது
சுழல் = [பணி_ஆக்கு("A", "B", "செய்யவேண்டியது", 0, 1, ""),
         பணி_ஆக்கு("B", "A", "செய்யவேண்டியது", 0, 1, "")];
அச்சு தவறு_மதிப்பு(பெற்றோர்_முன்_வரிசை(சுழல், "பணி_குறி", "பெற்றோர்_குறி"));
