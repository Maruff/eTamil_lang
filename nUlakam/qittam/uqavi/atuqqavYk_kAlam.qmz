// அடுத்த படிகளுக்குப் பார்க்கும் நாட்கள்

இறக்கு "../paNi.qmz";
இறக்கு "../nilY_aRikkY.qmz";

அச்சு அடுத்தவைக்_காலம்();

// __Today is 28 September. A task planned to start on 12 October, exactly__
// __fourteen days out, is a next step; one starting the day after is not yet.__
// பதினான்காம் நாள் தொடங்குவது அடுத்த படி; பதினைந்தாம் நாள் இன்னும் இல்லை
இன்று = "2026-09-28";
உள்ளே = பணி_ஆக்கு("T-21", "", "செய்யவேண்டியது", 0, 16, "2026-10-20");
உள்ளே["தொடக்க_நாள்"] = "2026-10-12";
வெளியே = பணி_ஆக்கு("T-22", "", "செய்யவேண்டியது", 0, 16, "2026-10-20");
வெளியே["தொடக்க_நாள்"] = "2026-10-13";

விடை = அறிக்கை_வேட்பாளர்கள்([உள்ளே, வெளியே], அறிக்கைக்_காலம்("2026-09-21", இன்று), இன்று);
ஒவ்வொரு ஒரு_பணி இல் விடை.அடுத்தவை {
    அச்சு ஒரு_பணி.பணி_குறி;
}
