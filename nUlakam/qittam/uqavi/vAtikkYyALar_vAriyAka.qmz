// __வாடிக்கையாளர்_வாரியாக(சுருக்கங்கள்) — the same figures, one set per client__
// வாடிக்கையாளர் வாரியான எண்ணிக்கைகள்

இறக்கு "../paNi.qmz";
இறக்கு "../pala_qittam.qmz";

// __Four projects across two clients, listed Globex first but interleaved.__
// இரண்டு வாடிக்கையாளர்களின் நான்கு திட்டங்கள், கலந்த வரிசையில்
சுருக்கங்கள் = [
    திட்டச்_சுருக்கம்("BK-GLB-0003", "Globex", {நிறம்: "மஞ்சள்", நிறைவு: 30, நிலுவைப்_பணிகள்: 1},
        [பணி_ஆக்கு("a", "", "நடப்பில்", 30, 80, "")]),
    திட்டச்_சுருக்கம்("BK-ACM-0001", "ACME", {நிறம்: "சிவப்பு", நிறைவு: 50, நிலுவைப்_பணிகள்: 2},
        [பணி_ஆக்கு("b", "", "நடப்பில்", 50, 40, "")]),
    திட்டச்_சுருக்கம்("BK-GLB-0004", "Globex", {நிறம்: "பச்சை", நிறைவு: 80, நிலுவைப்_பணிகள்: 0},
        [பணி_ஆக்கு("c", "", "நடப்பில்", 80, 20, "")]),
    திட்டச்_சுருக்கம்("BK-ACM-0002", "ACME", {நிறம்: "மூடியது", நிறைவு: 100, நிலுவைப்_பணிகள்: 0},
        [பணி_ஆக்கு("d", "", "மூடியது", 100, 60, "")])];

// __Clients come out in the order they first appear, not by name, each with what__
// __பல_திட்ட_நிலவரம் gives for its projects alone. Globex is (30×80 + 80×20) ÷ 100 = 40;__
// __ACME's closed project is left out of its progress, so ACME reads 50%.__
// முதலில் தோன்றிய வரிசையில்; மூடிய திட்டம் நிறைவுக் கணக்கில் இல்லை
ஒவ்வொரு ஒரு_குழு இல் வாடிக்கையாளர்_வாரியாக(சுருக்கங்கள்) {
    அச்சு ஒரு_குழு.வாடிக்கையாளர் & ": " & சொல்லாக்கு(ஒரு_குழு.நிலவரம்.திட்டங்கள்) & " திட்டம், "
          & சொல்லாக்கு(ஒரு_குழு.நிலவரம்.நிறைவு) & "%, சிவப்பு " & சொல்லாக்கு(ஒரு_குழு.நிலவரம்.சிவப்பு)
          & ", மூடியது " & சொல்லாக்கு(ஒரு_குழு.நிலவரம்.மூடியது);
}

// __The client name is matched exactly: "Acme" is a third client, not ACME.__
// பெயர் சரியாகப் பொருந்த வேண்டும்; எழுத்து அளவு வேறெனில் வேறு வாடிக்கையாளர்
அச்சு நீளம்(வாடிக்கையாளர்_வாரியாக(இணை(சுருக்கங்கள், திட்டச்_சுருக்கம்("BK-ACM-0005", "Acme",
    {நிறம்: "பச்சை", நிறைவு: 0, நிலுவைப்_பணிகள்: 0}, []))));
