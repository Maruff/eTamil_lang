// __பல_திட்ட_நிலவரம்(சுருக்கங்கள்) — the portfolio's figures__
// திட்டத் தொகுப்பின் எண்ணிக்கைகள்

இறக்கு "../paNi.qmz";
இறக்கு "../pala_qittam.qmz";

// __Three projects in the PMO book: a large red one, a small green one nearly done,__
// __and a closed 500-hour one.__
// பெரிய சிவப்புத் திட்டம், சிறிய பச்சைத் திட்டம், மூடிய திட்டம்
சுருக்கங்கள் = [
    திட்டச்_சுருக்கம்("BK-ACM-0001", "ACME", {நிறம்: "சிவப்பு", நிறைவு: 50, நிலுவைப்_பணிகள்: 2},
        [பணி_ஆக்கு("a", "", "நடப்பில்", 50, 40, "")]),
    திட்டச்_சுருக்கம்("BK-ACM-0002", "ACME", {நிறம்: "பச்சை", நிறைவு: 90, நிலுவைப்_பணிகள்: 0},
        [பணி_ஆக்கு("b", "", "நடப்பில்", 90, 10, "")]),
    திட்டச்_சுருக்கம்("BK-GLB-0003", "Globex", {நிறம்: "மூடியது", நிறைவு: 100, நிலுவைப்_பணிகள்: 0},
        [பணி_ஆக்கு("c", "", "மூடியது", 100, 500, "")])];
நிலவரம் = பல_திட்ட_நிலவரம்(சுருக்கங்கள்);
அச்சு சொல்லாக்கு(நிலவரம்.திட்டங்கள்) & " திட்டம்: பச்சை " & சொல்லாக்கு(நிலவரம்.பச்சை)
      & ", மஞ்சள் " & சொல்லாக்கு(நிலவரம்.மஞ்சள்) & ", சிவப்பு " & சொல்லாக்கு(நிலவரம்.சிவப்பு)
      & ", மூடியது " & சொல்லாக்கு(நிலவரம்.மூடியது);

// __Weighted by hours, (50×40 + 90×10) ÷ 50 = 58, not the 70 a plain mean of 50 and__
// __90 gives. The closed project is counted above but left out of progress and load.__
// மணி எடையால் 58; மூடியது எண்ணப்படும், ஆனால் நிறைவிலும் மணியிலும் இல்லை
அச்சு சொல்லாக்கு(நிலவரம்.நிறைவு) & "% நிறைவு, " & சொல்லாக்கு(நிலவரம்.மொத்த_மணி) & " மணி, "
      & சொல்லாக்கு(நிலவரம்.நிலுவைப்_பணிகள்) & " நிலுவை";

// __Projects with no estimated hours have nothing to weight, so the plain mean is used.__
// மணி இல்லாதபோது வெறும் சராசரி
அச்சு பல_திட்ட_நிலவரம்([திட்டச்_சுருக்கம்("P1", "ACME", {நிறம்: "பச்சை", நிறைவு: 20, நிலுவைப்_பணிகள்: 0}, []),
                         திட்டச்_சுருக்கம்("P2", "ACME", {நிறம்: "பச்சை", நிறைவு: 60, நிலுவைப்_பணிகள்: 0}, [])]).நிறைவு;
