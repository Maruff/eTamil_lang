// __திட்ட_நலம்(தொடக்க_நாள், முடிவு_நாள், மூடியதா, மைல்கற்கள், பணிகள், இன்றைய_நாள்) — the RAG status, with its reasons__
// திட்டத்தின் நிறக் குறியும் காரணங்களும்

இறக்கு "../paNi.qmz";
இறக்கு "../nalam.qmz";

இன்று = "2026-10-16";
மைல்கற்கள் = [மைல்கல்_ஆக்கு("M1", "2026-10-05", "2026-10-05", "2026-10-05", "எட்டியது"),
              மைல்கல்_ஆக்கு("M2", "2026-10-20", "2026-10-27", "", "தாமதம்"),
              மைல்கல்_ஆக்கு("M3", "2026-10-30", "2026-10-30", "", "இடரில்")];
பணிகள் = [பணி_ஆக்கு("T-1", "", "மூடியது", 100, 30, "2026-10-05"),
          பணி_ஆக்கு("T-2", "", "நடப்பில்", 50, 30, "2026-10-12")];

// __A delayed milestone makes it red. The reasons list every cause, red first,__
// __so the amber ones are not hidden behind it.__
// தாமதமான மைல்கல் சிவப்பாக்கும்; எல்லாக் காரணங்களும் சிவப்பு முதலில்
விடை = திட்ட_நலம்("2026-10-01", "2026-10-31", பொய், மைல்கற்கள், பணிகள், இன்று);
அச்சு விடை.நிறம்;
ஒவ்வொரு காரணம் இல் விடை.காரணங்கள் {
    அச்சு காரணம்;
}
அச்சு சொல்லாக்கு(விடை.நிறைவு) & " / " & சொல்லாக்கு(விடை.கழிந்தது);

// __With only the milestone that was met, the same tasks are amber: T-2 is overdue.__
// எட்டிய மைல்கல் மட்டும் இருந்தால் மஞ்சள்; இரண்டாம் பணி காலம் கடந்தது
அச்சு திட்ட_நலம்("2026-10-01", "2026-10-31", பொய், [மைல்கற்கள்[0]], பணிகள், இன்று).நிறம்;

// __Closed overrides everything, and carries no reasons.__
// மூடிய திட்டம் எல்லாவற்றையும் மீறும்; காரணங்கள் இல்லை
மூடியது = திட்ட_நலம்("2026-10-01", "2026-10-31", மெய், மைல்கற்கள், பணிகள், இன்று);
அச்சு மூடியது.நிறம் & " " & சொல்லாக்கு(நீளம்(மூடியது.காரணங்கள்));
