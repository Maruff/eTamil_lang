// __மாற்றத்தைப்_பணிகளாக்கு(ஒரு_கோரிக்கை, உருப்படிகள்) — an approved request's items as tasks__
// ஏற்ற கோரிக்கையின் உருப்படிகளைப் பணிகளாக்கும்

இறக்கு "../mARRak_kOrikkY.qmz";

// __CR-9 adds reporting to the signed portal scope. The items are listed child first.__
// குழந்தை முதலில் உள்ள உருப்படிகள்
உருப்படிகள் = [மாற்ற_உருப்படி_ஆக்கு("R2.1", "R2", "Export API", 8),
               மாற்ற_உருப்படி_ஆக்கு("R2", "", "Reporting", 0)];

// __Only reviewed, not yet approved: nothing is built from it.__
// மதிப்பாய்ந்தது மட்டும்; பணிகள் உருவாகாது
அச்சு தவறா(மாற்றத்தைப்_பணிகளாக்கு({மாற்றக்_குறி: "CR-9", நடப்பு_நிலை: "மதிப்பாய்ந்தது"}, உருப்படிகள்));

// __Approved, the items come back as to-do tasks, parent first, each carrying CR-9.__
// ஏற்றபின் பெற்றோர் முதலில், ஒவ்வொன்றும் கோரிக்கைக் குறியுடன்
பணிகள் = மதிப்பு(மாற்றத்தைப்_பணிகளாக்கு({மாற்றக்_குறி: "CR-9", நடப்பு_நிலை: "ஏற்றது"}, உருப்படிகள்));
ஒவ்வொரு ஒரு_பணி இல் பணிகள் {
    அச்சு ஒரு_பணி.பணி_குறி & " " & ஒரு_பணி.நடப்பு_நிலை & " " & சொல்லாக்கு(ஒரு_பணி.நிறைவு) & "% "
          & சொல்லாக்கு(ஒரு_பணி.மதிப்பீட்டு_மணி) & " " & ஒரு_பணி.மாற்றக்_குறி;
}

// __That code is what lets new top-level R2 past the signed-scope gate.__
// அக்குறியே கையொப்ப நோக்க வாயிலைக் கடக்க உதவும்
அச்சு சரியா(புதிய_பணிக்கு_அனுமதியா(மெய், "", பணிகள்[0].மாற்றக்_குறி));
அச்சு தவறா(புதிய_பணிக்கு_அனுமதியா(மெய், "", ""));

// __A revoked request is refused too: only ஏற்றது itself materialises.__
// திரும்பப்பெற்ற கோரிக்கையும் மறுக்கப்படும்
அச்சு தவறு_மதிப்பு(மாற்றத்தைப்_பணிகளாக்கு({மாற்றக்_குறி: "CR-9", நடப்பு_நிலை: "திரும்பப்பெற்றது"},
                                         உருப்படிகள்));
