// __திட்டச்_சுருக்கம்(திட்டக்_குறி, வாடிக்கையாளர், நலம்_விடை, பணிகள்) — one project, reduced to its portfolio line__
// ஒரு திட்டத்தின் தொகுப்பு வரி

இறக்கு "../paNi.qmz";
இறக்கு "../nalam.qmz";
இறக்கு "../pala_qittam.qmz";

// __ACME's billing portal on Monday 28 September: the API is half built and three__
// __days late, the UI has not started, and a 100-hour mainframe bridge was cancelled.__
// பாதி முடிந்த பணி தாமதம்; ஒன்று தொடங்கவில்லை; ஒன்று கைவிட்டது
இன்று = "2026-09-28";
பணிகள் = [பணி_ஆக்கு("API", "", "நடப்பில்", 50, 40, "2026-09-25"),
          பணி_ஆக்கு("UI", "", "செய்யவேண்டியது", 0, 24, "2026-10-16"),
          பணி_ஆக்கு("MFB", "", "கைவிட்டது", 0, 100, "2026-10-30")];
நலம்_விடை = திட்ட_நலம்("2026-09-01", "2026-10-31", பொய், [], பணிகள், இன்று);

// __The health is computed once, then passed in with the same tasks.__
// நலம் ஒருமுறை கணிக்கப்பட்டு அதே பணிகளுடன் தரப்படும்
வரி_ஒன்று = திட்டச்_சுருக்கம்("BK-ACM-0001", "ACME", நலம்_விடை, பணிகள்);
அச்சு வரி_ஒன்று.திட்டக்_குறி & " " & வரி_ஒன்று.வாடிக்கையாளர் & " " & வரி_ஒன்று.நிறம்;
அச்சு சொல்லாக்கு(வரி_ஒன்று.நிறைவு) & "% நிறைவு, " & சொல்லாக்கு(வரி_ஒன்று.நிலுவைப்_பணிகள்) & " நிலுவை";

// __The cancelled bridge's 100 hours weigh nothing: the project is 64 hours, not 164.__
// கைவிட்ட பணியின் மணிகள் கணக்கில் இல்லை
அச்சு சொல்லாக்கு(வரி_ஒன்று.மொத்த_மணி);

// __The line does not keep the reasons; read those from the health itself.__
// காரணங்கள் சுருக்கத்தில் இல்லை; நலத்திலிருந்தே படிக்க வேண்டும்
அச்சு புலம்_உள்ளதா(வரி_ஒன்று, "காரணங்கள்");
அச்சு நலம்_விடை.காரணங்கள்[0];
