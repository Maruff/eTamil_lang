// இன்றைய நிலையில் அட்டவணை

இறக்கு "../../nAtkAtti/vElYnAL.qmz";
இறக்கு "../paNi.qmz";
இறக்கு "../maRu_attavaNY.qmz";

// __A portal release begun Monday 28 September; today is Wednesday 7 October. UX design__
// __is done, the UI 40% built, the report cancelled; training waits for 20 October.__
// வடிவமைப்பு முடிந்தது; உருவாக்கம் நடப்பில்; பயிற்சி அக்டோபர் 20 வரை காத்திருக்கும்
வார_நாட்கள் = நாட்காட்டி_ஆக்கு([0, 6], []);
வடிவு = அட்டவணைக்கு_அமை(பணி_ஆக்கு("UX", "", "மூடியது", 100, 32, ""), 4, []);
வடிவு["உண்மைத்_தொடக்கம்"] = "2026-09-28";
வடிவு["முடிந்த_நாள்"] = "2026-10-01";
கட்டல் = அட்டவணைக்கு_அமை(பணி_ஆக்கு("UI", "", "நடப்பில்", 40, 40, ""), 5, ["UX"]);
கட்டல்["உண்மைத்_தொடக்கம்"] = "2026-10-02";
பயிற்சி = அட்டவணைக்கு_அமை(பணி_ஆக்கு("TRN", "", "செய்யவேண்டியது", 0, 8, ""), 1, []);
பயிற்சி["முந்தாத_நாள்"] = "2026-10-20";
விடை = மதிப்பு(மறு_அட்டவணையிடு([வடிவு, கட்டல்,
    அட்டவணைக்கு_அமை(பணி_ஆக்கு("QA", "", "செய்யவேண்டியது", 0, 24, ""), 3, ["UI"]),
    அட்டவணைக்கு_அமை(பணி_ஆக்கு("GO", "", "செய்யவேண்டியது", 0, 0, ""), 0, ["QA"]),
    அட்டவணைக்கு_அமை(பணி_ஆக்கு("RPT", "", "கைவிட்டது", 0, 8, ""), 2, ["UX"]),
    பயிற்சி], "2026-09-28", "2026-10-07", வார_நாட்கள்));
ஒவ்வொரு ஒரு_பணி இல் விடை.பணிகள் {
    அச்சு ஒரு_பணி.பணி_குறி & " " & ஒரு_பணி.தொடக்க_நாள் & ".." & ஒரு_பணி.முடிவு_நாள் & " "
          & ஒரு_பணி.நங்கூரம் & " " & சொல்லாக்கு(ஒரு_பணி.மிதப்பு);
}
அச்சு விடை.திட்ட_முடிவு_நாள்;
// __The UI keeps its real start; only its three days left run from today. Training sets__
// __the finish (float 0). A predecessor that is not in the list is refused, not ignored.__
// மீதி நாட்கள் இன்றிலிருந்து; பயிற்சியே முடிவைத் தீர்மானிக்கும்; இல்லாத முன்னோடி மறுக்கப்படும்
அச்சு தவறா(மறு_அட்டவணையிடு([அட்டவணைக்கு_அமை(பணி_ஆக்கு("UAT", "", "செய்யவேண்டியது", 0, 8, ""),
    2, ["QA"])], "2026-09-28", "2026-10-07", வார_நாட்கள்));
