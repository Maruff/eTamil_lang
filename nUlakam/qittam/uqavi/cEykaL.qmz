// __சேய்கள்(கணுக்கள், பெற்றோர்_குறி) — a node's immediate children__
// ஒரு கணுவின் நேரடிச் சேய்கள்

இறக்கு "../pakuppu.qmz";
இறக்கு "../pAqY.qmz";
இறக்கு "../qotarpu.qmz";
இறக்கு "../curukkal.qmz";
இறக்கு "../kattuppAtu.qmz";
இறக்கு "../Ittu_maqippu.qmz";
இறக்கு "../oppanqa_vakY.qmz";

கணுக்கள் = [கணு_ஆக்கு("1", "", "திட்டம்", 1000000),
             கணு_ஆக்கு("1.1", "1", "வடிவமைப்பு", 400000),
             கணு_ஆக்கு("1.2", "1", "கட்டுமானம்", 600000),
             கணு_ஆக்கு("1.1.1", "1.1", "வரைபடம்", 400000)];

// __Immediate, not every descendant: the grandchild is not a child.__
// நேரடிச் சேய்கள் மட்டுமே; பேரன் சேய் அல்ல
அச்சு நீளம்(சேய்கள்(கணுக்கள், "1"));
அச்சு நீளம்(சேய்கள்(கணுக்கள், "1.1"));
அச்சு நீளம்(சேய்கள்(கணுக்கள், "1.2"));
