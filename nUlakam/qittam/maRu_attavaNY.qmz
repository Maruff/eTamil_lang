// __nUlakam/qittam/maRu_attavaNY.qmz — மறு அட்டவணை (rescheduling a project already under way)__
// நடப்பிலுள்ள திட்டத்தை மீண்டும் அட்டவணையிடுதல்
//
// __attavaNY.qmz lays out a plan that has not started. Nobody reschedules a plan__
// __that has not started. By the time the question is asked, some work is done,__
// __some is half done, and the rest is waiting — and each of the three has to be__
// __treated differently or the new schedule is fiction:__
//
//   __done          sits on its actual dates. It happened when it happened.__
//   __in progress   keeps its actual start, and only the work left is laid out,__
//                 __from today. Moving its start would rewrite history.__
//   __not started   starts no earlier than today, the project start, its own__
//                 __முந்தாத_நாள் and the working day after its last predecessor__
//                 __finishes — the latest of the four.__
//
// __Cancelled work is left out altogether, and constrains nothing after it.__
// __முந்தாத_நாள் ("not before") is how a phase floor is expressed: give every__
// __task in a phase the phase's earliest start.__
//
// __Dependencies are finish-to-start, and everything is in working days on the__
// __calendar given. A zero-day task is a milestone and falls on the day its last__
// __predecessor finishes. The backward pass gives each task its late finish and__
// __its float in working days. Float can be negative: when an actual date is later__
// __than the plan allowed, the tasks behind it are late already, and a negative__
// __float is how the schedule says so.__
//
// __Tasks are paNi.qmz records given a duration and predecessors by__
// __அட்டவணைக்கு_அமை, so the same records carry status, progress and schedule.__

இறக்கு "../atippatY/kaNiqam.qmz";
இறக்கு "../atippatY/aNi.qmz";
இறக்கு "../nAtkAtti/mAqam.qmz";
இறக்கு "../nAtkAtti/vElYnAL.qmz";
இறக்கு "paNi.qmz";
இறக்கு "attavaNY.qmz";

// __அட்டவணைக்கு_அமை(ஒரு_பணி, கால_அளவு, முன்னோடிகள்) — give a task what the scheduler needs__
// அட்டவணைக்கு_அமை(ஒரு_பணி, கால_அளவு, முன்னோடிகள்) — பணிக்குக் கால அளவும் முன்னோடிகளும் தரும்
//
// __கால_அளவு is working days (0 for a milestone); முன்னோடிகள் a list of task__
// __codes. The optional dates the scheduler reads are added empty if missing:__
// __உண்மைத்_தொடக்கம் (actual start), முடிந்த_நாள் (actual finish) and__
// __முந்தாத_நாள் (not before). Set them on the returned record as they become known.__
செயல் அட்டவணைக்கு_அமை(ஒரு_பணி, கால_அளவு, முன்னோடிகள்) {
    புதியது = ஒரு_பணி;
    புதியது["கால_அளவு"] = கால_அளவு;
    புதியது["முன்னோடிகள்"] = முன்னோடிகள்;
    ஒவ்வொரு புலப்_பெயர் இல் ["உண்மைத்_தொடக்கம்", "முடிந்த_நாள்", "முந்தாத_நாள்"] {
        (இல்லை புலம்_உள்ளதா(புதியது, புலப்_பெயர்)) எனில் { புதியது[புலப்_பெயர்] = ""; }
    }
    திரும்பு புதியது;
}

// __மறு_அட்டவணையிடு(பணிகள், திட்டத்_தொடக்கம், இன்றைய_நாள், ஒரு_நாட்காட்டி) — the schedule as of today__
// மறு_அட்டவணையிடு(பணிகள், திட்டத்_தொடக்கம், இன்றைய_நாள், ஒரு_நாட்காட்டி) — இன்றைய நிலையில் அட்டவணை
//
// __சரி({பணிகள், திட்டத்_தொடக்க_நாள், திட்ட_முடிவு_நாள்}). Each task comes back,__
// __in the order given, with தொடக்க_நாள், முடிவு_நாள், பிந்தைய_முடிவு_நாள் (late__
// __finish), மிதப்பு (float, working days), கடும்_பாதையா (float ≤ 0 and not done)__
// __and நங்கூரம் — what fixed it: "உண்மை" (actual dates), "நடப்பில்" (actual__
// __start, remaining work), "திட்டம்" (planned) or "கைவிட்டது" (left out, dates "").__
//
// __தவறு when a predecessor is not in the list, or the predecessors form a cycle:__
// __either would otherwise produce dates that look right and are not.__
//
// __A done task with no actual start is placed from its predecessors like planned__
// __work but without today's floor — it happened, and only when is unknown.__
செயல் மறு_அட்டவணையிடு(பணிகள், திட்டத்_தொடக்கம், இன்றைய_நாள், ஒரு_நாட்காட்டி) {
    குறியால் = {};
    ஒவ்வொரு ஒரு_பணி இல் பணிகள் { குறியால்[ஒரு_பணி.பணி_குறி] = ஒரு_பணி; }
    பின்வருபவை = {};
    ஒவ்வொரு ஒரு_பணி இல் பணிகள் { பின்வருபவை[ஒரு_பணி.பணி_குறி] = []; }
    ஒவ்வொரு ஒரு_பணி இல் பணிகள் {
        ஒவ்வொரு முன் இல் ஒரு_பணி.முன்னோடிகள் {
            (இல்லை புலம்_உள்ளதா(குறியால், முன்)) எனில் {
                திரும்பு தவறு(ஒரு_பணி.பணி_குறி & " இன் முன்னோடி " & முன் & " பட்டியலில் இல்லை  (predecessor "
                               & முன் & " of " & ஒரு_பணி.பணி_குறி & " is not in the list)");
            }
            பின்வருபவை[முன்] = இணை(பின்வருபவை[முன்], ஒரு_பணி.பணி_குறி);
        }
    }

    // __Predecessors first. Swept to a fixed point, like பெற்றோர்_முன்_வரிசை; what__
    // __is left unplaced is on a cycle.__
    இட்ட_வரிசை = [];
    வைத்தவை = {};
    முன்னேற்றம் = மெய்;
    (முன்னேற்றம்) சுற்று {
        முன்னேற்றம் = பொய்;
        ஒவ்வொரு ஒரு_பணி இல் பணிகள் {
            (இல்லை புலம்_உள்ளதா(வைத்தவை, ஒரு_பணி.பணி_குறி)) எனில் {
                தயார் = மெய்;
                ஒவ்வொரு முன் இல் ஒரு_பணி.முன்னோடிகள் {
                    (இல்லை புலம்_உள்ளதா(வைத்தவை, முன்)) எனில் { தயார் = பொய்; }
                }
                (தயார்) எனில் {
                    இட்ட_வரிசை = இணை(இட்ட_வரிசை, ஒரு_பணி);
                    வைத்தவை[ஒரு_பணி.பணி_குறி] = மெய்;
                    முன்னேற்றம் = மெய்;
                }
            }
        }
    }
    (நீளம்(இட்ட_வரிசை) < நீளம்(பணிகள்)) எனில் {
        திரும்பு தவறு("முன்னோடிகளில் சுழற்சி உள்ளது  (the predecessors form a cycle)");
    }

    தொடக்க_எல்லை = மதிப்பு(நகர்த்தி_வேலை_நாள்(திட்டத்_தொடக்கம், ஒரு_நாட்காட்டி));
    இன்று_வேலை = மதிப்பு(நகர்த்தி_வேலை_நாள்(இன்றைய_நாள், ஒரு_நாட்காட்டி));

    // __Forward: the earliest each task can be, given what has already happened.__
    தொடக்கங்கள் = {};
    முடிவுகள் = {};
    நங்கூரங்கள் = {};
    ஒவ்வொரு ஒரு_பணி இல் இட்ட_வரிசை {
        குறி = ஒரு_பணி.பணி_குறி;
        நாட்கள் = ஒரு_பணி.கால_அளவு;
        பணி_நிலை = ஒரு_பணி.நடப்பு_நிலை;
        உண்மை = புலம்_அல்லது(ஒரு_பணி, "உண்மைத்_தொடக்கம்", "");
        முன்_முடிவு = "";
        ஒவ்வொரு முன் இல் ஒரு_பணி.முன்னோடிகள் { முன்_முடிவு = பிந்தையது(முன்_முடிவு, முடிவுகள்[முன்]); }

        (பணி_நிலை == "கைவிட்டது") எனில் {
            தொடக்கங்கள்[குறி] = "";
            முடிவுகள்[குறி] = "";
            நங்கூரங்கள்[குறி] = "கைவிட்டது";
        } இன்றேல் {
            (பணி_முடிந்ததா(பணி_நிலை) மற்றும் உண்மை != "") எனில் {
                தொடக்கம் = உண்மை;
                முடிவு = புலம்_அல்லது(ஒரு_பணி, "முடிந்த_நாள்", "");
                (முடிவு == "") எனில் {
                    முடிவு = மதிப்பு(வேலை_நாட்களைக்_கூட்டு(தொடக்கம், பெரியது(0, நாட்கள் - 1), ஒரு_நாட்காட்டி));
                }
                நங்கூரங்கள்[குறி] = "உண்மை";
            } இன்றேல் {
                (பணி_நிலை == "நடப்பில்" மற்றும் உண்மை != "") எனில் {
                    தொடக்கம் = உண்மை;
                    மீதி_நாள்_எண் = மீதி_நாட்கள்(நாட்கள், ஒரு_பணி.நிறைவு);
                    அடி = பிந்தையது(தொடக்கம், இன்று_வேலை);
                    முடிவு = அடி;
                    (மீதி_நாள்_எண் > 0) எனில் {
                        முடிவு = மதிப்பு(வேலை_நாட்களைக்_கூட்டு(அடி, மீதி_நாள்_எண் - 1, ஒரு_நாட்காட்டி));
                    }
                    நங்கூரங்கள்[குறி] = "நடப்பில்";
                } இன்றேல் {
                    எல்லை = தொடக்க_எல்லை;
                    முந்தாதது = புலம்_அல்லது(ஒரு_பணி, "முந்தாத_நாள்", "");
                    (முந்தாதது != "") எனில் {
                        எல்லை = பிந்தையது(எல்லை, மதிப்பு(நகர்த்தி_வேலை_நாள்(முந்தாதது, ஒரு_நாட்காட்டி)));
                    }
                    (இல்லை பணி_முடிந்ததா(பணி_நிலை)) எனில் { எல்லை = பிந்தையது(எல்லை, இன்று_வேலை); }
                    (நாட்கள் == 0) எனில் {
                        தொடக்கம் = பிந்தையது(எல்லை, முன்_முடிவு);
                        முடிவு = தொடக்கம்;
                    } இன்றேல் {
                        (முன்_முடிவு != "") எனில் {
                            எல்லை = பிந்தையது(எல்லை, மதிப்பு(அடுத்த_வேலை_நாள்(முன்_முடிவு, ஒரு_நாட்காட்டி)));
                        }
                        தொடக்கம் = எல்லை;
                        முடிவு = மதிப்பு(வேலை_நாட்களைக்_கூட்டு(தொடக்கம், நாட்கள் - 1, ஒரு_நாட்காட்டி));
                    }
                    நங்கூரங்கள்[குறி] = "திட்டம்";
                }
            }
            தொடக்கங்கள்[குறி] = தொடக்கம்;
            முடிவுகள்[குறி] = முடிவு;
        }
    }

    திட்ட_முடிவு = "";
    ஒவ்வொரு ஒரு_பணி இல் பணிகள் { திட்ட_முடிவு = பிந்தையது(திட்ட_முடிவு, முடிவுகள்[ஒரு_பணி.பணி_குறி]); }

    // __Backward: the latest each task can finish without moving the project's end.__
    பிந்தைய_முடிவுகள் = {};
    பிந்தைய_தொடக்கங்கள் = {};
    ஒவ்வொரு ஒரு_பணி இல் தலைகீழ்(இட்ட_வரிசை) {
        குறி = ஒரு_பணி.பணி_குறி;
        (நங்கூரங்கள்[குறி] != "கைவிட்டது") எனில் {
            பிந்தியது = திட்ட_முடிவு;
            ஒவ்வொரு பின் இல் பின்வருபவை[குறி] {
                (நங்கூரங்கள்[பின்] != "கைவிட்டது") எனில் {
                    வேட்பு = பிந்தைய_தொடக்கங்கள்[பின்];
                    (குறியால்[பின்].கால_அளவு > 0) எனில் {
                        வேட்பு = மதிப்பு(வேலை_நாட்களைக்_கூட்டு(வேட்பு, 0 - 1, ஒரு_நாட்காட்டி));
                    }
                    (வேட்பு < பிந்தியது) எனில் { பிந்தியது = வேட்பு; }
                }
            }
            பிந்தைய_முடிவுகள்[குறி] = பிந்தியது;
            பிந்தைய_தொடக்கங்கள்[குறி] = பிந்தியது;
            (ஒரு_பணி.கால_அளவு > 0) எனில் {
                பிந்தைய_தொடக்கங்கள்[குறி] = மதிப்பு(வேலை_நாட்களைக்_கூட்டு(பிந்தியது,
                    0 - (ஒரு_பணி.கால_அளவு - 1), ஒரு_நாட்காட்டி));
            }
        }
    }

    விடை_பட்டி = [];
    ஒவ்வொரு ஒரு_பணி இல் பணிகள் {
        குறி = ஒரு_பணி.பணி_குறி;
        புதியது = ஒரு_பணி;
        புதியது["தொடக்க_நாள்"] = தொடக்கங்கள்[குறி];
        புதியது["முடிவு_நாள்"] = முடிவுகள்[குறி];
        புதியது["நங்கூரம்"] = நங்கூரங்கள்[குறி];
        (நங்கூரங்கள்[குறி] == "கைவிட்டது") எனில் {
            புதியது["பிந்தைய_முடிவு_நாள்"] = "";
            புதியது["மிதப்பு"] = 0;
            புதியது["கடும்_பாதையா"] = பொய்;
        } இன்றேல் {
            முடிவு = முடிவுகள்[குறி];
            பிந்தியது = பிந்தைய_முடிவுகள்[குறி];
            மிதப்பு = வேலை_நாட்களை_எண்ணு(முடிவு, பிந்தியது, ஒரு_நாட்காட்டி) - 1;
            (பிந்தியது < முடிவு) எனில் {
                மிதப்பு = 0 - (வேலை_நாட்களை_எண்ணு(பிந்தியது, முடிவு, ஒரு_நாட்காட்டி) - 1);
            }
            புதியது["பிந்தைய_முடிவு_நாள்"] = பிந்தியது;
            புதியது["மிதப்பு"] = மிதப்பு;
            புதியது["கடும்_பாதையா"] = மிதப்பு <= 0 மற்றும் நங்கூரங்கள்[குறி] != "உண்மை";
        }
        விடை_பட்டி = இணை(விடை_பட்டி, புதியது);
    }
    திரும்பு சரி({ பணிகள்: விடை_பட்டி, திட்டத்_தொடக்க_நாள்: தொடக்க_எல்லை,
                  திட்ட_முடிவு_நாள்: திட்ட_முடிவு });
}

// __துணைச்_சாளரங்கள்(தொடக்க_நாள், முடிவு_நாள், எண்ணிக்கை, ஒரு_நாட்காட்டி) — split a parent's window across its sub-tasks__
// துணைச்_சாளரங்கள்(தொடக்க_நாள், முடிவு_நாள், எண்ணிக்கை, ஒரு_நாட்காட்டி) — பெற்றோரின் காலத்தைத் துணைப் பணிகளுக்குப் பகிரும்
//
// __Sub-tasks with no dates of their own share their parent's window in order,__
// __each taking an equal run of working days; the last also takes whatever the__
// __division leaves over, so the windows end exactly when the parent does. A__
// __window shorter than the sub-tasks gives each one day, and the later ones sit__
// __on the parent's last day rather than past it. சரி with the list of__
// __{தொடக்கம், முடிவு}, or தவறு for a count below one.__
செயல் துணைச்_சாளரங்கள்(தொடக்க_நாள், முடிவு_நாள், எண்ணிக்கை, ஒரு_நாட்காட்டி) {
    (எண்ணிக்கை < 1) எனில் {
        திரும்பு தவறு("துணைப் பணிகள் ஒன்றாவது வேண்டும்  (there must be at least one sub-task)");
    }
    முதல் = மதிப்பு(நகர்த்தி_வேலை_நாள்(தொடக்க_நாள், ஒரு_நாட்காட்டி));
    சாளர_நாட்கள் = வேலை_நாட்களை_எண்ணு(முதல், முடிவு_நாள், ஒரு_நாட்காட்டி);
    ஒவ்வொன்றும் = பெரியது(1, தரை(சாளர_நாட்கள் / எண்ணிக்கை));
    கடைசி_நாள் = மதிப்பு(வேலை_நாட்களைக்_கூட்டு(முதல், பெரியது(0, சாளர_நாட்கள் - 1), ஒரு_நாட்காட்டி));
    விடை_பட்டி = [];
    வரிசை_இடம் = 0;
    (வரிசை_இடம் < எண்ணிக்கை) சுற்று {
        தொடக்கம் = மதிப்பு(வேலை_நாட்களைக்_கூட்டு(முதல், வரிசை_இடம் * ஒவ்வொன்றும், ஒரு_நாட்காட்டி));
        முடிவு = மதிப்பு(வேலை_நாட்களைக்_கூட்டு(முதல், (வரிசை_இடம் + 1) * ஒவ்வொன்றும் - 1, ஒரு_நாட்காட்டி));
        (வரிசை_இடம் == எண்ணிக்கை - 1) எனில் { முடிவு = கடைசி_நாள்; }
        (தொடக்கம் > கடைசி_நாள்) எனில் { தொடக்கம் = கடைசி_நாள்; }
        (முடிவு > கடைசி_நாள்) எனில் { முடிவு = கடைசி_நாள்; }
        விடை_பட்டி = இணை(விடை_பட்டி, { தொடக்கம்: தொடக்கம், முடிவு: முடிவு });
        வரிசை_இடம் = வரிசை_இடம் + 1;
    }
    திரும்பு சரி(விடை_பட்டி);
}
