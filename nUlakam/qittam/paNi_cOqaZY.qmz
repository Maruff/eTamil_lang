// __பணி_சோதனை — tests for the task, schedule, health and change-control modules__
// பணி, அட்டவணை, நலம், மாற்றக் கட்டுப்பாட்டுத் தொகுதிகளுக்கான சோதனைகள்
//
// __Run it like any other program:  etamil --vm nUlakam/qittam/paNi_cOqaZY.qmz__
// __It exits non-zero if anything fails, so it works as a CI step.__
//
// __The fixture is one small delivery project, used throughout:__
//
//   __A    parent            40 h   in progress, due 2026-09-01 (overdue)__
//   __├── A1  closed         30 h   100%__
//   __└── A2  in progress    10 h    50%, due 2026-10-30__
//   __B    cancelled          0 h    20%, due 2026-01-01__
//
// __Today is 2026-09-28 unless a test says otherwise.__

இறக்கு "../cOqaZY/cOqaZY.qmz";
இறக்கு "nilYmARRam.qmz";
இறக்கு "paNi.qmz";
இறக்கு "attavaNY.qmz";
இறக்கு "nalam.qmz";
இறக்கு "mARRak_kOrikkY.qmz";
இறக்கு "nilY_aRikkY.qmz";

ஓட்டம் = சோதனை_தொடக்கம்("திட்டம் — tasks, schedule, health, change control");

இன்று_நாள் = "2026-09-28";
பணிகள் = [பணி_ஆக்கு("A", "", "நடப்பில்", 0, 40, "2026-09-01"),
          பணி_ஆக்கு("A1", "A", "மூடியது", 100, 30, ""),
          பணி_ஆக்கு("A2", "A", "நடப்பில்", 50, 10, "2026-10-30"),
          பணி_ஆக்கு("B", "", "கைவிட்டது", 20, 0, "2026-01-01")];

// =========================================================================
// __பணி — status, priority, lock, roll-up__
// =========================================================================

ஓட்டம் = உறுதிசெய்(ஓட்டம், பணி_முடிந்ததா("தீர்ந்தது"), "resolved counts as done");
ஓட்டம் = உறுதிசெய்(ஓட்டம், இல்லை பணி_முடிந்ததா("கைவிட்டது"), "cancelled does not count as done");
ஓட்டம் = உறுதிசெய்(ஓட்டம், பணி_நிலுவையா(பணிகள்[0], இன்று_நாள்), "A is past its due date and open");
ஓட்டம் = உறுதிசெய்(ஓட்டம், இல்லை பணி_நிலுவையா(பணிகள்[3], இன்று_நாள்), "a cancelled task is never overdue");
ஓட்டம் = உறுதிசெய்(ஓட்டம், இல்லை பணி_நிலுவையா(பணிகள்[1], இன்று_நாள்), "a task with no due date is never overdue");

ஓட்டம் = சமம்(ஓட்டம், முன்னுரிமை_தரம்("மிக_உயர்"), 0, "critical sorts first");
ஓட்டம் = சமம்(ஓட்டம், முன்னுரிமை_தரம்("தெரியாது"), 9, "an unknown priority sorts last");

ஓட்டம் = சமம்(ஓட்டம், நிலைக்கான_நிறைவு("மூடியது", 40), 100, "closing sets 100%");
ஓட்டம் = சமம்(ஓட்டம், நிலைக்கான_நிறைவு("செய்யவேண்டியது", 40), 0, "back to to-do resets to 0%");
ஓட்டம் = சமம்(ஓட்டம், நிலைக்கான_நிறைவு("கைவிட்டது", 40), 40, "cancelling keeps the progress made");

ஓட்டம் = உறுதிசெய்(ஓட்டம், சரியா(பூட்டிய_மாற்றம்_சரியா({நிறைவு: 60, நடப்பு_நிலை: "நடப்பில்"})),
                  "progress fields may change on a baselined task");
ஓட்டம் = உறுதிசெய்(ஓட்டம், தவறா(பூட்டிய_மாற்றம்_சரியா({நிறைவு: 60, இறுதி_நாள்: "2026-11-01"})),
                  "a planned date may not");
ஓட்டம் = உறுதிசெய்(ஓட்டம், சரியா(பூட்டிய_மாற்றம்_சரியா({நடப்பு_நிலை: "மூடியது", முடிந்த_நாள்: "2026-10-01"})),
                  "but an actual finish may: finishing a baselined task is progress");

ஓட்டம் = சமம்(ஓட்டம், திரட்டிய_நிறைவு(பணிகள், "A"), 75, "A is the mean of 100 and 50");
ஓட்டம் = சமம்(ஓட்டம், திரட்டிய_நிறைவு(பணிகள், "A2"), 50, "a leaf reports its own figure");
ஓட்டம் = சமம்(ஓட்டம், திரட்டிய_நிறைவு(பணிகள், "Z"), 0, "an unknown code is 0");

// __(40×0 + 30×100 + 10×50 + 0×20) ÷ 80 = 43.75, rounded to 44.__
ஓட்டம் = சமம்(ஓட்டம், எடையிட்ட_நிறைவு(பணிகள்), 44, "effort-weighted percentage");
ஓட்டம் = சமம்(ஓட்டம், எடையிட்ட_நிறைவு([பணி_ஆக்கு("X", "", "நடப்பில்", 30, 0, ""),
                                          பணி_ஆக்கு("Y", "", "நடப்பில்", 60, 0, "")]),
              45, "with no estimates it falls back to the plain mean");
ஓட்டம் = சமம்(ஓட்டம், எடையிட்ட_நிறைவு([]), 0, "an empty list is 0");
ஓட்டம் = சமம்(ஓட்டம், எடையிட்ட_நிறைவு([பணி_ஆக்கு("X", "", "கைவிட்டது", 80, 10, ""),
                                          பணி_ஆக்கு("Y", "", "செய்யவேண்டியது", 0, 10, "")]),
              0, "cancelled work does not count towards the project");

பெற்றோர்_வரிசை = பெற்றோர்_முன்_வரிசை([பணிகள்[1], பணிகள்[2], பணிகள்[0]], "பணி_குறி", "பெற்றோர்_குறி");
ஓட்டம் = சமம்(ஓட்டம், மதிப்பு(பெற்றோர்_வரிசை)[0].பணி_குறி, "A", "the parent comes first even when listed last");
ஓட்டம் = உறுதிசெய்(ஓட்டம், தவறா(பெற்றோர்_முன்_வரிசை(
                      [{குறி: "P", பெற்றோர்: "Q"}, {குறி: "Q", பெற்றோர்: "P"}], "குறி", "பெற்றோர்")),
                  "a parent cycle is refused");

// =========================================================================
// __அட்டவணை — the network on the calendar__
// =========================================================================
//
// __A (3 days) then B (2) and C (1) in parallel, from Friday 2 October 2026,__
// __with the weekend off and Tuesday 6 October a holiday.__

ஓட்டம் = சமம்(ஓட்டம், மணியிலிருந்து_நாட்கள்(40, 8), 5, "40 hours is 5 days");
ஓட்டம் = சமம்(ஓட்டம், மணியிலிருந்து_நாட்கள்(41, 8), 6, "41 hours rounds up to 6");
ஓட்டம் = சமம்(ஓட்டம், மணியிலிருந்து_நாட்கள்(0, 8), 1, "no estimate still takes a day");
ஓட்டம் = சமம்(ஓட்டம், மீதி_நாட்கள்(10, 90), 1, "90% of ten days leaves one");
ஓட்டம் = சமம்(ஓட்டம், மீதி_நாட்கள்(10, 100), 0, "a finished task needs none");

வலை = மதிப்பு(வலையைக்_கணக்கிடு([செயல்_ஆக்கு("A", 3, []), செயல்_ஆக்கு("B", 2, ["A"]),
                                   செயல்_ஆக்கு("C", 1, ["A"])]));
நாட்காட்டி = நாட்காட்டி_ஆக்கு([0, 6], ["2026-10-06"]);
இட்டது = மதிப்பு(நாட்காட்டியில்_இடு(வலை, "2026-10-02", நாட்காட்டி));
ஓட்டம் = சமம்(ஓட்டம், இட்டது.செயல்கள்[0].முடிவு_நாள், "2026-10-07",
              "A skips the weekend and the holiday");
ஓட்டம் = சமம்(ஓட்டம், இட்டது.செயல்கள்[1].தொடக்க_நாள், "2026-10-08", "B starts the working day after A");
ஓட்டம் = சமம்(ஓட்டம், இட்டது.செயல்கள்[2].பிந்தைய_தொடக்க_நாள், "2026-10-09",
              "C may start as late as the Friday");
ஓட்டம் = சமம்(ஓட்டம், இட்டது.திட்ட_முடிவு_நாள், "2026-10-09", "the project finishes with B");
மைல்_வலை = மதிப்பு(வலையைக்_கணக்கிடு([செயல்_ஆக்கு("A", 3, []), செயல்_ஆக்கு("G", 0, ["A"])]));
மைல்_இட்டது = மதிப்பு(நாட்காட்டியில்_இடு(மைல்_வலை, "2026-10-02", நாட்காட்டி));
ஓட்டம் = சமம்(ஓட்டம், மைல்_இட்டது.செயல்கள்[1].தொடக்க_நாள், மைல்_இட்டது.திட்ட_முடிவு_நாள்,
              "a closing milestone is on the finish date, not the day after");
சனி_தொடக்கம் = மதிப்பு(நாட்காட்டியில்_இடு(வலை, "2026-10-03", நாட்காட்டி));
ஓட்டம் = சமம்(ஓட்டம், சனி_தொடக்கம்.திட்டத்_தொடக்க_நாள், "2026-10-05",
              "a Saturday start moves to Monday");

// =========================================================================
// __நலம் — milestones and RAG__
// =========================================================================

மைல்கற்கள் = [மைல்கல்_ஆக்கு("M1", "2026-09-01", "2026-09-05", "2026-09-04", "எட்டியது"),
              மைல்கல்_ஆக்கு("M2", "2026-10-01", "2026-10-10", "", "இடரில்")];
ஓட்டம் = சமம்(ஓட்டம், மைல்கல்_வேறுபாடு(மைல்கற்கள்[0]), 3, "a met milestone measures from its actual");
ஓட்டம் = சமம்(ஓட்டம், மைல்கல்_வேறுபாடு(மைல்கற்கள்[1]), 9, "an open one from its forecast");

ஓட்டம் = சமம்(ஓட்டம், கழிந்த_சதவீதம்("2026-09-01", "2026-11-01", "2026-10-01"), 49, "30 of 61 days");
ஓட்டம் = சமம்(ஓட்டம், கழிந்த_சதவீதம்("2026-09-01", "2026-11-01", "2026-08-01"), 0, "before the start is 0");
ஓட்டம் = சமம்(ஓட்டம், கழிந்த_சதவீதம்("2026-09-01", "2026-11-01", "2027-01-01"), 100, "after the end is 100");

இரண்டு = [பணி_ஆக்கு("A", "", "நடப்பில்", 20, 10, "2026-09-20"), பணி_ஆக்கு("B", "", "மூடியது", 100, 10, "")];
நல = திட்ட_நலம்("2026-09-01", "2026-11-01", பொய், மைல்கற்கள், இரண்டு, "2026-10-01");
ஓட்டம் = சமம்(ஓட்டம், நல.நிறம், "மஞ்சள்", "at-risk milestone and an overdue task make amber");
ஓட்டம் = சமம்(ஓட்டம், நீளம்(நல.காரணங்கள்), 2, "and both reasons are given");
ஓட்டம் = சமம்(ஓட்டம், திட்ட_நலம்("2026-09-01", "2026-09-30", பொய், [], இரண்டு, "2026-10-01").நிறம்,
              "சிவப்பு", "past the end with work left is red");
ஓட்டம் = சமம்(ஓட்டம், திட்ட_நலம்("2026-09-01", "2026-09-30", மெய், [], இரண்டு, "2026-10-01").நிறம்,
              "மூடியது", "a closed project is closed, whatever else is true");
ஓட்டம் = சமம்(ஓட்டம், திட்ட_நலம்("2026-09-01", "2026-11-01", பொய், [],
                                 [பணி_ஆக்கு("A", "", "நடப்பில்", 30, 10, "")], "2026-10-01").நிறம்,
              "மஞ்சள்", "30% done at 49% of the calendar trails by more than 10 points");

// =========================================================================
// __நிலை மாற்றம் and மாற்றக் கோரிக்கை__
// =========================================================================

வரைவு = மாற்றக்_கோரிக்கை_வரைவு();
ஒரு_கோரிக்கை = {குறி: "CR-7", நடப்பு_நிலை: "கோரியது"};
நகர்வு = நிலையை_நகர்த்து(ஒரு_கோரிக்கை, வரைவு, "மதிப்பாய்ந்தது", "அருண்", இன்று_நாள்);
ஓட்டம் = சமம்(ஓட்டம், மதிப்பு(நகர்வு).புதிய_பதிவு.மதிப்பாய்ந்தவர், "அருண்", "the reviewer is stamped");
ஓட்டம் = சமம்(ஓட்டம், மதிப்பு(நகர்வு).நிகழ்வு.இருந்து, "கோரியது", "and the event says where it came from");
ஓட்டம் = சமம்(ஓட்டம், ஒரு_கோரிக்கை.நடப்பு_நிலை, "கோரியது", "the original record is untouched");
ஓட்டம் = உறுதிசெய்(ஓட்டம், தவறா(நிலையை_நகர்த்து(ஒரு_கோரிக்கை, வரைவு, "ஏற்றது", "அருண்", இன்று_நாள்)),
                  "approval cannot skip review");
ஓட்டம் = உறுதிசெய்(ஓட்டம், இல்லை இறுதி_நிலையா(வரைவு, "ஏற்றது"), "approval can still be revoked");
திரும்பியது = மதிப்பு(நிலையை_நகர்த்து({நடப்பு_நிலை: "ஏற்றது"}, வரைவு, "திரும்பப்பெற்றது", "மீனா", இன்று_நாள்));
ஓட்டம் = சமம்(ஓட்டம், திரும்பியது.புதிய_பதிவு.முடிவு_நாள், இன்று_நாள், "a terminal move stamps the decision date");
ஓட்டம் = சமம்(ஓட்டம், நீளம்(அடுத்த_நிலைகள்(வரைவு, "கோரியது")), 3, "three ways out of requested");
ஓட்டம் = சமம்(ஓட்டம், நீளம்(அடுத்த_நிலைகள்(வரைவு, "தெரியாதது")), 0, "none out of an unknown state");

ஓட்டம் = உறுதிசெய்(ஓட்டம், சரியா(புதிய_பணிக்கு_அனுமதியா(பொய், "", "")), "before sign-off anything goes");
ஓட்டம் = உறுதிசெய்(ஓட்டம், தவறா(புதிய_பணிக்கு_அனுமதியா(மெய், "", "")), "after, new scope needs a CR");
ஓட்டம் = உறுதிசெய்(ஓட்டம், சரியா(புதிய_பணிக்கு_அனுமதியா(மெய், "A", "")), "a sub-task never does");
ஓட்டம் = உறுதிசெய்(ஓட்டம், சரியா(புதிய_பணிக்கு_அனுமதியா(மெய், "", "CR-7")), "and one with a CR is allowed");

// =========================================================================
// __நிலை அறிக்கை — the status report__
// =========================================================================

காலம் = அறிக்கைக்_காலம்("2026-09-21", இன்று_நாள்);
