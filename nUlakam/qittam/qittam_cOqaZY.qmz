// SPDX-License-Identifier: AGPL-3.0-or-later
// Copyright (C) 2026 Mohammed Maruff (Esan Maruff) <esan@etamil.in>
// __திட்டம்_சோதனை — tests for the project costing modules, written in eTamil__
//
// __Run it like any other program:  etamil --vm nUlakam/qittam/qittam_cOqaZY.qmz__
// __It exits non-zero if anything fails, so it works as a CI step.__
//
// __The figures are chosen so every answer divides cleanly and can be checked by__
// __eye. Where a result is not exactly representable in binary floating point it__
// __is asserted within a tolerance rather than for equality, and said so.__

இறக்கு "../cOqaZY/cOqaZY.qmz";
இறக்கு "../atippatY/kaNiqam.qmz";
இறக்கு "pakuppu.qmz";
இறக்கு "kattuppAtu.qmz";
இறக்கு "Ittu_maqippu.qmz";
இறக்கு "pAqY.qmz";
இறக்கு "curukkal.qmz";
இறக்கு "oppanqa_vakY.qmz";
இறக்கு "qotarpu.qmz";

ஓட்டம் = சோதனை_தொடக்கம்("திட்டம் — project costing");

// =========================================================================
// __வேலைப் பகுப்பு — the WBS__
// =========================================================================
//
//   __S  1750__
//   __├── S1   310   (leaf)__
//   __├── S2   720__
//   __│   ├── S2a  400__
//   __│   └── S2b  320__
//   __└── S3   720   (leaf)__

கணுக்கள் = [
    கணு_ஆக்கு("S",   "",   "திட்டம் சங்கமம்", 1750),
    கணு_ஆக்கு("S1",  "S",  "வடிவமைப்பு",      310),
    கணு_ஆக்கு("S2",  "S",  "கட்டமைப்பு",      720),
    கணு_ஆக்கு("S2a", "S2", "நிதி அமைப்பு",    400),
    கணு_ஆக்கு("S2b", "S2", "செலவு தொகுதி",   320),
    கணு_ஆக்கு("S3",  "S",  "தரவு இடமாற்றம்",  720)
];

ஓட்டம் = சமம்(ஓட்டம், நீளம்(மூலங்கள்(கணுக்கள்)), 1, "the tree has one root");
ஓட்டம் = சமம்(ஓட்டம், நீளம்(சேய்கள்(கணுக்கள், "S")), 3, "the root has three children");
ஓட்டம் = சமம்(ஓட்டம், நீளம்(வேலைத்_தொகுப்புகள்(கணுக்கள்)), 4,
              "and four leaves, which are the work packages");
ஓட்டம் = உறுதிசெய்(ஓட்டம், இலைக்_கணுவா(கணுக்கள், "S2a"),
                  "S2a has no children, so it is a work package");
ஓட்டம் = உறுதிசெய்(ஓட்டம், இல்லை இலைக்_கணுவா(கணுக்கள், "S2"),
                  "S2 has children, so it is not");

// __Depth is per branch, not global: the WBS stops where an owner can be held__
// __to a cost, and that is level 1 on one branch and level 2 on another.__
ஓட்டம் = சமம்(ஓட்டம், ஆழம்(கணுக்கள், "S"), 0, "the root is at depth 0");
ஓட்டம் = சமம்(ஓட்டம், ஆழம்(கணுக்கள், "S1"), 1, "S1 at depth 1");
ஓட்டம் = சமம்(ஓட்டம், ஆழம்(கணுக்கள், "S2b"), 2, "S2b at depth 2");

// __The roll-up sums leaves, so it answers what the work actually adds to.__
ஓட்டம் = சமம்(ஓட்டம், உள்_கூட்டல்(கணுக்கள், "S2"), 720, "S2 rolls up to 720");
ஓட்டம் = சமம்(ஓட்டம், உள்_கூட்டல்(கணுக்கள், "S"), 1750,
              "and the whole tree to 1,750 — 310 + 400 + 320 + 720");
ஓட்டம் = சமம்(ஓட்டம், உள்_கூட்டல்(கணுக்கள், "S1"), 310,
              "a leaf rolls up to itself");

// __The 100% rule holds here, at both levels.__
ஓட்டம் = உறுதிசெய்(ஓட்டம், நூறு_விதி_சரியா(கணுக்கள், "S"),
                  "the root's entered budget equals its children's");
ஓட்டம் = உறுதிசெய்(ஓட்டம், நூறு_விதி_சரியா(கணுக்கள், "S2"), "and S2's does too");
ஓட்டம் = உறுதிசெய்(ஓட்டம், நூறு_விதி_சரியா(கணுக்கள், "S1"),
                  "a leaf satisfies it trivially");
ஓட்டம் = உறுதிசெய்(ஓட்டம், சரியா(விதியை_சரிபார்(கணுக்கள்)),
                  "so the whole tree passes");

// __Break it: 20 of work that is in no child. Invisible in a tree view, and__
// __exactly what the rule exists to find.__
உடைந்த_கணுக்கள் = [
    கணு_ஆக்கு("S",  "",  "திட்டம்", 1750),
    கணு_ஆக்கு("S1", "S", "ஒன்று",    900),
    கணு_ஆக்கு("S2", "S", "இரண்டு",   830)
];
ஓட்டம் = உறுதிசெய்(ஓட்டம், இல்லை நூறு_விதி_சரியா(உடைந்த_கணுக்கள், "S"),
                  "1,750 entered against 1,730 of children breaks the 100% rule");
ஓட்டம் = உறுதிசெய்(ஓட்டம், தவறா(விதியை_சரிபார்(உடைந்த_கணுக்கள்)),
                  "and the check reports it rather than returning a bare false");

// =========================================================================
// __கட்டுப்பாட்டுக் கணக்கு — control accounts, budget, reserves__
// =========================================================================

கணக்குகள் = [
    கட்டுப்பாட்டுக்_கணக்கு_ஆக்கு("SNG-DES", "S1", "நிரஞ்சனா"),
    கட்டுப்பாட்டுக்_கணக்கு_ஆக்கு("SNG-BLD", "S2", "பாலமுரளி"),
    கட்டுப்பாட்டுக்_கணக்கு_ஆக்கு("SNG-MIG", "S3", "ஸ்வேதா")
];

// __Exactly one control account on the path from every work package to the root.__
ஓட்டம் = சமம்(ஓட்டம், பாதையில்_கணக்குகள்(கணக்குகள், கணுக்கள், "S2a"), 1,
              "S2a reaches exactly one control account, at S2");
ஓட்டம் = சமம்(ஓட்டம், பாதையில்_கணக்குகள்(கணக்குகள், கணுக்கள், "S1"), 1,
              "S1 is itself one");
ஓட்டம் = உறுதிசெய்(ஓட்டம், சரியா(கட்டமைப்பை_சரிபார்(கணக்குகள், கணுக்கள்)),
                  "so the structure is sound");

// __Two on one path is double counting; it is invisible in a tree and shows up__
// __only in the totals, which is the worst combination available.__
மிகை_கணக்குகள் = இணை(கணக்குகள், கட்டுப்பாட்டுக்_கணக்கு_ஆக்கு("SNG-ALL", "S", "கணேஷ்"));
ஓட்டம் = சமம்(ஓட்டம், பாதையில்_கணக்குகள்(மிகை_கணக்குகள், கணுக்கள், "S2a"), 2,
              "adding one at the root puts two on S2a's path");
ஓட்டம் = உறுதிசெய்(ஓட்டம், தவறா(கட்டமைப்பை_சரிபார்(மிகை_கணக்குகள், கணுக்கள்)),
                  "and the check refuses it");

// __The time-phased budget. PV is cumulative by definition.__
பகிர்வுகள் = [
    காலப்_பகிர்வு(1, 100), காலப்_பகிர்வு(2, 150), காலப்_பகிர்வு(3, 250),
    காலப்_பகிர்வு(4, 300), காலப்_பகிர்வு(5, 200)
];
ஓட்டம் = சமம்(ஓட்டம், திரட்டிய_நிதி(பகிர்வுகள், 3), 500,
              "planned value at period 3 is 100 + 150 + 250, not 250");
ஓட்டம் = சமம்(ஓட்டம், திரட்டிய_நிதி(பகிர்வுகள், 1), 100, "and at period 1, 100");
ஓட்டம் = சமம்(ஓட்டம், மொத்த_நிதி(பகிர்வுகள்), 1000, "the phasing totals 1,000");
ஓட்டம் = சமம்(ஓட்டம், திரட்டிய_நிதி(பகிர்வுகள், 5), மொத்த_நிதி(பகிர்வுகள்),
              "and the cumulative at the last period is that total");

// __Reserves. Contingency sits inside the measurement baseline; management__
// __reserve sits outside it.__
தொகுதி = நிதித்_தொகுதி_ஆக்கு(1650, 100, 100);
ஓட்டம் = சமம்(ஓட்டம், அளவீட்டு_அடிப்படை(தொகுதி), 1750,
              "the measurement baseline is 1,650 + 100 contingency");
ஓட்டம் = சமம்(ஓட்டம், அனுமதித்த_நிதி(தொகுதி), 1850,
              "and authorised funding adds the 100 management reserve");

விடுவித்தது = இருப்பை_விடுவி(தொகுதி, 60);
ஓட்டம் = உறுதிசெய்(ஓட்டம், சரியா(விடுவித்தது), "releasing 60 of reserve is allowed");
ஓட்டம் = சமம்(ஓட்டம், அளவீட்டு_அடிப்படை(மதிப்பு(விடுவித்தது)), 1810,
              "which raises the baseline to 1,810");
ஓட்டம் = சமம்(ஓட்டம், அனுமதித்த_நிதி(மதிப்பு(விடுவித்தது)), 1850,
              "but leaves authorised funding untouched — a transfer, not new money");
ஓட்டம் = உறுதிசெய்(ஓட்டம், தவறா(இருப்பை_விடுவி(தொகுதி, 500)),
                  "releasing more than the reserve holds is refused");
ஓட்டம் = உறுதிசெய்(ஓட்டம், தவறா(இருப்பை_விடுவி(தொகுதி, 0)),
                  "and so is releasing nothing");

// =========================================================================
// __ஈட்டு மதிப்பு — earned value__
// =========================================================================

// __The three percent-complete conventions.__
ஓட்டம் = சமம்(ஓட்டம், முறை_0_100(பொய்), 0, "0/100 credits nothing until done");
ஓட்டம் = சமம்(ஓட்டம், முறை_0_100(மெய்), 1, "and everything when it is");
ஓட்டம் = சமம்(ஓட்டம், முறை_50_50(மெய், பொய்), 0.5, "50/50 credits half on starting");
ஓட்டம் = சமம்(ஓட்டம், முறை_50_50(பொய், பொய்), 0, "nothing before that");
ஓட்டம் = சமம்(ஓட்டம், முறை_50_50(மெய், மெய்), 1, "and all of it on finishing");
ஓட்டம் = சமம்(ஓட்டம், முறை_மைல்கற்கள்([0.2, 0.25]), 0.45,
              "weighted milestones credit only what was achieved");
ஓட்டம் = சமம்(ஓட்டம், ஈட்டிய_மதிப்பு(400, 0.45), 180,
              "a 400 package 45% done has earned 180 of budget — not of cost");

// __The month-10 position. Note what the conventional report says first.__
திட்டமிட்டது = 800;
ஈட்டியது = 620;
உண்மைச்_செலவு = 775;
மொத்த_நிதி = 1550;

ஓட்டம் = சமம்(ஓட்டம், கணக்கியல்_வேறுபாடு(திட்டமிட்டது, உண்மைச்_செலவு), 25,
              "spend against budget reads +25 — apparently favourable");
ஓட்டம் = சமம்(ஓட்டம், செலவு_வேறுபாடு(ஈட்டியது, உண்மைச்_செலவு), -155,
              "but the work done cost 155 more than it was budgeted to");
ஓட்டம் = சமம்(ஓட்டம், கால_வேறுபாடு(ஈட்டியது, திட்டமிட்டது), -180,
              "and 180 of budgeted work has not been done at all");

// __That contrast is the entire argument for the technique: the conventional__
// __report and the real position disagree in direction, not just in degree.__
ஓட்டம் = உறுதிசெய்(ஓட்டம்,
                  கணக்கியல்_வேறுபாடு(திட்டமிட்டது, உண்மைச்_செலவு) > 0
                  மற்றும் செலவு_வேறுபாடு(ஈட்டியது, உண்மைச்_செலவு) < 0,
                  "so a favourable spend report hides an adverse cost variance");

ஓட்டம் = சமம்(ஓட்டம், மதிப்பு(செலவுச்_செயல்திறன்(ஈட்டியது, உண்மைச்_செலவு)), 0.8,
              "CPI is 0.8 — 80 paise of value per rupee spent");
ஓட்டம் = சமம்(ஓட்டம், மதிப்பு(காலச்_செயல்திறன்(ஈட்டியது, திட்டமிட்டது)), 0.775,
              "SPI is 0.775");
ஓட்டம் = சமம்(ஓட்டம், மதிப்பு(நிறைவுப்_பங்கு_நிதியால்(ஈட்டியது, மொத்த_நிதி)), 40,
              "40% of the work is complete");
ஓட்டம் = உறுதிசெய்(ஓட்டம், தவறா(செலவுச்_செயல்திறன்(ஈட்டியது, 0)),
                  "and before any spend the index is refused, not infinite");

// __The three forecasts, answering three different questions.__
ஓட்டம் = சமம்(ஓட்டம், முடிவில்_மதிப்பீடு_மீதியால்(உண்மைச்_செலவு, மொத்த_நிதி,
                                                    ஈட்டியது), 1705,
              "if the overrun was a one-off, 1,705");
ஓட்டம் = சமம்(ஓட்டம், மதிப்பு(முடிவில்_மதிப்பீடு_திறனால்(மொத்த_நிதி, 0.8)), 1937.5,
              "if current efficiency persists, 1,937.50");

// __The third is 2,275 in exact arithmetic; 0.8 × 0.775 is not exactly__
// __representable in binary, so it is asserted within a rupee.__
இரண்டாலும் = முடிவில்_மதிப்பீடு_இரண்டாலும்(உண்மைச்_செலவு, மொத்த_நிதி,
                                            ஈட்டியது, 0.8, 0.775);
ஓட்டம் = உறுதிசெய்(ஓட்டம்,
                  முழுமதிப்பு(மதிப்பு(இரண்டாலும்) - 2275) < 1,
                  "and if schedule pressure persists too, about 2,275");
ஓட்டம் = உறுதிசெய்(ஓட்டம், மதிப்பு(இரண்டாலும்) > 1937.5,
                  "the three forecasts rank as they should, worst last");

ஓட்டம் = சமம்(ஓட்டம், முடிக்க_மீதி(1937.5, உண்மைச்_செலவு), 1162.5,
              "1,162.50 still to spend on the middle forecast");
ஓட்டம் = சமம்(ஓட்டம், முடிவில்_வேறுபாடு(மொத்த_நிதி, 1937.5), -387.5,
              "which overruns the budget by 387.50");

// __The sharpest figure on the report.__
ஓட்டம் = சமம்(ஓட்டம், மதிப்பு(முடிக்கத்_தேவையான_திறன்(மொத்த_நிதி, ஈட்டியது,
                                                        உண்மைச்_செலவு)), 1.2,
              "finishing within budget now needs 1.2 against the 0.8 achieved");

// __Expected duration: 31 / 0.775 is 40 in exact arithmetic, asserted loosely__
// __for the same floating-point reason.__
எதிர்_காலம் = எதிர்பார்க்கும்_காலம்(31, 0.775);
ஓட்டம் = உறுதிசெய்(ஓட்டம், முழுமதிப்பு(மதிப்பு(எதிர்_காலம்) - 40) < 0.01,
                  "a 31-period plan at SPI 0.775 forecasts about 40");

// __The whole report in one call, and its parts must agree with the pieces.__
நிலவரப்_பதிவு = நிலவரம்(திட்டமிட்டது, ஈட்டியது, உண்மைச்_செலவு, மொத்த_நிதி);
ஓட்டம் = உறுதிசெய்(ஓட்டம், சரியா(நிலவரப்_பதிவு), "the status report computes");
ஓட்டம் = சமம்(ஓட்டம், மதிப்பு(நிலவரப்_பதிவு).செலவு_வேறுபாடு, -155,
              "and carries the same cost variance");
ஓட்டம் = சமம்(ஓட்டம், மதிப்பு(நிலவரப்_பதிவு).முடிவில்_மதிப்பீடு, 1937.5,
              "and the same estimate at completion");

// =========================================================================
// __கடுமையான பாதை — CPM__
// =========================================================================
//
// __The data migration workstream. A and B start; C and D follow A; E follows__
// __B; F merges C, D and E; G finishes.__

செயல்கள் = [
    செயல்_ஆக்கு("A", 10, []),
    செயல்_ஆக்கு("B", 15, []),
    செயல்_ஆக்கு("C", 20, ["A"]),
    செயல்_ஆக்கு("D", 25, ["A"]),
    செயல்_ஆக்கு("E", 12, ["B"]),
    செயல்_ஆக்கு("F",  8, ["C", "D", "E"]),
    செயல்_ஆக்கு("G", 10, ["F"])
];

ஓட்டம் = உறுதிசெய்(ஓட்டம், இல்லை சுழற்சி_உள்ளதா(செயல்கள்),
                  "the network is acyclic");
ஓட்டம் = சமம்(ஓட்டம், நீளம்(வழித்தோன்றல்கள்(செயல்கள், "A")), 2,
              "A has two successors, C and D");

கணக்கிட்டவை = வலையைக்_கணக்கிடு(செயல்கள்);
ஓட்டம் = உறுதிசெய்(ஓட்டம், சரியா(கணக்கிட்டவை), "and both passes complete");
வலை = மதிப்பு(கணக்கிட்டவை);

ஓட்டம் = சமம்(ஓட்டம், வலை.திட்ட_காலம், 53,
              "the workstream takes 53 days — A 10, D 25, F 8, G 10");

// __The forward pass. F is a merge, so it waits for the largest EF of C (30),__
// __D (35) and E (27) — that is 35, not the average and not the first.__
ஓட்டம் = சமம்(ஓட்டம், பெறு_புலம்(வலை.செயல்கள், "D", "முந்தைய_முடிவு"), 35,
              "D finishes at 35 on the forward pass");
ஓட்டம் = சமம்(ஓட்டம், பெறு_புலம்(வலை.செயல்கள், "F", "முந்தைய_தொடக்கம்"), 35,
              "so F, a merge, starts at 35 and not at 27 or 30");
ஓட்டம் = சமம்(ஓட்டம், பெறு_புலம்(வலை.செயல்கள், "E", "முந்தைய_முடிவு"), 27,
              "E was ready at 27 and waits");

// __The backward pass and float. A is a burst, so its LF is the smallest LS of__
// __C (15) and D (10) — that is 10, which leaves it no float.__
ஓட்டம் = சமம்(ஓட்டம், பெறு_புலம்(வலை.செயல்கள், "A", "மிதப்பு"), 0,
              "A is a burst activity and has no float");
ஓட்டம் = சமம்(ஓட்டம், பெறு_புலம்(வலை.செயல்கள், "D", "மிதப்பு"), 0, "nor has D");
ஓட்டம் = சமம்(ஓட்டம், பெறு_புலம்(வலை.செயல்கள், "C", "மிதப்பு"), 5,
              "C has 5 days of float");
ஓட்டம் = சமம்(ஓட்டம், பெறு_புலம்(வலை.செயல்கள், "B", "மிதப்பு"), 8,
              "B has 8");
ஓட்டம் = சமம்(ஓட்டம், பெறு_புலம்(வலை.செயல்கள், "E", "மிதப்பு"), 8, "and so has E");

கடுமையான = கடுமையானவை(வலை);
ஓட்டம் = சமம்(ஓட்டம், நீளம்(கடுமையான), 4,
              "four activities are critical: A, D, F and G");

// __The defining property: the critical path is the longest path, so its__
// __durations sum to the project duration.__
கடுமையான_கூட்டல் = 0;
ஒவ்வொரு ஒரு_செயல் இல் கடுமையான {
    கடுமையான_கூட்டல் = கடுமையான_கூட்டல் + ஒரு_செயல்.செயல்_காலம்;
}
ஓட்டம் = சமம்(ஓட்டம், கடுமையான_கூட்டல், 53,
              "and their durations sum to the project duration, as they must");

// __A cycle must fail loudly rather than loop or overflow.__
சுழற்சி_செயல்கள் = [
    செயல்_ஆக்கு("X", 5, ["Z"]),
    செயல்_ஆக்கு("Y", 5, ["X"]),
    செயல்_ஆக்கு("Z", 5, ["Y"])
];
ஓட்டம் = உறுதிசெய்(ஓட்டம், சுழற்சி_உள்ளதா(சுழற்சி_செயல்கள்),
                  "a cycle is detected");
ஓட்டம் = உறுதிசெய்(ஓட்டம், தவறா(வலையைக்_கணக்கிடு(சுழற்சி_செயல்கள்)),
                  "and refused, rather than looping forever");

// __A predecessor that does not exist is a typo, and typos must not compute.__
ஓட்டம் = உறுதிசெய்(ஓட்டம்,
                  தவறா(வலையைக்_கணக்கிடு([செயல்_ஆக்கு("P", 3, ["இல்லாதது"])])),
                  "a named predecessor that does not exist is refused");

// =========================================================================
// __சுருக்கல் — crashing__
// =========================================================================

சுருக்கத்_தரவு = [
    செயல்_நேர_செலவு("A", 10,  400,  8,  520),
    செயல்_நேர_செலவு("C", 20, 1200, 17, 1500),
    செயல்_நேர_செலவு("D", 25, 1800, 20, 2300),
    செயல்_நேர_செலவு("F",  8,  600,  6,  760),
    செயல்_நேர_செலவு("G", 10,  500,  8,  740)
];

ஓட்டம் = சமம்(ஓட்டம், அதிகபட்ச_சுருக்கம்(சுருக்கத்_தரவு[0]), 2,
              "A can be shortened by 2 days at most");
ஓட்டம் = சமம்(ஓட்டம், மதிப்பு(செலவுச்_சரிவு(சுருக்கத்_தரவு[0])), 60,
              "at 60 a day — (520 − 400) over 2");
ஓட்டம் = சமம்(ஓட்டம், மதிப்பு(செலவுச்_சரிவு(சுருக்கத்_தரவு[3])), 80, "F costs 80");
ஓட்டம் = சமம்(ஓட்டம், மதிப்பு(செலவுச்_சரிவு(சுருக்கத்_தரவு[2])), 100, "D costs 100");
ஓட்டம் = சமம்(ஓட்டம், மதிப்பு(செலவுச்_சரிவு(சுருக்கத்_தரவு[4])), 120, "G costs 120");

// __An activity already at its crash time has no slope, so it can never be__
// __selected as cheapest by accident.__
ஓட்டம் = உறுதிசெய்(ஓட்டம்,
                  தவறா(செலவுச்_சரிவு(செயல்_நேர_செலவு("H", 4, 100, 4, 100))),
                  "an activity that cannot be shortened has no slope");

// __The choice: cheapest, and critical. C is cheaper per day than D but has__
// __float, so buying from it changes nothing.__
கடுமையான_குறிகள் = ["A", "D", "F", "G"];
வேட்பாளர் = மலிவான_வேட்பாளர்(சுருக்கத்_தரவு, கடுமையான_குறிகள்);
ஓட்டம் = உறுதிசெய்(ஓட்டம், சரியா(வேட்பாளர்), "there is a candidate");
ஓட்டம் = சமம்(ஓட்டம், மதிப்பு(வேட்பாளர்).செயல்_குறி, "A",
              "and it is A, the cheapest critical activity");
ஓட்டம் = சமம்(ஓட்டம், மதிப்பு(வேட்பாளர்).சரிவு, 60, "at 60 a day");

// __C is not offered even though it is crashable, because it is not critical —__
// __the mistake this function exists to prevent.__
ஓட்டம் = உறுதிசெய்(ஓட்டம், மதிப்பு(வேட்பாளர்).செயல்_குறி != "C",
                  "C is cheaper per day than D but has float, so it is not offered");
ஓட்டம் = உறுதிசெய்(ஓட்டம், தவறா(மலிவான_வேட்பாளர்(சுருக்கத்_தரவு, [])),
                  "with nothing critical there is no candidate");

// __When several paths are critical, one activity per path is often dearer than__
// __a single shared one. Only the comparison shows it.__
ஓட்டம் = சமம்(ஓட்டம், மதிப்பு(கூட்டுச்_சரிவு(சுருக்கத்_தரவு, ["A", "F"])), 140,
              "crashing A and F together costs 140 a day");
ஓட்டம் = உறுதிசெய்(ஓட்டம்,
                  மதிப்பு(கூட்டுச்_சரிவு(சுருக்கத்_தரவு, ["G"]))
                  < மதிப்பு(கூட்டுச்_சரிவு(சுருக்கத்_தரவு, ["A", "F"])),
                  "so a shared G at 120 beats a pair at 140");

// __Totals. Direct rises as the schedule shortens; indirect falls with it.__
ஓட்டம் = சமம்(ஓட்டம், இயல்பு_நேரடிச்_செலவு(சுருக்கத்_தரவு), 4500,
              "direct cost at normal durations is 4,500");
ஓட்டம் = சமம்(ஓட்டம், மொத்தச்_செலவு(4500, 90, 53), 9270,
              "with 90 a day of indirect over 53 days, 9,270 in all");
ஓட்டம் = சமம்(ஓட்டம், மொத்தச்_செலவு(4500 + 120, 90, 51), 9210,
              "buying 2 days from A for 120 saves 180 of indirect: 9,210");
ஓட்டம் = உறுதிசெய்(ஓட்டம், மொத்தச்_செலவு(4500 + 120, 90, 51)
                          < மொத்தச்_செலவு(4500, 90, 53),
                  "so that crash is worth making");

// __And the honest total, which usually moves the optimum earlier: project__
// __overhead is rarely the real cost of a day.__
ஓட்டம் = சமம்(ஓட்டம், தாமதச்_செலவுடன்(4500, 90, 200, 53), 19870,
              "at 200 a day of deferred benefit the same schedule costs 19,870");
ஓட்டம் = உறுதிசெய்(ஓட்டம், தாமதச்_செலவுடன்(4500, 90, 200, 53)
                          > மொத்தச்_செலவு(4500, 90, 53),
                  "which is why whose money is being optimised must be decided");

// =========================================================================
// __ஒப்பந்த வகை — who carries the cost risk__
// =========================================================================
//
// __Target cost 1,00,000; target fee 10,000, so a target price of 1,10,000;__
// __ceiling price 1,25,000; the buyer takes 75% of a variance and the seller 25%.__

ஓட்டம் = சமம்(ஓட்டம், விற்பவர்_இடர்("உறுதி_நிலை_விலை"), "முழு",
              "a firm fixed price puts the whole overrun on the seller");
ஓட்டம் = சமம்(ஓட்டம், விற்பவர்_இடர்("செலவுடன்_நிலைக்_கட்டணம்"), "இல்லை",
              "cost plus puts none of it there");
ஓட்டம் = சமம்(ஓட்டம், விற்பவர்_இடர்("நிலை_விலை_ஊக்கம்"), "பகிர்வு",
              "and the incentive form shares it, up to a point");
ஓட்டம் = சமம்(ஓட்டம், விற்பவர்_இடர்("ஏதோ"), "",
              "an unknown type answers nothing rather than guessing");

ஓட்டம் = சமம்(ஓட்டம், உறுதி_நிலை_லாபம்(110000, 90000), 20000,
              "under a fixed price every rupee saved is the seller's");
ஓட்டம் = சமம்(ஓட்டம், உறுதி_நிலை_லாபம்(110000, 130000), 0 - 20000,
              "and every rupee overspent, without comment");

ஓட்டம் = சமம்(ஓட்டம், ஊக்கக்_கட்டணம்(100000, 10000, 90000, 0.25), 12500,
              "an underrun raises the fee by the seller's share of it");
ஓட்டம் = சமம்(ஓட்டம், ஊக்கக்_கட்டணம்(100000, 10000, 130000, 0.25), 2500,
              "and an overrun lowers it — the sign works itself out");
ஓட்டம் = சமம்(ஓட்டம், ஊக்கக்_கட்டணம்(100000, 10000, 100000, 0.25), 10000,
              "at target cost the fee is the target fee");

// __--- the point of total assumption ---------------------------------------__

புள்ளி = மதிப்பு(முழுப்_பொறுப்புப்_புள்ளி(100000, 10000, 125000, 0.75));
ஓட்டம் = சமம்(ஓட்டம், புள்ளி, 120000,
              "the point of total assumption: target cost plus the room "
              & "between target and ceiling, divided by the buyer's share");

// __The formula proves itself: at the PTA the final price *is* the ceiling.__
புள்ளியில் = நிலை_விலை_ஊக்கம்(100000, 10000, 125000, 0.25, புள்ளி);
ஓட்டம் = சமம்(ஓட்டம், புள்ளியில்["இறுதி_விலை"], 125000,
              "at that cost the final price is exactly the ceiling — which is "
              & "what makes it the point");
ஓட்டம் = சமம்(ஓட்டம், புள்ளியில்["கட்டணம்"], 5000, "with 5,000 of fee left");

கீழே = நிலை_விலை_ஊக்கம்(100000, 10000, 125000, 0.25, 110000);
மேலே = நிலை_விலை_ஊக்கம்(100000, 10000, 125000, 0.25, 130000);

ஓட்டம் = சமம்(ஓட்டம், கீழே["கட்டணம்"], 7500, "below the point, fee of 7,500");
ஓட்டம் = உறுதிசெய்(ஓட்டம், இல்லை கீழே["உச்சம்_தொட்டதா"],
                  "and the ceiling has not bitten");
ஓட்டம் = சமம்(ஓட்டம், மேலே["கட்டணம்"], 0 - 5000,
              "past it the fee goes negative — the seller is paying to finish");
ஓட்டம் = உறுதிசெய்(ஓட்டம், மேலே["உச்சம்_தொட்டதா"], "because the ceiling bit");
ஓட்டம் = சமம்(ஓட்டம், மேலே["இறுதி_விலை"], 125000,
              "and the buyer pays no more than the ceiling, ever");

// __The marginal rate quadruples at the point, and nothing in the contract says so.__
ஓட்டம் = சமம்(ஓட்டம், கீழே["கட்டணம்"] - புள்ளியில்["கட்டணம்"], 2500,
              "10,000 of overrun below the point costs the seller 2,500");
ஓட்டம் = சமம்(ஓட்டம், புள்ளியில்["கட்டணம்"] - மேலே["கட்டணம்"], 10000,
              "the next 10,000 costs it 10,000 — four times the rate, at a "
              & "point that appears in none of the contract's schedules");

ஓட்டம் = உறுதிசெய்(ஓட்டம், புள்ளியைத்_தாண்டியதா(130000, புள்ளி),
                  "130,000 is past the point");
ஓட்டம் = உறுதிசெய்(ஓட்டம், இல்லை புள்ளியைத்_தாண்டியதா(120000, புள்ளி),
                  "and exactly at it is not past it");
ஓட்டம் = உறுதிசெய்(ஓட்டம், தவறா(முழுப்_பொறுப்புப்_புள்ளி(100000, 10000,
                                                            125000, 0)),
                  "with no buyer share there is no such point");
ஓட்டம் = உறுதிசெய்(ஓட்டம், தவறா(முழுப்_பொறுப்புப்_புள்ளி(100000, 10000,
                                                            105000, 0.75)),
                  "and a ceiling below the target price is refused");

// __--- cost plus ------------------------------------------------------------__

ஓட்டம் = சமம்(ஓட்டம், செலவுடன்_நிலைக்_கட்டணம்(130000, 10000)["விற்பவர்_கட்டணம்"],
              10000, "a fixed fee does not move with the cost");
ஓட்டம் = சமம்(ஓட்டம், செலவுடன்_நிலைக்_கட்டணம்(130000, 10000)["வாங்குபவர்_செலவு"],
              140000, "so the whole overrun lands on the buyer");

வரம்புடன் = செலவுடன்_ஊக்கம்(100000, 10000, 160000, 0.25, 4000, 15000);
ஓட்டம் = சமம்(ஓட்டம், வரம்புடன்["கட்டணம்_வரம்பின்றி"], 0 - 5000,
              "unbounded, a 60,000 overrun would wipe the fee out");
ஓட்டம் = சமம்(ஓட்டம், வரம்புடன்["விற்பவர்_கட்டணம்"], 4000,
              "but the floor holds it at 4,000 — the structural difference "
              & "from the fixed price incentive form, and what a buyer pays "
              & "more for");
ஓட்டம் = சமம்(ஓட்டம், செலவுடன்_ஊக்கம்(100000, 10000, 60000, 0.25, 4000,
                                        15000)["விற்பவர்_கட்டணம்"],
              15000, "and the cap holds a large underrun at 15,000");

// __--- time and materials ---------------------------------------------------__

மீறியது = நேரமும்_பொருளும்(500, 1000, 50000, 500000);
ஓட்டம் = சமம்(ஓட்டம், மீறியது["ஈட்டியது"], 550000, "550,000 of work was done");
ஓட்டம் = சமம்(ஓட்டம், மீறியது["வசூலிப்பது"], 500000, "500,000 can be billed");
ஓட்டம் = சமம்(ஓட்டம், மீறியது["வசூலிக்க_இயலாதது"], 50000,
              "and 50,000 cannot — past a not-to-exceed ceiling the seller "
              & "works for nothing, exactly as under a fixed price");
ஓட்டம் = உறுதிசெய்(ஓட்டம், மீறியது["எல்லை_தொட்டதா"], "the ceiling bit");
ஓட்டம் = உறுதிசெய்(ஓட்டம்,
                  இல்லை நேரமும்_பொருளும்(400, 1000, 50000, 500000)["எல்லை_தொட்டதா"],
                  "below it nothing changes");
ஓட்டம் = சமம்(ஓட்டம், நேரமும்_பொருளும்(500, 1000, 50000, 0)["வசூலிப்பது"],
              550000, "and with no ceiling the whole amount is billable");

// __--- the same overrun, four ways -----------------------------------------__

விளைவு = மிகைச்_செலவின்_விளைவு(100000, 10000, 125000, 0.25, 130000);
ஓட்டம் = சமம்(ஓட்டம், விளைவு["உறுதி_நிலை_விலை"], 0 - 20000,
              "a 30,000 overrun costs a fixed price seller 20,000");
ஓட்டம் = சமம்(ஓட்டம், விளைவு["நிலை_விலை_ஊக்கம்"], 0 - 5000,
              "an incentive seller 5,000");
ஓட்டம் = சமம்(ஓட்டம், விளைவு["செலவுடன்_நிலைக்_கட்டணம்"], 10000,
              "and a cost plus seller nothing at all — it still earns its fee");
ஓட்டம் = வேறுபடு(ஓட்டம், விளைவு["உறுதி_நிலை_விலை"],
                 விளைவு["செலவுடன்_நிலைக்_கட்டணம்"],
                 "the identical event, 30,000 apart — which is why a cost "
                 & "variance reported without naming the contract is half a fact");

// =========================================================================
// __தொடர்பு — the four dependency types, and lag__
// =========================================================================
//
// __Two activities, P of four days and Q of six, related four different ways.__

இரண்டு_நீளம் = [முனை_ஆக்கு("P", "", 4), முனை_ஆக்கு("Q", "", 6)];
இரண்டு_குறுகல் = [முனை_ஆக்கு("P", "", 4), முனை_ஆக்கு("Q", "", 2)];

// __காலத்தைப்_பெறு(முனைகள், தொடர்புகள்) — the project duration, for a test to assert on__
//
// __Solves the network and takes the one figure out of the result. A fixture: the tests care about how long the schedule comes to, and unwrapping the whole result in each of them would bury the assertion.__
செயல் காலத்தைப்_பெறு(முனைகள், தொடர்புகள்) {
    திரும்பு மதிப்பு(தொடர்பு_வலையைக்_கணக்கிடு(முனைகள், தொடர்புகள்))["திட்ட_காலம்"];
}

ஓட்டம் = சமம்(ஓட்டம், காலத்தைப்_பெறு(இரண்டு_நீளம்,
              [தொடர்பு_ஆக்கு("P", "Q", "முடிவு_தொடக்கம்", 0)]), 10,
              "finish-to-start puts the six after the four");
ஓட்டம் = சமம்(ஓட்டம், காலத்தைப்_பெறு(இரண்டு_நீளம்,
              [தொடர்பு_ஆக்கு("P", "Q", "முடிவு_தொடக்கம்", 2)]), 12,
              "and a lag of two adds two days of nothing");
ஓட்டம் = சமம்(ஓட்டம், காலத்தைப்_பெறு(இரண்டு_நீளம்,
              [தொடர்பு_ஆக்கு("P", "Q", "தொடக்கம்_தொடக்கம்", 0)]), 6,
              "start-to-start runs them together, so the project is the longer "
              & "of the two");
ஓட்டம் = சமம்(ஓட்டம், காலத்தைப்_பெறு(இரண்டு_நீளம்,
              [தொடர்பு_ஆக்கு("P", "Q", "தொடக்கம்_தொடக்கம்", 2)]), 8,
              "offset by two");
ஓட்டம் = சமம்(ஓட்டம், காலத்தைப்_பெறு(இரண்டு_குறுகல்,
              [தொடர்பு_ஆக்கு("P", "Q", "முடிவு_முடிவு", 3)]), 7,
              "finish-to-finish pushes the successor's *end* three past the "
              & "predecessor's");
ஓட்டம் = சமம்(ஓட்டம், காலத்தைப்_பெறு(இரண்டு_குறுகல்,
              [தொடர்பு_ஆக்கு("P", "Q", "தொடக்கம்_முடிவு", 5)]), 5,
              "start-to-finish ties the successor's end to the predecessor's "
              & "start — rare, and nearly always a mistake where it appears");

// __A relationship can bind backwards instead of forwards, which is the case__
// __people do not expect: the successor is long enough already, so the__
// __constraint gives the *predecessor* float.__
ஒட்டுதல் = மதிப்பு(தொடர்பு_வலையைக்_கணக்கிடு(இரண்டு_நீளம்,
              [தொடர்பு_ஆக்கு("P", "Q", "முடிவு_முடிவு", 0)]));
ஓட்டம் = சமம்(ஓட்டம், ஒட்டுதல்["திட்ட_காலம்"], 6,
              "finish-to-finish with a longer successor does not delay it");
ஓட்டம் = சமம்(ஓட்டம், மதிப்பு(தொடர்பு_முனையின்_புலம்(ஒட்டுதல், "P", "மிதவை")), 2,
              "but it gives the predecessor two days of float, because P must "
              & "now finish by 6");

// __--- a mixed network ------------------------------------------------------__
//
// __A(5) --FS+0--> B(3) ;  A --SS+2--> C(4) ;  B --FF+1--> D(2) ;  C --FS+3--> D__

கலவை_முனைகள் = [முனை_ஆக்கு("A", "அடித்தளம்", 5),
                  முனை_ஆக்கு("B", "சுவர்", 3),
                  முனை_ஆக்கு("C", "கம்பி", 4),
                  முனை_ஆக்கு("D", "பூச்சு", 2)];
கலவை_தொடர்புகள் = [தொடர்பு_ஆக்கு("A", "B", "முடிவு_தொடக்கம்", 0),
                     தொடர்பு_ஆக்கு("A", "C", "தொடக்கம்_தொடக்கம்", 2),
                     தொடர்பு_ஆக்கு("B", "D", "முடிவு_முடிவு", 1),
                     தொடர்பு_ஆக்கு("C", "D", "முடிவு_தொடக்கம்", 3)];

கலவை = மதிப்பு(தொடர்பு_வலையைக்_கணக்கிடு(கலவை_முனைகள், கலவை_தொடர்புகள்));

ஓட்டம் = சமம்(ஓட்டம், கலவை["திட்ட_காலம்"], 11, "the network runs eleven days");
ஓட்டம் = சமம்(ஓட்டம், மதிப்பு(தொடர்பு_முனையின்_புலம்(கலவை, "C", "முந்தி_தொடக்கம்")),
              2, "C starts on day 2, two after A, by start-to-start");
ஓட்டம் = சமம்(ஓட்டம், மதிப்பு(தொடர்பு_முனையின்_புலம்(கலவை, "D", "முந்தி_தொடக்கம்")),
              9, "D waits until 9 — C ends at 6 and the lag is three");
ஓட்டம் = சமம்(ஓட்டம், மதிப்பு(தொடர்பு_முனையின்_புலம்(கலவை, "B", "மிதவை")), 2,
              "B has two days of float");
ஓட்டம் = சமம்(ஓட்டம், மதிப்பு(தொடர்பு_முனையின்_புலம்(கலவை, "A", "மிதவை")), 0,
              "A has none");
ஓட்டம் = சமம்(ஓட்டம், நீளம்(தொடர்பு_கடுமையானவை(கலவை)), 3,
              "so three of the four are critical");

// __--- what a lag is, and what it costs -------------------------------------__

ஓட்டம் = சமம்(ஓட்டம், மொத்தத்_தாமதம்(கலவை_தொடர்புகள்), 6,
              "six days of the plan are lag");
ஓட்டம் = சமம்(ஓட்டம், மதிப்பு(தாமதப்_பங்கு(கலவை_தொடர்புகள்,
                                             கலவை["திட்ட_காலம்"])), 54.55,
              "which is more than half the project — a schedule whose critical "
              & "path runs mostly through other people's organisations");
ஓட்டம் = உறுதிசெய்(ஓட்டம், தவறா(தாமதப்_பங்கு(கலவை_தொடர்புகள், 0)),
                  "and a project with no duration has no share to report");

ஓட்டம் = சமம்(ஓட்டம், நீளம்(முன்னோட்டங்கள்(கலவை_தொடர்புகள்)), 0,
              "this network has no leads");
ஓட்டம் = உறுதிசெய்(ஓட்டம், முன்னோட்டமா(
                      தொடர்பு_ஆக்கு("A", "B", "முடிவு_தொடக்கம்", 0 - 2)),
                  "a negative lag is a lead — an assertion that the work can "
                  & "overlap, which if true means two activities rather than "
                  & "one with a lead");
ஓட்டம் = சமம்(ஓட்டம், மொத்தத்_தாமதம்(
                  [தொடர்பு_ஆக்கு("A", "B", "முடிவு_தொடக்கம்", 0 - 2)]), 0,
              "and a lead is not counted as lag — netting the two would report "
              & "neither");

// __--- what can actually be crashed -----------------------------------------__

சுருக்கம் = சுருக்கக்கூடிய_காலம்(கலவை_முனைகள், கலவை_தொடர்புகள், ["A", "C", "D"]);
ஓட்டம் = சமம்(ஓட்டம், சுருக்கம்["வேலை"], 11,
              "the critical path carries eleven days of work");
ஓட்டம் = சமம்(ஓட்டம், சுருக்கம்["தாமதம்"], 5,
              "and five days of lag between its activities");
ஓட்டம் = சமம்(ஓட்டம், சுருக்கம்["சுருக்கக்கூடியது"], 6,
              "but only six days of it can be crashed — A drives C by "
              & "start-to-start, so shortening A moves nothing at all");
ஓட்டம் = சமம்(ஓட்டம், சுருக்கம்["சுருக்க_இயலாதது"], 5,
              "leaving five days of work that is critical and not worth buying");
ஓட்டம் = வேறுபடு(ஓட்டம், சுருக்கம்["சுருக்கக்கூடியது"], சுருக்கம்["வேலை"],
                 "**an activity can have zero float and still be pointless to "
                 & "crash** — which curukkal.qmz, looking only at float, would "
                 & "happily price");

// __--- a plain finish-to-start chain agrees with the simple scheduler --------__

சங்கிலி_முனைகள் = [முனை_ஆக்கு("X", "", 4), முனை_ஆக்கு("Y", "", 6),
                    முனை_ஆக்கு("Z", "", 3)];
சங்கிலி_தொடர்புகள் = [தொடர்பு_ஆக்கு("X", "Y", "முடிவு_தொடக்கம்", 0),
                       தொடர்பு_ஆக்கு("Y", "Z", "முடிவு_தொடக்கம்", 0)];
ஓட்டம் = சமம்(ஓட்டம், காலத்தைப்_பெறு(சங்கிலி_முனைகள், சங்கிலி_தொடர்புகள்), 13,
              "with only finish-to-start and no lag this reduces to what "
              & "pAqY.qmz computes: the durations add");

// __--- refusals --------------------------------------------------------------__

ஓட்டம் = உறுதிசெய்(ஓட்டம், தவறா(தொடர்பு_வலையைக்_கணக்கிடு(கலவை_முனைகள்,
                      [தொடர்பு_ஆக்கு("A", "B", "ஏதோ", 0)])),
                  "an unknown relationship type is refused before any "
                  & "arithmetic");
ஓட்டம் = உறுதிசெய்(ஓட்டம், தவறா(தொடர்பு_வலையைக்_கணக்கிடு(கலவை_முனைகள்,
                      [தொடர்பு_ஆக்கு("A", "Z", "முடிவு_தொடக்கம்", 0)])),
                  "and so is a relationship naming an activity that does not "
                  & "exist — a lost constraint makes a project look shorter, "
                  & "which is the direction nobody questions");
ஓட்டம் = உறுதிசெய்(ஓட்டம், தவறா(தொடர்பு_வலையைக்_கணக்கிடு([], [])),
                  "a network with no activities is refused");
ஓட்டம் = உறுதிசெய்(ஓட்டம், தவறா(தொடர்பு_வலையைக்_கணக்கிடு(கலவை_முனைகள்,
                      [தொடர்பு_ஆக்கு("A", "B", "முடிவு_தொடக்கம்", 0),
                       தொடர்பு_ஆக்கு("B", "A", "முடிவு_தொடக்கம்", 0)])),
                  "and a cycle fails loudly rather than looping, which is why "
                  & "both passes run to a fixed point");
ஓட்டம் = உறுதிசெய்(ஓட்டம், தவறா(தொடர்பு_முனையின்_புலம்(கலவை, "Z", "மிதவை")),
                  "asking about an activity the result does not hold is a தவறு");

ஓட்டம் = உறுதிசெய்(ஓட்டம், தொடர்பு_வகை_சரியா("முடிவு_தொடக்கம்"),
                  "the four type names are the four the module accepts");
ஓட்டம் = உறுதிசெய்(ஓட்டம், இல்லை தொடர்பு_வகை_சரியா("FS"),
                  "and an abbreviation is not one of them");

சோதனை_முடிவு(ஓட்டம்);
