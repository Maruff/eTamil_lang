// __nUlakam/qittam/oppanqa_vakY.qmz — ஒப்பந்த வகை, and who carries the cost risk__
// ஒப்பந்த வகையும், செலவு இடரை யார் சுமப்பது என்பதும்
//
// __Everything else in this directory costs a project as though the money simply__
// __arrives. What arrives depends on the **shape of the contract**, and the__
// __shapes differ in one respect that decides everything else: who is worse off__
// __when the work costs more than expected.__
//
//   __**Firm fixed price** — the seller. Every rupee of overrun comes out of the__
//     __seller's fee, and past a point out of the seller's own pocket.__
//   __**Fixed price incentive fee** — the seller, but shared up to a ceiling,__
//     __and then wholly the seller's again. The point where that switch happens__
//     __is the point of total assumption, and it is the most useful number in__
//     __this file.__
//   __**Cost plus** — the buyer. The seller recovers cost whatever it is, so the__
//     __seller's risk is to its fee and not to its capital.__
//   __**Time and materials** — the buyer, unless a not-to-exceed ceiling is__
//     __written in, which quietly turns it into a fixed price at the top end.__
//
// __A cost overrun is the same event in all four and the money moves in__
// __different directions. A project manager who does not know which contract__
// __they are on does not know what an overrun costs them, and the commonest__
// __version of that confusion is treating a not-to-exceed time-and-materials__
// __contract as though the ceiling were a target.__

இறக்கு "../atippatY/kaNiqam.qmz";
இறக்கு "../atippatY/poruL.qmz";

// =========================================================================
// __வகைகள் — who carries the risk__
// =========================================================================
//
// விற்பவர்_இடர்(ஒப்பந்த_வகை)
//
// __How much of a cost overrun falls on the seller, as a word. It is the one__
// __question that distinguishes the types, and a table of it is more use than__
// __the names.__
//
// __"முழு" — the seller absorbs all of it.__
// __"பகிர்வு" — shared to a ceiling, then all the seller's.__
// __"கட்டணம்_மட்டும்" — the seller's fee is at risk, the cost is not.__
// __"இல்லை" — the seller recovers whatever it spends.__
// விற்பவர்_இடர்(ஒப்பந்த_வகை) — இவ்வகை ஒப்பந்தத்தில் விற்பவர் சுமக்கும் இடர்
செயல் விற்பவர்_இடர்(ஒப்பந்த_வகை) {
    (ஒப்பந்த_வகை == "உறுதி_நிலை_விலை") எனில் { திரும்பு "முழு"; }
    (ஒப்பந்த_வகை == "நிலை_விலை_ஊக்கம்") எனில் { திரும்பு "பகிர்வு"; }
    (ஒப்பந்த_வகை == "செலவுடன்_ஊக்கம்") எனில் { திரும்பு "கட்டணம்_மட்டும்"; }
    (ஒப்பந்த_வகை == "செலவுடன்_நிலைக்_கட்டணம்") எனில் { திரும்பு "இல்லை"; }
    (ஒப்பந்த_வகை == "நேரமும்_பொருளும்") எனில் { திரும்பு "இல்லை"; }
    திரும்பு "";
}

// =========================================================================
// __உறுதி நிலை விலை — firm fixed price__
// =========================================================================
//
// உறுதி_நிலை_லாபம்(ஒப்பந்த_மதிப்பு, உண்மைச்_செலவு)
//
// __The price is the price. Every rupee saved is the seller's and every rupee__
// __overspent is the seller's, and the answer goes negative without comment__
// __because that is exactly what happens.__
//
// __The buyer's cost is known on the day of signature, which is what the type is__
// __for, and is paid for in the margin the seller prices in for bearing the__
// __whole risk. A buyer who believes a fixed price contains no contingency has__
// __not thought about who else would carry it.__
// உறுதி_நிலை_லாபம்(ஒப்பந்த_மதிப்பு, உண்மைச்_செலவு) — உறுதி விலை ஒப்பந்தத்தில் லாபம்
செயல் உறுதி_நிலை_லாபம்(ஒப்பந்த_மதிப்பு, உண்மைச்_செலவு) {
    திரும்பு வட்டக்_கழி(ஒப்பந்த_மதிப்பு, உண்மைச்_செலவு);
}

// =========================================================================
// __ஊக்கக் கட்டணம் — the incentive__
// =========================================================================
//
// ஊக்கக்_கட்டணம்(இலக்குச்_செலவு, இலக்குக்_கட்டணம், உண்மைச்_செலவு,
//                 விற்பவர்_பகிர்வு)
//
// __The fee moves against the cost: an underrun raises it, an overrun lowers it,__
// __in the agreed proportion.__
//
//     __fee = target fee + (target cost − actual cost) × seller's share__
//
// __விற்பவர்_பகிர்வு is the seller's share as a fraction — 0.4 for a 60/40__
// __arrangement, where the buyer takes 60. It is a fraction and not a percentage__
// __because the two halves must sum to one, and that is easier to see and to__
// __check in this form.__
//
// __The sign works itself out. An underrun makes the bracket positive and the__
// __fee rises; an overrun makes it negative and the fee falls, which is the__
// __whole mechanism.__
// ஊக்கக்_கட்டணம்(இலக்குச்_செலவு, உண்மைச்_செலவு, இலக்குக்_கட்டணம், பகிர்வு_விகிதம்) — சேமிப்பையோ மிகையையோ பகிர்ந்த பின் கட்டணம்
செயல் ஊக்கக்_கட்டணம்(இலக்குச்_செலவு, இலக்குக்_கட்டணம், உண்மைச்_செலவு,
                      விற்பவர்_பகிர்வு) {
    திரும்பு வட்டமிடு(இலக்குக்_கட்டணம்
                       + (இலக்குச்_செலவு - உண்மைச்_செலவு) * விற்பவர்_பகிர்வு, 2);
}

// கட்டணத்தை_வரம்பிடு(கட்டணத்_தொகை, குறைந்த_கட்டணம், உச்சக்_கட்டணம்)
//
// __Cost-plus-incentive-fee arrangements bound the fee at both ends: the seller__
// __cannot lose its whole fee however badly the work goes, and cannot earn__
// __without limit however well.__
//
// __Pass 0 as the maximum for no upper bound. The minimum is taken as given,__
// __including zero — a floor of zero is a real term and means the fee can be__
// __wiped out but not go negative.__
// கட்டணத்தை_வரம்பிடு(கட்டணத்_தொகை, குறைந்த_கட்டணம், உச்சக்_கட்டணம்) — கட்டணத்தை இரு எல்லைகளுக்குள் வைக்கும்
செயல் கட்டணத்தை_வரம்பிடு(கட்டணத்_தொகை, குறைந்த_கட்டணம், உச்சக்_கட்டணம்) {
    விடை = கட்டணத்_தொகை;
    (விடை < குறைந்த_கட்டணம்) எனில் { விடை = குறைந்த_கட்டணம்; }
    (உச்சக்_கட்டணம் > 0 மற்றும் விடை > உச்சக்_கட்டணம்) எனில் {
        விடை = உச்சக்_கட்டணம்;
    }
    திரும்பு வட்டமிடு(விடை, 2);
}

// =========================================================================
// __முழுப் பொறுப்புப் புள்ளி — the point of total assumption__
// =========================================================================
//
// முழுப்_பொறுப்புப்_புள்ளி(இலக்குச்_செலவு, இலக்குக்_கட்டணம், உச்ச_விலை,
//                           வாங்குபவர்_பகிர்வு)
//
// __On a fixed price incentive contract the buyer shares an overrun **only until__
// __the price reaches the ceiling**. Past that the buyer pays no more, so every__
// __further rupee of cost is the seller's alone.__
//
//     __PTA = target cost + (ceiling price − target price) ÷ buyer's share__
//
// __where target price is target cost plus target fee.__
//
// __It is the most important number in such a contract and it appears in none of__
// __its schedules. Below it an overrun costs the seller its share; above it an__
// __overrun costs the seller everything, and the seller's marginal loss rate__
// __jumps — in the tests — from 25 paise in the rupee to 100. A seller tracking__
// __cost against the target, which is the natural thing to do, sees nothing__
// __happen at the point where its exposure quadruples.__
//
// __A buyer share of nothing is a தவறு rather than an infinity: with no sharing__
// __there is no incentive arrangement and the contract is a fixed price one,__
// __which has no such point.__
// முழுப்_பொறுப்புப்_புள்ளி(இலக்குச்_செலவு, இலக்குக்_கட்டணம், உச்ச_விலை, பகிர்வு_விகிதம்) — இதற்கு மேல் மிகையை விற்பவரே முழுவதும் சுமப்பார்
செயல் முழுப்_பொறுப்புப்_புள்ளி(இலக்குச்_செலவு, இலக்குக்_கட்டணம், உச்ச_விலை,
                                வாங்குபவர்_பகிர்வு) {
    (வாங்குபவர்_பகிர்வு <= 0) எனில் {
        திரும்பு தவறு("வாங்குபவர் பகிர்வு இல்லை  "
                       & "(with no buyer share there is no incentive "
                       & "arrangement and no point of total assumption)");
    }
    இலக்கு_விலை = இலக்குச்_செலவு + இலக்குக்_கட்டணம்;
    (உச்ச_விலை < இலக்கு_விலை) எனில் {
        திரும்பு தவறு("உச்ச விலை இலக்கு விலைக்குக் கீழே உள்ளது  "
                       & "(the ceiling price is below the target price, so the "
                       & "seller is past total assumption before it starts)");
    }
    திரும்பு சரி(வட்டமிடு(இலக்குச்_செலவு
                           + (உச்ச_விலை - இலக்கு_விலை) / வாங்குபவர்_பகிர்வு, 2));
}

// புள்ளியைத்_தாண்டியதா(உண்மைச்_செலவு, புள்ளி)
// __புள்ளியைத்_தாண்டியதா(உண்மைச்_செலவு, புள்ளி) — has cost passed the point of total assumption?__
// புள்ளியைத்_தாண்டியதா(உண்மைச்_செலவு, புள்ளி) — செலவு முழுப் பொறுப்புப் புள்ளியைத் தாண்டிவிட்டதா
//
// __Beyond it the contractor bears every further rupee, so the incentive stops working: there is nothing left to share and the only remaining question is who absorbs the overrun. The point where a cost-plus-incentive contract turns into a fixed price in all but name.__
செயல் புள்ளியைத்_தாண்டியதா(உண்மைச்_செலவு, புள்ளி) {
    திரும்பு உண்மைச்_செலவு > புள்ளி;
}

// நிலை_விலை_ஊக்கம்(இலக்குச்_செலவு, இலக்குக்_கட்டணம், உச்ச_விலை,
//                   விற்பவர்_பகிர்வு, உண்மைச்_செலவு)
//
// __The whole settlement for a fixed price incentive contract: the fee, the__
// __final price, and whether the ceiling bit.__
//
// __The ceiling applies to the **price**, not to the fee. Once it bites, the fee__
// __is whatever is left of the ceiling after the cost — which is why it can go__
// __negative, and why a seller far past the point of total assumption is paying__
// __to finish the work. Capping the fee at zero instead would hide that, and a__
// __contract that can produce it should say so.__
// நிலை_விலை_ஊக்கம்(இலக்குச்_செலவு, இலக்குக்_கட்டணம், உச்ச_விலை, பகிர்வு_விகிதம், உண்மைச்_செலவு) — நிலை விலை ஊக்க ஒப்பந்தத்தின் முடிவு
செயல் நிலை_விலை_ஊக்கம்(இலக்குச்_செலவு, இலக்குக்_கட்டணம், உச்ச_விலை,
                        விற்பவர்_பகிர்வு, உண்மைச்_செலவு) {
    கச்சாக்_கட்டணம் = ஊக்கக்_கட்டணம்(இலக்குச்_செலவு, இலக்குக்_கட்டணம்,
                                      உண்மைச்_செலவு, விற்பவர்_பகிர்வு);
    கச்சா_விலை = உண்மைச்_செலவு + கச்சாக்_கட்டணம்;

    உச்சம்_தொட்டதா = கச்சா_விலை > உச்ச_விலை;
    இறுதி_விலை = கச்சா_விலை;
    (உச்சம்_தொட்டதா) எனில் { இறுதி_விலை = உச்ச_விலை; }

    திரும்பு {"கட்டணம்": வட்டமிடு(இறுதி_விலை - உண்மைச்_செலவு, 2),
              "கட்டணம்_வரம்பின்றி": கச்சாக்_கட்டணம்,
              "இறுதி_விலை": வட்டமிடு(இறுதி_விலை, 2),
              "உச்சம்_தொட்டதா": உச்சம்_தொட்டதா,
              "விற்பவர்_லாபம்": வட்டமிடு(இறுதி_விலை - உண்மைச்_செலவு, 2)};
}

// =========================================================================
// __செலவுக் கூடு — cost plus__
// =========================================================================
//
// செலவுடன்_நிலைக்_கட்டணம்(உண்மைச்_செலவு, நிலையான_கட்டணம்)
//
// __The fee is fixed in rupees at the outset and does not move with the cost.__
// __The seller therefore has **no financial reason to control cost at all** —__
// __which is not a criticism of the type but the reason it exists: it is for__
// __work whose scope cannot be defined well enough to price, and the control has__
// __to come from somewhere other than the contract.__
//
// __The fee not moving is the point. A fee fixed as a *percentage* of cost would__
// __rise with the overrun, which is why that arrangement is prohibited in public__
// __procurement almost everywhere.__
// செலவுடன்_நிலைக்_கட்டணம்(உண்மைச்_செலவு, நிலையான_கட்டணம்) — செலவுடன் நிலையான கட்டணம்
செயல் செலவுடன்_நிலைக்_கட்டணம்(உண்மைச்_செலவு, நிலையான_கட்டணம்) {
    திரும்பு {"விற்பவர்_கட்டணம்": வட்டமிடு(நிலையான_கட்டணம், 2),
              "வாங்குபவர்_செலவு": வட்டமிடு(உண்மைச்_செலவு + நிலையான_கட்டணம், 2)};
}

// செலவுடன்_ஊக்கம்(இலக்குச்_செலவு, இலக்குக்_கட்டணம், உண்மைச்_செலவு,
//                  விற்பவர்_பகிர்வு, குறைந்த_கட்டணம், உச்சக்_கட்டணம்)
//
// __Cost plus incentive fee: the same sharing formula, bounded at both ends, and__
// __with the cost itself reimbursed whatever it turns out to be.__
//
// __There is no ceiling price and therefore no point of total assumption. The__
// __seller's exposure is bounded by the fee floor, which is the structural__
// __difference from the fixed price incentive form and the reason a buyer pays__
// __more for this one.__
// செலவுடன்_ஊக்கம்(இலக்குச்_செலவு, இலக்குக்_கட்டணம், உண்மைச்_செலவு, பகிர்வு_விகிதம்) — செலவுடன் ஊக்கக் கட்டணம்
செயல் செலவுடன்_ஊக்கம்(இலக்குச்_செலவு, இலக்குக்_கட்டணம், உண்மைச்_செலவு,
                       விற்பவர்_பகிர்வு, குறைந்த_கட்டணம், உச்சக்_கட்டணம்) {
    கச்சாக்_கட்டணம் = ஊக்கக்_கட்டணம்(இலக்குச்_செலவு, இலக்குக்_கட்டணம்,
                                      உண்மைச்_செலவு, விற்பவர்_பகிர்வு);
    கட்டணத்_தொகை = கட்டணத்தை_வரம்பிடு(கச்சாக்_கட்டணம், குறைந்த_கட்டணம்,
                                  உச்சக்_கட்டணம்);
    திரும்பு {"விற்பவர்_கட்டணம்": கட்டணத்_தொகை,
              "கட்டணம்_வரம்பின்றி": கச்சாக்_கட்டணம்,
              "வாங்குபவர்_செலவு": வட்டமிடு(உண்மைச்_செலவு + கட்டணத்_தொகை, 2)};
}

// =========================================================================
// __நேரமும் பொருளும் — time and materials__
// =========================================================================
//
// நேரமும்_பொருளும்(மணிகள், மணி_விகிதம், பொருள்_செலவு, மீற_இயலா_எல்லை)
//
// __Hours at a rate, plus materials. The rate already contains the seller's__
// __profit, so there is no separate fee.__
//
// __மீற_இயலா_எல்லை is a not-to-exceed ceiling; pass 0 for none. **A ceiling__
// __turns the top of the contract into a fixed price**, and that is the term__
// __most often misread: the buyer treats it as a budget and the seller treats it__
// __as an estimate, and both are wrong. Past the ceiling the seller works for__
// __nothing, exactly as under a firm fixed price, and the switch is invisible__
// __until it happens.__
//
// __The record says whether the ceiling bit and how many hours went unpaid,__
// __because that is the number a dispute is actually about.__
// நேரமும்_பொருளும்(மணிகள், மணி_விகிதம், பொருள்_செலவு) — நேரமும் பொருளும் அடிப்படையிலான ஒப்பந்தம்
செயல் நேரமும்_பொருளும்(மணிகள், மணி_விகிதம், பொருள்_செலவு, மீற_இயலா_எல்லை) {
    ஈட்டியது = வட்டமிடு(மணிகள் * மணி_விகிதம் + பொருள்_செலவு, 2);

    (மீற_இயலா_எல்லை <= 0 அல்லது ஈட்டியது <= மீற_இயலா_எல்லை) எனில் {
        திரும்பு {"வசூலிப்பது": ஈட்டியது,
                  "ஈட்டியது": ஈட்டியது,
                  "எல்லை_தொட்டதா": பொய்,
                  "வசூலிக்க_இயலாதது": 0};
    }

    திரும்பு {"வசூலிப்பது": வட்டமிடு(மீற_இயலா_எல்லை, 2),
              "ஈட்டியது": ஈட்டியது,
              "எல்லை_தொட்டதா": மெய்,
              "வசூலிக்க_இயலாதது": வட்டமிடு(ஈட்டியது - மீற_இயலா_எல்லை, 2)};
}

// =========================================================================
// __ஒப்பீடு — the same overrun, four ways__
// =========================================================================
//
// மிகைச்_செலவின்_விளைவு(இலக்குச்_செலவு, இலக்குக்_கட்டணம், உச்ச_விலை,
//                        விற்பவர்_பகிர்வு, உண்மைச்_செலவு)
//
// __What one overrun does to the seller's profit under each type, side by side.__
//
// __The point is how differently the same event lands. The seller's profit is__
// __identical at target cost under all of them and diverges immediately, and a__
// __project manager reporting a cost variance without saying which contract it__
// __arises under has reported half a fact.__
// மிகைச்_செலவின்_விளைவு(இலக்குச்_செலவு, இலக்குக்_கட்டணம், உச்ச_விலை, பகிர்வு_விகிதம், மிகைச்_செலவு) — மிகைச் செலவு யாரைப் பாதிக்கிறது என்பதைக் காட்டும்
செயல் மிகைச்_செலவின்_விளைவு(இலக்குச்_செலவு, இலக்குக்_கட்டணம், உச்ச_விலை,
                             விற்பவர்_பகிர்வு, உண்மைச்_செலவு) {
    இலக்கு_விலை = இலக்குச்_செலவு + இலக்குக்_கட்டணம்;
    ஊக்கம் = நிலை_விலை_ஊக்கம்(இலக்குச்_செலவு, இலக்குக்_கட்டணம், உச்ச_விலை,
                               விற்பவர்_பகிர்வு, உண்மைச்_செலவு);
    செலவுக்கூடு = செலவுடன்_நிலைக்_கட்டணம்(உண்மைச்_செலவு, இலக்குக்_கட்டணம்);

    திரும்பு {"உறுதி_நிலை_விலை": உறுதி_நிலை_லாபம்(இலக்கு_விலை, உண்மைச்_செலவு),
              "நிலை_விலை_ஊக்கம்": ஊக்கம்["விற்பவர்_லாபம்"],
              "செலவுடன்_நிலைக்_கட்டணம்": செலவுக்கூடு["விற்பவர்_கட்டணம்"],
              "உண்மைச்_செலவு": வட்டமிடு(உண்மைச்_செலவு, 2)};
}
