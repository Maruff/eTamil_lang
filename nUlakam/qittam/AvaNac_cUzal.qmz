// __nUlakam/qittam/AvaNac_cUzal.qmz — ஆவணச் சூழல் (project data, shaped for a document template)__
// திட்டத் தரவை ஆவண வார்ப்புருவுக்கு ஏற்ற வடிவில் தருதல்
//
// __vativam/AvaNam.qmz fills a template from two things: a list of values, each__
// __{குறி, மதிப்பு}, for the {{ திட்டம்.பெயர் }} placeholders, and a list of__
// __blocks, each {பெயர், புலங்கள், வரிசைகள்}, for the rows a {%tr for … %} loop__
// __repeats. It knows nothing about projects. This file turns what the other__
// __qittam modules produce into exactly those two lists, so that generating a__
// __charter or a status report is one call to build the context and one to__
// __ஆவணம்_நிரப்பு or பொதியை_நிரப்பு.__
//
// __Values are always text. Numbers go through சொல்லாக்கு, so a percentage reads__
// __44, not 44.0; nested records become dotted keys, which is how the template__
// __addresses them. Arrays are not values — they are blocks.__
//
// __Fields a template needs but no module computes — the sponsor, the objective__
// __— come from defaults layered by அடுக்கிய_இயல்புகள்: organisation-wide, then__
// __per product, then what was saved for this project, the later winning.__

இறக்கு "../atippatY/col.qmz";

// __ஆவண_மதிப்புகள்(பதிவு_தரவு, முன்னொட்டு) — a record as template values__
// ஆவண_மதிப்புகள்(பதிவு_தரவு, முன்னொட்டு) — ஒரு பதிவை வார்ப்புரு மதிப்புகளாக்கும்
//
// __The list of {குறி, மதிப்பு} ஆவணம்_நிரப்பு takes. முன்னொட்டு is put in front__
// __of every key with a dot — pass "திட்டம்" to get திட்டம்.பெயர் — or "" for__
// __none; a trailing dot on it is dropped, so "திட்டம்." cannot make a doubled__
// __one. Nested records are walked; arrays are skipped; இன்மை becomes "". The__
// __keys come in the order a record iterates, which is sorted, not the order__
// __they were written — ஆவணம்_நிரப்பு looks each one up, so order does not matter.__
செயல் ஆவண_மதிப்புகள்(பதிவு_தரவு, முன்னொட்டு) {
    (முடிகிறதா(முன்னொட்டு, ".")) சுற்று {
        முன்னொட்டு = துண்டு(முன்னொட்டு, 0, நீளம்(முன்னொட்டு) - 1);
    }
    விடை_பட்டி = [];
    ஒவ்வொரு புலப்_பெயர் இல் பதிவு_தரவு {
        முழுக்_குறி = புலப்_பெயர்;
        (முன்னொட்டு != "") எனில் { முழுக்_குறி = முன்னொட்டு & "." & புலப்_பெயர்; }
        உள்ளது = பதிவு_தரவு[புலப்_பெயர்];
        இனம் = வகை(உள்ளது);
        (இனம் == "a record") எனில் {
            ஒவ்வொரு ஒன்று இல் ஆவண_மதிப்புகள்(உள்ளது, முழுக்_குறி) { விடை_பட்டி = இணை(விடை_பட்டி, ஒன்று); }
        } இன்றேல் {
            (இனம் != "an array") எனில் {
                உரை_மதிப்பு = "";
                (இனம் != "nil") எனில் { உரை_மதிப்பு = சொல்லாக்கு(உள்ளது); }
                விடை_பட்டி = இணை(விடை_பட்டி, { "குறி": முழுக்_குறி, "மதிப்பு": உரை_மதிப்பு });
            }
        }
    }
    திரும்பு விடை_பட்டி;
}

// __அடுக்கிய_இயல்புகள்(அடுக்குகள்) — defaults from several layers, the later winning__
// அடுக்கிய_இயல்புகள்(அடுக்குகள்) — பல ஓர்_அடுக்கு இயல்புகளை இணைக்கும்; பிந்தையதே வெல்லும்
//
// __அடுக்குகள் is a list of records, most general first. A field in a later layer__
// __replaces the same field in an earlier one; nested records are merged field by__
// __field rather than replaced whole, so a product can change the sponsor without__
// __losing the organisation's address.__
செயல் அடுக்கிய_இயல்புகள்(அடுக்குகள்) {
    விடை = {};
    ஒவ்வொரு ஓர்_அடுக்கு இல் அடுக்குகள் {
        ஒவ்வொரு புலப்_பெயர் இல் ஓர்_அடுக்கு {
            புதியது = ஓர்_அடுக்கு[புலப்_பெயர்];
            (வகை(புதியது) == "a record" மற்றும் புலம்_உள்ளதா(விடை, புலப்_பெயர்)) எனில் {
                (வகை(விடை[புலப்_பெயர்]) == "a record") எனில் {
                    புதியது = அடுக்கிய_இயல்புகள்([விடை[புலப்_பெயர்], புதியது]);
                }
            }
            விடை[புலப்_பெயர்] = புதியது;
        }
    }
    திரும்பு விடை;
}

// __ஆவணத்_தொகுதி(தொகுதிப்_பெயர், புலங்கள், வரிசைகள்) — rows for one repeating block__
// ஆவணத்_தொகுதி(தொகுதிப்_பெயர், புலங்கள், வரிசைகள்) — மீளும் ஒரு தொகுதிக்கான வரிசைகள்
//
// __தொகுதிப்_பெயர் is the loop VARIABLE the template uses — பணி in "for பணி in__
// __பணிகள்" — not the collection. Each row keeps only புலங்கள், as text; a field a__
// __row lacks is "".__
செயல் ஆவணத்_தொகுதி(தொகுதிப்_பெயர், புலங்கள், வரிசைகள்) {
    வரிசைப்_பட்டி = [];
    ஒவ்வொரு ஒரு_வரிசை இல் வரிசைகள் {
        சுருக்கம் = {};
        ஒவ்வொரு புலப்_பெயர் இல் புலங்கள் {
            உள்ளது = புலம்_அல்லது(ஒரு_வரிசை, புலப்_பெயர், "");
            (உள்ளது == இன்மை) எனில் { உள்ளது = ""; }
            சுருக்கம்[புலப்_பெயர்] = சொல்லாக்கு(உள்ளது);
        }
        வரிசைப்_பட்டி = இணை(வரிசைப்_பட்டி, சுருக்கம்);
    }
    திரும்பு { "பெயர்": தொகுதிப்_பெயர், "புலங்கள்": புலங்கள், "வரிசைகள்": வரிசைப்_பட்டி };
}

// __நிலை_அறிக்கைச்_சூழல்(திட்டப்_பெயர், காலம், நலம்_விடை, வேட்பாளர்கள்) — everything a status report template reads__
// நிலை_அறிக்கைச்_சூழல்(திட்டப்_பெயர், காலம், நலம்_விடை, வேட்பாளர்கள்) — நிலை அறிக்கை வார்ப்புருவுக்கான முழுச் சூழல்
//
// __{மதிப்புகள், தொகுதிகள்}, ready for ஆவணம்_நிரப்பு. காலம் is from__
// __அறிக்கைக்_காலம், நலம்_விடை from திட்ட_நலம், வேட்பாளர்கள் from__
// __அறிக்கை_வேட்பாளர்கள். Values: திட்டம்.பெயர், காலம்.தொடக்கம்,__
// __காலம்.முடிவு, நலம்.நிறம், நலம்.நிறைவு, நலம்.கழிந்தது. Blocks, each row__
// __with பணி_குறி and விவரம்: சாதனை, தடை, அடுத்தது; and காரணம், whose rows__
// __carry காரண_உரை — the reasons behind the colour.__
செயல் நிலை_அறிக்கைச்_சூழல்(திட்டப்_பெயர், காலம், நலம்_விடை, வேட்பாளர்கள்) {
    மதிப்புகள் = ஆவண_மதிப்புகள்({
        "திட்டம்": { "பெயர்": திட்டப்_பெயர் },
        "காலம்": { "தொடக்கம்": காலம்.தொடக்கம், "முடிவு": காலம்.முடிவு },
        "நலம்": { "நிறம்": நலம்_விடை.நிறம், "நிறைவு": நலம்_விடை.நிறைவு,
                  "கழிந்தது": நலம்_விடை.கழிந்தது }
    }, "");
    காரண_வரிசைகள் = [];
    ஒவ்வொரு காரணம்_ஒன்று இல் நலம்_விடை.காரணங்கள் {
        காரண_வரிசைகள் = இணை(காரண_வரிசைகள், { "காரண_உரை": காரணம்_ஒன்று });
    }
    பணிப்_புலங்கள் = ["பணி_குறி", "விவரம்"];
    திரும்பு { மதிப்புகள்: மதிப்புகள், தொகுதிகள்: [
        ஆவணத்_தொகுதி("சாதனை", பணிப்_புலங்கள், வேட்பாளர்கள்.சாதனைகள்),
        ஆவணத்_தொகுதி("தடை", பணிப்_புலங்கள், வேட்பாளர்கள்.தடைகள்),
        ஆவணத்_தொகுதி("அடுத்தது", பணிப்_புலங்கள், வேட்பாளர்கள்.அடுத்தவை),
        ஆவணத்_தொகுதி("காரணம்", ["காரண_உரை"], காரண_வரிசைகள்)
    ] };
}

// __சாசனச்_சூழல்(திட்டத்_தரவு, பணிகள், மைல்கற்கள்) — everything a project charter template reads__
// சாசனச்_சூழல்(திட்டத்_தரவு, பணிகள், மைல்கற்கள்) — திட்டச் சாசன வார்ப்புருவுக்கான முழுச் சூழல்
//
// __திட்டத்_தரவு is the project's own record — usually அடுக்கிய_இயல்புகள் of the__
// __defaults and what was saved — and every field in it becomes திட்டம்.<field>.__
// __Added: முயற்சி.மணி, the estimated hours of the tasks that are not cancelled,__
// __and முயற்சி.நபர்_நாட்கள், those hours in eight-hour person-days to one__
// __decimal place, which is how a charter states effort. Blocks: பணி__
// __(பணி_குறி, விவரம், மதிப்பீட்டு_மணி) and மைல்கல் (மைல்கல்_குறி,__
// __அடிப்படை_நாள்). Cancelled tasks are left out of the task table as well as the__
// __total, so the two always agree.__
செயல் சாசனச்_சூழல்(திட்டத்_தரவு, பணிகள், மைல்கற்கள்) {
    மணிகள் = 0;
    செயலிலுள்ளவை = [];
    ஒவ்வொரு ஒரு_பணி இல் பணிகள் {
        (ஒரு_பணி.நடப்பு_நிலை != "கைவிட்டது") எனில் {
            மணிகள் = மணிகள் + ஒரு_பணி.மதிப்பீட்டு_மணி;
            செயலிலுள்ளவை = இணை(செயலிலுள்ளவை, ஒரு_பணி);
        }
    }
    மதிப்புகள் = ஆவண_மதிப்புகள்(திட்டத்_தரவு, "திட்டம்");
    ஒவ்வொரு ஒன்று இல் ஆவண_மதிப்புகள்({ "மணி": மணிகள், "நபர்_நாட்கள்": வட்டமிடு(மணிகள் / 8, 1) }, "முயற்சி") {
        மதிப்புகள் = இணை(மதிப்புகள், ஒன்று);
    }
    திரும்பு { மதிப்புகள்: மதிப்புகள், தொகுதிகள்: [
        ஆவணத்_தொகுதி("பணி", ["பணி_குறி", "விவரம்", "மதிப்பீட்டு_மணி"], செயலிலுள்ளவை),
        ஆவணத்_தொகுதி("மைல்கல்", ["மைல்கல்_குறி", "அடிப்படை_நாள்"], மைல்கற்கள்)
    ] };
}
