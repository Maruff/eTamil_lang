// __செலவுத்_தாள்_ஆக்கு(தரவுத்_தொகுதி) — the whole cost sheet, from one record__
// முழுச் செலவுத் தாளை உருவாக்கும்

இறக்கு "../nilYyam.qmz";
இறக்கு "../celavu_qAL.qmz";
இறக்கு "../pawkaLippu.qmz";
இறக்கு "../mElnilY.qmz";
இறக்கு "../mILpakirvu.qmz";
இறக்கு "../ceyalpAtu.qmz";
இறக்கு "../ceyalmuRY.qmz";
இறக்கு "../niyamam.qmz";

தொகுதி = {"நேரடிப்_பொருட்கள்": 400000, "நேரடி_ஊதியம்": 250000,
           "நேரடிச்_செலவுகள்": 30000, "தொழிற்சாலை_மேல்நிலை": 150000,
           "ஆரம்ப_நிறைவேறாதவை": 40000, "இறுதி_நிறைவேறாதவை": 60000,
           "நிர்வாக_மேல்நிலை": 90000, "ஆரம்ப_முடிந்தவை": 80000,
           "இறுதி_முடிந்தவை": 120000, "விற்பனை_மேல்நிலை": 70000,
           "விற்பனை_வருவாய்": 1200000, "அலகுகள்": 5000};

// __Every stage kept, not just the total. A cost sheet is read for where the__
// __cost went rather than for what it came to.__
// ஒவ்வொரு படியும் தக்கவைக்கப்படுகிறது; மொத்தம் மட்டுமல்ல
தாள் = செலவுத்_தாள்_ஆக்கு(தொகுதி);
அச்சு தாள்["முதன்மைச்_செலவு"];
அச்சு தாள்["தொழிற்சாலைச்_செலவு"];
அச்சு தாள்["உற்பத்திச்_செலவு"];
அச்சு தாள்["விற்பனைச்_செலவு"];
அச்சு தாள்["ஈட்டிய_லாபம்"];
