// SPDX-License-Identifier: AGPL-3.0-or-later
// Copyright (C) 2026 Mohammed Maruff (Esan Maruff) <esan@etamil.in>
// __செலவு_சோதனை — tests for the cost accounting modules, written in eTamil__
// செலவுக் கணக்குத் தொகுதிகளுக்கான சோதனைகள்
//
// __Run it like any other program:  etamil --vm nUlakam/celavu/celavu_cOqaZY.qmz__
// __It exits non-zero if anything fails, so it works as a CI step.__
//
// __The figures are chosen so the arithmetic is checkable by eye. None of them__
// __is a claim about any real product's costs.__

இறக்கு "../cOqaZY/cOqaZY.qmz";
இறக்கு "pawkaLippu.qmz";
இறக்கு "mILpakirvu.qmz";
இறக்கு "ceyalmuRY.qmz";
இறக்கு "ceyalpAtu.qmz";
இறக்கு "nilYyam.qmz";
இறக்கு "celavu_qAL.qmz";
இறக்கு "mElnilY.qmz";
இறக்கு "niyamam.qmz";

ஓட்டம் = சோதனை_தொடக்கம்("செலவு — பங்களிப்பு (marginal costing)");

// __--- Contribution --------------------------------------------------------__
//
// __A product at ₹250 with ₹150 of variable cost contributes ₹100 a unit. Fixed__
// __cost does not appear yet, which is the whole point of the measure.__
ஓட்டம் = சமம்(ஓட்டம், அலகு_பங்களிப்பு(250, 150), 100,
              "250 less 150 contributes 100 a unit");
ஓட்டம் = சமம்(ஓட்டம், மொத்த_பங்களிப்பு(250, 150, 400), 40000,
              "400 units contribute 40,000");

// __A unit sold below variable cost contributes negatively. Worth pinning:__
// __nothing in the function rejects it, because it is a real situation and the__
// __caller has to see the sign.__
ஓட்டம் = சமம்(ஓட்டம், அலகு_பங்களிப்பு(120, 150), -30,
              "priced under variable cost, contribution is negative");

// __--- Profit is contribution less fixed cost, once ------------------------__
ஓட்டம் = சமம்(ஓட்டம், லாபம்(250, 150, 400, 30000), 10000,
              "40,000 contribution less 30,000 fixed is 10,000 profit");
ஓட்டம் = சமம்(ஓட்டம், லாபம்(250, 150, 300, 30000), 0,
              "at 300 units the same fixed cost is exactly covered");

// __--- The P/V ratio -------------------------------------------------------__
//
// __100 on 250 is 40 per cent, written 40. Not 40% — see the note in the module.__
ஓட்டம் = சமம்(ஓட்டம், மதிப்பு(பங்களிப்பு_விகிதம்(250, 150)), 40,
              "the P/V ratio is 40, meaning forty per cent");
ஓட்டம் = உறுதிசெய்(ஓட்டம், தவறா(பங்களிப்பு_விகிதம்(0, 150)),
                  "a zero price has no P/V ratio");

// __--- Break-even ----------------------------------------------------------__
//
// __30,000 of fixed cost over 100 a unit is 300 units, and 300 units at 250 is__
// __₹75,000. The two answers have to agree, which is what the second assertion__
// __checks — computing it in rupees from the ratio instead of the unit count is__
// __the standard exam shortcut and it must not disagree.__
ஓட்டம் = சமம்(ஓட்டம், மதிப்பு(சமநிலை_அலகுகள்(30000, 250, 150)), 300,
              "30,000 fixed over 100 contribution breaks even at 300 units");
ஓட்டம் = சமம்(ஓட்டம், மதிப்பு(சமநிலை_மதிப்பு(30000, 250, 150)), 75000,
              "which is 75,000 of sales");

// __A product that contributes nothing never breaks even, and a negative__
// __contribution is worse. Both are தவறு rather than a division by zero.__
ஓட்டம் = உறுதிசெய்(ஓட்டம், தவறா(சமநிலை_அலகுகள்(30000, 150, 150)),
                  "zero contribution has no break-even point");
ஓட்டம் = உறுதிசெய்(ஓட்டம், தவறா(சமநிலை_அலகுகள்(30000, 120, 150)),
                  "nor does a negative one");

// __--- Margin of safety ----------------------------------------------------__
ஓட்டம் = சமம்(ஓட்டம், மதிப்பு(பாதுகாப்பு_வரம்பு(400, 30000, 250, 150)), 100,
              "planning 400 against a 300 break-even leaves 100 units of safety");
ஓட்டம் = சமம்(ஓட்டம், மதிப்பு(பாதுகாப்பு_விகிதம்(400, 30000, 250, 150)), 25,
              "which is 25 per cent of the plan");

// __Below break-even the margin is negative. That is a reading, not an error,__
// __so it comes back as சரி with a negative number.__
ஓட்டம் = சமம்(ஓட்டம், மதிப்பு(பாதுகாப்பு_வரம்பு(250, 30000, 250, 150)), -50,
              "a plan below break-even has a negative margin of safety");

// __--- Planning backwards from a target ------------------------------------__
//
// __The question the costing department is actually asked. 30,000 fixed plus__
// __20,000 wanted is 50,000 to recover at 100 a unit.__
ஓட்டம் = சமம்(ஓட்டம், மதிப்பு(இலக்கு_அலகுகள்(20000, 30000, 250, 150)), 500,
              "earning 20,000 on top of 30,000 fixed needs 500 units");
ஓட்டம் = சமம்(ஓட்டம், மதிப்பு(இலக்கு_அலகுகள்(0, 30000, 250, 150)), 300,
              "a target of nothing is the break-even point again");

// __The round trip: sell the target quantity and the profit is the target.__
ஓட்டம் = சமம்(ஓட்டம், லாபம்(250, 150, மதிப்பு(இலக்கு_அலகுகள்(20000, 30000, 250, 150)),
                            30000), 20000,
              "and selling that quantity earns exactly the target");

// __--- Ranking under a constraint -----------------------------------------__
//
// __Product A contributes more per unit but eats three machine hours; B__
// __contributes less and takes one. Ranked per unit A wins; ranked per hour of__
// __the thing that is actually scarce, B wins by a wide margin. This is the__
// __distinction the function exists for.__
ஓட்டம் = உறுதிசெய்(ஓட்டம், அலகு_பங்களிப்பு(250, 150) > அலகு_பங்களிப்பு(180, 120),
                  "per unit, A (100) beats B (60)");
ஓட்டம் = சமம்(ஓட்டம், மதிப்பு(அலகு_வளத்திற்கு_பங்களிப்பு(250, 150, 3)), 100 / 3,
              "but A earns only 33.33 an hour");
ஓட்டம் = சமம்(ஓட்டம், மதிப்பு(அலகு_வளத்திற்கு_பங்களிப்பு(180, 120, 1)), 60,
              "while B earns 60 an hour, so B is made first");
ஓட்டம் = உறுதிசெய்(ஓட்டம், தவறா(அலகு_வளத்திற்கு_பங்களிப்பு(250, 150, 0)),
                  "a product consuming none of the constraint cannot be ranked");

// =========================================================================
// __நிலையம் — cost centres, objects and elements__
// =========================================================================

// __Only a production centre absorbs cost into units. A service centre's total__
// __is re-apportioned onto production centres first, and this flag is what a__
// __caller checks before absorbing.__
இயந்திரம் = மதிப்பு(நிலையம்_ஆக்கு("உ1", "இயந்திரப் பிரிவு", வகை_உற்பத்தி()));
பணிமனை   = மதிப்பு(நிலையம்_ஆக்கு("ச1", "பணிமனை", வகை_சேவைத்துறை()));

ஓட்டம் = உறுதிசெய்(ஓட்டம், உற்பத்தி_நிலையமா(இயந்திரம்),
                  "a production centre absorbs into units");
ஓட்டம் = உறுதிசெய்(ஓட்டம், இல்லை உற்பத்தி_நிலையமா(பணிமனை),
                  "a service centre does not");
ஓட்டம் = உறுதிசெய்(ஓட்டம், தவறா(நிலையம்_ஆக்கு("x", "?", "கிடங்கு")),
                  "an unknown centre type is rejected");

நிலையப்_பட்டி = [இயந்திரம், பணிமனை];
ஓட்டம் = சமம்(ஓட்டம், மதிப்பு(நிலையம்_தேடு(நிலையப்_பட்டி, "ச1")).நிலைய_பெயர்,
              "பணிமனை", "a centre is found by its code");
ஓட்டம் = உறுதிசெய்(ஓட்டம், தவறா(நிலையம்_தேடு(நிலையப்_பட்டி, "இல்லை")),
                  "and a missing code is a தவறு, not a silent nothing");
ஓட்டம் = சமம்(ஓட்டம், நீளம்(வகையால்_நிலையங்கள்(நிலையப்_பட்டி, "உற்பத்தி")), 1,
              "filtering by type finds the one production centre");

// __A cost object with no units is legal — a job can be open with nothing__
// __finished — but a negative count is not.__
ஓட்டம் = உறுதிசெய்(ஓட்டம், சரியா(செலவுப்_பொருள்_ஆக்கு("ப1", "தொகுதி A", 0)),
                  "a cost object may carry zero units");
ஓட்டம் = உறுதிசெய்(ஓட்டம், தவறா(செலவுப்_பொருள்_ஆக்கு("ப2", "தொகுதி B", -5)),
                  "but never a negative count");

// __The two classifications are independent. Rent is indirect and wholly fixed;__
// __power is indirect and 70% variable; direct material is direct and wholly__
// __variable. Summing them all gives 10,000; the variable part is only the__
// __portions that move with volume.__
கூறுப்_பட்டி = [
    கூறு_ஆக்கு("நேரடிப் பொருள்", 6000, மெய், 1),
    கூறு_ஆக்கு("வாடகைச் செலவு", 2000, பொய், 0),
    கூறு_ஆக்கு("மின்சாரம்", 2000, பொய், 0.7)
];

ஓட்டம் = சமம்(ஓட்டம், கூறுகளின்_கூட்டல்(கூறுப்_பட்டி), 10000,
              "the elements total 10,000");
ஓட்டம் = சமம்(ஓட்டம், நீளம்(நேரடிக்_கூறுகள்(கூறுப்_பட்டி)), 1,
              "one of the three is direct");
ஓட்டம் = சமம்(ஓட்டம், நீளம்(மறைமுகக்_கூறுகள்(கூறுப்_பட்டி)), 2,
              "the other two are indirect");
ஓட்டம் = சமம்(ஓட்டம், மாறும்_பகுதி(கூறுப்_பட்டி), 7400,
              "6000 + 0 + 1400 of it moves with volume");
ஓட்டம் = சமம்(ஓட்டம், நிலையான_பகுதி(கூறுப்_பட்டி), 2600,
              "and 2,600 does not");
ஓட்டம் = சமம்(ஓட்டம், மாறும்_பகுதி(கூறுப்_பட்டி)
                      + நிலையான_பகுதி(கூறுப்_பட்டி),
              கூறுகளின்_கூட்டல்(கூறுப்_பட்டி),
              "and the two parts add back to the whole");

// =========================================================================
// __செலவுத் தாள் — the cost sheet__
// =========================================================================

ஓட்டம் = சமம்(ஓட்டம், நுகர்ந்த_பொருட்கள்(5000, 40000, 3000), 42000,
              "material consumed is opening + purchases − closing");
ஓட்டம் = சமம்(ஓட்டம், முதன்மைச்_செலவு(42000, 18000, 2000), 62000,
              "prime cost is material + wages + direct expenses");

// __WIP adjusts inside the factory, before administrative overhead.__
ஓட்டம் = சமம்(ஓட்டம், தொழிற்சாலைச்_செலவு(62000, 15000, 4000, 6000), 75000,
              "works cost adds factory overhead and the movement in WIP");
ஓட்டம் = சமம்(ஓட்டம், தொழிற்சாலைச்_செலவு(62000, 15000, 0, 0), 77000,
              "with no WIP it is simply prime plus factory overhead");

தாள் = செலவுத்_தாள்_ஆக்கு({
    நேரடிப்_பொருட்கள்: 42000,
    நேரடி_ஊதியம்: 18000,
    நேரடிச்_செலவுகள்: 2000,
    தொழிற்சாலை_மேல்நிலை: 15000,
    நிர்வாக_மேல்நிலை: 8000,
    விற்பனை_மேல்நிலை: 5000,
    ஆரம்ப_நிறைவேறாதவை: 4000,
    இறுதி_நிறைவேறாதவை: 6000,
    ஆரம்ப_முடிந்தவை: 3000,
    இறுதி_முடிந்தவை: 1000,
    விற்பனை_வருவாய்: 120000,
    அலகுகள்: 1000
});

ஓட்டம் = சமம்(ஓட்டம், தாள்.முதன்மைச்_செலவு, 62000, "the sheet's prime cost");
ஓட்டம் = சமம்(ஓட்டம், தாள்.தொழிற்சாலைச்_செலவு, 75000, "its works cost");
ஓட்டம் = சமம்(ஓட்டம், தாள்.உற்பத்திச்_செலவு, 83000, "its cost of production");
ஓட்டம் = சமம்(ஓட்டம், தாள்.விற்றவை_செலவு, 85000, "its cost of goods sold");
ஓட்டம் = சமம்(ஓட்டம், தாள்.விற்பனைச்_செலவு, 90000, "its cost of sales");
ஓட்டம் = சமம்(ஓட்டம், தாள்.ஈட்டிய_லாபம், 30000, "and the profit that leaves");

// __The ladder property: every rung is the one below it plus one class of__
// __overhead, so the differences have to be exactly those overheads.__
ஓட்டம் = சமம்(ஓட்டம், தாள்.உற்பத்திச்_செலவு - தாள்.தொழிற்சாலைச்_செலவு, 8000,
              "production less works is exactly the administrative overhead");
ஓட்டம் = சமம்(ஓட்டம், தாள்.விற்பனைச்_செலவு - தாள்.விற்றவை_செலவு, 5000,
              "and cost of sales less goods sold is the selling overhead");

ஓட்டம் = சமம்(ஓட்டம், மதிப்பு(அலகுக்குச்_செலவு(90000, 1000)), 90,
              "1,000 units at a 90,000 cost of sales is 90 a unit");
ஓட்டம் = உறுதிசெய்(ஓட்டம், தவறா(அலகுக்குச்_செலவு(90000, 0)),
                  "and no units means no unit cost, not a division by zero");

// =========================================================================
// __மேல்நிலை — overhead absorption__
// =========================================================================

// __80,000 of budgeted overhead over 2,000 budgeted machine hours is 40 an hour.__
விகிதம் = மதிப்பு(உள்வாங்கல்_விகிதம்(80000, 2000, அடிப்படை_இயந்திர_நேரம்()));
ஓட்டம் = சமம்(ஓட்டம், விகிதம்.விகிதப்_பணம், 40, "80,000 over 2,000 hours is 40");
ஓட்டம் = சமம்(ஓட்டம், விகிதம்.அடிப்படை_வகை, "இயந்திர_நேரம்",
              "and the rate carries its base, so 40 is never ambiguous");
ஓட்டம் = உறுதிசெய்(ஓட்டம், தவறா(உள்வாங்கல்_விகிதம்(80000, 0,
                                                    அடிப்படை_இயந்திர_நேரம்())),
                  "a zero base has no rate");
ஓட்டம் = உறுதிசெய்(ஓட்டம், தவறா(உள்வாங்கல்_விகிதம்(80000, 2000, "நிலவு")),
                  "and an unknown base is rejected");

// __Worked 2,100 hours, so 84,000 is absorbed against 81,500 actually spent:__
// __2,500 over-absorbed. This is the case the rate is *supposed* to produce —__
// __budgeted rate, actual activity — and it is not an error.__
உள்வாங்கியவை = உள்வாங்கியது(விகிதம், 2100);
ஓட்டம் = சமம்(ஓட்டம், உள்வாங்கியவை, 84000, "2,100 actual hours absorb 84,000");
ஓட்டம் = சமம்(ஓட்டம், உள்வாங்கல்_வேறுபாடு(84000, 81500), 2500,
              "against 81,500 spent, 2,500 is over-absorbed");
ஓட்டம் = உறுதிசெய்(ஓட்டம், அதிக_உள்வாங்கலா(உள்வாங்கல்_வேறுபாடு(84000, 81500)),
                  "and the sign says over, not under");
ஓட்டம் = உறுதிசெய்(ஓட்டம், குறை_உள்வாங்கலா(உள்வாங்கல்_வேறுபாடு(84000, 90000)),
                  "spending 90,000 would be under-absorption");

ஓட்டம் = சமம்(ஓட்டம், மதிப்பு(சதவீத_விகிதம்(30000, 20000)), 150,
              "30,000 of overhead on 20,000 of wages quotes as 150 per cent");

// __Apportionment must add back to the pool exactly. விகிதத்தில்_பிரி in kAcu__
// __exists because naive division does not guarantee that.__
பகிர்வு = விகிதத்தில்_பிரி(100000, [3, 1, 1]);
ஓட்டம் = சமம்(ஓட்டம், கூட்டு(பகிர்வு), 100000,
              "overhead split 3:1:1 adds back to the whole, to the paisa");
ஓட்டம் = சமம்(ஓட்டம், நீளம்(நிலையங்களுக்குப்_பகிர்(100000, [3, 1, 1])), 3,
              "and gives one share per centre");

// =========================================================================
// __நியமச் செலவு — standard costing variances__
// =========================================================================
//
// __Standard: 500 kg at ₹20 = ₹10,000. Actual: 520 kg at ₹19 = ₹9,880.__
// __Price is favourable (paid 1 less on 520 kg = +520); usage is adverse__
// __(20 kg over at the standard 20 = −400). Net +120.__
பொருள்_தொகுதி = பொருள்_வேறுபாட்டுத்_தொகுதி(500, 20, 520, 19);

ஓட்டம் = சமம்(ஓட்டம், பொருள்_தொகுதி.வீத_வேறுபாடு, 520,
              "buying 1 under standard on 520 kg is 520 favourable");
ஓட்டம் = சமம்(ஓட்டம், பொருள்_தொகுதி.பயன்பாட்டு_வேறுபாடு, -400,
              "using 20 kg too much at standard price is 400 adverse");
ஓட்டம் = சமம்(ஓட்டம், பொருள்_தொகுதி.மொத்த_வேறுபாடு, 120,
              "and the total is 120 favourable");

// __The reconciliation. This is the property that makes the decomposition mean__
// __anything: the parts must equal the whole, exactly.__
ஓட்டம் = சமம்(ஓட்டம், பொருள்_தொகுதி.வீத_வேறுபாடு
                      + பொருள்_தொகுதி.பயன்பாட்டு_வேறுபாடு,
              பொருள்_தொகுதி.மொத்த_வேறுபாடு,
              "price + usage reconciles to the total material variance");

ஓட்டம் = உறுதிசெய்(ஓட்டம், சாதகமா(520), "a positive variance is favourable");
ஓட்டம் = உறுதிசெய்(ஓட்டம், பாதகமா(-400), "and a negative one is adverse");
ஓட்டம் = சமம்(ஓட்டம், வேறுபாட்டு_உரை(-400), "400 பாதகம்",
              "an adverse variance reads as a positive number labelled பாதகம்");
ஓட்டம் = சமம்(ஓட்டம், வேறுபாட்டு_உரை(0), "வேறுபாடு இல்லை",
              "and no variance says so");

// __Labour. Standard 400 hours at ₹50 = ₹20,000. Actual 380 at ₹55 = ₹20,900.__
// __Rate adverse (5 over on 380 = −1,900); efficiency favourable (20 hours saved__
// __at 50 = +1,000). Net −900.__
ஊதியத்_தொகுதி = ஊதிய_வேறுபாட்டுத்_தொகுதி(400, 50, 380, 55);

ஓட்டம் = சமம்(ஓட்டம், ஊதியத்_தொகுதி.வீத_வேறுபாடு, -1900,
              "paying 5 over standard on 380 hours is 1,900 adverse");
ஓட்டம் = சமம்(ஓட்டம், ஊதியத்_தொகுதி.திறன்_வேறுபாடு, 1000,
              "finishing 20 hours early at standard rate is 1,000 favourable");
ஓட்டம் = சமம்(ஓட்டம், ஊதியத்_தொகுதி.மொத்த_வேறுபாடு, -900,
              "so the labour total is 900 adverse");
ஓட்டம் = சமம்(ஓட்டம், ஊதியத்_தொகுதி.வீத_வேறுபாடு
                      + ஊதியத்_தொகுதி.திறன்_வேறுபாடு,
              ஊதியத்_தொகுதி.மொத்த_வேறுபாடு,
              "rate + efficiency reconciles to the total labour variance");

// __Idle time is never favourable, whatever is passed.__
ஓட்டம் = சமம்(ஓட்டம், ஊதிய_செயலிழப்பு_வேறுபாடு(50, 12), -600,
              "12 idle hours at 50 is 600 adverse and cannot be otherwise");

// __Variable overhead reconciles the same way: expenditure + efficiency.__
ஓட்டம் = சமம்(ஓட்டம், மாறும்_மேல்நிலை_செலவு_வேறுபாடு(380, 12, 4200), 360,
              "380 hours should carry 4,560 of overhead; 4,200 spent is 360 favourable");
ஓட்டம் = சமம்(ஓட்டம், மாறும்_மேல்நிலை_திறன்_வேறுபாடு(12, 400, 380), 240,
              "and 20 hours saved at 12 is 240 favourable");
ஓட்டம் = சமம்(ஓட்டம், மாறும்_மேல்நிலை_செலவு_வேறுபாடு(380, 12, 4200)
                      + மாறும்_மேல்நிலை_திறன்_வேறுபாடு(12, 400, 380),
              மாறும்_மேல்நிலை_மொத்த_வேறுபாடு(400, 12, 4200),
              "expenditure + efficiency reconciles to the total");

// __Fixed overhead: no usage variance, so the split is expenditure and volume.__
ஓட்டம் = சமம்(ஓட்டம், நிலையான_மேல்நிலை_செலவு_வேறுபாடு(50000, 52000), -2000,
              "spending 52,000 against a 50,000 budget is 2,000 adverse");
ஓட்டம் = சமம்(ஓட்டம், நிலையான_மேல்நிலை_கொள்திறன்_வேறுபாடு(25, 2000, 2200), 5000,
              "making 200 units more than planned over-recovers 5,000");

// __Sales is the exception to the sign rule: above standard price is favourable,__
// __so it reads actual less standard.__
ஓட்டம் = சமம்(ஓட்டம், விற்பனை_வீத_வேறுபாடு(1000, 260, 250), 10000,
              "selling 10 above standard on 1,000 units is 10,000 favourable");
ஓட்டம் = சமம்(ஓட்டம், விற்பனை_அளவு_வேறுபாடு(100, 1000, 1100), 10000,
              "and 100 extra units at 100 contribution is 10,000 — contribution, not price");

// =========================================================================
// __மீள்பகிர்வு — reciprocal service apportionment__
// =========================================================================
//
// __S1 costs 900 direct and sends P1 50%, P2 30%, S2 20%.__
// __S2 costs 450 direct and sends P1 20%, P2 30%, S1 50%.__

சேவை1 = சேவை_நிலையம்_ஆக்கு("S1", 900, [பகிர்வு_ஆக்கு("P1", 50),
                                          பகிர்வு_ஆக்கு("P2", 30),
                                          பகிர்வு_ஆக்கு("S2", 20)]);
சேவை2 = சேவை_நிலையம்_ஆக்கு("S2", 450, [பகிர்வு_ஆக்கு("P1", 20),
                                          பகிர்வு_ஆக்கு("P2", 30),
                                          பகிர்வு_ஆக்கு("S1", 50)]);
உற்பத்தி_மையங்கள் = ["P1", "P2"];

ஓட்டம் = சமம்(ஓட்டம், பகிர்வு_மொத்தம்(சேவை1), 100,
              "a centre's percentages total a hundred");

ஒரேசமய_விடை = மதிப்பு(இரு_சேவை_ஒரேசமயம்(900, 450, 20, 50));
ஓட்டம் = சமம்(ஓட்டம், ஒரேசமய_விடை["அ_மொத்தம்"], 1250,
              "S1 grossed up for the service it receives back is 1,250");
ஓட்டம் = சமம்(ஓட்டம், ஒரேசமய_விடை["ஆ_மொத்தம்"], 700, "and S2 is 700");
ஓட்டம் = உறுதிசெய்(ஓட்டம், ஒரேசமய_விடை["அ_மொத்தம்"] > 900,
                  "both exceed their direct cost, which is not double "
                  & "counting — what they send back out is removed again");
ஓட்டம் = உறுதிசெய்(ஓட்டம், தவறா(இரு_சேவை_ஒரேசமயம்(100, 100, 100, 100)),
                  "two centres passing each other everything have no solution");

மீள்_விடை = மதிப்பு(மீண்டும்_பகிர்([சேவை1, சேவை2], உற்பத்தி_மையங்கள்,
                                     100, 0.000001));
ஓட்டம் = சமம்(ஓட்டம், நிலையத்_தொகையைப்_பெறு(மீள்_விடை["உற்பத்திக்கு"], "P1"),
              765, "repeated distribution charges P1 765");
ஓட்டம் = சமம்(ஓட்டம், நிலையத்_தொகையைப்_பெறு(மீள்_விடை["உற்பத்திக்கு"], "P2"),
              585, "and P2 585");

// __The two methods agree to the paisa. Repeated distribution is not an__
// __approximation of a different answer; it converges to this one.__
ஓட்டம் = சமம்(ஓட்டம், நிலையத்_தொகையைப்_பெறு(மீள்_விடை["உற்பத்திக்கு"], "P1"),
              வட்டமிடு(சதவீதம்(ஒரேசமய_விடை["அ_மொத்தம்"], 50)
                        + சதவீதம்(ஒரேசமய_விடை["ஆ_மொத்தம்"], 20), 2),
              "which is exactly what the simultaneous equations give");

ஓட்டம் = சமம்(ஓட்டம், உற்பத்திக்கு_மொத்தம்(மீள்_விடை["உற்பத்திக்கு"]),
              நேரடிச்_செலவின்_மொத்தம்([சேவை1, சேவை2]),
              "everything the service centres held reaches production — the "
              & "assertion that found a rounding leak when the shares were "
              & "rounded inside the iteration");
ஓட்டம் = உறுதிசெய்(ஓட்டம், மீள்_விடை["சுற்றுகள்"] < 100,
                  "and it converges well inside the round limit");

படிநிலை_விடை = படிநிலைப்_பகிர்வு([சேவை1, சேவை2], உற்பத்தி_மையங்கள்);
ஓட்டம் = சமம்(ஓட்டம், உற்பத்திக்கு_மொத்தம்(படிநிலை_விடை), 1350,
              "step-down also accounts for every rupee");
ஓட்டம் = வேறுபடு(ஓட்டம், நிலையத்_தொகையைப்_பெறு(படிநிலை_விடை, "P1"), 765,
                 "but puts it somewhere else — 702 against 765, and the 63 is "
                 & "the reciprocal service it refused to send backwards");

வரிசை_விடை = படிநிலை_வரிசை_வேறுபாடு([சேவை1, சேவை2], [சேவை2, சேவை1],
                                       உற்பத்தி_மையங்கள், "P1");
ஓட்டம் = வேறுபடு(ஓட்டம், வரிசை_விடை["முதல்_வரிசையில்"],
                 வரிசை_விடை["இரண்டாம்_வரிசையில்"],
                 "**and the step-down answer depends on the order** — two "
                 & "defensible orders, two different product costs, and "
                 & "nothing in the accounts records which was used");

// =========================================================================
// __செயல்முறை — process costing__
// =========================================================================
//
// __1,000 units in at a cost of 9,500. Normal loss 10%, scrap 5 a unit.__
// __Output 850, so 150 were lost and 50 of those should not have been.__

செயல்முறை_விடை = மதிப்பு(செயல்முறையைக்_கணக்கிடு(1000, 9500, 10, 850, 5));

ஓட்டம் = சமம்(ஓட்டம், செயல்முறை_விடை["இயல்பு_இழப்பு"], 100,
              "normal loss is a percentage of input, not of output");
ஓட்டம் = சமம்(ஓட்டம், செயல்முறை_விடை["அசாதாரண_வேறுபாடு"], 50,
              "so 50 units were lost that should not have been");
ஓட்டம் = சமம்(ஓட்டம், செயல்முறை_விடை["கழிவு_வரவு"], 500,
              "the normal loss fetches 500 of scrap");
ஓட்டம் = சமம்(ஓட்டம், செயல்முறை_விடை["உறிஞ்ச_வேண்டியது"], 9000,
              "which reduces what has to be absorbed to 9,000");
ஓட்டம் = சமம்(ஓட்டம், செயல்முறை_விடை["அலகுச்_செலவு"], 10,
              "and 9,000 over 900 surviving units is 10 — the normal loss is "
              & "absorbed by leaving its units out of the denominator");

// __The natural-looking mistake, priced.__
ஓட்டம் = சமம்(ஓட்டம், அலகுக்கான_செலவு_தவறாக(9000, 850), 10.5882,
              "dividing by good output instead gives 10.59 — the abnormal "
              & "loss buried in every good unit");

இழப்பு_மதிப்பு = அசாதாரண_இழப்பின்_மதிப்பு(50, 10, 5);
ஓட்டம் = சமம்(ஓட்டம், இழப்பு_மதிப்பு["மொத்த_மதிப்பு"], 500,
              "abnormal loss is valued at the same rate as good output");
ஓட்டம் = சமம்(ஓட்டம், இழப்பு_மதிப்பு["எழுதித்_தள்ளுவது"], 250,
              "and written off net of its own scrap");

ஓட்டம் = சமம்(ஓட்டம், செயல்முறை_விடை["நல்லதன்_மதிப்பு"]
              + இழப்பு_மதிப்பு["மொத்த_மதிப்பு"],
              செயல்முறை_விடை["உறிஞ்ச_வேண்டியது"],
              "good output plus abnormal loss accounts for the whole cost — "
              & "the process account closes");

// __An abnormal gain, and the scrap it forgoes.__
ஆதாய_விடை = மதிப்பு(செயல்முறையைக்_கணக்கிடு(1000, 9500, 10, 920, 5));
ஓட்டம் = சமம்(ஓட்டம், ஆதாய_விடை["அசாதாரண_வேறுபாடு"], 0 - 20,
              "losing less than expected is an abnormal gain, signed negative");
ஆதாயம் = அசாதாரண_ஆதாயத்தின்_மதிப்பு(20, 10, 5);
ஓட்டம் = சமம்(ஓட்டம், ஆதாயம்["மொத்த_மதிப்பு"], 200, "worth 200 at the unit cost");
ஓட்டம் = சமம்(ஓட்டம், ஆதாயம்["நிகர_ஆதாயம்"], 100,
              "but only 100 net — the twenty units that were not lost would "
              & "have sold as scrap, and that revenue is forgone");

ஓட்டம் = உறுதிசெய்(ஓட்டம், தவறா(அலகுக்கான_செலவு(9000, 100, 100)),
                  "a process whose normal loss consumes the whole input has "
                  & "nothing to absorb the cost");

// __--- equivalent units ----------------------------------------------------__

சமமான_விடை = முறைகளின்_வேறுபாடு(200, 40, 900, 300, 60);
ஓட்டம் = சமம்(ஓட்டம், சமமான_விடை["சராசரி"], 1080,
              "weighted average counts everything finished, whenever the work "
              & "was done");
ஓட்டம் = சமம்(ஓட்டம், சமமான_விடை["fifo"], 1000,
              "FIFO counts only this period's work");
ஓட்டம் = சமம்(ஓட்டம், சமமான_விடை["வேறுபாடு"], 80,
              "and the gap is exactly the opening stock's prior-period work");
ஓட்டம் = சமம்(ஓட்டம், சமமான_விடை["வேறுபாடு"], சமமான_விடை["முந்தைய_கால_வேலை"],
              "nothing else");
ஓட்டம் = சமம்(ஓட்டம், சராசரி_சமமான_அலகுகள்(900, 300, 100), 1200,
              "material complete in closing stock counts in full");
ஓட்டம் = உறுதிசெய்(ஓட்டம், தவறா(சமமான_அலகின்_செலவு(1000, 0)),
                  "no equivalent units, no unit cost");

// =========================================================================
// __செயல்பாடு — activity-based costing__
// =========================================================================
//
// __Two pools: 1,10,000 of setup cost over 100 setups, and 50,000 of ordering__
// __cost over 50 orders. Product A is high volume and simple, B is low volume__
// __and complex, and the blanket base is 16,000 labour hours.__

செயல்பாடுகள் = [
    செயல்பாடு_ஆக்கு("SET", "இயந்திர அமைப்பு", 110000, "அமைப்புகள்", 100),
    செயல்பாடு_ஆக்கு("ORD", "கொள்முதல் ஆணைகள்", 50000, "ஆணைகள்", 50)
];
அ_நுகர்வு = [நுகர்வு_ஆக்கு("SET", 20), நுகர்வு_ஆக்கு("ORD", 10)];
ஆ_நுகர்வு = [நுகர்வு_ஆக்கு("SET", 80), நுகர்வு_ஆக்கு("ORD", 40)];

ஓட்டம் = சமம்(ஓட்டம், மதிப்பு(இயக்கி_விகிதம்(செயல்பாடுகள்[0])), 1100,
              "1,10,000 over 100 setups is 1,100 a setup");
ஓட்டம் = உறுதிசெய்(ஓட்டம், தவறா(இயக்கி_விகிதம்(
                      செயல்பாடு_ஆக்கு("X", "", 5000, "எதுவும்", 0))),
                  "an activity that happened no times has no rate");

அ_ஒப்பீடு = மதிப்பு(குறுக்கு_மானியம்(செயல்பாடுகள், அ_நுகர்வு, 16000, 15000,
                                        10000));
ஆ_ஒப்பீடு = மதிப்பு(குறுக்கு_மானியம்(செயல்பாடுகள், ஆ_நுகர்வு, 16000, 1000,
                                        1000));

ஓட்டம் = சமம்(ஓட்டம், அ_ஒப்பீடு["பாரம்பரியம்"], 150000,
              "the blanket rate charges the high-volume product 1,50,000");
ஓட்டம் = சமம்(ஓட்டம், அ_ஒப்பீடு["செயல்பாட்டு_அடிப்படை"], 32000,
              "its activities justify 32,000");
ஓட்டம் = சமம்(ஓட்டம், ஆ_ஒப்பீடு["பாரம்பரியம்"], 10000,
              "and charge the low-volume product 10,000");
ஓட்டம் = சமம்(ஓட்டம், ஆ_ஒப்பீடு["செயல்பாட்டு_அடிப்படை"], 128000,
              "whose activities justify 1,28,000");

ஓட்டம் = சமம்(ஓட்டம், அ_ஒப்பீடு["மாற்றம்"], 118000,
              "so A was subsidising by 1,18,000");
ஓட்டம் = சமம்(ஓட்டம், ஆ_ஒப்பீடு["மாற்றம்"], 0 - 118000,
              "and B was subsidised by exactly the same — **it is a transfer, "
              & "not a saving**");
ஓட்டம் = சமம்(ஓட்டம், அ_ஒப்பீடு["மாற்றம்"] + ஆ_ஒப்பீடு["மாற்றம்"], 0,
              "the two net to nothing");

ஓட்டம் = சமம்(ஓட்டம், அ_ஒப்பீடு["அலகுக்கு_பாரம்பரியம்"], 15,
              "per unit, A was carrying 15 of overhead");
ஓட்டம் = சமம்(ஓட்டம், அ_ஒப்பீடு["அலகுக்கு_செயல்பாடு"], 3.2, "and should carry 3.20");
ஓட்டம் = சமம்(ஓட்டம், ஆ_ஒப்பீடு["அலகுக்கு_பாரம்பரியம்"], 10,
              "while B was carrying 10");
ஓட்டம் = சமம்(ஓட்டம், ஆ_ஒப்பீடு["அலகுக்கு_செயல்பாடு"], 128,
              "and should carry 128 — a pricing decision, and possibly a "
              & "discontinuation decision, about to be taken on the wrong number");

ஓட்டம் = உறுதிசெய்(ஓட்டம், மொத்தம்_மாறவில்லையா(
                      [அ_ஒப்பீடு["செயல்பாட்டு_அடிப்படை"],
                       ஆ_ஒப்பீடு["செயல்பாட்டு_அடிப்படை"]],
                      தொகுப்புகளின்_கூட்டல்(செயல்பாடுகள்)),
                  "and the pools are fully assigned — the method redistributes "
                  & "overhead and never reduces it");

ஓட்டம் = உறுதிசெய்(ஓட்டம், மதிப்பு(பயனளிக்குமா(செயல்பாடுகள், அ_நுகர்வு, 16000,
                                                  15000, 10)),
                  "a shift of that size is worth the trouble");

// __Where consumption is proportional to the base, it is not.__
விகிதாசார_நுகர்வு = [நுகர்வு_ஆக்கு("SET", 50), நுகர்வு_ஆக்கு("ORD", 25)];
ஓட்டம் = உறுதிசெய்(ஓட்டம், இல்லை மதிப்பு(பயனளிக்குமா(செயல்பாடுகள்,
                                                        விகிதாசார_நுகர்வு,
                                                        16000, 8000, 10)),
                  "a product consuming activities in proportion to the base "
                  & "gets the same answer, at more expense");

சோதனை_முடிவு(ஓட்டம்);
