// __nUlakam/celavu/nilYyam.qmz — நிலையம் (cost centres, objects and elements)__
// நிலையங்கள், செலவுப் பொருள்கள், கூறுகள்
//
// __Financial accounting asks what was spent. Cost accounting asks where it went__
// __and what it attached to, and that needs two structures the ledger does not__
// __have: a place that incurs cost (a cost centre) and a thing that carries it__
// __(a cost object). Everything else in this directory hangs off them.__
//
// __Field and parameter names here are compound — நிலைய_வகை, கூறு_தொகை — because__
// __செலவு, தொகை, விலை, அளவு and நிலை are all keywords in this language. A bare__
// __keyword used as a field name is stored under its token name instead, so the__
// __record you read back is not the one you wrote. Compounding is the fix, and__
// __the same convention runs through kaNakkiyal/.__

// __--- What kind of place incurred it -------------------------------------__
//
// __The three-way split matters because only the first absorbs cost into__
// __product: service and administrative centres have their cost re-apportioned__
// __onto production centres before absorption, never onto units directly.__
// வகை_உற்பத்தி() — உற்பத்தி நிலைய வகை: இங்கே செலவு அலகுகளில் உள்வாங்கப்படும்
செயல் வகை_உற்பத்தி()  { திரும்பு "உற்பத்தி"; }
// __வகை_சேவைத்துறை() — the service-centre kind: maintenance, stores, canteen__
// வகை_சேவைத்துறை() — சேவை நிலைய வகை: பராமரிப்பு, கிடங்கு, உணவகம்
//
// __A service centre incurs real cost and absorbs none of it into product. Its__
// __total is re-apportioned onto the production centres it serves, so it must__
// __be emptied before absorption runs or the cost is simply lost.__
செயல் வகை_சேவைத்துறை() { திரும்பு "சேவை"; }
// __வகை_நிர்வாகம்() — the administrative kind, which serves the business__
// வகை_நிர்வாகம்() — நிறுவனத்துக்கே சேவை செய்யும் நிர்வாக வகை
//
// __Kept separate from சேவை because administration is often not apportioned to__
// __production at all: many costing policies write it off against the period__
// __rather than burying it in unit cost, and that is a choice the caller makes.__
செயல் வகை_நிர்வாகம்()  { திரும்பு "நிர்வாகம்"; }

// __நிலைய_வகை_செல்லுபடியா(நிலைய_வகை) — is this one of the three kinds?__
// நிலைய_வகை_செல்லுபடியா(நிலைய_வகை) — இது மூன்று வகைகளில் ஒன்றா
//
// __Checked at construction rather than at absorption. A centre with a mistyped__
// __kind would otherwise sit in the list looking correct and quietly absorb__
// __nothing, and the shortfall surfaces much later as an under-absorption that__
// __nobody can trace back to a spelling.__
செயல் நிலைய_வகை_செல்லுபடியா(நிலைய_வகை) {
    (நிலைய_வகை == "உற்பத்தி") எனில் { திரும்பு மெய்; }
    (நிலைய_வகை == "சேவை")     எனில் { திரும்பு மெய்; }
    (நிலைய_வகை == "நிர்வாகம்") எனில் { திரும்பு மெய்; }
    திரும்பு பொய்;
}

// __உற்பத்தி_நிலையமா(நிலையம்) — does cost absorb into units here?__
// உற்பத்தி_நிலையமா(நிலையம்) — இங்கே செலவு அலகுகளில் உள்வாங்கப்படுமா
செயல் உற்பத்தி_நிலையமா(நிலையம்) {
    திரும்பு நிலையம்.நிலைய_வகை == "உற்பத்தி";
}

// நிலையம்_ஆக்கு(நிலைய_குறி, நிலைய_பெயர், நிலைய_வகை)
// __நிலையம்_ஆக்கு(நிலைய_குறி, நிலைய_பெயர், நிலைய_வகை) — build one cost centre__
// நிலையம்_ஆக்கு(நிலைய_குறி, நிலைய_பெயர், நிலைய_வகை) — ஒரு செலவு நிலையத்தை உருவாக்கும்
//
// __Returns தவறு for an unknown kind rather than the record, so an invalid__
// __centre cannot enter the list at all. The code is what everything else joins__
// __on; the name is for the report and is never matched against.__
செயல் நிலையம்_ஆக்கு(நிலைய_குறி, நிலைய_பெயர், நிலைய_வகை) {
    (இல்லை நிலைய_வகை_செல்லுபடியா(நிலைய_வகை)) எனில் {
        திரும்பு தவறு("அறியப்படாத நிலைய வகை: " & நிலைய_வகை);
    }
    திரும்பு சரி({
        நிலைய_குறி: நிலைய_குறி,
        நிலைய_பெயர்: நிலைய_பெயர்,
        நிலைய_வகை: நிலைய_வகை
    });
}

// __நிலையம்_தேடு(நிலையங்கள், நிலைய_குறி) — find one cost centre by its code__
// நிலையம்_தேடு(நிலையங்கள், நிலைய_குறி) — குறியைக் கொண்டு ஒரு நிலையத்தைத் தேடும்
//
// __சரி with the centre, or தவறு naming the code that was not there. Absent is__
// __an answer, not a failure: apportioning to a centre that does not exist is a__
// __mistake worth stopping on rather than skipping past.__
செயல் நிலையம்_தேடு(நிலையங்கள், நிலைய_குறி) {
    ஒவ்வொரு ஒரு_நிலையம் இல் நிலையங்கள் {
        (ஒரு_நிலையம்.நிலைய_குறி == நிலைய_குறி) எனில் {
            திரும்பு சரி(ஒரு_நிலையம்);
        }
    }
    திரும்பு தவறு("நிலையம் காணவில்லை: " & நிலைய_குறி);
}

// __வகையால்_நிலையங்கள்(நிலையங்கள், நிலைய_வகை) — every centre of one kind__
// வகையால்_நிலையங்கள்(நிலையங்கள், நிலைய_வகை) — ஒரு வகையைச் சேர்ந்த நிலையங்கள்
//
// __How an apportionment run finds its targets: service cost goes onto the__
// __production centres, so the list of those is what it asks for first.__
செயல் வகையால்_நிலையங்கள்(நிலையங்கள், நிலைய_வகை) {
    விடை_பட்டி = [];
    ஒவ்வொரு ஒரு_நிலையம் இல் நிலையங்கள் {
        (ஒரு_நிலையம்.நிலைய_வகை == நிலைய_வகை) எனில் {
            விடை_பட்டி = இணை(விடை_பட்டி, ஒரு_நிலையம்);
        }
    }
    திரும்பு விடை_பட்டி;
}

// __--- What carries it ----------------------------------------------------__

// செலவுப்_பொருள்_ஆக்கு(பொருள்_குறி, பொருள்_பெயர், அலகுகள்)
//
// __The cost object: a job, a batch, a process, a contract, a product line. The__
// __unit count is held with it because per-unit cost is meaningless without it,__
// __and a cost sheet that reports a unit cost against the wrong quantity is the__
// __most common error in the whole discipline.__
// செலவுப்_பொருள்_ஆக்கு(பொருள்_குறி, பொருள்_பெயர், அலகுகள்) — செலவு அளக்கப்படும் பொருளை உருவாக்கும்
செயல் செலவுப்_பொருள்_ஆக்கு(பொருள்_குறி, பொருள்_பெயர், அலகுகள்) {
    (அலகுகள் < 0) எனில் {
        திரும்பு தவறு("அலகுகள் எதிர்மறையாக இருக்க முடியாது");
    }
    திரும்பு சரி({
        பொருள்_குறி: பொருள்_குறி,
        பொருள்_பெயர்: பொருள்_பெயர்,
        அலகுகள்: அலகுகள்
    });
}

// __--- The elements of cost -----------------------------------------------__

// கூறு_ஆக்கு(கூறு_பெயர், கூறு_தொகை, நேரடியா, மாறுபடுமா)
//
// __Two independent classifications, and keeping them independent is the point.__
// __Direct/indirect answers "can this be traced to the object?" and decides__
// __whether it is absorbed or apportioned. Variable/fixed answers "does it move__
// __with volume?" and decides whether it enters a contribution calculation.__
// __Direct cost is usually variable and indirect usually fixed, but the pairs__
// __are not the same question and a semi-variable element belongs to neither__
// __cleanly — which is why மாறுபடுமா is a fraction, not a flag.__
// கூறு_ஆக்கு(கூறு_பெயர், கூறு_தொகை, நேரடியா, மாறுபடுமா) — ஒரு செலவுக் கூறு
செயல் கூறு_ஆக்கு(கூறு_பெயர், கூறு_தொகை, நேரடியா, மாறுபடுமா) {
    திரும்பு {
        கூறு_பெயர்: கூறு_பெயர்,
        கூறு_தொகை: கூறு_தொகை,
        நேரடியா: நேரடியா,
        மாறுபடுமா: மாறுபடுமா
    };
}

// __கூறுகளின்_கூட்டல்(கூறுகள்) — the total of an element list, in rupees__
// கூறுகளின்_கூட்டல்(கூறுகள்) — கூறுப் பட்டியலின் மொத்தம்
//
// __Ignores both classifications deliberately. This is the cost sheet's total__
// __line, and it has to equal direct plus indirect, and variable plus fixed,__
// __whichever way the same elements are later split.__
செயல் கூறுகளின்_கூட்டல்(கூறுகள்) {
    மொத்தக்_கூட்டல் = 0;
    ஒவ்வொரு ஒரு_கூறு இல் கூறுகள் {
        மொத்தக்_கூட்டல் = மொத்தக்_கூட்டல் + ஒரு_கூறு.கூறு_தொகை;
    }
    திரும்பு மொத்தக்_கூட்டல்;
}

// __நேரடிக்_கூறுகள்(கூறுகள்) — only the elements traceable to the cost object__
// நேரடிக்_கூறுகள்(கூறுகள்) — செலவுப் பொருளுக்கு நேரடியாகத் தொடர்புபடுத்தக்கூடியவை
//
// __These are absorbed into the object as they stand. What is left over is the__
// __pool that has to be apportioned on some basis, which is where judgement__
// __enters a cost sheet and why the two lists are kept apart.__
செயல் நேரடிக்_கூறுகள்(கூறுகள்) {
    விடை_பட்டி = [];
    ஒவ்வொரு ஒரு_கூறு இல் கூறுகள் {
        (ஒரு_கூறு.நேரடியா) எனில் { விடை_பட்டி = இணை(விடை_பட்டி, ஒரு_கூறு); }
    }
    திரும்பு விடை_பட்டி;
}

// __மறைமுகக்_கூறுகள்(கூறுகள்) — the elements that cannot be traced, the overhead__
// மறைமுகக்_கூறுகள்(கூறுகள்) — தொடர்புபடுத்த முடியாதவை, அதாவது மேல்நிலை
//
// __The complement of நேரடிக்_கூறுகள், and the two together are the whole list.__
// __Overhead is not a lesser cost, it is a cost whose owner is a matter of__
// __policy rather than of measurement.__
செயல் மறைமுகக்_கூறுகள்(கூறுகள்) {
    விடை_பட்டி = [];
    ஒவ்வொரு ஒரு_கூறு இல் கூறுகள் {
        (இல்லை ஒரு_கூறு.நேரடியா) எனில் { விடை_பட்டி = இணை(விடை_பட்டி, ஒரு_கூறு); }
    }
    திரும்பு விடை_பட்டி;
}

// __மாறும்_பகுதி(கூறுகள்) — the volume-sensitive rupees inside a mixed list__
// மாறும்_பகுதி(கூறுகள்) — அளவுக்கு ஏற்ப மாறும் பகுதி
//
// __A semi-variable element with மாறுபடுமா 0.6 contributes 60% of itself here__
// __and 40% to நிலையான_பகுதி. Splitting a mixed list this way is what makes a__
// __contribution figure computable from an absorption cost sheet.__
செயல் மாறும்_பகுதி(கூறுகள்) {
    மாறும்_கூட்டல் = 0;
    ஒவ்வொரு ஒரு_கூறு இல் கூறுகள் {
        மாறும்_கூட்டல் = மாறும்_கூட்டல் + ஒரு_கூறு.கூறு_தொகை * ஒரு_கூறு.மாறுபடுமா;
    }
    திரும்பு மாறும்_கூட்டல்;
}

// __நிலையான_பகுதி(கூறுகள்) — the rupees that do not move with volume__
// நிலையான_பகுதி(கூறுகள்) — அளவுடன் மாறாத பகுதி
//
// __Computed as the total less மாறும்_பகுதி rather than summed on its own, so__
// __the two halves always add back to the total exactly. Summing both__
// __independently would let a rounding difference appear between them.__
செயல் நிலையான_பகுதி(கூறுகள்) {
    திரும்பு கூறுகளின்_கூட்டல்(கூறுகள்) - மாறும்_பகுதி(கூறுகள்);
}
