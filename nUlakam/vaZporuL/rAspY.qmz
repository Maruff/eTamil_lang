// __nUlakam/vaZporuL/rAspY.qmz — ராஸ்பை: the Raspberry Pi's pins, and the hardware API__
//
//   __இறக்கு "nUlakam/vaZporuL/rAspY.qmz";__
//   __etamil --vm prog.qmz__
//
// __For a Raspberry Pi 3, 4 or 5 running the eTamil VM. It is not an artino__
// __board: a Pi runs eTamil itself. Pin numbers are BCM GPIO numbers;__
// __தலைப்பு_முனை turns a physical pin on the 40-pin header into one, since that__
// __is how wiring diagrams number them.__
//
// __3.3 V, and the pins are not 5 V tolerant. There are no analog inputs:__
// __ஒப்புமை_படி is refused, naming an external ADC such as the MCP3008.__

இறக்கு "vaZporuL.qmz";

// __The boards this file describes. artino checks it against --board.__
நிலை சொல் பலகைக்_கோப்பு = "pi";

// __Serial: the header's UART, and an Arduino plugged in by USB__
நிலை சொல் தொடர்_சாதனம் = "/dev/serial0";      // __turn the serial port on, and the login shell on it off, in raspi-config__
நிலை எண் தொடர்_அனுப்பு_முனை = 14;              // __GPIO14, TXD: header pin 8__
நிலை எண் தொடர்_பெறு_முனை = 15;                 // __GPIO15, RXD: header pin 10__
நிலை சொல் USB_தொடர்_சாதனம் = "/dev/ttyACM0";  // __an Uno, Mega or Pico by USB; a Nano clone is often /dev/ttyUSB0__

// __I2C and SPI pins, for modules wired to them__
நிலை எண் I2C_SDA_முனை = 2;       // __header pin 3__
நிலை எண் I2C_SCL_முனை = 3;       // __header pin 5__
நிலை எண் SPI_MOSI_முனை = 10;     // __header pin 19__
நிலை எண் SPI_MISO_முனை = 9;      // __header pin 21__
நிலை எண் SPI_SCLK_முனை = 11;     // __header pin 23__
நிலை எண் SPI_CE0_முனை = 8;       // __header pin 24__
நிலை எண் SPI_CE1_முனை = 7;       // __header pin 26__

// __The BCM number of each header pin, 1 to 40; -1 for power and ground__
நிலை தலைப்பு_முனைகள் = [
    0 - 1, 0 - 1, 2, 0 - 1, 3, 0 - 1, 4, 14, 0 - 1, 15,
    17, 18, 27, 0 - 1, 22, 23, 0 - 1, 24, 10, 0 - 1,
    9, 25, 11, 8, 0 - 1, 7, 0, 1, 5, 0 - 1,
    6, 12, 13, 0 - 1, 19, 16, 26, 20, 0 - 1, 21
];

// __தலைப்பு_முனை(எண்ணிக்கை) — the BCM GPIO number of header pin 1–40, or -1 for a power or ground pin__
செயல் தலைப்பு_முனை(எண்ணிக்கை) {
    ((எண்ணிக்கை < 1) அல்லது (எண்ணிக்கை > 40)) எனில் { திரும்பு 0 - 1; }
    திரும்பு தலைப்பு_முனைகள்[எண்ணிக்கை - 1];
}
