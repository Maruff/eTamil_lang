// __நாட்காட்டி_சோதனை — tests for the calendar, written in eTamil__
//
// __Run it like any other program:  etamil --vm nUlakam/nAtkAtti/nAtkAtti_cOqaZY.qmz__
// __It exits non-zero if anything fails, so it works as a CI step.__
//
// __The dates are real and the weekdays are the true ones. In 2026, 2 March is a__
// __Monday, 31 January and 1 August are Saturdays, and 31 May is a Sunday; 2024__
// __is a leap year and 2100 is not. Every expected value below was computed from__
// __the calendar rather than from the code.__

இறக்கு "../cOqaZY/cOqaZY.qmz";
இறக்கு "../atippatY/kaNiqam.qmz";
இறக்கு "nAL.qmz";
இறக்கு "vElYnAL.qmz";

ஓட்டம் = சோதனை_தொடக்கம்("நாட்காட்டி — the calendar");

// =========================================================================
// __செல்லுபடி — validity__
// =========================================================================

ஓட்டம் = உறுதிசெய்(ஓட்டம், நாள்_செல்லுபடியா("2026-03-14"), "a real date is valid");
ஓட்டம் = உறுதிசெய்(ஓட்டம், நாள்_செல்லுபடியா("2024-02-29"),
                  "29 February exists in a leap year");

// __The one the host gets wrong on its own: it accepts 2026-02-31 and answers__
// __2026-03-03. The round trip is what catches it.__
ஓட்டம் = உறுதிசெய்(ஓட்டம், இல்லை நாள்_செல்லுபடியா("2026-02-31"),
                  "31 February is refused, though the host would roll it to 3 March");
ஓட்டம் = சமம்(ஓட்டம், நாள்_கூட்டு("2026-02-31", 0), "2026-03-03",
              "— and that is exactly what the host does with it");
ஓட்டம் = உறுதிசெய்(ஓட்டம், இல்லை நாள்_செல்லுபடியா("2026-02-29"),
                  "29 February does not exist in a common year");
ஓட்டம் = உறுதிசெய்(ஓட்டம், இல்லை நாள்_செல்லுபடியா("2026-04-31"),
                  "nor 31 April");

// __Shape failures never reach the host, which would stop the program rather__
// __than answer.__
ஓட்டம் = உறுதிசெய்(ஓட்டம், இல்லை நாள்_செல்லுபடியா("2026-13-01"),
                  "a thirteenth month is refused here, not raised as an error");
ஓட்டம் = உறுதிசெய்(ஓட்டம், இல்லை நாள்_செல்லுபடியா("2026-00-10"),
                  "nor a zeroth month");
ஓட்டம் = உறுதிசெய்(ஓட்டம், இல்லை நாள்_செல்லுபடியா("14-03-2026"),
                  "the other way round is not ISO-8601");
ஓட்டம் = உறுதிசெய்(ஓட்டம், இல்லை நாள்_செல்லுபடியா("2026-3-14"),
                  "an unpadded month is refused — the format is fixed width");
ஓட்டம் = உறுதிசெய்(ஓட்டம், இல்லை நாள்_செல்லுபடியா(""), "the empty string is not a date");
ஓட்டம் = உறுதிசெய்(ஓட்டம், இல்லை நாள்_செல்லுபடியா("இன்றைய நாள்"),
                  "and neither is prose");
ஓட்டம் = உறுதிசெய்(ஓட்டம், இல்லை நாள்_செல்லுபடியா(20260314),
                  "a number is not a date either");

ஓட்டம் = உறுதிசெய்(ஓட்டம், சரியா(நாள்_சரிபார்("2026-03-14")),
                  "நாள்_சரிபார் answers a Result for the edge of a system");
ஓட்டம் = உறுதிசெய்(ஓட்டம், தவறா(நாள்_சரிபார்("2026-02-31")),
                  "and carries a reason when it refuses");

ஓட்டம் = சமம்(ஓட்டம், மதிப்பு(நாள்_ஆக்கு(2026, 3, 14)), "2026-03-14",
              "the constructor pads each part");
ஓட்டம் = சமம்(ஓட்டம், மதிப்பு(நாள்_ஆக்கு(2026, 3, 4)), "2026-03-04",
              "including single digits");
ஓட்டம் = உறுதிசெய்(ஓட்டம், தவறா(நாள்_ஆக்கு(2026, 2, 30)),
                  "and refuses a day the month does not have");

// =========================================================================
// __கூறுகள் — the parts__
// =========================================================================

ஓட்டம் = சமம்(ஓட்டம், ஆண்டைப்_பெறு("2026-03-14"), 2026, "the year");
ஓட்டம் = சமம்(ஓட்டம், மாதத்தைப்_பெறு("2026-03-14"), 3, "the month, as a number");
ஓட்டம் = சமம்(ஓட்டம், நாளைப்_பெறு("2026-03-04"), 4,
              "the day, with the leading zero gone");

// =========================================================================
// __நெட்டாண்டு — leap years__
// =========================================================================

ஓட்டம் = உறுதிசெய்(ஓட்டம், நெட்டாண்டா(2024), "2024 is divisible by four");
ஓட்டம் = உறுதிசெய்(ஓட்டம், இல்லை நெட்டாண்டா(2026), "2026 is not");
ஓட்டம் = உறுதிசெய்(ஓட்டம், இல்லை நெட்டாண்டா(1900),
                  "1900 is a century and not a leap year — the case a "
                  & "divisible-by-four rule gets wrong");
ஓட்டம் = உறுதிசெய்(ஓட்டம், நெட்டாண்டா(2000),
                  "2000 is divisible by four hundred and is one — the case a "
                  & "century rule gets wrong");
ஓட்டம் = உறுதிசெய்(ஓட்டம், இல்லை நெட்டாண்டா(2100), "2100 will not be");

ஓட்டம் = சமம்(ஓட்டம், மாத_நாட்கள்(2024, 2), 29, "February has 29 days in 2024");
ஓட்டம் = சமம்(ஓட்டம், மாத_நாட்கள்(2026, 2), 28, "and 28 in 2026");
ஓட்டம் = சமம்(ஓட்டம், மாத_நாட்கள்(2026, 4), 30, "April has 30");
ஓட்டம் = சமம்(ஓட்டம், மாத_நாட்கள்(2026, 12), 31, "December has 31");

ஓட்டம் = சமம்(ஓட்டம், மாத_முதல்("2026-03-14"), "2026-03-01", "the first of the month");
ஓட்டம் = சமம்(ஓட்டம், மாத_இறுதி("2026-02-14"), "2026-02-28", "the last of February");
ஓட்டம் = சமம்(ஓட்டம், மாத_இறுதி("2024-02-14"), "2024-02-29", "and in a leap year");
ஓட்டம் = உறுதிசெய்(ஓட்டம், மாத_இறுதியா("2026-02-28"), "28 February 2026 is month end");
ஓட்டம் = உறுதிசெய்(ஓட்டம், இல்லை மாத_இறுதியா("2024-02-28"),
                  "but not in 2024, when the month has one more day");

// =========================================================================
// __மாதங்களைக் கூட்டுதல் — the clamping rule__
// =========================================================================

ஓட்டம் = சமம்(ஓட்டம், மாதங்களைக்_கூட்டு("2026-01-31", 1), "2026-02-28",
              "31 January plus one month is 28 February — there is no 31st");
ஓட்டம் = சமம்(ஓட்டம், மாதங்களைக்_கூட்டு("2026-01-31", 2), "2026-03-31",
              "plus two months is 31 March: counted from the original, the "
              & "day of the month comes back");
ஓட்டம் = சமம்(ஓட்டம், மாதங்களைக்_கூட்டு("2026-03-15", 12), "2027-03-15",
              "twelve months is a year later");
ஓட்டம் = சமம்(ஓட்டம், மாதங்களைக்_கூட்டு("2026-03-31", 0 - 1), "2026-02-28",
              "a negative count subtracts, and clamps the same way");
ஓட்டம் = சமம்(ஓட்டம், மாதங்களைக்_கூட்டு("2026-01-15", 0 - 1), "2025-12-15",
              "and crosses the year boundary backwards");
ஓட்டம் = சமம்(ஓட்டம், மாதங்களைக்_கூட்டு("2026-11-30", 2), "2027-01-30",
              "and forwards");

// __Clamping does not reverse, and a schedule built by chaining drifts. This is__
// __the reason மாதங்களைக்_கூட்டு says to count from the original.__
சங்கிலி = மாதங்களைக்_கூட்டு(மாதங்களைக்_கூட்டு("2026-01-31", 1), 1);
ஓட்டம் = சமம்(ஓட்டம், சங்கிலி, "2026-03-28",
              "adding one month twice gives 28 March — the drift that "
              & "chaining causes");
ஓட்டம் = வேறுபடு(ஓட்டம், சங்கிலி, மாதங்களைக்_கூட்டு("2026-01-31", 2),
                 "which is not 31 March, the answer counted from the original");

ஓட்டம் = சமம்(ஓட்டம், ஆண்டுகளைக்_கூட்டு("2024-02-29", 1), "2025-02-28",
              "29 February plus a year clamps to the 28th, not to 1 March");
ஓட்டம் = சமம்(ஓட்டம், ஆண்டுகளைக்_கூட்டு("2024-02-29", 4), "2028-02-29",
              "and four years later the day exists again");

// =========================================================================
// __இடைவெளிகள் — completed and part months__
// =========================================================================

ஓட்டம் = சமம்(ஓட்டம், முடிந்த_மாதங்கள்("2026-01-01", "2026-03-01"), 2,
              "two whole months");
ஓட்டம் = சமம்(ஓட்டம், முடிந்த_மாதங்கள்("2026-01-01", "2026-02-28"), 1,
              "a day short of two is one");
ஓட்டம் = சமம்(ஓட்டம், முடிந்த_மாதங்கள்("2026-01-31", "2026-02-28"), 1,
              "31 January to 28 February is a completed month — the end of "
              & "the month is as far as the month goes");
ஓட்டம் = சமம்(ஓட்டம், முடிந்த_மாதங்கள்("2026-01-31", "2026-02-27"), 0,
              "a day earlier and it is not");
ஓட்டம் = சமம்(ஓட்டம், முடிந்த_மாதங்கள்("2026-03-01", "2026-01-01"), 0,
              "a backwards range is zero, not negative");

ஓட்டம் = சமம்(ஓட்டம், முடிந்த_ஆண்டுகள்("1990-06-15", "2026-06-14"), 35,
              "the day before a birthday");
ஓட்டம் = சமம்(ஓட்டம், முடிந்த_ஆண்டுகள்("1990-06-15", "2026-06-15"), 36,
              "and on it");

ஓட்டம் = சமம்(ஓட்டம், பகுதி_மாதங்கள்("2026-02-01", "2026-04-01"), 2,
              "two exact months is two, not three");
ஓட்டம் = சமம்(ஓட்டம், பகுதி_மாதங்கள்("2026-02-01", "2026-04-02"), 3,
              "one day more is a whole further month");
ஓட்டம் = சமம்(ஓட்டம், பகுதி_மாதங்கள்("2026-02-01", "2026-02-01"), 0,
              "no elapsed time is no months");
ஓட்டம் = சமம்(ஓட்டம், பகுதி_மாதங்கள்("2026-02-01", "2026-02-02"), 1,
              "and one day is one");

// __Where days/30 and the calendar disagree — the reason this module exists.__
ஓட்டம் = சமம்(ஓட்டம், பகுதி_மாதங்கள்("2026-01-01", "2026-02-01"), 1,
              "January to February is one calendar month");
ஓட்டம் = சமம்(ஓட்டம், மேல்(நாள்_வேறுபாடு("2026-01-01", "2026-02-01") / 30), 2,
              "but 31 days over 30, rounded up, is two");
ஓட்டம் = சமம்(ஓட்டம், பகுதி_மாதங்கள்("2026-01-01", "2027-01-01"), 12,
              "a year is twelve months");
ஓட்டம் = சமம்(ஓட்டம், மேல்(நாள்_வேறுபாடு("2026-01-01", "2027-01-01") / 30), 13,
              "and thirteen by the division — an extra month of interest, "
              & "every year, always against the assessee");

// =========================================================================
// __வாரநாள் — the day of the week__
// =========================================================================

ஓட்டம் = சமம்(ஓட்டம், வாரநாள்("1970-01-01"), 4,
              "the epoch was a Thursday, which is 4 when Sunday is 0");
ஓட்டம் = சமம்(ஓட்டம், வாரநாள்("1969-12-31"), 3,
              "the day before was a Wednesday — the arithmetic works before "
              & "the epoch, because மீதி floors");
ஓட்டம் = சமம்(ஓட்டம், வாரநாள்("2000-01-01"), 6, "1 January 2000 was a Saturday");
ஓட்டம் = சமம்(ஓட்டம், வாரநாள்("2026-03-02"), 1, "2 March 2026 is a Monday");
ஓட்டம் = சமம்(ஓட்டம், வாரநாள்("2026-05-31"), 0, "31 May 2026 is a Sunday");
ஓட்டம் = சமம்(ஓட்டம், வாரநாள்_பெயர்(1), "திங்கள்", "and Monday is named");
ஓட்டம் = சமம்(ஓட்டம், வாரநாள்_பெயர்(9), "",
              "a number that is not a weekday names nothing");

// =========================================================================
// __நிதியாண்டு — the financial year__
// =========================================================================

ஓட்டம் = சமம்(ஓட்டம், நிதியாண்டின்_தொடக்க_ஆண்டு("2026-03-14", 4), 2025,
              "14 March 2026 falls in the year that began in April 2025");
ஓட்டம் = சமம்(ஓட்டம், நிதியாண்டின்_தொடக்க_ஆண்டு("2026-04-01", 4), 2026,
              "and 1 April 2026 begins the next one");
ஓட்டம் = சமம்(ஓட்டம், நிதியாண்டின்_தொடக்க_ஆண்டு("2026-03-14", 1), 2026,
              "with a January start it is simply the calendar year");

ஓட்டம் = சமம்(ஓட்டம், கால்_ஆண்டு_எண்("2026-07-15", 4), 2,
              "July is the second quarter of an April year");
ஓட்டம் = சமம்(ஓட்டம், கால்_ஆண்டு_எண்("2026-07-15", 1), 3,
              "and the third of a calendar year — a report that quarters the "
              & "calendar disagrees with the accounts three times in four");
ஓட்டம் = சமம்(ஓட்டம், கால்_ஆண்டு_எண்("2026-04-01", 4), 1, "April starts the first");
ஓட்டம் = சமம்(ஓட்டம், கால்_ஆண்டு_எண்("2026-03-31", 4), 4, "and March ends the fourth");

ஓட்டம் = சமம்(ஓட்டம், முந்தையது("2026-03-14", "2026-01-01"), "2026-01-01",
              "the earlier of two dates is a string comparison");
ஓட்டம் = சமம்(ஓட்டம், பிந்தையது("2026-03-14", "2026-01-01"), "2026-03-14",
              "and so is the later");

// =========================================================================
// __வேலை நாட்கள் — working days__
// =========================================================================
//
// __A five-day week with one holiday: Thursday 5 March 2026.__

நாட்காட்டி = நாட்காட்டி_ஆக்கு([0, 6], ["2026-03-05"]);

ஓட்டம் = உறுதிசெய்(ஓட்டம், வேலை_நாளா("2026-03-02", நாட்காட்டி),
                  "Monday 2 March is worked");
ஓட்டம் = உறுதிசெய்(ஓட்டம், இல்லை வேலை_நாளா("2026-03-07", நாட்காட்டி),
                  "Saturday is not");
ஓட்டம் = உறுதிசெய்(ஓட்டம், இல்லை வேலை_நாளா("2026-03-05", நாட்காட்டி),
                  "and neither is the Thursday holiday");
ஓட்டம் = உறுதிசெய்(ஓட்டம், விடுமுறையா("2026-03-05", நாட்காட்டி),
                  "which is a holiday rather than a weekly off");
ஓட்டம் = உறுதிசெய்(ஓட்டம், வார_ஓய்வா("2026-03-07", நாட்காட்டி),
                  "and Saturday the other way round");

ஓட்டம் = சமம்(ஓட்டம், மதிப்பு(அடுத்த_வேலை_நாள்("2026-03-06", நாட்காட்டி)),
              "2026-03-09", "after Friday comes Monday");
ஓட்டம் = சமம்(ஓட்டம், மதிப்பு(அடுத்த_வேலை_நாள்("2026-03-04", நாட்காட்டி)),
              "2026-03-06", "and the Thursday holiday is skipped");
ஓட்டம் = சமம்(ஓட்டம், மதிப்பு(முந்தைய_வேலை_நாள்("2026-03-09", நாட்காட்டி)),
              "2026-03-06", "backwards from Monday is Friday");

// __"The next working day" and "this day or the next" are different questions.__
ஓட்டம் = சமம்(ஓட்டம், மதிப்பு(அடுத்த_வேலை_நாள்("2026-03-02", நாட்காட்டி)),
              "2026-03-03", "the next working day after a Monday is Tuesday");
ஓட்டம் = சமம்(ஓட்டம், மதிப்பு(நகர்த்தி_வேலை_நாள்("2026-03-02", நாட்காட்டி)),
              "2026-03-02", "but rolling a Monday forward leaves it alone");
ஓட்டம் = சமம்(ஓட்டம், மதிப்பு(நகர்த்தி_வேலை_நாள்("2026-03-01", நாட்காட்டி)),
              "2026-03-02", "while a Sunday rolls to the Monday");

ஓட்டம் = சமம்(ஓட்டம், மதிப்பு(வேலை_நாட்களைக்_கூட்டு("2026-03-02", 4, நாட்காட்டி)),
              "2026-03-09",
              "four working days from Monday is the next Monday, because a "
              & "holiday and a weekend fall in between");
ஓட்டம் = சமம்(ஓட்டம், மதிப்பு(வேலை_நாட்களைக்_கூட்டு("2026-03-02", 0, நாட்காட்டி)),
              "2026-03-02", "zero does not move a date");
ஓட்டம் = சமம்(ஓட்டம், மதிப்பு(வேலை_நாட்களைக்_கூட்டு("2026-03-02", 0 - 1, நாட்காட்டி)),
              "2026-02-27", "and a negative count walks backwards to the Friday");

ஓட்டம் = சமம்(ஓட்டம், வேலை_நாட்களை_எண்ணு("2026-03-02", "2026-03-08", நாட்காட்டி), 4,
              "a full week holds four working days once the holiday is out");
ஓட்டம் = சமம்(ஓட்டம், வேலை_நாட்களை_எண்ணு("2026-03-02", "2026-03-02", நாட்காட்டி), 1,
              "a single working day counts as one — the range includes both ends");
ஓட்டம் = சமம்(ஓட்டம், வேலை_நாட்களை_எண்ணு("2026-03-08", "2026-03-02", நாட்காட்டி), 0,
              "a backwards range is zero rather than negative");

// =========================================================================
// __அட்டவணை — duration to dates__
// =========================================================================

ஓட்டம் = சமம்(ஓட்டம், மதிப்பு(முடிவு_நாள்("2026-03-02", 1, நாட்காட்டி)),
              "2026-03-02",
              "an activity of one day starting Monday finishes Monday — the "
              & "duration includes its start");
ஓட்டம் = சமம்(ஓட்டம், மதிப்பு(முடிவு_நாள்("2026-03-02", 10, நாட்காட்டி)),
              "2026-03-16", "ten working days from Monday 2 March is Monday 16th");
ஓட்டம் = சமம்(ஓட்டம், மதிப்பு(முடிவு_நாள்("2026-03-01", 1, நாட்காட்டி)),
              "2026-03-02", "a start on a Sunday is rolled onto the Monday first");
ஓட்டம் = உறுதிசெய்(ஓட்டம், தவறா(முடிவு_நாள்("2026-03-02", 0, நாட்காட்டி)),
                  "a duration of nothing is refused");

// __Adding the full duration instead of duration − 1 is the classic scheduling__
// __error, and it makes every activity a day too long.__
ஓட்டம் = வேறுபடு(ஓட்டம், மதிப்பு(முடிவு_நாள்("2026-03-02", 10, நாட்காட்டி)),
                 மதிப்பு(வேலை_நாட்களைக்_கூட்டு("2026-03-02", 10, நாட்காட்டி)),
                 "which is one working day later than the correct finish");

வரிசைப்_பணி = மதிப்பு(பணி_அட்டவணை("2026-03-02", 10, நாட்காட்டி));
ஓட்டம் = சமம்(ஓட்டம், வரிசைப்_பணி["தொடக்கம்"], "2026-03-02", "the schedule's start");
ஓட்டம் = சமம்(ஓட்டம், வரிசைப்_பணி["முடிவு"], "2026-03-16", "and its finish");
ஓட்டம் = சமம்(ஓட்டம், வரிசைப்_பணி["வேலை_நாட்கள்"], 10,
              "ten working days, which is the duration it was given");
ஓட்டம் = சமம்(ஓட்டம், வரிசைப்_பணி["மொத்த_நாட்கள்"], 15,
              "spread over fifteen elapsed days — the difference is what a "
              & "Gantt chart shows and a duration does not");

// =========================================================================
// __உருட்டல் மரபுகள் — rolling conventions__
// =========================================================================
//
// __31 May 2026 is a Sunday, and 1 August 2026 is a Saturday.__

வங்கி_நாட்காட்டி = நாட்காட்டி_ஆக்கு([0, 6], []);

ஓட்டம் = சமம்(ஓட்டம், மதிப்பு(உருட்டு("2026-05-29", வங்கி_நாட்காட்டி, "அடுத்தது")),
              "2026-05-29", "a working day is not rolled at all");
ஓட்டம் = சமம்(ஓட்டம், மதிப்பு(உருட்டு("2026-05-31", வங்கி_நாட்காட்டி, "அடுத்தது")),
              "2026-06-01", "following rolls Sunday 31 May into June");
ஓட்டம் = சமம்(ஓட்டம், மதிப்பு(உருட்டு("2026-05-31", வங்கி_நாட்காட்டி, "திருத்திய_அடுத்தது")),
              "2026-05-29",
              "modified following refuses to leave May and goes back to the "
              & "Friday — which is why a month-end obligation stays in its "
              & "own accounting period");
ஓட்டம் = சமம்(ஓட்டம், மதிப்பு(உருட்டு("2026-05-31", வங்கி_நாட்காட்டி, "முந்தையது")),
              "2026-05-29", "preceding reaches the same day by a different rule");
ஓட்டம் = சமம்(ஓட்டம், மதிப்பு(உருட்டு("2026-08-01", வங்கி_நாட்காட்டி, "திருத்திய_முந்தையது")),
              "2026-08-03",
              "modified preceding refuses to leave August and goes forward");
ஓட்டம் = சமம்(ஓட்டம், மதிப்பு(உருட்டு("2026-08-01", வங்கி_நாட்காட்டி, "முந்தையது")),
              "2026-07-31", "while plain preceding crosses into July");
ஓட்டம் = உறுதிசெய்(ஓட்டம், தவறா(உருட்டு("2026-05-31", வங்கி_நாட்காட்டி, "விரைவாக")),
                  "an unknown convention is refused rather than guessed");

// =========================================================================
// __தவறான நாட்காட்டி — a calendar that cannot work__
// =========================================================================

இயலாத_நாட்காட்டி = நாட்காட்டி_ஆக்கு([0, 1, 2, 3, 4, 5, 6], []);
ஓட்டம் = உறுதிசெய்(ஓட்டம், இல்லை வேலை_வாரம்_உள்ளதா(இயலாத_நாட்காட்டி),
                  "a calendar with all seven days off has no working week");
ஓட்டம் = உறுதிசெய்(ஓட்டம், தவறா(அடுத்த_வேலை_நாள்("2026-03-02", இயலாத_நாட்காட்டி)),
                  "and searching it fails loudly instead of running for ever");
ஓட்டம் = உறுதிசெய்(ஓட்டம், தவறா(முந்தைய_வேலை_நாள்("2026-03-02", இயலாத_நாட்காட்டி)),
                  "in both directions");
ஓட்டம் = உறுதிசெய்(ஓட்டம், வேலை_வாரம்_உள்ளதா(வங்கி_நாட்காட்டி),
                  "an ordinary five-day week has one");

// __A six-day week, because the weekend is not universal.__
ஆலை = நாட்காட்டி_ஆக்கு([0], []);
ஓட்டம் = உறுதிசெய்(ஓட்டம், வேலை_நாளா("2026-03-07", ஆலை),
                  "a factory working Saturdays treats 7 March as a working day");
ஓட்டம் = சமம்(ஓட்டம், வேலை_நாட்களை_எண்ணு("2026-03-02", "2026-03-08", ஆலை), 6,
              "and finds six working days in the week the office found four");

சோதனை_முடிவு(ஓட்டம்);
