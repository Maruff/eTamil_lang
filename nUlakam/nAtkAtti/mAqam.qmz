// __nUlakam/nAtkAtti/mAqam.qmz — மாதம்: month ends, and arithmetic in months and years__
// மாதம்: மாத முனைகளும், மாதம் ஆண்டு கணக்கும்
//
// __Adding a month to the 31st is the question these exist to answer. They__
// __clamp to the month's own last day rather than spilling into the next one,__
// __because a tenancy that starts on the 31st of January has its next due date__
// __in February, not in March.__

இறக்கு "../atippatY/kaNiqam.qmz";
இறக்கு "../atippatY/col.qmz";
இறக்கு "caripArppu.qmz";

// மாத_முதல்(ஒரு_நாள்) / மாத_இறுதி(ஒரு_நாள்)
// மாத_முதல்(ஒரு_நாள்) — அம்மாதத்தின் முதல் நாள்
// __மாத_முதல்(ஒரு_நாள்) — the first of that month__
//
// __Always day 1, so it needs no length lookup. Together with மாத_இறுதி it gives the period boundaries that a monthly report, an ageing bucket or an interest rest is computed between.__
செயல் மாத_முதல்(ஒரு_நாள்) {
    திரும்பு நாளாக_வடிவமை(ஆண்டைப்_பெறு(ஒரு_நாள்),
                            மாதத்தைப்_பெறு(ஒரு_நாள்), 1);
}

// __மாத_இறுதி(ஒரு_நாள்) — the last day of that month__
// மாத_இறுதி(ஒரு_நாள்) — அம்மாதத்தின் இறுதி நாள்
//
// __Asks மாத_நாட்கள் rather than adding a month and stepping back a day, which would go wrong from the 29th, 30th and 31st. The end of January reached by shifting a month from 31 January is not 28 February in most libraries, and this is the source of the classic month-end bug.__
செயல் மாத_இறுதி(ஒரு_நாள்) {
    ஆண்டு_மதிப்பு = ஆண்டைப்_பெறு(ஒரு_நாள்);
    மாத_மதிப்பு = மாதத்தைப்_பெறு(ஒரு_நாள்);
    திரும்பு நாளாக_வடிவமை(ஆண்டு_மதிப்பு, மாத_மதிப்பு,
                            மாத_நாட்கள்(ஆண்டு_மதிப்பு, மாத_மதிப்பு));
}

// __மாத_இறுதியா(ஒரு_நாள்) — is this the last day of its month?__
// மாத_இறுதியா(ஒரு_நாள்) — இது அம்மாதத்தின் இறுதி நாளா
//
// __The test a month-end rule needs: a schedule that falls on the end of the month has to land on the 28th, 30th or 31st depending on where it is, and a fixed day number cannot express that.__
செயல் மாத_இறுதியா(ஒரு_நாள்) {
    திரும்பு ஒரு_நாள் == மாத_இறுதி(ஒரு_நாள்);
}

// மாதங்களைக்_கூட்டு(ஒரு_நாள், மாத_எண்ணிக்கை)
//
// __Adding a month is not adding thirty days, and the difference is the last few__
// __days of every long month. The 31st of January plus one month is the 28th of__
// __February — there is no 31st — and the rule is to **clamp to the end of the__
// __target month** rather than to roll over into March.__
//
// __Clamping is not reversible, and that is a property of the calendar rather__
// __than a defect here: 31 January plus one month is 28 February, and 28__
// __February minus one month is 28 January. A schedule generated by repeatedly__
// __adding one month to the *previous* result therefore drifts — 31 Jan, 28 Feb,__
// __28 Mar — while one generated by adding n months to the *original* does not.__
// __Always count from the original.__
//
// __A negative count subtracts.__
// மாதங்களைக்_கூட்டு(ஒரு_நாள், மாத_எண்ணிக்கை) — நாளுடன் மாதங்களைக் கூட்டும்
செயல் மாதங்களைக்_கூட்டு(ஒரு_நாள், மாத_எண்ணிக்கை) {
    ஆண்டு_மதிப்பு = ஆண்டைப்_பெறு(ஒரு_நாள்);
    மாத_மதிப்பு = மாதத்தைப்_பெறு(ஒரு_நாள்);
    நாள்_மதிப்பு = நாளைப்_பெறு(ஒரு_நாள்);

    // __Count months from year zero so that மீதி never sees a negative.__
    ஓட்டு_மாதம் = ஆண்டு_மதிப்பு * 12 + (மாத_மதிப்பு - 1) + மாத_எண்ணிக்கை;
    புது_ஆண்டு = தரை(ஓட்டு_மாதம் / 12);
    புது_மாதம் = மீதி(ஓட்டு_மாதம், 12) + 1;

    உச்ச_நாள் = மாத_நாட்கள்(புது_ஆண்டு, புது_மாதம்);
    (நாள்_மதிப்பு > உச்ச_நாள்) எனில் { நாள்_மதிப்பு = உச்ச_நாள்; }

    திரும்பு நாளாக_வடிவமை(புது_ஆண்டு, புது_மாதம், நாள்_மதிப்பு);
}

// ஆண்டுகளைக்_கூட்டு(ஒரு_நாள், ஆண்டு_எண்ணிக்கை)
//
// __Through months, so that the 29th of February clamps to the 28th in a common__
// __year instead of becoming the 1st of March.__
// ஆண்டுகளைக்_கூட்டு(ஒரு_நாள், ஆண்டு_எண்ணிக்கை) — நாளுடன் ஆண்டுகளைக் கூட்டும்
செயல் ஆண்டுகளைக்_கூட்டு(ஒரு_நாள், ஆண்டு_எண்ணிக்கை) {
    திரும்பு மாதங்களைக்_கூட்டு(ஒரு_நாள், ஆண்டு_எண்ணிக்கை * 12);
}

// =========================================================================
// __இடைவெளிகள் — how long between two dates__
// =========================================================================
//
// __முடிந்த_மாதங்கள்(தொடக்கம், முடிவு) — whole months completed__
// முடிந்த_மாதங்கள்(தொடக்கம், முடிவு) — முழுமையாக முடிந்த மாதங்கள்
//
// __The count of calendar months from one date to another, ignoring the part__
// __month at the end. Gratuity, a period of holding, a loan tenor and a notice__
// __period are all stated this way, and none of them is days divided by thirty:__
// __from 31 January to 28 February is one completed month, and 28 days.__
//
// __The end-of-month rule matters. 31 January to 28 February is a full month__
// __because the 28th is as late as February goes — clamping made the target__
// __date, so the target date counts as reached. Without that rule, a monthly__
// __obligation starting on the 31st would never complete a month in February.__
// முடிந்த_மாதங்கள்(தொடக்கம், முடிவு) — முற்றுப்பெற்ற நாட்காட்டி மாதங்கள்; நாட்களை முப்பதால் வகுத்தல் அல்ல
செயல் முடிந்த_மாதங்கள்(தொடக்கம், முடிவு) {
    (நாள்_வேறுபாடு(தொடக்கம், முடிவு) <= 0) எனில் { திரும்பு 0; }

    கச்சா = (ஆண்டைப்_பெறு(முடிவு) * 12 + மாதத்தைப்_பெறு(முடிவு))
             - (ஆண்டைப்_பெறு(தொடக்கம்) * 12 + மாதத்தைப்_பெறு(தொடக்கம்));

    // __The day of the month has not come round yet, unless the month ran out__
    // __first — in which case its last day is the day it came round on.__
    (நாளைப்_பெறு(முடிவு) < நாளைப்_பெறு(தொடக்கம்)
     மற்றும் இல்லை மாத_இறுதியா(முடிவு)) எனில் {
        கச்சா = கச்சா - 1;
    }
    (கச்சா < 0) எனில் { திரும்பு 0; }
    திரும்பு கச்சா;
}

// __முடிந்த_ஆண்டுகள்(தொடக்கம், முடிவு) — whole years completed__
// முடிந்த_ஆண்டுகள்(தொடக்கம், முடிவு) — முழுமையாக முடிந்த ஆண்டுகள்
//
// __Somebody's age, and the number of completed years of service that gratuity__
// __is paid on.__
செயல் முடிந்த_ஆண்டுகள்(தொடக்கம், முடிவு) {
    திரும்பு தரை(முடிந்த_மாதங்கள்(தொடக்கம், முடிவு) / 12);
}

// __பகுதி_மாதங்கள்(தொடக்கம், முடிவு) — months, counting a part month as whole__
// பகுதி_மாதங்கள்(தொடக்கம், முடிவு) — முழு மாதங்களுக்குப் பின் எஞ்சும் பகுதி
//
// __This is the rule the Income Tax Act's interest sections use — "for every__
// __month or part of a month" — and it is the reason muZvari.qmz and__
// __mUlavari.qmz take a count of months rather than a pair of dates. One day__
// __into a new month is a whole month's interest.__
//
// __It is **calendar** months, not days divided by thirty and rounded up, and__
// __the two disagree on any month of 31 days: 1 January to 1 February is one__
// __month here and 31/30 rounded up — two — by the division. Seven months of__
// __twelve are long, so the error accumulates rather than averaging out, and a__
// __full year is twelve months by this rule against thirteen by the division.__
// __The division always overcharges and never under-charges, which is why it__
// __survives review: nobody disputes an interest computation in their favour.__
// பகுதி_மாதங்கள்(தொடக்கம், முடிவு) — தொடங்கிய மாதமும் சேர்ந்த நாட்காட்டி மாதங்கள்; நாட்களை முப்பதால் வகுத்து மேல்வழித்தல் அல்ல
செயல் பகுதி_மாதங்கள்(தொடக்கம், முடிவு) {
    (நாள்_வேறுபாடு(தொடக்கம், முடிவு) <= 0) எனில் { திரும்பு 0; }

    முழுமை = முடிந்த_மாதங்கள்(தொடக்கம், முடிவு);
    (மாதங்களைக்_கூட்டு(தொடக்கம், முழுமை) == முடிவு) எனில் { திரும்பு முழுமை; }
    திரும்பு முழுமை + 1;
}

// __முந்தையது(அ, ஆ) / பிந்தையது(அ, ஆ) — the earlier and the later__
// முந்தையது(அ, ஆ) — இரு நாள்களில் முந்தியது
//
// __ISO-8601 text sorts chronologically, so this is a string comparison and__
// __needs no arithmetic. That is the whole reason the format was chosen.__
செயல் முந்தையது(அ, ஆ) {
    (அ <= ஆ) எனில் { திரும்பு அ; }
    திரும்பு ஆ;
}

// __பிந்தையது(அ, ஆ) — the later of two dates__
// பிந்தையது(அ, ஆ) — இரு நாள்களில் பிந்தியது
//
// __A string comparison, like முந்தையது, because ISO-8601 text sorts chronologically. Ties return அ, which matters only in that the answer is a date and not a copy — the two are equal.__
செயல் பிந்தையது(அ, ஆ) {
    (அ >= ஆ) எனில் { திரும்பு அ; }
    திரும்பு ஆ;
}
