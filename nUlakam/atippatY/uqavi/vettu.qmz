// __வெட்டு(அணி, தொடக்கம், அளவு) — slice__
// அணியின் ஒரு பகுதியை வெட்டி எடுக்கும்

இறக்கு "../aNi.qmz";
இறக்கு "../col.qmz";
இறக்கு "../poruL.qmz";
இறக்கு "../kaNiqam.qmz";

எழுத்துகள் = ["அ", "ஆ", "இ", "ஈ", "உ"];
நடு = வெட்டு(எழுத்துகள், 1, 3);
அச்சு நீளம்(நடு);
அச்சு நடு[0];

// __Asking for more than is there stops at the end.__
// இருப்பதை விட அதிகம் கேட்டால் இருப்பதோடு நிற்கும்
அச்சு நீளம்(வெட்டு(எழுத்துகள், 3, 99));
