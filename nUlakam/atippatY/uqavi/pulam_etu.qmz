இறக்கு "../aNi.qmz";
இறக்கு "../col.qmz";
இறக்கு "../poruL.qmz";
இறக்கு "../kaNiqam.qmz";

ஊழியர்கள் = [ { பெயர்: "அரசி", ஊதியம்: 40000 },
              { பெயர்: "முருகன்", ஊதியம்: 35000 } ];
பெயர்கள் = புலம்_எடு(ஊழியர்கள், "பெயர்");
அச்சு பெயர்கள்[0];
அச்சு பெயர்கள்[1];
