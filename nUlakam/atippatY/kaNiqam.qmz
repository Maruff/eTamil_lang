// __nUlakam/atippatY/kaNiqam.qmz — கணிதம் (math) helpers__
//
// __Rounding, floor and ceiling come from the host because they need the__
// __decimal representation itself. Everything below is built from those.__

// __முழுமதிப்பு(எண்) — absolute value__
செயல் முழுமதிப்பு(மதிப்பு) {
    (மதிப்பு < 0) எனில் { திரும்பு 0 - மதிப்பு; }
    திரும்பு மதிப்பு;
}

// சிறியது(அ, ஆ) / பெரியது(அ, ஆ)
// __சிறியது(அ, ஆ) — the smaller of two numbers__
//
// __A tie returns ஆ, which matters only in that the values are equal. Present so callers do not write the comparison inline, where reversing it is easy and the mistake reads as correct.__
செயல் சிறியது(அ, ஆ) {
    (அ < ஆ) எனில் { திரும்பு அ; }
    திரும்பு ஆ;
}

// __பெரியது(அ, ஆ) — the larger of two numbers__
//
// __The pair to சிறியது. Between them they cover the clamping that shows up all over the accounting modules: an allowance that cannot go below zero, a claim capped at the sum insured.__
செயல் பெரியது(அ, ஆ) {
    (அ > ஆ) எனில் { திரும்பு அ; }
    திரும்பு ஆ;
}

// __கூட்டு(அணி) — sum of an array__
செயல் கூட்டு(பட்டியல்) {
    மொத்தம் = 0;
    ஒவ்வொரு உறுப்பு இல் பட்டியல் {
        மொத்தம் = மொத்தம் + உறுப்பு;
    }
    திரும்பு மொத்தம்;
}

// __சராசரி(அணி) — mean; an empty array is an error, not a division by zero__
செயல் சராசரி(பட்டியல்) {
    எண்ணிக்கை = நீளம்(பட்டியல்);
    (எண்ணிக்கை == 0) எனில் {
        திரும்பு தவறு("காலி அணியின் சராசரி இல்லை  (no average of an empty array)");
    }
    திரும்பு சரி(கூட்டு(பட்டியல்) / எண்ணிக்கை);
}

// மிகச்சிறியது(அணி) / மிகப்பெரியது(அணி)
// __மிகச்சிறியது(பட்டியல்) — the smallest element of an array__
//
// __சரி with the value, or தவறு for an empty array. Empty has no minimum, and answering zero would be a lie that survives into a report — the least of nothing is not nothing.__
செயல் மிகச்சிறியது(பட்டியல்) {
    (நீளம்(பட்டியல்) == 0) எனில் {
        திரும்பு தவறு("காலி அணி  (empty array)");
    }
    விடை = பட்டியல்[0];
    ஒவ்வொரு உறுப்பு இல் பட்டியல் {
        (உறுப்பு < விடை) எனில் { விடை = உறுப்பு; }
    }
    திரும்பு சரி(விடை);
}

// __மிகப்பெரியது(பட்டியல்) — the largest element of an array__
//
// __The pair to மிகச்சிறியது, and தவறு on empty for the same reason. Walks the array once rather than sorting it, so the cost is linear and the original order is untouched.__
செயல் மிகப்பெரியது(பட்டியல்) {
    (நீளம்(பட்டியல்) == 0) எனில் {
        திரும்பு தவறு("காலி அணி  (empty array)");
    }
    விடை = பட்டியல்[0];
    ஒவ்வொரு உறுப்பு இல் பட்டியல் {
        (உறுப்பு > விடை) எனில் { விடை = உறுப்பு; }
    }
    திரும்பு சரி(விடை);
}

// __சதவீதம்(தொகை, விகிதம்) — விகிதம் percent of தொகை, rounded to paise__
செயல் சதவீதம்(தொகை, விகிதம்) {
    திரும்பு வட்டமிடு(தொகை * விகிதம் / 100, 2);
}

// __முழு_எண்ணா(மதிப்பு) — is this a whole number?__
செயல் முழு_எண்ணா(மதிப்பு) {
    திரும்பு தரை(மதிப்பு) == மதிப்பு;
}

// __மீதி(எண், வகுப்பான்) — the remainder, since there is no % operator__
//
// __Written here rather than added to the host: it follows from தரை and the__
// __arithmetic the language already has, so Layer 0 gains nothing by owning it.__
செயல் மீதி(எண்_மதிப்பு, வகுப்பான்) {
    (வகுப்பான் == 0) எனில் { திரும்பு 0; }
    திரும்பு எண்_மதிப்பு - தரை(எண்_மதிப்பு / வகுப்பான்) * வகுப்பான்;
}

// __வர்க்கமூலம்(மதிப்பு) is a host builtin now.__
//
// __It was Newton's method here, written in eTamil because the host had no__
// __square root and the arithmetic to build one was all the language gave.__
// __Forty iterations per call, and it was never quite exact: √25 came back__
// __as 5.000000000000000000000288615.__
//
// __The host computes it on the Decimal itself, not through f64, so it is__
// __both faster and exact — √25 is 5. A negative input is still a தவறு for__
// __the reason it always was: the root of a negative variance is a sign__
// __error upstream, and answering zero hides it inside a confidence figure__
// __that looks perfectly reasonable.__
//
// __A function defined here would shadow the builtin, so it is gone rather__
// __than delegating.__

// __--- Money, to the paisa --------------------------------------------------__
//
// __Four operations that were written out in sixteen places across eleven__
// __modules before they lived here: a difference, a difference that cannot go__
// __negative, a share, and a product — each rounded to two places, because a__
// __figure carried to twenty-eight and rounded at the end disagrees with a__
// __ledger that rounded as it went.__
//
// __The domain names stay where they are. `தற்காலிக_வேறுபாடு` and__
// __`இந்தக்_காலத்து_வருவாய்` are not the same idea and should not share a name;__
// __what they share is arithmetic, and that is what lives here.__

// __வட்டக்_கழி(அ, ஆ) — அ less ஆ, to the paisa__
செயல் வட்டக்_கழி(அ, ஆ) {
    திரும்பு வட்டமிடு(அ - ஆ, 2);
}

// __குறையாக்_கழி(அ, ஆ) — அ less ஆ, floored at zero__
//
// __A deduction larger than the income it is set against does not make the__
// __income negative; it exhausts it. Chapter VI-A says so, and so does every__
// __other place this is used.__
செயல் குறையாக்_கழி(அ, ஆ) {
    விடை = அ - ஆ;
    (விடை < 0) எனில் { திரும்பு 0; }
    திரும்பு வட்டமிடு(விடை, 2);
}

// __வட்டப்_பங்கு(தொகை, வீதம்) — வீதம் per cent of தொகை, to the paisa__
செயல் வட்டப்_பங்கு(தொகை, வீதம்) {
    திரும்பு வட்டமிடு(சதவீதம்(தொகை, வீதம்), 2);
}

// __வட்டப்_பெருக்கு(அ, ஆ) — a rate times a quantity, to the paisa__
செயல் வட்டப்_பெருக்கு(அ, ஆ) {
    திரும்பு வட்டமிடு(அ * ஆ, 2);
}

// __நாள்_விகிதம்(தொகை, நாட்கள், மொத்த_நாட்கள்) — a period's share of an amount__
//
// __A premium for part of a year, a salary for part of a month, a rent for part__
// __of a quarter. Three guards, and each of them is a real case: no period at__
// __all is zero rather than a division by zero; a period at least as long as the__
// __whole is the whole amount and not an amount scaled slightly past it; and a__
// __negative number of days is nothing, not a refund.__
செயல் நாள்_விகிதம்(தொகை, நாட்கள், மொத்த_நாட்கள்) {
    (மொத்த_நாட்கள் <= 0) எனில் { திரும்பு 0; }
    (நாட்கள் >= மொத்த_நாட்கள்) எனில் { திரும்பு வட்டமிடு(தொகை, 2); }
    (நாட்கள் <= 0) எனில் { திரும்பு 0; }
    திரும்பு வட்டமிடு(தொகை * நாட்கள் / மொத்த_நாட்கள், 2);
}

// __வட்ட_மாதங்கள்(நாட்கள்) — days as whole months, any part month counting as one__
//
// __The convention the Income-tax Act uses for interest: a month begun is a__
// __month owed. Thirty days to the month, so a caller holding real dates should__
// __count calendar months itself — February will disagree with this by a day.__
செயல் வட்ட_மாதங்கள்(நாட்கள்) {
    (நாட்கள் <= 0) எனில் { திரும்பு 0; }
    திரும்பு மேல்(நாட்கள் / 30);
}
