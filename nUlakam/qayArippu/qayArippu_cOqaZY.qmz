// __தயாரிப்பு_சோதனை — tests for the product management modules__
// தயாரிப்பு மேலாண்மைத் தொகுதிகளுக்கான சோதனைகள்
//
// __Run it like any other program:  etamil --vm nUlakam/qayArippu/qayArippu_cOqaZY.qmz__
// __It exits non-zero if anything fails, so it works as a CI step. Today is__
// __2026-09-28 throughout.__

இறக்கு "../cOqaZY/cOqaZY.qmz";
இறக்கு "paqippu.qmz";
இறக்கு "vAkkuRuqi.qmz";

ஓட்டம் = சோதனை_தொடக்கம்("தயாரிப்பு — product management");
இன்று_நாள் = "2026-09-28";

// =========================================================================
// __பதிப்பு — versions__
// =========================================================================

ஆறு_பத்து = மதிப்பு(பதிப்பைப்_படி("V6.10.0"));
ஆறு_ஒன்பது = மதிப்பு(பதிப்பைப்_படி("6.9.4"));
ஓட்டம் = சமம்(ஓட்டம், ஆறு_பத்து.சிறு_எண், 10, "a leading V is dropped");
ஓட்டம் = சமம்(ஓட்டம், பதிப்புகளை_ஒப்பிடு(ஆறு_பத்து, ஆறு_ஒன்பது), 1, "6.10.0 is after 6.9.4");
ஓட்டம் = சமம்(ஓட்டம், பதிப்புகளை_ஒப்பிடு(ஆறு_ஒன்பது, ஆறு_பத்து), 0 - 1, "and 6.9.4 before 6.10.0");
ஓட்டம் = சமம்(ஓட்டம், பதிப்புகளை_ஒப்பிடு(ஆறு_ஒன்பது, ஆறு_ஒன்பது), 0, "a version equals itself");
ஓட்டம் = உறுதிசெய்(ஓட்டம், தவறா(பதிப்பைப்_படி("6.2")), "two parts is refused");
ஓட்டம் = உறுதிசெய்(ஓட்டம், தவறா(பதிப்பைப்_படி("6.x.1")), "a part that is not a number is refused");
ஓட்டம் = உறுதிசெய்(ஓட்டம், தவறா(பதிப்பைப்_படி("6.1.5.2")), "four parts is refused");
ஓட்டம் = உறுதிசெய்(ஓட்டம், தவறா(பதிப்பைப்_படி("6.1.-1")), "a negative part is refused");
ஓட்டம் = உறுதிசெய்(ஓட்டம், தவறா(பதிப்பைப்_படி("06.2.1")), "a leading zero is refused");
ஓட்டம் = உறுதிசெய்(ஓட்டம், தவறா(பதிப்பைப்_படி("6.2.5e0")), "and so is an exponent");
ஓட்டம் = உறுதிசெய்(ஓட்டம், சரியா(பதிப்பைப்_படி("0.10.0")), "but a part that is exactly 0 is fine");

ஓட்டம் = சமம்(ஓட்டம், பதிப்பை_எழுது(மதிப்பு(பதிப்பை_உயர்த்து(ஆறு_ஒன்பது, "சிறு"))), "6.10.0",
              "a minor release zeroes the patch");
ஓட்டம் = சமம்(ஓட்டம், பதிப்பை_எழுது(மதிப்பு(பதிப்பை_உயர்த்து(ஆறு_ஒன்பது, "பெரும்"))), "7.0.0",
              "a major release zeroes both");
ஓட்டம் = சமம்(ஓட்டம், பதிப்பை_எழுது(மதிப்பு(பதிப்பை_உயர்த்து(ஆறு_ஒன்பது, "திருத்தம்"))), "6.9.5",
              "a patch moves only the patch");
ஓட்டம் = உறுதிசெய்(ஓட்டம், தவறா(பதிப்பை_உயர்த்து(ஆறு_ஒன்பது, "minor")), "an unknown part is refused");
ஓட்டம் = உறுதிசெய்(ஓட்டம், அதே_தளமா(ஆறு_பத்து, 6), "6.10.0 is on platform 6");
ஓட்டம் = உறுதிசெய்(ஓட்டம், இல்லை அதே_தளமா(ஆறு_பத்து, 7), "and not on 7");

ஓட்டம் = சமம்(ஓட்டம், ஆதரவு_நிலை("", இன்று_நாள், 12), "நடப்பு", "never superseded is current");
ஓட்டம் = சமம்(ஓட்டம், ஆதரவு_நிலை("2026-01-31", இன்று_நாள், 12), "மாற்றப்பட்டது", "superseded, still supported");
ஓட்டம் = சமம்(ஓட்டம், ஆதரவு_நிலை("2025-09-28", இன்று_நாள், 12), "ஆதரவு_முடிந்தது",
              "support ends on the anniversary itself");
ஓட்டம் = சமம்(ஓட்டம், ஆதரவு_நிலை("2025-09-29", இன்று_நாள், 12), "மாற்றப்பட்டது", "and not a day before");

// =========================================================================
// __வாக்குறுதி — release commitments__
// =========================================================================
//
//   __C1  slipped, not told, target ahead          → notice due__
//   __C2  slipped, told after the target, revised  → notice late__
//   __C3  in build, target passed                  → overdue__
//   __C4  shipped                                  → closed__

வாக்குறுதிகள் = [வாக்குறுதி_ஆக்கு("C1", "2026-10-15", "", "நழுவியது", ""),
                 வாக்குறுதி_ஆக்கு("C2", "2026-09-01", "2026-10-30", "நழுவியது", "2026-09-05"),
                 வாக்குறுதி_ஆக்கு("C3", "2026-09-20", "", "கட்டுமானத்தில்", ""),
                 வாக்குறுதி_ஆக்கு("C4", "2026-09-01", "", "வெளியிட்டது", "")];

ஓட்டம் = சமம்(ஓட்டம், உரிய_நாள்(வாக்குறுதிகள்[1]), "2026-10-30", "a revised date is the one that counts");
ஓட்டம் = சமம்(ஓட்டம், உரிய_நாள்(வாக்குறுதிகள்[0]), "2026-10-15", "else the target");
ஓட்டம் = உறுதிசெய்(ஓட்டம், இல்லை வாக்குறுதி_திறந்ததா(வாக்குறுதிகள்[3]), "shipped is closed");
ஓட்டம் = உறுதிசெய்(ஓட்டம், வாக்குறுதி_கடந்ததா(வாக்குறுதிகள்[2], இன்று_நாள்), "C3 is overdue");
ஓட்டம் = உறுதிசெய்(ஓட்டம், இல்லை வாக்குறுதி_கடந்ததா(வாக்குறுதிகள்[1], இன்று_நாள்),
                  "C2 is not, because its date was revised");
ஓட்டம் = உறுதிசெய்(ஓட்டம், இல்லை வாக்குறுதி_கடந்ததா(வாக்குறுதிகள்[3], இன்று_நாள்), "a shipped one never is");

ஓட்டம் = உறுதிசெய்(ஓட்டம், அறிவிப்பு_தேவையா(வாக்குறுதிகள்[0], இன்று_நாள்), "C1 must be told now");
ஓட்டம் = உறுதிசெய்(ஓட்டம், இல்லை அறிவிப்பு_தாமதமா(வாக்குறுதிகள்[0], இன்று_நாள்), "and it is not late yet");
ஓட்டம் = உறுதிசெய்(ஓட்டம், அறிவிப்பு_தாமதமா(வாக்குறுதிகள்[1], இன்று_நாள்), "C2 was told after its target");
ஓட்டம் = உறுதிசெய்(ஓட்டம், அறிவிப்பு_தாமதமா(வாக்குறுதிகள்[0], "2026-10-15"),
                  "C1 becomes late on its target day if still untold");
அன்றே = வாக்குறுதி_ஆக்கு("C5", "2026-09-10", "", "நழுவியது", "2026-09-10");
ஓட்டம் = உறுதிசெய்(ஓட்டம், இல்லை அறிவிப்பு_தாமதமா(அன்றே, இன்று_நாள்), "told on the target day is in time");

ஓட்டம் = சமம்(ஓட்டம், தெரிவித்ததாகப்_பதி(வாக்குறுதிகள்[1], இன்று_நாள்).தெரிவித்த_நாள், "2026-09-05",
              "a second notice does not move the first");
ஓட்டம் = சமம்(ஓட்டம், தெரிவித்ததாகப்_பதி(வாக்குறுதிகள்[0], இன்று_நாள்).தெரிவித்த_நாள், இன்று_நாள்,
              "the first notice is recorded");

எண்ணிக்கைகள் = வாக்குறுதி_எண்ணிக்கைகள்(வாக்குறுதிகள், இன்று_நாள்);
ஓட்டம் = சமம்(ஓட்டம், எண்ணிக்கைகள்.மொத்தம், 4, "four commitments");
ஓட்டம் = சமம்(ஓட்டம், எண்ணிக்கைகள்.திறந்தவை, 3, "three open");
ஓட்டம் = சமம்(ஓட்டம், எண்ணிக்கைகள்.கடந்தவை, 1, "one overdue");
ஓட்டம் = சமம்(ஓட்டம், எண்ணிக்கைகள்.அறிவிப்பு_தேவை, 1, "one notice due");
ஓட்டம் = சமம்(ஓட்டம், எண்ணிக்கைகள்.அறிவிப்பு_தாமதம், 1, "one notice late");

சோதனை_முடிவு(ஓட்டம்);
