// __nUlakam/qayArippu/paqippu.qmz — பதிப்பு (product versions and their support life)__
// தயாரிப்புப் பதிப்புகளும் அவற்றின் ஆதரவுக் காலமும்
//
// __A product version is three numbers, major.minor.patch, and the major is the__
// __platform: every product on platform 6 is 6.x.y, and a milestone for a 6.x__
// __release cannot be planned on platform 7. The minor moves with features and__
// __the patch with fixes.__
//
// __Versions compare as numbers, part by part — 6.10.0 is after 6.9.4, which a__
// __text comparison gets backwards. A leading V is accepted and dropped, since__
// __branches and release titles are often written V6.0.0.__
//
// __A version is current until a later one supersedes it, then supported for__
// __ஆதரவு_மாதங்கள் more months, then out of support:__
//
//   __நடப்பு             nothing has replaced it__
//   __மாற்றப்பட்டது       replaced, still supported__
//   __ஆதரவு_முடிந்தது     replaced, and the support window has closed__

இறக்கு "../atippatY/col.qmz";
இறக்கு "../nAtkAtti/mAqam.qmz";

// __இயல்பு_ஆதரவு_மாதங்கள்() — how long a superseded version stays supported__
// இயல்பு_ஆதரவு_மாதங்கள்() — மாற்றப்பட்ட பதிப்புக்கு ஆதரவு தொடரும் மாதங்கள்
செயல் இயல்பு_ஆதரவு_மாதங்கள்() { திரும்பு 12; }

// __பதிப்பைப்_படி(பதிப்பு_உரை) — "6.2.1" or "V6.2.1" as a version record__
// பதிப்பைப்_படி(பதிப்பு_உரை) — பதிப்பு உரையைப் பதிவாக்கும்
//
// __சரி({பெரும்_எண், சிறு_எண், திருத்த_எண்}) or தவறு naming the text. Exactly__
// __three parts of plain digits, with no leading zero except 0 itself; "6.2" is__
// __refused rather than read as 6.2.0, because a version written short is__
// __usually a version written wrong, and "06.2.1" is refused because it would__
// __come back from பதிப்பை_எழுது as a different string.__
செயல் பதிப்பைப்_படி(பதிப்பு_உரை) {
    உரை_மட்டும் = ஒழுங்கு(பதிப்பு_உரை);
    (தொடங்குகிறதா(உரை_மட்டும், "V") அல்லது தொடங்குகிறதா(உரை_மட்டும், "v")) எனில் {
        உரை_மட்டும் = துண்டு(உரை_மட்டும், 1, நீளம்(உரை_மட்டும்) - 1);
    }
    பகுதிகள் = பிரி(உரை_மட்டும், ".");
    பிழை = தவறு("'" & பதிப்பு_உரை & "' ஒரு பதிப்பு அல்ல  ('" & பதிப்பு_உரை
                 & "' is not a version; expected major.minor.patch)");
    (நீளம்(பகுதிகள்) != 3) எனில் { திரும்பு பிழை; }
    எண்கள் = [];
    ஒவ்வொரு பகுதி இல் பகுதிகள் {
        (பகுதி == "") எனில் { திரும்பு பிழை; }
        (நீளம்(பகுதி) > 1 மற்றும் தொடங்குகிறதா(பகுதி, "0")) எனில் { திரும்பு பிழை; }
        ஒவ்வொரு குறியெழுத்து இல் பகுதி {
            (இல்லை கொண்டுள்ளதா("0123456789", குறியெழுத்து)) எனில் { திரும்பு பிழை; }
        }
        எண்கள் = இணை(எண்கள், மதிப்பு(எண்ணாக்கு(பகுதி)));
    }
    திரும்பு சரி({ பெரும்_எண்: எண்கள்[0], சிறு_எண்: எண்கள்[1], திருத்த_எண்: எண்கள்[2] });
}

// __பதிப்பை_எழுது(ஒரு_பதிப்பு) — a version record as text__
// பதிப்பை_எழுது(ஒரு_பதிப்பு) — பதிப்புப் பதிவை உரையாக்கும்
செயல் பதிப்பை_எழுது(ஒரு_பதிப்பு) {
    திரும்பு சொல்லாக்கு(ஒரு_பதிப்பு.பெரும்_எண்) & "." & சொல்லாக்கு(ஒரு_பதிப்பு.சிறு_எண்)
             & "." & சொல்லாக்கு(ஒரு_பதிப்பு.திருத்த_எண்);
}

// __பதிப்புகளை_ஒப்பிடு(அ, ஆ) — −1, 0 or 1 as அ is before, equal to or after ஆ__
// பதிப்புகளை_ஒப்பிடு(அ, ஆ) — இரு பதிப்புகளை ஒப்பிடும்
செயல் பதிப்புகளை_ஒப்பிடு(அ, ஆ) {
    ஒவ்வொரு பகுதி இல் ["பெரும்_எண்", "சிறு_எண்", "திருத்த_எண்"] {
        (அ[பகுதி] < ஆ[பகுதி]) எனில் { திரும்பு 0 - 1; }
        (அ[பகுதி] > ஆ[பகுதி]) எனில் { திரும்பு 1; }
    }
    திரும்பு 0;
}

// __பதிப்பை_உயர்த்து(ஒரு_பதிப்பு, பகுதி) — the next version__
// பதிப்பை_உயர்த்து(ஒரு_பதிப்பு, பகுதி) — அடுத்த பதிப்பு
//
// __பகுதி is "பெரும்", "சிறு" or "திருத்தம்". Raising a part zeroes every part__
// __after it: the release after 6.2.3 with a new feature is 6.3.0, not 6.3.3.__
செயல் பதிப்பை_உயர்த்து(ஒரு_பதிப்பு, பகுதி) {
    (பகுதி == "பெரும்") எனில் {
        திரும்பு சரி({ பெரும்_எண்: ஒரு_பதிப்பு.பெரும்_எண் + 1, சிறு_எண்: 0, திருத்த_எண்: 0 });
    }
    (பகுதி == "சிறு") எனில் {
        திரும்பு சரி({ பெரும்_எண்: ஒரு_பதிப்பு.பெரும்_எண், சிறு_எண்: ஒரு_பதிப்பு.சிறு_எண் + 1,
                      திருத்த_எண்: 0 });
    }
    (பகுதி == "திருத்தம்") எனில் {
        திரும்பு சரி({ பெரும்_எண்: ஒரு_பதிப்பு.பெரும்_எண், சிறு_எண்: ஒரு_பதிப்பு.சிறு_எண்,
                      திருத்த_எண்: ஒரு_பதிப்பு.திருத்த_எண் + 1 });
    }
    திரும்பு தவறு("பகுதி பெரும், சிறு, திருத்தம் இவற்றில் ஒன்றாக இருக்க வேண்டும்  "
                   & "(the part must be பெரும், சிறு or திருத்தம்)");
}

// __அதே_தளமா(ஒரு_பதிப்பு, தள_எண்) — does this version belong to this platform?__
// அதே_தளமா(ஒரு_பதிப்பு, தள_எண்) — இப்பதிப்பு இத்தளத்தைச் சேர்ந்ததா
//
// __தள_எண் is a number, 6, not the text "6": a number and a string are never__
// __equal, so text read from a form must go through எண்ணாக்கு first.__
செயல் அதே_தளமா(ஒரு_பதிப்பு, தள_எண்) {
    திரும்பு ஒரு_பதிப்பு.பெரும்_எண் == தள_எண்;
}

// __ஆதரவு_நிலை(மாற்றிய_நாள், இன்றைய_நாள், ஆதரவு_மாதங்கள்) — where a version is in its support life__
// ஆதரவு_நிலை(மாற்றிய_நாள், இன்றைய_நாள், ஆதரவு_மாதங்கள்) — ஒரு பதிப்பின் ஆதரவு நிலை
//
// __மாற்றிய_நாள் is the date a later version superseded this one, or "" if__
// __nothing has. Support runs to the same day ஆதரவு_மாதங்கள் months later, and__
// __ends on it.__
செயல் ஆதரவு_நிலை(மாற்றிய_நாள், இன்றைய_நாள், ஆதரவு_மாதங்கள்) {
    (மாற்றிய_நாள் == "") எனில் { திரும்பு "நடப்பு"; }
    (இன்றைய_நாள் < மாதங்களைக்_கூட்டு(மாற்றிய_நாள், ஆதரவு_மாதங்கள்)) எனில் {
        திரும்பு "மாற்றப்பட்டது";
    }
    திரும்பு "ஆதரவு_முடிந்தது";
}
