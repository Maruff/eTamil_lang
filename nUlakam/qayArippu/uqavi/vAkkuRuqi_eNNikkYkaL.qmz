// __வாக்குறுதி_எண்ணிக்கைகள்(வாக்குறுதிகள், இன்றைய_நாள்) — the register's dashboard figures__
// பதிவேட்டின் முகப்பு எண்ணிக்கைகள்

இறக்கு "../vAkkuRuqi.qmz";

// __The platform-6 register on 20 October 2026.__
// இருபது அக்டோபர் அன்று ஆறாம் தளப் பதிவேடு
பதிவேடு_பட்டியல் = [
    வாக்குறுதி_ஆக்கு("வா-801", "2026-10-15", "", "நழுவியது", ""),
    வாக்குறுதி_ஆக்கு("வா-802", "2026-10-15", "2026-11-30", "நழுவியது", "2026-10-18"),
    வாக்குறுதி_ஆக்கு("வா-803", "2026-12-01", "", "நழுவியது", ""),
    வாக்குறுதி_ஆக்கு("வா-804", "2026-09-01", "", "வெளியிட்டது", ""),
    வாக்குறுதி_ஆக்கு("வா-805", "2026-11-15", "", "விலக்கியது", "")
];
அச்சு வாக்குறுதி_எண்ணிக்கைகள்(பதிவேடு_பட்டியல், "2026-10-20");

// __The figures overlap and do not add up to the total. வா-801 is both overdue__
// __and late in notice; வா-802, revised to November, is late but not overdue;__
// __வா-803 still needs a notice.__
// எண்ணிக்கைகள் ஒன்றோடொன்று மேவும்; கூட்டினால் மொத்தம் வராது
அச்சு வாக்குறுதி_எண்ணிக்கைகள்([], "2026-10-20");
