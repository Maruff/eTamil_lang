// __nUlakam/paNam/kAcu.qmz — காசு: money as whole paise__
// காசு: பணத்தை முழுப் பைசாவாக வைத்துக் கணக்கிடல்
//
// __Two decimal places, exactly, without decimal arithmetic underneath.__
//
// __₹2.05 is 205. Nothing in this file writes a fractional number, and that is__
// __the point: a double represents every integer below 2^53 exactly — about__
// __₹90,000 crore expressed in paise — so adding, subtracting and multiplying__
// __money is exact even on a backend that has only floats. The LLVM backend__
// __computes in f64 and refuses fractional literals; a program written in paise__
// __is not asking it for anything it cannot do.__
//
// __On the VM this is simply a second way to hold money, and a good one for__
// __anything that must reconcile: an amount that is only ever a whole number of__
// __paise cannot acquire a fraction of one by accident.__
//
// __The one operation that needs care is division, and it is the reason the two__
// __interesting functions here exist:__
//
//   __விழுக்காடு_காசு  a percentage, rounded once rather than at every step__
//   __சமமாகப்_பிரி     a split that distributes the odd paise instead of losing__
//                    __them — the classic way money disappears from a ledger__
//
// __A note for the LLVM backend: division of a paise figure is the one step where__
// __a double can be out by one in the last place. Compiling whole numbers as i64__
// __and using integer division would make it exact, and that is a much smaller__
// __change than decimal arithmetic. See docs/llvm-backend-gaps.md.__

இறக்கு "../atippatY/kaNiqam.qmz";

பைசா_ஒரு_ரூபாய் = 100;

// __--- making it ------------------------------------------------------------__
//
// __ரூபாயும்_பைசாவும்(ரூபாய், பைசா) — ₹2.05 is ரூபாயும்_பைசாவும்(2, 5)__
// ரூபாயும்_பைசாவும்(ரூபாய், பைசா) — ரூபாயையும் பைசாவையும் சேர்த்து மொத்தப் பைசாவாக்கும்
//
// __Two whole numbers rather than one written 2.05, so that a program in paise__
// __never has a fractional literal in it anywhere.__
செயல் ரூபாயும்_பைசாவும்(ரூபாய், பைசா) {
    திரும்பு ரூபாய் * பைசா_ஒரு_ரூபாய் + பைசா;
}

// __ரூபாயாக(ரூபாய்) — whole rupees__
// ரூபாயாக(ரூபாய்) — முழு ரூபாயை மொத்தப் பைசாவாக்கும்
செயல் ரூபாயாக(ரூபாய்) {
    திரும்பு ரூபாய் * பைசா_ஒரு_ரூபாய்;
}

// __--- showing it -----------------------------------------------------------__
//
// __காசு_உரை(மொத்த_பைசா) — "2.05", built from the two halves rather than by__
// காசு_உரை(மொத்த_பைசா) — பைசாவை ரூபாய்.பைசா வடிவ உரையாக்கும்
// __dividing, so no fraction is ever produced to be formatted.__
செயல் காசு_உரை(மொத்த_பைசா) {
    குறி = "";
    அளவு = மொத்த_பைசா;
    (மொத்த_பைசா < 0) எனில் {
        குறி = "-";
        அளவு = 0 - மொத்த_பைசா;
    }

    ரூபாய்ப்_பகுதி = தரை(அளவு / பைசா_ஒரு_ரூபாய்);
    பைசாப்_பகுதி = அளவு - ரூபாய்ப்_பகுதி * பைசா_ஒரு_ரூபாய்;

    (பைசாப்_பகுதி < 10) எனில் {
        திரும்பு குறி & ரூபாய்ப்_பகுதி & ".0" & பைசாப்_பகுதி;
    }
    திரும்பு குறி & ரூபாய்ப்_பகுதி & "." & பைசாப்_பகுதி;
}

// __--- the exact operations -------------------------------------------------__
//
// __Addition, subtraction and multiplication by a count: exact on any backend,__
// __because whole numbers are exact in a double.__
// காசு_கூட்டு(அ, ஆ) — இரு பணத் தொகைகளைக் கூட்டும்
செயல் காசு_கூட்டு(அ, ஆ) { திரும்பு அ + ஆ; }
// __காசு_கழி(அ, ஆ) — subtract one money amount from another__
// காசு_கழி(அ, ஆ) — ஒரு தொகையிலிருந்து இன்னொன்றைக் கழிக்கும்
//
// __Plain subtraction, named for symmetry with காசு_கூட்டு so money arithmetic reads the same way throughout. No rounding: the operands are already at the scale money is held in, and rounding a difference that was never rounded into existence only loses paise.__
செயல் காசு_கழி(அ, ஆ) { திரும்பு அ - ஆ; }

// __காசு_மடங்கு(மொத்த_பைசா, எண்ணிக்கை) — a price times a quantity__
// காசு_மடங்கு(மொத்த_பைசா, எண்ணிக்கை) — விலையை எண்ணிக்கையால் பெருக்கும்
செயல் காசு_மடங்கு(மொத்த_பைசா, எண்ணிக்கை) {
    திரும்பு மொத்த_பைசா * எண்ணிக்கை;
}

// __காசு_கூட்டல்(பட்டியல்) — a column of money__
// காசு_கூட்டல்(பட்டியல்) — பணத் தொகைகளின் பட்டியலைக் கூட்டும்
செயல் காசு_கூட்டல்(பட்டியல்) {
    கூட்டல் = 0;
    ஒவ்வொரு ஒன்று இல் பட்டியல் {
        கூட்டல் = கூட்டல் + ஒன்று;
    }
    திரும்பு கூட்டல்;
}

// __--- the operation that needs rounding -----------------------------------__
//
// __விழுக்காடு_காசு(மொத்த_பைசா, மேல், கீழ்) — a rate as a fraction__
// விழுக்காடு_காசு(மொத்த_பைசா, மேல், கீழ்) — வீதத்தைப் பின்னமாகக் கொண்டு தொகையைக் கணக்கிடும்
//
// __18% is மேல்=18, கீழ்=100. A rate of 7.5% is 75 and 1000, because writing 7.5__
// __would be the fractional literal this whole approach avoids.__
//
// __Rounded half-up, once, at the end. Rounding at each step of a calculation is__
// __how a total stops matching the sum of its lines.__
செயல் விழுக்காடு_காசு(மொத்த_பைசா, மேல், கீழ்) {
    (கீழ் == 0) எனில் { திரும்பு 0; }
    (மொத்த_பைசா < 0) எனில் {
        திரும்பு 0 - விழுக்காடு_காசு(0 - மொத்த_பைசா, மேல், கீழ்);
    }
    // __+ கீழ்/2 before dividing is half-up rounding done in whole numbers.__
    திரும்பு தரை((மொத்த_பைசா * மேல் + தரை(கீழ் / 2)) / கீழ்);
}

// __--- the split that does not lose paise ----------------------------------__
//
// சமமாகப்_பிரி(மொத்த_பைசா, எத்தனை)
//
// __Ten rupees three ways is 3.34, 3.33, 3.33 — not 3.33 three times, which__
// __loses a paisa, and not 3.34 three times, which invents one. The remainder is__
// __handed out one paisa at a time to the earliest shares.__
//
// __This is the classic way money disappears from a ledger: every share rounded__
// __the same way, and the total quietly short.__
// __சமமாகப்_பிரி(மொத்த_பைசா, எத்தனை) — split an amount evenly, losing no paisa__
// சமமாகப்_பிரி(மொத்த_பைசா, எத்தனை) — தொகையைச் சமமாகப் பிரிக்கும்; மீதிப் பைசா தொலையாது
செயல் சமமாகப்_பிரி(மொத்த_பைசா, எத்தனை) {
    (எத்தனை <= 0) எனில் { திரும்பு []; }

    அடிப்படை = தரை(மொத்த_பைசா / எத்தனை);
    மீதம் = மொத்த_பைசா - அடிப்படை * எத்தனை;

    பங்குகள் = [];
    எண்ணி = 0;
    (எண்ணி < எத்தனை) சுற்று {
        இந்தப்_பங்கு = அடிப்படை;
        (எண்ணி < மீதம்) எனில் {
            இந்தப்_பங்கு = அடிப்படை + 1;
        }
        பங்குகள் = இணை(பங்குகள், இந்தப்_பங்கு);
        எண்ணி = எண்ணி + 1;
    }
    திரும்பு பங்குகள்;
}

// __--- splitting in proportion ---------------------------------------------__
//
// விகிதத்தில்_பிரி(மொத்த_பைசா, எடைகள்)
//
// __Apportioning a total by weights — a cost across departments, a duty across__
// __line items. Same discipline: the shares must add to the total, so the last__
// __one takes whatever is left rather than being rounded independently.__
// __விகிதத்தில்_பிரி(மொத்த_பைசா, எடைகள்) — apportion an amount by weights, losing no paisa__
// விகிதத்தில்_பிரி(மொத்த_பைசா, எடைகள்) — எடைகளுக்கு ஏற்பத் தொகையைப் பிரிக்கும்
செயல் விகிதத்தில்_பிரி(மொத்த_பைசா, எடைகள்) {
    மொத்த_எடை = 0;
    ஒவ்வொரு ஒரு_எடை இல் எடைகள் {
        மொத்த_எடை = மொத்த_எடை + ஒரு_எடை;
    }
    (மொத்த_எடை <= 0) எனில் { திரும்பு []; }

    பங்குகள் = [];
    ஒதுக்கியது = 0;
    எண்ணி = 0;
    எத்தனை = நீளம்(எடைகள்);

    (எண்ணி < எத்தனை) சுற்று {
        (எண்ணி == எத்தனை - 1) எனில் {
            // __The last share closes the total exactly.__
            இந்தப்_பங்கு = மொத்த_பைசா - ஒதுக்கியது;
        }
        இன்றேல் {
            இந்தப்_பங்கு = தரை(மொத்த_பைசா * எடைகள்[எண்ணி] / மொத்த_எடை);
        }
        பங்குகள் = இணை(பங்குகள், இந்தப்_பங்கு);
        ஒதுக்கியது = ஒதுக்கியது + இந்தப்_பங்கு;
        எண்ணி = எண்ணி + 1;
    }
    திரும்பு பங்குகள்;
}
