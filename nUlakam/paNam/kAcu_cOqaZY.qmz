// __காசு சோதனை — money as whole paise__
// காசுச் செயல்களுக்கான சோதனைகள்
//
//   __etamil --vm nUlakam/paNam/kAcu_cOqaZY.qmz__
//
// __Every number in this file is a whole number. That is the discipline being__
// __tested: two decimal places, exactly, with no fractional literal anywhere —__
// __so a program written this way is not asking the LLVM backend for arithmetic__
// __it cannot do.__

இறக்கு "../cOqaZY/cOqaZY.qmz";
இறக்கு "kAcu.qmz";

ஓட்டம் = சோதனை_தொடக்கம்("காசு (paise)");

// __--- making and showing ---------------------------------------------------__
ஓட்டம் = சமம்(ஓட்டம், ரூபாயும்_பைசாவும்(2, 5), 205, "2.05 is two hundred and five paise");
ஓட்டம் = சமம்(ஓட்டம், ரூபாயாக(1000), 100000, "a thousand rupees is a lakh of paise");
ஓட்டம் = சமம்(ஓட்டம், காசு_உரை(205), "2.05", "and it prints back with both places");
ஓட்டம் = சமம்(ஓட்டம், காசு_உரை(200), "2.00", "a whole rupee still shows two places");
ஓட்டம் = சமம்(ஓட்டம், காசு_உரை(5), "0.05", "and five paise keeps its leading zero");
ஓட்டம் = சமம்(ஓட்டம், காசு_உரை(50), "0.50", "as does fifty");
ஓட்டம் = சமம்(ஓட்டம், காசு_உரை(0), "0.00", "nothing is nothing, with places");
ஓட்டம் = சமம்(ஓட்டம், காசு_உரை(0 - 205), "-2.05", "and a negative keeps its sign");

// __--- the claim this exists to keep ----------------------------------------__
//
// __The language's opening example, done in paise. On the VM this is exact__
// __either way; written like this it is exact on a backend that has only floats,__
// __because whole numbers are exact in a double.__
ஓட்டம் = சமம்(ஓட்டம், காசு_உரை(காசு_கூட்டு(10, 20)), "0.30",
              "ten paise and twenty paise are thirty paise");

// __--- the exact operations -------------------------------------------------__
ஓட்டம் = சமம்(ஓட்டம், காசு_கூட்டு(205, 195), 400, "adding money");
ஓட்டம் = சமம்(ஓட்டம், காசு_கழி(400, 205), 195, "and subtracting it");
ஓட்டம் = சமம்(ஓட்டம், காசு_மடங்கு(205, 7), 1435, "a price times a quantity");
ஓட்டம் = சமம்(ஓட்டம், காசு_கூட்டல்([100, 205, 5]), 310, "a column of money");
ஓட்டம் = சமம்(ஓட்டம், காசு_கூட்டல்([]), 0, "an empty column is nothing");

// __A total large enough to be worth checking stays exact: a double holds every__
// __integer below 2^53, which is about ninety thousand crore in paise.__
பெரிது = காசு_மடங்கு(ரூபாயாக(10000000), 1000);
ஓட்டம் = சமம்(ஓட்டம், காசு_உரை(பெரிது), "10000000000.00",
              "a thousand crore is still exact to the paisa");

// __--- percentages ----------------------------------------------------------__
//
// __A rate is a fraction, so that no fractional literal is needed: 18% is 18/100__
// __and 7.5% is 75/1000.__
ஓட்டம் = சமம்(ஓட்டம், விழுக்காடு_காசு(ரூபாயாக(1000), 18, 100), 1800000 / 100,
              "eighteen per cent of a thousand rupees");
ஓட்டம் = சமம்(ஓட்டம், காசு_உரை(விழுக்காடு_காசு(ரூபாயாக(1000), 18, 100)), "180.00",
              "which is a hundred and eighty rupees");
ஓட்டம் = சமம்(ஓட்டம், காசு_உரை(விழுக்காடு_காசு(ரூபாயாக(1000), 75, 1000)), "75.00",
              "and seven and a half per cent is seventy-five");

// __Rounded half-up, once. 18% of 2.05 is 36.9 paise, which is 37.__
ஓட்டம் = சமம்(ஓட்டம், விழுக்காடு_காசு(205, 18, 100), 37,
              "a fraction of a paisa rounds up at a half");
ஓட்டம் = சமம்(ஓட்டம், விழுக்காடு_காசு(100, 1, 3), 33,
              "a third of a rupee is thirty-three paise");
ஓட்டம் = சமம்(ஓட்டம், விழுக்காடு_காசு(0, 18, 100), 0, "nothing taxed is nothing");
ஓட்டம் = சமம்(ஓட்டம், விழுக்காடு_காசு(ரூபாயாக(100), 0, 100), 0, "at no rate, nothing");
ஓட்டம் = சமம்(ஓட்டம், விழுக்காடு_காசு(205, 18, 0), 0,
              "and a rate over nothing answers nothing rather than dividing by it");

// __A negative amount is taxed symmetrically — a credit note is not rounded the__
// __other way from the invoice it reverses.__
ஓட்டம் = சமம்(ஓட்டம், விழுக்காடு_காசு(0 - 205, 18, 100), 0 - 37,
              "a credit note rounds like the invoice it reverses");

// __--- the split that loses nothing ----------------------------------------__
//
// __Ten rupees three ways. Every share rounded the same way loses a paisa, and__
// __that is how money disappears from a ledger.__
மூன்று = சமமாகப்_பிரி(ரூபாயாக(10), 3);
ஓட்டம் = சமம்(ஓட்டம், நீளம்(மூன்று), 3, "three shares");
ஓட்டம் = சமம்(ஓட்டம், மூன்று, [334, 333, 333], "the odd paisa goes to the first");
ஓட்டம் = சமம்(ஓட்டம், காசு_கூட்டல்(மூன்று), 1000,
              "and the shares add back to the whole — nothing lost, nothing invented");

சரியாக = சமமாகப்_பிரி(ரூபாயாக(9), 3);
ஓட்டம் = சமம்(ஓட்டம், சரியாக, [300, 300, 300], "an amount that divides evenly needs no help");

இரண்டு = சமமாகப்_பிரி(1, 2);
ஓட்டம் = சமம்(ஓட்டம், இரண்டு, [1, 0], "one paisa two ways gives one and none");
ஓட்டம் = சமம்(ஓட்டம், காசு_கூட்டல்(இரண்டு), 1, "and still adds back to one");

ஓட்டம் = சமம்(ஓட்டம், சமமாகப்_பிரி(1000, 0), [], "splitting no ways gives no shares");

// __--- splitting in proportion ---------------------------------------------__
சமன் = விகிதத்தில்_பிரி(ரூபாயாக(1000), [1, 1, 1]);
ஓட்டம் = சமம்(ஓட்டம், காசு_கூட்டல்(சமன்), 100000,
              "an apportionment adds back to the total exactly");
ஓட்டம் = சமம்(ஓட்டம், சமன், [33333, 33333, 33334],
              "with the last share taking what is left rather than being rounded alone");

எடையுடன் = விகிதத்தில்_பிரி(ரூபாயாக(100), [1, 3]);
ஓட்டம் = சமம்(ஓட்டம், எடையுடன், [2500, 7500], "a quarter and three quarters");
ஓட்டம் = சமம்(ஓட்டம், காசு_கூட்டல்(எடையுடன்), 10000, "and they add back");

ஓட்டம் = சமம்(ஓட்டம், விகிதத்தில்_பிரி(1000, [0, 0]), [],
              "weights that add to nothing apportion nothing");

சோதனை_முடிவு(ஓட்டம்);
