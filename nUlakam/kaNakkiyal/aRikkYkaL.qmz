// __nUlakam/kaNakkiyal/aRikkYkaL.qmz — அறிக்கைகள் (financial statements)__
//
// __Every figure here is derived from the ledger. Nothing is stored twice, so__
// __a statement cannot disagree with the postings it came from.__

இறக்கு "pErEtu.qmz";
இறக்கு "kaNakkukaL.qmz";
இறக்கு "kAlam.qmz";
இறக்கு "../paNam.qmz";
இறக்கு "../col.qmz";

// __--- இருப்பாய்வு (trial balance) ---__
//
// __இருப்பாய்வு(பேரேடு, கணக்குகள்) — the trial balance__
//
// __Totals every account's raw debits and credits. The two columns must__
// __agree; if they do not, the ledger has been damaged, since posting refuses__
// __anything unbalanced.__
செயல் இருப்பாய்வு(பேரேடு, கணக்குகள்) {
    வரிகள் = [];
    மொத்த_பற்று_நிரல் = 0;
    மொத்த_வரவு_நிரல் = 0;

    ஒவ்வொரு ஒரு_கணக்கு இல் கணக்குகள் {
        பற்று_மொத்தம் = 0;
        வரவு_மொத்தம் = 0;
        ஒவ்வொரு பதிவு இல் பேரேடு {
            (பதிவு.கணக்கு_குறி == ஒரு_கணக்கு.குறி) எனில் {
                பற்று_மொத்தம் = பற்று_மொத்தம் + பதிவு.பற்று_தொகை;
                வரவு_மொத்தம் = வரவு_மொத்தம் + பதிவு.வரவு_தொகை;
            }
        }
        (பற்று_மொத்தம் > 0 அல்லது வரவு_மொத்தம் > 0) எனில் {
            நிகரம் = பற்று_மொத்தம் - வரவு_மொத்தம்;
            பற்று_பக்கம் = 0;
            வரவு_பக்கம் = 0;
            (நிகரம் > 0) எனில் { பற்று_பக்கம் = நிகரம்; }
            இன்றேல் { வரவு_பக்கம் = 0 - நிகரம்; }

            வரிகள் = இணை(வரிகள், {
                குறி: ஒரு_கணக்கு.குறி,
                பெயர்: ஒரு_கணக்கு.பெயர்,
                பற்று_பக்கம்: பற்று_பக்கம்,
                வரவு_பக்கம்: வரவு_பக்கம்
            });
            மொத்த_பற்று_நிரல் = மொத்த_பற்று_நிரல் + பற்று_பக்கம்;
            மொத்த_வரவு_நிரல் = மொத்த_வரவு_நிரல் + வரவு_பக்கம்;
        }
    }

    திரும்பு {
        வரிகள்: வரிகள்,
        மொத்த_பற்று_நிரல்: மொத்த_பற்று_நிரல்,
        மொத்த_வரவு_நிரல்: மொத்த_வரவு_நிரல்,
        சமநிலையா: மொத்த_பற்று_நிரல் == மொத்த_வரவு_நிரல்
    };
}

// __--- வருமான அறிக்கை (income statement) ---__
// __வருமான_அறிக்கை(பேரேடு, கணக்குகள்) — the income statement from the ledger__
//
// __Selects the வருவாய் and செலவு accounts and nets them. Derived from the postings rather than stored, so it cannot disagree with the ledger it came from. Takes the whole ledger: use கால_வருமான_அறிக்கை when a period is meant, since income is a flow and a figure since the ledger began is rarely what was wanted.__
செயல் வருமான_அறிக்கை(பேரேடு, கணக்குகள்) {
    மொத்த_வருவாய் = 0;
    மொத்த_செலவு = 0;
    வருவாய்_வரிகள் = [];
    செலவு_வரிகள் = [];

    ஒவ்வொரு ஒரு_கணக்கு இல் கணக்குகள் {
        இருப்பு_மதிப்பு = கணக்கு_இருப்பு(பேரேடு, ஒரு_கணக்கு.குறி, ஒரு_கணக்கு.கணக்கு_வகை);
        (ஒரு_கணக்கு.கணக்கு_வகை == "வருவாய்") எனில் {
            (இருப்பு_மதிப்பு != 0) எனில் {
                வருவாய்_வரிகள் = இணை(வருவாய்_வரிகள்,
                    {பெயர்: ஒரு_கணக்கு.பெயர், மதிப்பு: இருப்பு_மதிப்பு});
                மொத்த_வருவாய் = மொத்த_வருவாய் + இருப்பு_மதிப்பு;
            }
        }
        (ஒரு_கணக்கு.கணக்கு_வகை == "செலவு") எனில் {
            (இருப்பு_மதிப்பு != 0) எனில் {
                செலவு_வரிகள் = இணை(செலவு_வரிகள்,
                    {பெயர்: ஒரு_கணக்கு.பெயர், மதிப்பு: இருப்பு_மதிப்பு});
                மொத்த_செலவு = மொத்த_செலவு + இருப்பு_மதிப்பு;
            }
        }
    }

    திரும்பு {
        வருவாய்_வரிகள்: வருவாய்_வரிகள்,
        செலவு_வரிகள்: செலவு_வரிகள்,
        மொத்த_வருவாய்: மொத்த_வருவாய்,
        மொத்த_செலவு: மொத்த_செலவு,
        நிகர_லாபம்: மொத்த_வருவாய் - மொத்த_செலவு
    };
}

// __--- இருப்புநிலை (balance sheet) ---__
//
// __Retained earnings are the net profit carried in from the income__
// __statement, which is what makes the sheet balance.__
செயல் இருப்புநிலை(பேரேடு, கணக்குகள்) {
    மொத்த_சொத்து = 0;
    மொத்த_பொறுப்பு = 0;
    மொத்த_பங்கு = 0;
    சொத்து_வரிகள் = [];
    பொறுப்பு_வரிகள் = [];
    பங்கு_வரிகள் = [];

    ஒவ்வொரு ஒரு_கணக்கு இல் கணக்குகள் {
        இருப்பு_மதிப்பு = கணக்கு_இருப்பு(பேரேடு, ஒரு_கணக்கு.குறி, ஒரு_கணக்கு.கணக்கு_வகை);
        (இருப்பு_மதிப்பு != 0) எனில் {
            (ஒரு_கணக்கு.கணக்கு_வகை == "சொத்து") எனில் {
                சொத்து_வரிகள் = இணை(சொத்து_வரிகள்,
                    {பெயர்: ஒரு_கணக்கு.பெயர், மதிப்பு: இருப்பு_மதிப்பு});
                மொத்த_சொத்து = மொத்த_சொத்து + இருப்பு_மதிப்பு;
            }
            (ஒரு_கணக்கு.கணக்கு_வகை == "பொறுப்பு") எனில் {
                பொறுப்பு_வரிகள் = இணை(பொறுப்பு_வரிகள்,
                    {பெயர்: ஒரு_கணக்கு.பெயர், மதிப்பு: இருப்பு_மதிப்பு});
                மொத்த_பொறுப்பு = மொத்த_பொறுப்பு + இருப்பு_மதிப்பு;
            }
            (ஒரு_கணக்கு.கணக்கு_வகை == "பங்கு") எனில் {
                பங்கு_வரிகள் = இணை(பங்கு_வரிகள்,
                    {பெயர்: ஒரு_கணக்கு.பெயர், மதிப்பு: இருப்பு_மதிப்பு});
                மொத்த_பங்கு = மொத்த_பங்கு + இருப்பு_மதிப்பு;
            }
        }
    }

    வருமானம் = வருமான_அறிக்கை(பேரேடு, கணக்குகள்);
    தேக்கிய_வருவாய் = வருமானம்.நிகர_லாபம்;
    மொத்த_பங்கு_நிகரம் = மொத்த_பங்கு + தேக்கிய_வருவாய்;

    திரும்பு {
        சொத்து_வரிகள்: சொத்து_வரிகள்,
        பொறுப்பு_வரிகள்: பொறுப்பு_வரிகள்,
        பங்கு_வரிகள்: பங்கு_வரிகள்,
        மொத்த_சொத்து: மொத்த_சொத்து,
        மொத்த_பொறுப்பு: மொத்த_பொறுப்பு,
        தேக்கிய_வருவாய்: தேக்கிய_வருவாய்,
        மொத்த_பங்கு: மொத்த_பங்கு_நிகரம்,
        சமநிலையா: மொத்த_சொத்து == மொத்த_பொறுப்பு + மொத்த_பங்கு_நிகரம்
    };
}

// __--- Period-aware entry points ---__
//
// __An income statement covers a period; a balance sheet is cumulative as at a__
// __date. Calling the plain forms above runs over the whole ledger, which is__
// __only right for a first year with no closing.__

// கால_வருமான_அறிக்கை(பேரேடு, கணக்குகள், காலம்)
// __கால_வருமான_அறிக்கை(பேரேடு, கணக்குகள், காலம்) — the income statement for one period__
//
// __Filters the ledger first, then builds the statement, and records the period on the result. Income accounts are flows: reporting them without a period gives a figure since the ledger began, which is a number nobody asked for.__
செயல் கால_வருமான_அறிக்கை(பேரேடு, கணக்குகள், காலம்) {
    அறிக்கை = வருமான_அறிக்கை(காலம்_வடிகட்டு(பேரேடு, காலம்), கணக்குகள்);
    அறிக்கை.காலம் = காலம்;
    திரும்பு அறிக்கை;
}

// __நாள்_இருப்புநிலை(பேரேடு, கணக்குகள், நாள்) — as at a date__
//
// __Retained earnings must accumulate from the beginning of time, not from the__
// __start of a period, so the sheet filters only by the closing date.__
செயல் நாள்_இருப்புநிலை(பேரேடு, கணக்குகள், வரம்பு_நாள்) {
    அறிக்கை = இருப்புநிலை(வரை_வடிகட்டு(பேரேடு, வரம்பு_நாள்), கணக்குகள்);
    அறிக்கை.நாள் = வரம்பு_நாள்;
    திரும்பு அறிக்கை;
}

// கால_இருப்பாய்வு(பேரேடு, கணக்குகள், நாள்)
// __கால_இருப்பாய்வு(பேரேடு, கணக்குகள், வரம்பு_நாள்) — the trial balance as at a date__
//
// __Takes everything up to the date rather than a window, because a balance is a position and not a flow. That is the difference between the two period functions here, and it is worth being deliberate about.__
செயல் கால_இருப்பாய்வு(பேரேடு, கணக்குகள், வரம்பு_நாள்) {
    திரும்பு இருப்பாய்வு(வரை_வடிகட்டு(பேரேடு, வரம்பு_நாள்), கணக்குகள்);
}

// __--- கணக்கு அறிக்கை (account statement) ---__
//
// __Every line touching one account, with a running balance — what a customer__
// __or supplier is sent when they query their account.__
செயல் கணக்கு_அறிக்கை(பேரேடு, கணக்கு_குறி, கணக்கு_வகை) {
    வரிகள் = [];
    ஓட்டம் = 0;
    ஒவ்வொரு பதிவு இல் கணக்கு_பதிவுகள்(பேரேடு, கணக்கு_குறி) {
        (பற்று_இயல்பா(கணக்கு_வகை)) எனில் {
            ஓட்டம் = ஓட்டம் + பதிவு.பற்று_தொகை - பதிவு.வரவு_தொகை;
        }
        இன்றேல் {
            ஓட்டம் = ஓட்டம் + பதிவு.வரவு_தொகை - பதிவு.பற்று_தொகை;
        }
        வரிகள் = இணை(வரிகள், {
            நாள்: பதிவு.நாள்,
            பரிவர்த்தனை_எண்: பதிவு.பரிவர்த்தனை_எண்,
            விவரம்: பதிவு.விவரம்,
            பற்று_தொகை: பதிவு.பற்று_தொகை,
            வரவு_தொகை: பதிவு.வரவு_தொகை,
            ஓட்ட_இருப்பு: ஓட்டம்
        });
    }
    திரும்பு {வரிகள்: வரிகள், இறுதி_இருப்பு: ஓட்டம்};
}

// __--- பணப்புழக்கம் (cash flow, direct method) ---__
//
// __Movement on the cash and bank accounts over a period, split by whether the__
// __other side of each entry was an operating account or not.__
செயல் பணப்புழக்க_அறிக்கை(பேரேடு, ரொக்க_கணக்குகள், காலம்) {
    உள்ளே = 0;
    வெளியே = 0;
    கால_பேரேடு = காலம்_வடிகட்டு(பேரேடு, காலம்);

    ஒவ்வொரு குறி இல் ரொக்க_கணக்குகள் {
        ஒவ்வொரு பதிவு இல் கால_பேரேடு {
            (பதிவு.கணக்கு_குறி == குறி) எனில் {
                உள்ளே = உள்ளே + பதிவு.பற்று_தொகை;
                வெளியே = வெளியே + பதிவு.வரவு_தொகை;
            }
        }
    }

    // __Opening cash is everything before the period began.__
    தொடக்கம் = 0;
    ஒவ்வொரு குறி இல் ரொக்க_கணக்குகள் {
        ஒவ்வொரு பதிவு இல் பேரேடு {
            (பதிவு.கணக்கு_குறி == குறி மற்றும் பதிவு.நாள் < காலம்.தொடக்கம்) எனில் {
                தொடக்கம் = தொடக்கம் + பதிவு.பற்று_தொகை - பதிவு.வரவு_தொகை;
            }
        }
    }

    திரும்பு {
        தொடக்க_இருப்பு: தொடக்கம்,
        உள்வரவு: உள்ளே,
        வெளிச்செலவு: வெளியே,
        நிகர_மாற்றம்: உள்ளே - வெளியே,
        இறுதி_இருப்பு: தொடக்கம் + உள்ளே - வெளியே
    };
}

// __--- Printing ---__

// __இருப்பாய்வு_அச்சிடு(அறிக்கை) — print a trial balance__
//
// __States the balance check as a mark rather than leaving the reader to add the columns. A trial balance that does not balance is not a formatting matter, so it is said on the face of the report.__
செயல் இருப்பாய்வு_அச்சிடு(அறிக்கை) {
    அச்சு "இருப்பாய்வு";
    அச்சு திரும்பச்செய்("=", 56);
    ஒவ்வொரு வரி இல் அறிக்கை.வரிகள் {
        அச்சு "  " & வரி.குறி & "  " & வரி.பெயர்
              & "   பற்று " & காசு_வடிவம்(வரி.பற்று_பக்கம்)
              & "   வரவு " & காசு_வடிவம்(வரி.வரவு_பக்கம்);
    }
    அச்சு திரும்பச்செய்("-", 56);
    அச்சு "  மொத்தம்   பற்று " & காசு_வடிவம்(அறிக்கை.மொத்த_பற்று_நிரல்)
          & "   வரவு " & காசு_வடிவம்(அறிக்கை.மொத்த_வரவு_நிரல்);
    (அறிக்கை.சமநிலையா) எனில் { அச்சு "  ✓ சமநிலை"; }
    இன்றேல் { அச்சு "  ✗ சமநிலை இல்லை"; }
}

// __வருமான_அறிக்கை_அச்சிடு(அறிக்கை) — print an income statement__
//
// __Revenue lines, expense lines, then totals, with amounts through ரூபாய் so the lakh and crore grouping is the one an Indian reader expects. Printing is kept apart from the functions that compute, so a statement can be tested without asserting on its layout.__
செயல் வருமான_அறிக்கை_அச்சிடு(அறிக்கை) {
    அச்சு "வருமான அறிக்கை";
    அச்சு திரும்பச்செய்("=", 56);
    அச்சு "வருவாய்";
    ஒவ்வொரு வரி இல் அறிக்கை.வருவாய்_வரிகள் {
        அச்சு "  " & வரி.பெயர் & "  " & ரூபாய்(வரி.மதிப்பு);
    }
    அச்சு "செலவு";
    ஒவ்வொரு வரி இல் அறிக்கை.செலவு_வரிகள் {
        அச்சு "  " & வரி.பெயர் & "  " & ரூபாய்(வரி.மதிப்பு);
    }
    அச்சு திரும்பச்செய்("-", 56);
    அச்சு "  மொத்த வருவாய் : " & ரூபாய்(அறிக்கை.மொத்த_வருவாய்);
    அச்சு "  மொத்த செலவு   : " & ரூபாய்(அறிக்கை.மொத்த_செலவு);
    அச்சு "  நிகர லாபம்    : " & ரூபாய்(அறிக்கை.நிகர_லாபம்);
}

// __இருப்புநிலை_அச்சிடு(அறிக்கை) — print a balance sheet__
//
// __Assets on one side, liabilities and equity on the other, and the accounting equation checked on the face of it. The check is worth printing even though the ledger already rejects unbalanced entries: it also catches a classification error, where a real posting has been filed under the wrong root.__
செயல் இருப்புநிலை_அச்சிடு(அறிக்கை) {
    அச்சு "இருப்புநிலை";
    அச்சு திரும்பச்செய்("=", 56);
    அச்சு "சொத்துகள்";
    ஒவ்வொரு வரி இல் அறிக்கை.சொத்து_வரிகள் {
        அச்சு "  " & வரி.பெயர் & "  " & ரூபாய்(வரி.மதிப்பு);
    }
    அச்சு "  மொத்த சொத்து : " & ரூபாய்(அறிக்கை.மொத்த_சொத்து);
    அச்சு "";
    அச்சு "பொறுப்புகள்";
    ஒவ்வொரு வரி இல் அறிக்கை.பொறுப்பு_வரிகள் {
        அச்சு "  " & வரி.பெயர் & "  " & ரூபாய்(வரி.மதிப்பு);
    }
    அச்சு "  மொத்த பொறுப்பு: " & ரூபாய்(அறிக்கை.மொத்த_பொறுப்பு);
    அச்சு "";
    அச்சு "பங்கு";
    ஒவ்வொரு வரி இல் அறிக்கை.பங்கு_வரிகள் {
        அச்சு "  " & வரி.பெயர் & "  " & ரூபாய்(வரி.மதிப்பு);
    }
    அச்சு "  தேக்கிய வருவாய்: " & ரூபாய்(அறிக்கை.தேக்கிய_வருவாய்);
    அச்சு "  மொத்த பங்கு   : " & ரூபாய்(அறிக்கை.மொத்த_பங்கு);
    அச்சு திரும்பச்செய்("-", 56);
    (அறிக்கை.சமநிலையா) எனில் {
        அச்சு "  ✓ சொத்து = பொறுப்பு + பங்கு";
    }
    இன்றேல் { அச்சு "  ✗ இருப்புநிலை சமநிலை இல்லை"; }
}
