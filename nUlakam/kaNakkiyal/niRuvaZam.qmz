// __nUlakam/kaNakkiyal/niRuvaZam.qmz — நிறுவனம் and நாணயம்__
//
// __Multiple companies in one ledger, and transactions in a currency other__
// __than the one the books are kept in.__
//
// __Entities are a stamp on each posting rather than separate ledgers, so a__
// __group can be consolidated by simply not filtering.__

இறக்கு "pErEtu.qmz";
இறக்கு "../atippatY/kaNiqam.qmz";
இறக்கு "../atippatY/aNi.qmz";

// __--- நிறுவனம் (entity) ---__

// நிறுவனம்_ஆக்கு(குறி, பெயர், அறிக்கை_நாணயம்)
// __நிறுவனம்_ஆக்கு(குறி, பெயர், அறிக்கை_நாணயம்) — one company in the ledger__
//
// __The reporting currency belongs to the company, not to the installation, which is what lets several companies share one ledger and still each present in their own. Translation differences are then a property of the pair, and வேறுபாட்டுத்_தொகை below computes them.__
செயல் நிறுவனம்_ஆக்கு(குறி, பெயர், அறிக்கை_நாணயம்) {
    திரும்பு {
        குறி: குறி,
        பெயர்: பெயர்,
        அறிக்கை_நாணயம்: அறிக்கை_நாணயம்
    };
}

// நிறுவனத்துடன்_பதிவிடு(பேரேடு, பரிவர்த்தனை, நிறுவனக்_குறி)
//
// __Posts exactly as பதிவிடு does — the same balance check — then stamps each__
// __line with the entity it belongs to.__
செயல் நிறுவனத்துடன்_பதிவிடு(பேரேடு, பரிவர்த்தனை, நிறுவனக்_குறி) {
    முன்_நீளம் = நீளம்(பேரேடு);
    விளைவு = பதிவிடு(பேரேடு, பரிவர்த்தனை);
    புதிய = விளைவு?;

    முடிவு = [];
    எண்ணி = 0;
    ஒவ்வொரு பதிவு இல் புதிய {
        (எண்ணி < முன்_நீளம்) எனில் {
            முடிவு = இணை(முடிவு, பதிவு);
        }
        இன்றேல் {
            பதிவு.நிறுவனக்_குறி = நிறுவனக்_குறி;
            முடிவு = இணை(முடிவு, பதிவு);
        }
        எண்ணி = எண்ணி + 1;
    }
    திரும்பு சரி(முடிவு);
}

// __நிறுவன_வடிகட்டு(பேரேடு, நிறுவனக்_குறி) — one company's books__
செயல் நிறுவன_வடிகட்டு(பேரேடு, நிறுவனக்_குறி) {
    திரும்பு புலத்தால்_வடிகட்டு(பேரேடு, "நிறுவனக்_குறி", நிறுவனக்_குறி);
}

// __--- நாணயம் (currency) ---__

// நாணயம்_ஆக்கு(குறி, பெயர், சின்னம்)
// __நாணயம்_ஆக்கு(குறி, பெயர், சின்னம்) — one currency__
//
// __The symbol is carried for presentation only. Nothing computes with it: amounts are numbers and the currency is a label on them, because a figure that knows how to print itself is a figure that can be added to one that prints differently.__
செயல் நாணயம்_ஆக்கு(குறி, பெயர், சின்னம்) {
    திரும்பு {குறி: குறி, பெயர்: பெயர், சின்னம்: சின்னம்};
}

// மாற்று_விகிதம்_ஆக்கு(நாணயக்_குறி, நாள், விகிதம்)
// __விகிதம் is units of the reporting currency per one unit of the foreign one.__
செயல் மாற்று_விகிதம்_ஆக்கு(நாணயக்_குறி, நாள், விகிதம்) {
    திரும்பு {நாணயக்_குறி: நாணயக்_குறி, நாள்: நாள், விகிதம்: விகிதம்};
}

// __அடிப்படைக்கு_மாற்று(தொகை, விகிதம்) — foreign amount into reporting currency__
செயல் அடிப்படைக்கு_மாற்று(தொகை_மதிப்பு, விகிதம்) {
    திரும்பு வட்டப்_பெருக்கு(தொகை_மதிப்பு, விகிதம்);
}

// __--- அன்னிய வேறுபாடு (forex difference) ---__
//
// __An invoice raised at one rate and settled at another leaves a difference__
// __that is neither revenue nor a change in what the customer owed. IFRS puts__
// __it to exchange gain or loss, and it must be posted or the books will not__
// __balance in the reporting currency.__

// வேறுபாட்டுத்_தொகை(அன்னியத்_தொகை, பழைய_விகிதம், புதிய_விகிதம்)
// __வேறுபாட்டுத்_தொகை(அன்னியத்_தொகை, பழைய_விகிதம், புதிய_விகிதம்) — the exchange difference__
//
// __The foreign amount revalued at the new rate less the old, rounded to two places. Positive when the new rate is higher, which is a gain on an asset and a loss on a liability — the sign here is arithmetic and which side it falls on is the caller's to decide.__
செயல் வேறுபாட்டுத்_தொகை(அன்னியத்_தொகை, பழைய_விகிதம், புதிய_விகிதம்) {
    திரும்பு வட்டமிடு(அன்னியத்_தொகை * (புதிய_விகிதம் - பழைய_விகிதம்), 2);
}

// __அன்னிய_வேறுபாடு(...) — the transaction that records it__
//
// __A positive difference on a receivable is a gain: the customer's debt is__
// __worth more in our currency than when it was raised.__
செயல் அன்னிய_வேறுபாடு(பரிவர்த்தனை_எண், நாள், விவரம்,
                         வாடிக்கையாளர்_கணக்கு, லாப_கணக்கு, இழப்பு_கணக்கு,
                         வேறுபாடு) {
    (வேறுபாடு == 0) எனில் {
        திரும்பு தவறு("வேறுபாடு இல்லை  (no exchange difference to post)");
    }
    (வேறுபாடு > 0) எனில் {
        திரும்பு சரி(பரிவர்த்தனை_ஆக்கு(பரிவர்த்தனை_எண், நாள், விவரம், [
            பற்று_வரிசை(வாடிக்கையாளர்_கணக்கு, வேறுபாடு),
            வரவு_வரிசை(லாப_கணக்கு, வேறுபாடு)
        ]));
    }
    இழப்பு = 0 - வேறுபாடு;
    திரும்பு சரி(பரிவர்த்தனை_ஆக்கு(பரிவர்த்தனை_எண், நாள், விவரம், [
        பற்று_வரிசை(இழப்பு_கணக்கு, இழப்பு),
        வரவு_வரிசை(வாடிக்கையாளர்_கணக்கு, இழப்பு)
    ]));
}
