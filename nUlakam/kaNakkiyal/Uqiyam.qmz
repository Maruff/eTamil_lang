// __nUlakam/kaNakkiyal/Uqiyam.qmz — ஊதியம் (payroll)__
//
// __Every rate, ceiling, threshold and slab in Indian payroll is statutory. The__
// __provident fund contribution rate, the wage ceiling it applies to, the pay__
// __above which employees' state insurance stops, professional tax by state,__
// __income tax slabs — all set by government, all amended, none of them here.__
//
// __What is here is the arithmetic that applies them, and the two things about__
// __payroll arithmetic that are easy to get wrong: proportioning a month for__
// __days not worked, and computing a slab tax so that a rupee more of pay never__
// __leaves someone with less in hand.__
//
// __Rates are a number out of a hundred: 12% is 12.__
//
// __ஊதியம், நிகர, செலவு and விலை are keywords, so the parameters below read as__
// __compounds. That is the language's doing, not a style choice.__

இறக்கு "../atippatY/kaNiqam.qmz";
இறக்கு "../atippatY/poruL.qmz";

// __--- what was earned ------------------------------------------------------__
//
// __மொத்தச்_சம்பளம்(கூறுகள்) — the components added up__
//
// __கூறுகள் is a record: {"அடிப்படை": 40000, "வீட்டுப்படி": 16000, ...}. Naming__
// __them is the employer's business; adding them is not.__
செயல் மொத்தச்_சம்பளம்(கூறுகள்) {
    கூட்டல் = 0;
    ஒவ்வொரு கூற்றுப்_பெயர் இல் கூறுகள் {
        கூட்டல் = கூட்டல் + கூறுகள்[கூற்றுப்_பெயர்];
    }
    திரும்பு வட்டமிடு(கூட்டல், 2);
}

// நாட்களுக்கு_ஏற்ப(தொகை_மதிப்பு, ஊதிய_நாட்கள், மாத_நாட்கள்)
//
// __Loss of pay. A month is not thirty days for this: February is twenty-eight,__
// __and paying a month's salary divided by thirty in February overpays every__
// __year. The number of days in the month is passed in for that reason.__
செயல் நாட்களுக்கு_ஏற்ப(தொகை_மதிப்பு, ஊதிய_நாட்கள், மாத_நாட்கள்) {
    திரும்பு நாள்_விகிதம்(தொகை_மதிப்பு, ஊதிய_நாட்கள், மாத_நாட்கள்);
}

// __--- contributions with a ceiling -----------------------------------------__
//
// வரம்புடன்_பங்களிப்பு(பங்களிப்பு_ஊதியம், விகிதம், உச்ச_வரம்பு)
//
// __The provident fund shape: a percentage of wages, but only of wages up to a__
// __ceiling. Pass 0 as the ceiling for no ceiling — an employer may contribute__
// __on full wages, and many do.__
செயல் வரம்புடன்_பங்களிப்பு(பங்களிப்பு_ஊதியம், விகிதம், உச்ச_வரம்பு) {
    கணக்கிடத்தக்கது = பங்களிப்பு_ஊதியம்;
    (உச்ச_வரம்பு > 0 மற்றும் பங்களிப்பு_ஊதியம் > உச்ச_வரம்பு) எனில் {
        கணக்கிடத்தக்கது = உச்ச_வரம்பு;
    }
    திரும்பு வட்டமிடு(சதவீதம்(கணக்கிடத்தக்கது, விகிதம்), 2);
}

// தகுதிக்குள்_பங்களிப்பு(மொத்தம், விகிதம், தகுதி_எல்லை)
//
// __The employees' state insurance shape, and it is not the same as a ceiling.__
// __Above the eligibility limit nothing is contributed at all, rather than__
// __something being contributed on the limit. Treating one like the other is a__
// __deduction taken from someone who owes none.__
செயல் தகுதிக்குள்_பங்களிப்பு(மொத்தத்_தொகை, விகிதம், தகுதி_எல்லை) {
    (தகுதி_எல்லை > 0 மற்றும் மொத்தத்_தொகை > தகுதி_எல்லை) எனில் { திரும்பு 0; }
    திரும்பு வட்டமிடு(சதவீதம்(மொத்தத்_தொகை, விகிதம்), 2);
}

// __--- slabs ----------------------------------------------------------------__
//
// படிநிலை_வரி(வரிக்குரிய_தொகை, படிகள்)
//
// __One engine for professional tax, for income tax, and for anything else__
// __stated as bands. படிகள் is an array ordered by where each band starts:__
//
//   [{"முதல்": 0,      "விகிதம்": 0},
//    {"முதல்": 300000, "விகிதம்": 5},
//    {"முதல்": 700000, "விகிதம்": 10}]
//
// __Each band's rate applies only to the part of the amount inside it, which is__
// __the whole point: a rupee more of income is taxed at the new rate only on__
// __that rupee. Applying the top rate to the whole amount — which is what__
// __"I moved into the next bracket and took home less" describes — is the__
// __classic way to compute this wrongly, and it is wrong.__
//
// __A band may instead carry a fixed amount, which is how professional tax is__
// __usually stated: so many rupees a month for pay in this range.__
செயல் படிநிலை_வரி(வரிக்குரிய_தொகை, படிகள்) {
    (வரிக்குரிய_தொகை <= 0) எனில் { திரும்பு 0; }

    வரி_மொத்தம் = 0;
    படி_எண் = 0;
    எத்தனை = நீளம்(படிகள்);

    (படி_எண் < எத்தனை) சுற்று {
        இந்தப்_படி = படிகள்[படி_எண்];
        தொடக்கம் = இந்தப்_படி["முதல்"];

        // __Where this band ends is where the next one starts.__
        (படி_எண் + 1 < எத்தனை) எனில் {
            முடிவு = படிகள்[படி_எண் + 1]["முதல்"];
        }
        இன்றேல் {
            முடிவு = வரிக்குரிய_தொகை;
        }

        (வரிக்குரிய_தொகை > தொடக்கம்) எனில் {
            மேல்_எல்லை = முடிவு;
            (வரிக்குரிய_தொகை < முடிவு) எனில் { மேல்_எல்லை = வரிக்குரிய_தொகை; }
            இந்தப்_பகுதி = மேல்_எல்லை - தொடக்கம்;

            // __A band states either a rate on its own part, or a flat amount.__
            நிலையானது = புலம்_அல்லது(இந்தப்_படி, "நிலைத்_தொகை", 0);
            (நிலையானது > 0) எனில் {
                வரி_மொத்தம் = நிலையானது;
            }
            இன்றேல் {
                விகிதம் = புலம்_அல்லது(இந்தப்_படி, "விகிதம்", 0);
                வரி_மொத்தம் = வரி_மொத்தம் + சதவீதம்(இந்தப்_பகுதி, விகிதம்);
            }
        }
        படி_எண் = படி_எண் + 1;
    }
    திரும்பு வட்டமிடு(வரி_மொத்தம், 2);
}

// __--- gratuity -------------------------------------------------------------__
//
// பணிக்கொடை(கடைசிச்_சம்பளம், பணி_ஆண்டுகள், மேல்_எண், கீழ்_எண், உச்ச_வரம்பு)
//
// __The Payment of Gratuity Act states it as fifteen days' wages for each__
// __completed year, on a month reckoned as twenty-six working days — so__
// __last drawn × 15/26 × years. The fifteen and the twenty-six are passed rather__
// __than written in, as is the statutory maximum: all three have been amended.__
//
// __Pass 0 as the maximum for none.__
செயல் பணிக்கொடை(கடைசிச்_சம்பளம், பணி_ஆண்டுகள், மேல்_எண், கீழ்_எண், உச்ச_வரம்பு) {
    (கீழ்_எண் <= 0 அல்லது பணி_ஆண்டுகள் <= 0) எனில் { திரும்பு 0; }
    கணக்கு = கடைசிச்_சம்பளம் * மேல்_எண் / கீழ்_எண் * பணி_ஆண்டுகள்;
    விடை = வட்டமிடு(கணக்கு, 2);
    (உச்ச_வரம்பு > 0 மற்றும் விடை > உச்ச_வரம்பு) எனில் { திரும்பு உச்ச_வரம்பு; }
    திரும்பு விடை;
}

// __--- the payslip ----------------------------------------------------------__
//
// சம்பளச்_சீட்டு(கூறுகள், பிடித்தங்கள்)
//
// __Answers {மொத்தம், பிடித்தம், கையில்}. Deliberately dull: it adds up what it__
// __is given and subtracts what it is given. Deciding which deductions apply is__
// __the caller's, because that decision is where the statute lives.__
செயல் சம்பளச்_சீட்டு(கூறுகள், பிடித்தங்கள்) {
    மொத்தம் = மொத்தச்_சம்பளம்(கூறுகள்);
    பிடித்தக்_கூட்டல் = மொத்தச்_சம்பளம்(பிடித்தங்கள்);
    திரும்பு {"மொத்தம்": மொத்தம்,
              "பிடித்தம்": பிடித்தக்_கூட்டல்,
              "கையில்": வட்டமிடு(மொத்தம் - பிடித்தக்_கூட்டல், 2)};
}
