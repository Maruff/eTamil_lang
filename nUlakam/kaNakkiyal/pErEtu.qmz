// __nUlakam/kaNakkiyal/pErEtu.qmz — பேரேடு (the ledger)__
//
// __Double entry, enforced. A transaction that does not balance is rejected;__
// __it never reaches the ledger. The ledger itself is append-only: posting__
// __returns a new ledger rather than modifying the old one, so an entry cannot__
// __be edited after the fact — the property eloquent-ifrs protects by keeping__
// __clients away from the table.__

இறக்கு "kaNakkukaL.qmz";
இறக்கு "kAlam.qmz";
இறக்கு "../atippatY/kaNiqam.qmz";
இறக்கு "../atippatY/aNi.qmz";

// வரிசை_ஆக்கு(கணக்கு_குறி, பற்று_தொகை, வரவு_தொகை)
// __வரிசை_ஆக்கு(கணக்கு_குறி, பற்று_தொகை, வரவு_தொகை) — one line of a journal entry__
//
// __Both amounts are carried, not a single signed figure with a side flag. A line is conventionally one or the other, but holding both means the totals below add without knowing the convention, and a line that somehow has two is visible rather than silently netted.__
செயல் வரிசை_ஆக்கு(கணக்கு_குறி, பற்று_தொகை, வரவு_தொகை) {
    திரும்பு {
        கணக்கு_குறி: கணக்கு_குறி,
        பற்று_தொகை: பற்று_தொகை,
        வரவு_தொகை: வரவு_தொகை
    };
}

// __பற்று(கணக்கு_குறி, தொகை) / வரவு(கணக்கு_குறி, தொகை) — the readable forms__
செயல் பற்று_வரிசை(கணக்கு_குறி, தொகை_மதிப்பு) {
    திரும்பு வரிசை_ஆக்கு(கணக்கு_குறி, தொகை_மதிப்பு, 0);
}

// __வரவு_வரிசை(கணக்கு_குறி, தொகை_மதிப்பு) — a credit line__
//
// __The credit half of the pair with பற்று_வரிசை. Writing the two sides through named helpers rather than positional zeroes is what stops the commonest journal mistake, which is not an unbalanced entry but a balanced one posted the wrong way round.__
செயல் வரவு_வரிசை(கணக்கு_குறி, தொகை_மதிப்பு) {
    திரும்பு வரிசை_ஆக்கு(கணக்கு_குறி, 0, தொகை_மதிப்பு);
}

// பரிவர்த்தனை_ஆக்கு(ஒரு_எண், நாள், விவரம், வரிசைகள்)
// __பரிவர்த்தனை_ஆக்கு(பரிவர்த்தனை_எண், நாள், விவரம், வரிசைகள்) — assemble one transaction__
//
// __Builds it; it does not post it. The balance check belongs to posting, so a caller can construct an entry, inspect it and amend it before the ledger ever sees it — and what the ledger accepts is still only what balances.__
செயல் பரிவர்த்தனை_ஆக்கு(பரிவர்த்தனை_எண், நாள், விவரம், வரிசைகள்) {
    திரும்பு {
        பரிவர்த்தனை_எண்: பரிவர்த்தனை_எண்,
        நாள்: நாள்,
        விவரம்: விவரம்,
        வரிசைகள்: வரிசைகள்
    };
}

// __மொத்த_பற்று / மொத்த_வரவு over a transaction's lines__
செயல் மொத்த_பற்று(வரிசைகள்) {
    மொத்தம் = 0;
    ஒவ்வொரு ஒரு_வரிசை இல் வரிசைகள் {
        மொத்தம் = மொத்தம் + ஒரு_வரிசை.பற்று_தொகை;
    }
    திரும்பு மொத்தம்;
}

// __மொத்த_வரவு(வரிசைகள்) — the credits of one transaction, added up__
//
// __Compared against மொத்த_பற்று to decide whether the entry balances. Computed over the lines as given rather than accumulated as they are added, so the check cannot be fooled by an entry assembled in an unusual order.__
செயல் மொத்த_வரவு(வரிசைகள்) {
    மொத்தம் = 0;
    ஒவ்வொரு ஒரு_வரிசை இல் வரிசைகள் {
        மொத்தம் = மொத்தம் + ஒரு_வரிசை.வரவு_தொகை;
    }
    திரும்பு மொத்தம்;
}

// __சமநிலையா(பரிவர்த்தனை) — do the two sides agree?__
செயல் சமநிலையா(பரிவர்த்தனை) {
    திரும்பு மொத்த_பற்று(பரிவர்த்தனை.வரிசைகள்) == மொத்த_வரவு(பரிவர்த்தனை.வரிசைகள்);
}

// __பதிவிடு(பேரேடு, பரிவர்த்தனை) — post, or refuse__
//
// __Exact decimals matter here: with f64 a transaction could be a fraction of__
// __a paisa out and this equality would fail, or worse, silently pass.__
செயல் பதிவிடு(பேரேடு, பரிவர்த்தனை) {
    (நீளம்(பரிவர்த்தனை.வரிசைகள்) == 0) எனில் {
        திரும்பு தவறு("வரிசைகள் இல்லாத பரிவர்த்தனை: " & பரிவர்த்தனை.பரிவர்த்தனை_எண்);
    }
    (இல்லை சமநிலையா(பரிவர்த்தனை)) எனில் {
        திரும்பு தவறு("சமநிலை இல்லை " & பரிவர்த்தனை.பரிவர்த்தனை_எண்
                      & ": பற்று " & மொத்த_பற்று(பரிவர்த்தனை.வரிசைகள்)
                      & ", வரவு " & மொத்த_வரவு(பரிவர்த்தனை.வரிசைகள்));
    }

    புதிய_பேரேடு = பேரேடு;
    ஒவ்வொரு ஒரு_வரிசை இல் பரிவர்த்தனை.வரிசைகள் {
        பதிவு = {
            பரிவர்த்தனை_எண்: பரிவர்த்தனை.பரிவர்த்தனை_எண்,
            நாள்: பரிவர்த்தனை.நாள்,
            விவரம்: பரிவர்த்தனை.விவரம்,
            கணக்கு_குறி: ஒரு_வரிசை.கணக்கு_குறி,
            பற்று_தொகை: ஒரு_வரிசை.பற்று_தொகை,
            வரவு_தொகை: ஒரு_வரிசை.வரவு_தொகை
        };
        புதிய_பேரேடு = இணை(புதிய_பேரேடு, பதிவு);
    }
    திரும்பு சரி(புதிய_பேரேடு);
}

// கணக்கு_இருப்பு(பேரேடு, கணக்கு_குறி, வகை)
//
// __Returned in the account's own normal direction, so an asset with more__
// __debits than credits reads positive, and so does a liability with more__
// __credits than debits.__
செயல் கணக்கு_இருப்பு(பேரேடு, கணக்கு_குறி, கணக்கு_வகை) {
    பற்று_மொத்தம் = 0;
    வரவு_மொத்தம் = 0;
    ஒவ்வொரு பதிவு இல் பேரேடு {
        (பதிவு.கணக்கு_குறி == கணக்கு_குறி) எனில் {
            பற்று_மொத்தம் = பற்று_மொத்தம் + பதிவு.பற்று_தொகை;
            வரவு_மொத்தம் = வரவு_மொத்தம் + பதிவு.வரவு_தொகை;
        }
    }
    (பற்று_இயல்பா(கணக்கு_வகை)) எனில் {
        திரும்பு பற்று_மொத்தம் - வரவு_மொத்தம்;
    }
    திரும்பு வரவு_மொத்தம் - பற்று_மொத்தம்;
}

// __கணக்கு_பதிவுகள்(பேரேடு, கணக்கு_குறி) — the lines for one account__
செயல் கணக்கு_பதிவுகள்(பேரேடு, கணக்கு_குறி) {
    திரும்பு புலத்தால்_வடிகட்டு(பேரேடு, "கணக்கு_குறி", கணக்கு_குறி);
}

// __--- Period filters ---__
//
// __Reports run over a filtered ledger rather than taking a period argument__
// __each. An income statement filters to a period; a balance sheet filters to__
// __everything up to a date, because it is cumulative by nature.__

// __காலம்_வடிகட்டு(பேரேடு, காலம்) — postings within the period__
செயல் காலம்_வடிகட்டு(பேரேடு, காலம்) {
    விடை = [];
    ஒவ்வொரு பதிவு இல் பேரேடு {
        (காலத்தில்_உள்ளதா(பதிவு.நாள், காலம்)) எனில் {
            விடை = இணை(விடை, பதிவு);
        }
    }
    திரும்பு விடை;
}

// __வரை_வடிகட்டு(பேரேடு, நாள்) — everything on or before a date__
செயல் வரை_வடிகட்டு(பேரேடு, வரம்பு_நாள்) {
    விடை = [];
    ஒவ்வொரு பதிவு இல் பேரேடு {
        (பதிவு.நாள் <= வரம்பு_நாள்) எனில் {
            விடை = இணை(விடை, பதிவு);
        }
    }
    திரும்பு விடை;
}

// பரிவர்த்தனை_தொகை(பேரேடு, பரிவர்த்தனை_எண், கணக்கு_குறி)
// __The amount one transaction put on one account, in that account's normal__
// __direction. Clearing needs this to know what an invoice was worth.__
செயல் பரிவர்த்தனை_தொகை(பேரேடு, பரிவர்த்தனை_எண், கணக்கு_குறி, கணக்கு_வகை) {
    பற்று_மொத்தம் = 0;
    வரவு_மொத்தம் = 0;
    ஒவ்வொரு பதிவு இல் பேரேடு {
        (பதிவு.பரிவர்த்தனை_எண் == பரிவர்த்தனை_எண்
         மற்றும் பதிவு.கணக்கு_குறி == கணக்கு_குறி) எனில் {
            பற்று_மொத்தம் = பற்று_மொத்தம் + பதிவு.பற்று_தொகை;
            வரவு_மொத்தம் = வரவு_மொத்தம் + பதிவு.வரவு_தொகை;
        }
    }
    (பற்று_இயல்பா(கணக்கு_வகை)) எனில் {
        திரும்பு பற்று_மொத்தம் - வரவு_மொத்தம்;
    }
    திரும்பு வரவு_மொத்தம் - பற்று_மொத்தம்;
}

// பரிவர்த்தனை_நாள்(பேரேடு, பரிவர்த்தனை_எண்)
// __பரிவர்த்தனை_நாள்(பேரேடு, பரிவர்த்தனை_எண்) — the date a transaction was posted on__
//
// __சரி with the date, or தவறு for a number that is not in the ledger. Needed because the ledger is append-only and flat: the date lives on the entry, and a period report has to ask rather than assume the order of posting matches the order of dates.__
செயல் பரிவர்த்தனை_நாள்(பேரேடு, பரிவர்த்தனை_எண்) {
    ஒவ்வொரு பதிவு இல் பேரேடு {
        (பதிவு.பரிவர்த்தனை_எண் == பரிவர்த்தனை_எண்) எனில் {
            திரும்பு சரி(பதிவு.நாள்);
        }
    }
    திரும்பு தவறு("பரிவர்த்தனை காணவில்லை: " & பரிவர்த்தனை_எண்);
}

// __பரிவர்த்தனை_எண்கள்(பேரேடு, கணக்கு_குறி) — distinct transactions touching__
// __an account, in the order they were posted__
செயல் பரிவர்த்தனை_எண்கள்(பேரேடு, கணக்கு_குறி) {
    விடை = [];
    ஒவ்வொரு பதிவு இல் பேரேடு {
        (பதிவு.கணக்கு_குறி == கணக்கு_குறி) எனில் {
            ஏற்கனவே = பொய்;
            ஒவ்வொரு ஒரு_எண் இல் விடை {
                (ஒரு_எண் == பதிவு.பரிவர்த்தனை_எண்) எனில் { ஏற்கனவே = மெய்; }
            }
            (இல்லை ஏற்கனவே) எனில் {
                விடை = இணை(விடை, பதிவு.பரிவர்த்தனை_எண்);
            }
        }
    }
    திரும்பு விடை;
}
