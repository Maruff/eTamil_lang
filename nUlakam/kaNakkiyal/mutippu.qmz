// __nUlakam/kaNakkiyal/mutippu.qmz — ஆண்டு முடிப்பு (period close)__
// ஆண்டு முடிப்பு
//
// __At the end of a year the revenue and expense accounts are emptied into__
// __retained earnings. Without this, a second year's income statement would__
// __include the first year's trading, and the balance sheet would count the__
// __same profit twice — once in the accumulated ledger and once as the__
// __current period's result.__
//
// __The closing entry is an ordinary transaction: it balances, it posts__
// __through பதிவிடு, and it appears in the ledger like any other. Nothing is__
// __deleted.__

இறக்கு "pErEtu.qmz";
இறக்கு "kaNakkukaL.qmz";
இறக்கு "kAlam.qmz";
இறக்கு "aRikkYkaL.qmz";

// __முடிப்பு_பரிவர்த்தனை(...) — build the closing entry for a period__
// முடிப்பு_பரிவர்த்தனை(பேரேடு, கணக்குகள், காலம், எண், நாள், தக்கவைப்புக்_கணக்கு) — காலத்தை முடிக்கும் பதிவை உருவாக்கும்
//
// __Every revenue account is debited by its balance and every expense account__
// __credited by its, with the net going to retained earnings. The result is__
// __that both sets read zero from the day after the close.__
செயல் முடிப்பு_பரிவர்த்தனை(பரிவர்த்தனை_எண், பேரேடு, கணக்குகள்,
                              காலம், தேக்கிய_கணக்கு) {
    கால_பேரேடு = காலம்_வடிகட்டு(பேரேடு, காலம்);
    வரிசைகள் = [];
    நிகரம் = 0;

    ஒவ்வொரு ஒரு_கணக்கு இல் கணக்குகள் {
        இருப்பு_மதிப்பு = கணக்கு_இருப்பு(கால_பேரேடு, ஒரு_கணக்கு.குறி,
                                            ஒரு_கணக்கு.கணக்கு_வகை);
        (இருப்பு_மதிப்பு != 0) எனில் {
            (ஒரு_கணக்கு.கணக்கு_வகை == "வருவாய்") எனில் {
                // __revenue carries a credit balance, so debit it away__
                வரிசைகள் = இணை(வரிசைகள்,
                    பற்று_வரிசை(ஒரு_கணக்கு.குறி, இருப்பு_மதிப்பு));
                நிகரம் = நிகரம் + இருப்பு_மதிப்பு;
            }
            (ஒரு_கணக்கு.கணக்கு_வகை == "செலவு") எனில் {
                வரிசைகள் = இணை(வரிசைகள்,
                    வரவு_வரிசை(ஒரு_கணக்கு.குறி, இருப்பு_மதிப்பு));
                நிகரம் = நிகரம் - இருப்பு_மதிப்பு;
            }
        }
    }

    (நீளம்(வரிசைகள்) == 0) எனில் {
        திரும்பு தவறு("முடிக்க எதுவும் இல்லை  (nothing to close in this period)");
    }

    // __The balancing line: a profit credits retained earnings, a loss debits it__
    (நிகரம் >= 0) எனில் {
        வரிசைகள் = இணை(வரிசைகள், வரவு_வரிசை(தேக்கிய_கணக்கு, நிகரம்));
    }
    இன்றேல் {
        வரிசைகள் = இணை(வரிசைகள், பற்று_வரிசை(தேக்கிய_கணக்கு, 0 - நிகரம்));
    }

    திரும்பு சரி(பரிவர்த்தனை_ஆக்கு(பரிவர்த்தனை_எண், காலம்.முடிவு,
                                     "ஆண்டு முடிப்பு", வரிசைகள்));
}

// __ஆண்டை_முடி(...) — build the entry and post it in one step__
// ஆண்டை_முடி(பேரேடு, கணக்குகள், காலம், எண், நாள், தக்கவைப்புக்_கணக்கு) — பதிவை உருவாக்கிப் பதிவிடும்
செயல் ஆண்டை_முடி(பேரேடு, கணக்குகள், காலம், தேக்கிய_கணக்கு, பரிவர்த்தனை_எண்) {
    முடிப்பு = முடிப்பு_பரிவர்த்தனை(பரிவர்த்தனை_எண், பேரேடு, கணக்குகள்,
                                      காலம், தேக்கிய_கணக்கு)?;
    திரும்பு பதிவிடு(பேரேடு, முடிப்பு);
}

// __முடிக்கப்பட்டதா(பேரேடு, கணக்குகள், காலம்) — do the income accounts read__
// முடிக்கப்பட்டதா(பேரேடு, கணக்குகள், காலம்) — வருவாய்ச் செலவுக் கணக்குகள் பூஜ்ஜியமாகிவிட்டனவா
// __zero for this period? A safety check before opening the next year.__
செயல் முடிக்கப்பட்டதா(பேரேடு, கணக்குகள், காலம்) {
    அறிக்கை = கால_வருமான_அறிக்கை(பேரேடு, கணக்குகள், காலம்);
    திரும்பு அறிக்கை.நிகர_லாபம் == 0;
}
