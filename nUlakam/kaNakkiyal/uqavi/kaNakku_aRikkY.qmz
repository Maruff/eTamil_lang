// ஒரு கணக்கின் விவர அறிக்கை

இறக்கு "../kaNakkukaL.qmz";
இறக்கு "../pErEtu.qmz";
இறக்கு "../kAlam.qmz";
இறக்கு "../aRikkYkaL.qmz";
இறக்கு "../mutippu.qmz";
