இறக்கு "../vari.qmz";
இறக்கு "../vari_vikiqam.qmz";

கணக்குகள் = [மதிப்பு(கணக்கு_ஆக்கு("1000", "வங்கி", வகை_சொத்து(), "நடப்பு")),
              மதிப்பு(கணக்கு_ஆக்கு("3000", "மூலதனம்", வகை_பங்கு(), "மூலதனம்"))];
ஏடு = மதிப்பு(பதிவிடு([], பரிவர்த்தனை_ஆக்கு(1, "2026-04-01", "மூலதனம்",
    [பற்று_வரிசை("1000", 100000), வரவு_வரிசை("3000", 100000)])));
ஏடு = மதிப்பு(பதிவிடு(ஏடு, பரிவர்த்தனை_ஆக்கு(2, "2026-06-01", "மூலதனம்",
    [பற்று_வரிசை("1000", 50000), வரவு_வரிசை("3000", 50000)])));

// __As at, not for. Everything that ever happened up to that day.__
// அந்நாள்வரை நடந்த அனைத்தும்
அச்சு நாள்_இருப்புநிலை(ஏடு, கணக்குகள், "2026-04-30")["மொத்த_சொத்து"];
அச்சு நாள்_இருப்புநிலை(ஏடு, கணக்குகள், "2026-12-31")["மொத்த_சொத்து"];
