இறக்கு "../vari_vikiqam.qmz";

ஏடு = [];
ஏடு = மதிப்பு(பதிவிடு(ஏடு, பரிவர்த்தனை_ஆக்கு(1, "2026-04-01", "விற்பனை",
    [பற்று_வரிசை("1100", 5000), வரவு_வரிசை("4000", 5000)])));
ஏடு = மதிப்பு(பதிவிடு(ஏடு, பரிவர்த்தனை_ஆக்கு(2, "2026-04-10", "வசூல்",
    [பற்று_வரிசை("1000", 3000), வரவு_வரிசை("1100", 3000)])));

// __The element decides the sign, so a receivable of 2,000 reads as 2,000 and__
// __revenue of 5,000 reads as 5,000 — both positive, both meaning what they__
// __say.__
// மூலமே திசையைத் தீர்மானிக்கிறது; இரண்டும் நேர்மறையாகவே படிக்கப்படுகின்றன
அச்சு கணக்கு_இருப்பு(ஏடு, "1100", வகை_சொத்து());
அச்சு கணக்கு_இருப்பு(ஏடு, "4000", வகை_வருவாய்());
அச்சு கணக்கு_இருப்பு(ஏடு, "9999", வகை_சொத்து());
