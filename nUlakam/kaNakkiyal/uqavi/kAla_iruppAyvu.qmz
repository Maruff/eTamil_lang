// __கால_இருப்பாய்வு(பேரேடு, கணக்குகள், வரம்பு_நாள்) — the trial balance as at a date__
// அந்நாள் வரையிலான இருப்பாய்வு

இறக்கு "../kaNakkukaL.qmz";
இறக்கு "../pErEtu.qmz";
இறக்கு "../kAlam.qmz";
இறக்கு "../aRikkYkaL.qmz";
இறக்கு "../mutippu.qmz";
இறக்கு "../oqukkItu.qmz";
இறக்கு "../niRuvaZam.qmz";
இறக்கு "../qEymAZam.qmz";
இறக்கு "../Uqiyam.qmz";
இறக்கு "../vari.qmz";
இறக்கு "../vari_vikiqam.qmz";

கணக்குகள் = [மதிப்பு(கணக்கு_ஆக்கு("1000", "வங்கி", வகை_சொத்து(), "நடப்பு")),
              மதிப்பு(கணக்கு_ஆக்கு("4000", "விற்பனை", வகை_வருவாய்(), "இயக்கம்"))];
ஏடு = மதிப்பு(பதிவிடு([], பரிவர்த்தனை_ஆக்கு(1, "2026-04-01", "விற்பனை",
    [பற்று_வரிசை("1000", 50000), வரவு_வரிசை("4000", 50000)])));
ஏடு = மதிப்பு(பதிவிடு(ஏடு, பரிவர்த்தனை_ஆக்கு(2, "2026-06-01", "விற்பனை",
    [பற்று_வரிசை("1000", 30000), வரவு_வரிசை("4000", 30000)])));

// __A trial balance at a month end has to be computed on the ledger as it stood__
// __then, not on the ledger as it stands now with a filter applied afterwards.__
// மாத இறுதி இருப்பாய்வு, அன்றைய பேரேட்டின்மீதே
அச்சு கால_இருப்பாய்வு(ஏடு, கணக்குகள், "2026-04-30")["மொத்த_பற்று_நிரல்"];
அச்சு கால_இருப்பாய்வு(ஏடு, கணக்குகள், "2026-12-31")["மொத்த_பற்று_நிரல்"];
அச்சு கால_இருப்பாய்வு(ஏடு, கணக்குகள், "2026-12-31")["சமநிலையா"];
