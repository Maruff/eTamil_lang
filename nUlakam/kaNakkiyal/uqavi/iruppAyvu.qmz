கணக்குகள் = [மதிப்பு(கணக்கு_ஆக்கு("1000", "வங்கி", வகை_சொத்து(), "நடப்பு")),
              மதிப்பு(கணக்கு_ஆக்கு("1100", "பெறவேண்டியது", வகை_சொத்து(), "நடப்பு")),
              மதிப்பு(கணக்கு_ஆக்கு("4000", "விற்பனை", வகை_வருவாய்(), "இயக்கம்"))];
ஏடு = மதிப்பு(பதிவிடு([], பரிவர்த்தனை_ஆக்கு(1, "2026-04-01", "விற்பனை",
    [பற்று_வரிசை("1100", 5000), வரவு_வரிசை("4000", 5000)])));

// __Every account with a balance, on the side it belongs. It balances because__
// __every entry did, which is the only reason it ever balances.__
// ஒவ்வொரு பதிவும் சமநிலையில் இருந்ததால் இதுவும் சமநிலையில் உள்ளது
அறிக்கை = இருப்பாய்வு(ஏடு, கணக்குகள்);
அச்சு அறிக்கை["மொத்த_பற்று_நிரல்"];
அச்சு அறிக்கை["மொத்த_வரவு_நிரல்"];
அச்சு அறிக்கை["சமநிலையா"];
அச்சு நீளம்(அறிக்கை["வரிகள்"]);
