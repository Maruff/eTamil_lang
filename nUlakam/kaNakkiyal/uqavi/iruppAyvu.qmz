// இருப்பாய்வு

இறக்கு "../kaNakkukaL.qmz";
இறக்கு "../pErEtu.qmz";
இறக்கு "../kAlam.qmz";
இறக்கு "../aRikkYkaL.qmz";
இறக்கு "../mutippu.qmz";
இறக்கு "../oqukkItu.qmz";
