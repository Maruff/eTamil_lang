கணக்குகள் = [மதிப்பு(கணக்கு_ஆக்கு("4000", "விற்பனை", வகை_வருவாய்(), "இயக்கம்")),
              மதிப்பு(கணக்கு_ஆக்கு("5000", "வாடகை", வகை_செலவு(), "இயக்கம்")),
              மதிப்பு(கணக்கு_ஆக்கு("1000", "வங்கி", வகை_சொத்து(), "நடப்பு"))];
ஏடு = மதிப்பு(பதிவிடு([], பரிவர்த்தனை_ஆக்கு(1, "2026-04-01", "விற்பனை",
    [பற்று_வரிசை("1000", 50000), வரவு_வரிசை("4000", 50000)])));
ஏடு = மதிப்பு(பதிவிடு(ஏடு, பரிவர்த்தனை_ஆக்கு(2, "2026-04-05", "வாடகை",
    [பற்று_வரிசை("5000", 12000), வரவு_வரிசை("1000", 12000)])));

// __Revenue less expenses. The asset account is in the chart and not in this__
// __report, which is what வகையால்_வடிகட்டு is for.__
// வருவாய் போக செலவு; சொத்துக் கணக்கு இங்கே வருவதில்லை
அறிக்கை = வருமான_அறிக்கை(ஏடு, கணக்குகள்);
அச்சு அறிக்கை["மொத்த_வருவாய்"];
அச்சு அறிக்கை["மொத்த_செலவு"];
அச்சு அறிக்கை["நிகர_லாபம்"];
