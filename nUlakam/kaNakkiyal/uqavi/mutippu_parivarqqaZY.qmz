// __முடிப்பு_பரிவர்த்தனை(பரிவர்த்தனை_எண், பேரேடு, கணக்குகள், காலம், தேக்கிய_கணக்கு) — build the entry that closes a period__
// காலத்தை முடிக்கும் பதிவை உருவாக்கும்

இறக்கு "../kaNakkukaL.qmz";
இறக்கு "../pErEtu.qmz";
இறக்கு "../kAlam.qmz";
இறக்கு "../aRikkYkaL.qmz";
இறக்கு "../mutippu.qmz";
இறக்கு "../oqukkItu.qmz";
இறக்கு "../niRuvaZam.qmz";
இறக்கு "../qEymAZam.qmz";
இறக்கு "../Uqiyam.qmz";
இறக்கு "../vari.qmz";
இறக்கு "../vari_vikiqam.qmz";

கணக்குகள் = [மதிப்பு(கணக்கு_ஆக்கு("1000", "வங்கி", வகை_சொத்து(), "நடப்பு")),
              மதிப்பு(கணக்கு_ஆக்கு("3100", "தேக்கியது", வகை_பங்கு(), "தேக்கம்")),
              மதிப்பு(கணக்கு_ஆக்கு("4000", "விற்பனை", வகை_வருவாய்(), "இயக்கம்")),
              மதிப்பு(கணக்கு_ஆக்கு("5000", "வாடகை", வகை_செலவு(), "இயக்கம்"))];
ஏடு = மதிப்பு(பதிவிடு([], பரிவர்த்தனை_ஆக்கு(1, "2026-04-01", "விற்பனை",
    [பற்று_வரிசை("1000", 50000), வரவு_வரிசை("4000", 50000)])));
ஏடு = மதிப்பு(பதிவிடு(ஏடு, பரிவர்த்தனை_ஆக்கு(2, "2026-04-05", "வாடகை",
    [பற்று_வரிசை("5000", 12000), வரவு_வரிசை("1000", 12000)])));

// __Every revenue and expense account is emptied into retained earnings, so__
// __next year starts at nothing. The entry is built and not posted, so it can__
// __be inspected before it is.__
// பதிவு கட்டப்படுகிறது; பதியப்படவில்லை — பதியுமுன் பார்க்க முடியும்
முடிப்பு = மதிப்பு(முடிப்பு_பரிவர்த்தனை(99, ஏடு, கணக்குகள்,
                                          இந்திய_ஆண்டு(2026), "3100"));
அச்சு சமநிலையா(முடிப்பு);
அச்சு நீளம்(முடிப்பு["வரிசைகள்"]);

// __A period with nothing in it has nothing to close.__
// ஒன்றுமில்லாத காலத்தில் முடிக்க ஒன்றுமில்லை
அச்சு தவறா(முடிப்பு_பரிவர்த்தனை(99, ஏடு, கணக்குகள்,
                                  இந்திய_ஆண்டு(2030), "3100"));
