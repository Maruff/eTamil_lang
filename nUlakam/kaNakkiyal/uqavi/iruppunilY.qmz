கணக்குகள் = [மதிப்பு(கணக்கு_ஆக்கு("1000", "வங்கி", வகை_சொத்து(), "நடப்பு")),
              மதிப்பு(கணக்கு_ஆக்கு("3000", "மூலதனம்", வகை_பங்கு(), "மூலதனம்")),
              மதிப்பு(கணக்கு_ஆக்கு("4000", "விற்பனை", வகை_வருவாய்(), "இயக்கம்")),
              மதிப்பு(கணக்கு_ஆக்கு("5000", "வாடகை", வகை_செலவு(), "இயக்கம்"))];
ஏடு = மதிப்பு(பதிவிடு([], பரிவர்த்தனை_ஆக்கு(1, "2026-04-01", "மூலதனம்",
    [பற்று_வரிசை("1000", 100000), வரவு_வரிசை("3000", 100000)])));
ஏடு = மதிப்பு(பதிவிடு(ஏடு, பரிவர்த்தனை_ஆக்கு(2, "2026-04-05", "விற்பனை",
    [பற்று_வரிசை("1000", 50000), வரவு_வரிசை("4000", 50000)])));

// __The profit for the year is folded into equity as retained earnings, so the__
// __sheet balances before the books are closed rather than only after.__
// ஆண்டு லாபம் தேக்கிய வருவாயாகப் பங்குக்குள் சேர்க்கப்படுகிறது
அறிக்கை = இருப்புநிலை(ஏடு, கணக்குகள்);
அச்சு அறிக்கை["மொத்த_சொத்து"];
அச்சு அறிக்கை["தேக்கிய_வருவாய்"];
அச்சு அறிக்கை["மொத்த_பங்கு"];
அச்சு அறிக்கை["சமநிலையா"];
