// __சம்பளச்_சீட்டு(கூறுகள், பிடித்தங்கள்) — the payslip: gross, deductions, and what is left__
// மொத்தம், பிடித்தம், நிகரம் கொண்ட சம்பளச் சீட்டு

இறக்கு "../kaNakkukaL.qmz";
இறக்கு "../pErEtu.qmz";
இறக்கு "../kAlam.qmz";
இறக்கு "../aRikkYkaL.qmz";
இறக்கு "../mutippu.qmz";
இறக்கு "../oqukkItu.qmz";
இறக்கு "../niRuvaZam.qmz";
இறக்கு "../qEymAZam.qmz";
இறக்கு "../Uqiyam.qmz";
இறக்கு "../vari.qmz";
இறக்கு "../vari_vikiqam.qmz";

கூறுகள் = [{"பெயர்": "அடிப்படை", "தொகை": 40000},
            {"பெயர்": "அகவிலைப்படி", "தொகை": 8000},
            {"பெயர்": "வீட்டுப்படி", "தொகை": 16000}];
பிடித்தங்கள் = [{"பெயர்": "வருங்கால வைப்பு", "தொகை": 1800},
                {"பெயர்": "தொழில் வரி", "தொகை": 208},
                {"பெயர்": "மூலவரி", "தொகை": 4500}];

// __Both sides named, because a payslip that shows only a net figure is one__
// __nobody can check.__
// இரு பக்கமும் பெயரிடப்பட்டவை; நிகரம் மட்டும் காட்டும் சீட்டைச் சரிபார்க்க முடியாது
சீட்டு = சம்பளச்_சீட்டு(கூறுகள், பிடித்தங்கள்);
அச்சு சீட்டு["மொத்தம்"];
அச்சு சீட்டு["பிடித்தம்"];
அச்சு சீட்டு["கையில்"];
