// __nUlakam/kaNakkiyal/vari.qmz — வணிகவரி (GST) on transactions__
// பரிவர்த்தனைகளின் மேல் வணிக வரி
//
// __GST posts to a control account, exactly as eloquent-ifrs handles VAT:__
// __output tax on a sale is a liability until it is paid over, and input tax__
// __on a purchase is recoverable. Within a state the tax splits into CGST and__
// __SGST; across states it is IGST.__

இறக்கு "pErEtu.qmz";
இறக்கு "../atippatY/kaNiqam.qmz";

// வரி_விகிதம்_ஆக்கு(பெயர், விகிதம், கட்டுப்பாட்டு_கணக்கு)
// __வரி_விகிதம்_ஆக்கு(பெயர், விகிதம், கட்டுப்பாட்டு_கணக்கு) — one GST rate__
// வரி_விகிதம்_ஆக்கு(பெயர், விகிதம், கட்டுப்பாட்டு_கணக்கு) — ஒரு வரி விகிதம்
//
// __The control account travels with the rate, because tax collected is money held for the government and not revenue. Binding the two here means a posting cannot use a rate without also knowing where the tax half belongs.__
செயல் வரி_விகிதம்_ஆக்கு(பெயர், விகிதம், கட்டுப்பாட்டு_கணக்கு) {
    திரும்பு {
        பெயர்: பெயர்,
        விகிதம்: விகிதம்,
        கட்டுப்பாட்டு_கணக்கு: கட்டுப்பாட்டு_கணக்கு
    };
}

// __வரி_தொகை(அடிப்படை, விகிதம்) — the GST on a net amount, to the paisa__
// வரி_தொகை(அடிப்படை, விகிதம்) — நிகரத் தொகைமேல் வரி, பைசா வரை
செயல் வரி_தொகை(அடிப்படை, விகிதம்) {
    திரும்பு சதவீதம்(அடிப்படை, விகிதம்);
}

// வரியுடன்_மொத்தம்(அடிப்படை, விகிதம்)
// __வரியுடன்_மொத்தம்(அடிப்படை, விகிதம்) — the invoice total, tax included__
// வரியுடன்_மொத்தம்(அடிப்படை, விகிதம்) — வரி சேர்த்த விலைப்பட்டியல் மொத்தம்
//
// __Base plus tax, with the tax computed by வரி_தொகை so rounding happens in exactly one place. Adding a separately rounded tax to a base is how an invoice ends up a paisa away from the sum of its own lines.__
செயல் வரியுடன்_மொத்தம்(அடிப்படை, விகிதம்) {
    திரும்பு அடிப்படை + வரி_தொகை(அடிப்படை, விகிதம்);
}

// __அடிப்படையை_பிரி(மொத்தம், விகிதம்) — strip tax out of a gross amount__
// அடிப்படையை_பிரி(மொத்தம், விகிதம்) — மொத்தத்திலிருந்து வரியைப் பிரிக்கும்
செயல் அடிப்படையை_பிரி(மொத்தம், விகிதம்) {
    திரும்பு வட்டமிடு(மொத்தம் * 100 / (100 + விகிதம்), 2);
}

// __மாநில_பிரிப்பு(வரி, உள்_மாநிலமா) — CGST/SGST within a state, IGST across__
// மாநில_பிரிப்பு(வரி, உள்_மாநிலமா) — மாநிலத்துக்குள் இரண்டாகப் பிரித்து, வெளியே ஒன்றாக
செயல் மாநில_பிரிப்பு(மொத்த_வரி, உள்_மாநிலமா) {
    (உள்_மாநிலமா) எனில் {
        பாதி = வட்டமிடு(மொத்த_வரி / 2, 2);
        // __The remainder goes to the second half so the two always sum to the__
        // __whole, even when the tax is an odd number of paise.__
        திரும்பு {cgst: பாதி, sgst: மொத்த_வரி - பாதி, igst: 0};
    }
    திரும்பு {cgst: 0, sgst: 0, igst: மொத்த_வரி};
}

// விற்பனை_பரிவர்த்தனை(எண், நாள், விவரம், வாடிக்கையாளர்_கணக்கு,
//                     வருவாய்_கணக்கு, வரி_கணக்கு, அடிப்படை, விகிதம்)
//
// __A credit sale with output tax:__
//   __debit  receivable      gross__
//   __credit revenue         net__
//   __credit tax control     tax__
// விற்பனை_பரிவர்த்தனை(எண், நாள், விவரம், வாடிக்கையாளர்_கணக்கு, அடிப்படை, விகிதம், உள்_மாநிலமா) — கடன் விற்பனைப் பதிவு
செயல் விற்பனை_பரிவர்த்தனை(பரிவர்த்தனை_எண், நாள், விவரம்,
                             வாடிக்கையாளர்_கணக்கு, வருவாய்_கணக்கு,
                             வரி_கணக்கு, அடிப்படை, விகிதம்) {
    வரி = வரி_தொகை(அடிப்படை, விகிதம்);
    மொத்தம் = அடிப்படை + வரி;

    வரிசைகள் = [
        பற்று_வரிசை(வாடிக்கையாளர்_கணக்கு, மொத்தம்),
        வரவு_வரிசை(வருவாய்_கணக்கு, அடிப்படை)
    ];
    (வரி > 0) எனில் {
        வரிசைகள் = இணை(வரிசைகள், வரவு_வரிசை(வரி_கணக்கு, வரி));
    }
    திரும்பு பரிவர்த்தனை_ஆக்கு(பரிவர்த்தனை_எண், நாள், விவரம், வரிசைகள்);
}

// __கொள்முதல்_பரிவர்த்தனை(...) — a credit purchase with recoverable input tax:__
// கொள்முதல்_பரிவர்த்தனை(எண், நாள், விவரம், விற்பனையாளர்_கணக்கு, அடிப்படை, விகிதம், உள்_மாநிலமா) — மீட்கக்கூடிய உள்ளீட்டு வரியுடன் கடன் கொள்முதல்
//   __debit  expense         net__
//   __debit  tax control     tax__
//   __credit payable         gross__
செயல் கொள்முதல்_பரிவர்த்தனை(பரிவர்த்தனை_எண், நாள், விவரம்,
                                விற்பனையாளர்_கணக்கு, செலவு_கணக்கு,
                                வரி_கணக்கு, அடிப்படை, விகிதம்) {
    வரி = வரி_தொகை(அடிப்படை, விகிதம்);
    மொத்தம் = அடிப்படை + வரி;

    வரிசைகள் = [பற்று_வரிசை(செலவு_கணக்கு, அடிப்படை)];
    (வரி > 0) எனில் {
        வரிசைகள் = இணை(வரிசைகள், பற்று_வரிசை(வரி_கணக்கு, வரி));
    }
    வரிசைகள் = இணை(வரிசைகள், வரவு_வரிசை(விற்பனையாளர்_கணக்கு, மொத்தம்));
    திரும்பு பரிவர்த்தனை_ஆக்கு(பரிவர்த்தனை_எண், நாள், விவரம், வரிசைகள்);
}

// __பணம்_பெறு(...) — a receipt against a receivable__
// பணம்_பெறு(எண், நாள், விவரம், வாடிக்கையாளர்_கணக்கு, வங்கிக்_கணக்கு, தொகை) — பெறத்தக்கதற்கு எதிராகப் பணம் பெறுதல்
செயல் பணம்_பெறு(பரிவர்த்தனை_எண், நாள், விவரம்,
                  வங்கி_கணக்கு, வாடிக்கையாளர்_கணக்கு, தொகை_மதிப்பு) {
    திரும்பு பரிவர்த்தனை_ஆக்கு(பரிவர்த்தனை_எண், நாள், விவரம், [
        பற்று_வரிசை(வங்கி_கணக்கு, தொகை_மதிப்பு),
        வரவு_வரிசை(வாடிக்கையாளர்_கணக்கு, தொகை_மதிப்பு)
    ]);
}

// __பணம்_செலுத்து(...) — a payment against a payable__
// பணம்_செலுத்து(எண், நாள், விவரம், விற்பனையாளர்_கணக்கு, வங்கிக்_கணக்கு, தொகை) — கொடுக்கத்தக்கதற்கு எதிராகப் பணம் செலுத்துதல்
செயல் பணம்_செலுத்து(பரிவர்த்தனை_எண், நாள், விவரம்,
                      வங்கி_கணக்கு, விற்பனையாளர்_கணக்கு, தொகை_மதிப்பு) {
    திரும்பு பரிவர்த்தனை_ஆக்கு(பரிவர்த்தனை_எண், நாள், விவரம், [
        பற்று_வரிசை(விற்பனையாளர்_கணக்கு, தொகை_மதிப்பு),
        வரவு_வரிசை(வங்கி_கணக்கு, தொகை_மதிப்பு)
    ]);
}

// __ரொக்க_விற்பனை(...) — a sale settled immediately: the money lands in the__
// ரொக்க_விற்பனை(எண், நாள், விவரம், வங்கிக்_கணக்கு, அடிப்படை, விகிதம், உள்_மாநிலமா) — உடனே பணம் வரும் விற்பனை
// __bank instead of creating a receivable__
செயல் ரொக்க_விற்பனை(பரிவர்த்தனை_எண், நாள், விவரம்,
                      வங்கி_கணக்கு, வருவாய்_கணக்கு, வரி_கணக்கு,
                      அடிப்படை, விகிதம்) {
    திரும்பு விற்பனை_பரிவர்த்தனை(பரிவர்த்தனை_எண், நாள், விவரம்,
                                   வங்கி_கணக்கு, வருவாய்_கணக்கு,
                                   வரி_கணக்கு, அடிப்படை, விகிதம்);
}

// __ரொக்க_கொள்முதல்(...) — a purchase paid on the spot__
// ரொக்க_கொள்முதல்(எண், நாள், விவரம், வங்கிக்_கணக்கு, அடிப்படை, விகிதம், உள்_மாநிலமா) — உடனே பணம் செலுத்தும் கொள்முதல்
செயல் ரொக்க_கொள்முதல்(பரிவர்த்தனை_எண், நாள், விவரம்,
                        வங்கி_கணக்கு, செலவு_கணக்கு, வரி_கணக்கு,
                        அடிப்படை, விகிதம்) {
    திரும்பு கொள்முதல்_பரிவர்த்தனை(பரிவர்த்தனை_எண், நாள், விவரம்,
                                     வங்கி_கணக்கு, செலவு_கணக்கு,
                                     வரி_கணக்கு, அடிப்படை, விகிதம்);
}

// __வரவு_குறிப்பு(...) — a credit note: a sale reversed, tax included.__
// வரவு_குறிப்பு(எண், நாள், விவரம், வாடிக்கையாளர்_கணக்கு, அடிப்படை, விகிதம், உள்_மாநிலமா) — விற்பனையைத் திருப்பும் வரவுக் குறிப்பு
// __Debit revenue and tax, credit the customer.__
செயல் வரவு_குறிப்பு(பரிவர்த்தனை_எண், நாள், விவரம்,
                      வாடிக்கையாளர்_கணக்கு, வருவாய்_கணக்கு, வரி_கணக்கு,
                      அடிப்படை, விகிதம்) {
    வரி = வரி_தொகை(அடிப்படை, விகிதம்);
    மொத்தம் = அடிப்படை + வரி;

    வரிசைகள் = [பற்று_வரிசை(வருவாய்_கணக்கு, அடிப்படை)];
    (வரி > 0) எனில் {
        வரிசைகள் = இணை(வரிசைகள், பற்று_வரிசை(வரி_கணக்கு, வரி));
    }
    வரிசைகள் = இணை(வரிசைகள், வரவு_வரிசை(வாடிக்கையாளர்_கணக்கு, மொத்தம்));
    திரும்பு பரிவர்த்தனை_ஆக்கு(பரிவர்த்தனை_எண், நாள், விவரம், வரிசைகள்);
}

// __பற்று_குறிப்பு(...) — a debit note: a purchase returned to the supplier__
// பற்று_குறிப்பு(எண், நாள், விவரம், விற்பனையாளர்_கணக்கு, அடிப்படை, விகிதம், உள்_மாநிலமா) — கொள்முதலைத் திருப்பும் பற்றுக் குறிப்பு
செயல் பற்று_குறிப்பு(பரிவர்த்தனை_எண், நாள், விவரம்,
                       விற்பனையாளர்_கணக்கு, செலவு_கணக்கு, வரி_கணக்கு,
                       அடிப்படை, விகிதம்) {
    வரி = வரி_தொகை(அடிப்படை, விகிதம்);
    மொத்தம் = அடிப்படை + வரி;

    வரிசைகள் = [பற்று_வரிசை(விற்பனையாளர்_கணக்கு, மொத்தம்),
                 வரவு_வரிசை(செலவு_கணக்கு, அடிப்படை)];
    (வரி > 0) எனில் {
        வரிசைகள் = இணை(வரிசைகள், வரவு_வரிசை(வரி_கணக்கு, வரி));
    }
    திரும்பு பரிவர்த்தனை_ஆக்கு(பரிவர்த்தனை_எண், நாள், விவரம், வரிசைகள்);
}

// __எதிர்_பதிவு(...) — a contra entry: money moved between the entity's own__
// எதிர்_பதிவு(எண், நாள், விவரம், இருந்து_கணக்கு, வரை_கணக்கு, தொகை) — நிறுவனத்தின் சொந்தக் கணக்குகளுக்கு இடையே பண நகர்வு
// __accounts, such as a bank transfer or a cash deposit__
செயல் எதிர்_பதிவு(பரிவர்த்தனை_எண், நாள், விவரம்,
                    இருந்து_கணக்கு, க்கு_கணக்கு, தொகை_மதிப்பு) {
    திரும்பு பரிவர்த்தனை_ஆக்கு(பரிவர்த்தனை_எண், நாள், விவரம், [
        பற்று_வரிசை(க்கு_கணக்கு, தொகை_மதிப்பு),
        வரவு_வரிசை(இருந்து_கணக்கு, தொகை_மதிப்பு)
    ]);
}

// __தொடக்க_இருப்பு(...) — an opening balance at the start of a year__
// தொடக்க_இருப்பு(எண், நாள், விவரம், வரிசைகள்) — ஆண்டின் தொடக்கத்தில் திறப்பு இருப்பு
செயல் தொடக்க_இருப்பு(பரிவர்த்தனை_எண், நாள், கணக்கு_குறி,
                       எதிர்_கணக்கு, தொகை_மதிப்பு, பற்றா) {
    (பற்றா) எனில் {
        திரும்பு பரிவர்த்தனை_ஆக்கு(பரிவர்த்தனை_எண், நாள், "தொடக்க இருப்பு", [
            பற்று_வரிசை(கணக்கு_குறி, தொகை_மதிப்பு),
            வரவு_வரிசை(எதிர்_கணக்கு, தொகை_மதிப்பு)
        ]);
    }
    திரும்பு பரிவர்த்தனை_ஆக்கு(பரிவர்த்தனை_எண், நாள், "தொடக்க இருப்பு", [
        பற்று_வரிசை(எதிர்_கணக்கு, தொகை_மதிப்பு),
        வரவு_வரிசை(கணக்கு_குறி, தொகை_மதிப்பு)
    ]);
}
