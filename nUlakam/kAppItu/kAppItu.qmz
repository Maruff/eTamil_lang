// __nUlakam/kAppItu/kAppItu.qmz — காப்பீடு (insurance): policy, premium, claim__
// காப்பீடு: பாலிசி, முனைமம், கோரல்
//
// __Insurance arithmetic is mostly small and one rule is famously not: when a__
// __property is insured for less than it is worth, the insurer pays only the__
// __proportion that was insured — even for a partial loss well inside the sum__
// __insured. That is the average clause, it surprises policyholders, and getting__
// __it wrong overpays every under-insured claim.__
//
// __Rates are a number out of a hundred, as everywhere here. A premium rate__
// __quoted per mille has its own function, because that is how property risks__
// __are actually quoted and converting by hand is where a factor of ten goes.__
//
// __No rate, loading or limit is in this file. They are terms of a contract, and__
// __a contract is data.__
//
// __காப்பீடு, இழப்பு, விலக்கு and பங்கு are all keywords, so the words this__
// __module most wants are unavailable alone. Compounds it is.__

இறக்கு "../atippatY/kaNiqam.qmz";
இறக்கு "../atippatY/poruL.qmz";

// __--- premium --------------------------------------------------------------__
//
// __முனைமம்(காப்பீட்டுத்_தொகை, விகிதம்) — a premium at a percentage rate__
// முனைமம்(காப்பீட்டுத்_தொகை, விகிதம்) — சதவீத வீதத்தில் முனைமம்
செயல் முனைமம்(காப்பீட்டுத்_தொகை, விகிதம்) {
    திரும்பு வட்டப்_பங்கு(காப்பீட்டுத்_தொகை, விகிதம்);
}

// ஆயிரத்திற்கு_முனைமம்(காப்பீட்டுத்_தொகை, ஆயிரத்திற்கு)
//
// __Property is quoted per thousand — "one rupee eighty per mille" — not per__
// __cent. Writing 1.80 into a percentage function charges a hundred times too__
// __much, and the number looks plausible either way.__
// ஆயிரத்திற்கு_முனைமம்(காப்பீட்டுத்_தொகை, ஆயிரத்திற்கு) — ஆயிரத்திற்கு இவ்வளவு என்ற வீதத்தில் முனைமம்
செயல் ஆயிரத்திற்கு_முனைமம்(காப்பீட்டுத்_தொகை, ஆயிரத்திற்கு) {
    திரும்பு வட்டமிடு(காப்பீட்டுத்_தொகை * ஆயிரத்திற்கு / 1000, 2);
}

// ஏற்ற_இறக்கத்துடன்(அடிப்படை_முனைமம், ஏற்ற_விகிதம், தள்ளுபடி_விகிதம்)
//
// __A loading for risk, a discount for a claim-free record. Both as percentages__
// __of the base premium, and the loading is applied before the discount because__
// __that is the order a schedule states them in.__
// ஏற்ற_இறக்கத்துடன்(அடிப்படை_முனைமம், ஏற்ற_விகிதம், தள்ளுபடி_விகிதம்) — ஏற்றமும் தள்ளுபடியும் சேர்த்த முனைமம்
செயல் ஏற்ற_இறக்கத்துடன்(அடிப்படை_முனைமம், ஏற்ற_விகிதம், தள்ளுபடி_விகிதம்) {
    ஏற்றியது = அடிப்படை_முனைமம் + சதவீதம்(அடிப்படை_முனைமம், ஏற்ற_விகிதம்);
    திரும்பு வட்டமிடு(ஏற்றியது - சதவீதம்(ஏற்றியது, தள்ளுபடி_விகிதம்), 2);
}

// குறுகிய_காலம்(ஆண்டு_முனைமம், நாட்கள், ஆண்டு_நாட்கள்)
//
// __A policy for part of a year. Pro rata by days, not by months: a policy__
// __starting on the fifteenth is not half a month's cover.__
// குறுகிய_காலம்(ஆண்டு_முனைமம், நாட்கள், ஆண்டு_நாட்கள்) — ஆண்டுக்கும் குறைவான காலத்திற்கான முனைமம்
செயல் குறுகிய_காலம்(ஆண்டு_முனைமம், நாட்கள், ஆண்டு_நாட்கள்) {
    திரும்பு நாள்_விகிதம்(ஆண்டு_முனைமம், நாட்கள், ஆண்டு_நாட்கள்);
}

// __--- the claim ------------------------------------------------------------__
//
// __கழிவுக்குப்_பின்(இழப்புத்_தொகை, கழிவு) — the excess the insured bears__
// கழிவுக்குப்_பின்(இழப்புத்_தொகை, கழிவு) — காப்பீடு செய்தவர் தாங்கும் கழிவுக்குப் பிறகு மிஞ்சுவது
//
// __Applied to the loss before anything else. A loss smaller than the excess is__
// __not a small payment; it is no payment.__
செயல் கழிவுக்குப்_பின்(இழப்புத்_தொகை, கழிவு) {
    திரும்பு குறையாக்_கழி(இழப்புத்_தொகை, கழிவு);
}

// சராசரி_விதி(இழப்புத்_தொகை, காப்பீட்டுத்_தொகை, உண்மை_மதிப்பு)
//
// __The average clause, and the rule this module exists for.__
//
// __A building worth fifty lakh insured for twenty-five is insured for half its__
// __value, so the insurer pays half of any loss — not the whole of a five-lakh__
// __loss merely because five lakh is inside the sum insured. Policyholders find__
// __this surprising, and an implementation that pays the full partial loss__
// __overpays every under-insured claim.__
//
// __Insured for its full value or more, nothing is scaled back.__
// சராசரி_விதி(இழப்புத்_தொகை, காப்பீட்டுத்_தொகை, உண்மை_மதிப்பு) — குறைவாகக் காப்பீடு செய்தால் விகிதப்படி குறைக்கும் விதி
செயல் சராசரி_விதி(இழப்புத்_தொகை, காப்பீட்டுத்_தொகை, உண்மை_மதிப்பு) {
    (உண்மை_மதிப்பு <= 0) எனில் { திரும்பு வட்டமிடு(இழப்புத்_தொகை, 2); }
    (காப்பீட்டுத்_தொகை >= உண்மை_மதிப்பு) எனில் { திரும்பு வட்டமிடு(இழப்புத்_தொகை, 2); }
    திரும்பு வட்டமிடு(இழப்புத்_தொகை * காப்பீட்டுத்_தொகை / உண்மை_மதிப்பு, 2);
}

// __கோரல்_தீர்வு(விவரங்கள்) — what is actually payable__
// கோரல்_தீர்வு(இழப்புத்_தொகை, பாலிசி) — கழிவும் சராசரி விதியும் சேர்த்த இறுதிக் கோரல் தொகை
//
// __விவரங்கள் carries what the policy says:__
//   __இழப்பு       what was lost__
//   __காப்பீடு     the sum insured__
//   __உண்மை_மதிப்பு the value at risk — leave it out and no averaging applies__
//   __கழிவு        the excess__
//   __பங்கேற்பு     co-payment, as a percentage the insured bears__
//   __உட்_வரம்பு    a sub-limit for this head of cover__
//
// __The order is the order a settlement is computed in, and it is not__
// __interchangeable: average first on the whole loss, then the excess, then__
// __co-payment, then any sub-limit, and finally the sum insured as a ceiling.__
// __Applying the excess before averaging pays more than the policy promises.__
//
// __Answers a record rather than a number, so a settlement letter can say how it__
// __got there — which is what a policyholder disputing it will ask.__
// கோரல்_தீர்வு(விவரங்கள்) — சராசரி, விலக்கு, கூட்டுக்கட்டணம், உட்பெல்லை, காப்புத்தொகை என்ற வரிசையில் கோரலைத் தீர்த்து, வந்த வழியைச் சொல்லும் பதிவைத் தரும்
செயல் கோரல்_தீர்வு(விவரங்கள்) {
    இழப்பு_மதிப்பு = புலம்_அல்லது(விவரங்கள், "இழப்பு", 0);
    காப்பீட்டுத்_தொகை = புலம்_அல்லது(விவரங்கள், "காப்பீடு", 0);
    உண்மை_மதிப்பு = புலம்_அல்லது(விவரங்கள், "உண்மை_மதிப்பு", 0);
    கழிவு = புலம்_அல்லது(விவரங்கள், "கழிவு", 0);
    பங்கேற்பு = புலம்_அல்லது(விவரங்கள், "பங்கேற்பு", 0);
    உட்_வரம்பு = புலம்_அல்லது(விவரங்கள், "உட்_வரம்பு", 0);

    சராசரிக்குப்_பின் = சராசரி_விதி(இழப்பு_மதிப்பு, காப்பீட்டுத்_தொகை, உண்மை_மதிப்பு);
    கழிவுக்குப்_பின்னது = கழிவுக்குப்_பின்(சராசரிக்குப்_பின், கழிவு);

    பங்கேற்புத்_தொகை = வட்டமிடு(சதவீதம்(கழிவுக்குப்_பின்னது, பங்கேற்பு), 2);
    பங்கிற்குப்_பின் = கழிவுக்குப்_பின்னது - பங்கேற்புத்_தொகை;

    வரம்பிற்குப்_பின் = பங்கிற்குப்_பின்;
    (உட்_வரம்பு > 0 மற்றும் வரம்பிற்குப்_பின் > உட்_வரம்பு) எனில் {
        வரம்பிற்குப்_பின் = உட்_வரம்பு;
    }

    // __Indemnity: the sum insured is a ceiling and not a target. Nothing above__
    // __it is payable however the arithmetic came out.__
    செலுத்தத்தக்கது = வரம்பிற்குப்_பின்;
    (காப்பீட்டுத்_தொகை > 0 மற்றும் செலுத்தத்தக்கது > காப்பீட்டுத்_தொகை) எனில் {
        செலுத்தத்தக்கது = காப்பீட்டுத்_தொகை;
    }
    (செலுத்தத்தக்கது < 0) எனில் { செலுத்தத்தக்கது = 0; }

    திரும்பு {"இழப்பு": வட்டமிடு(இழப்பு_மதிப்பு, 2),
              "சராசரிக்குப்_பின்": சராசரிக்குப்_பின்,
              "கழிவு": வட்டமிடு(கழிவு, 2),
              "பங்கேற்பு": பங்கேற்புத்_தொகை,
              "செலுத்தத்தக்கது": வட்டமிடு(செலுத்தத்தக்கது, 2),
              "குறை_காப்பீடா": காப்பீட்டுத்_தொகை < உண்மை_மதிப்பு
                                 மற்றும் உண்மை_மதிப்பு > 0};
}

// __--- no-claim bonus -------------------------------------------------------__
//
// கோரல்_இல்லா_சலுகை(ஆண்டு_முனைமம், தொடர்_ஆண்டுகள், படிகள்)
//
// __The discount for a claim-free record steps up with each year and stops at a__
// __maximum. Both the steps and the cap are policy terms, so படிகள் is an array__
// __of {"ஆண்டு": n, "விகிதம்": r} ordered by year.__
// கோரல்_இல்லா_சலுகை(ஆண்டு_முனைமம், தொடர்_ஆண்டுகள், படிகள்) — கோரல் இல்லாத ஆண்டுகளுக்கான சலுகை
செயல் கோரல்_இல்லா_சலுகை(ஆண்டு_முனைமம், தொடர்_ஆண்டுகள், படிகள்) {
    பொருந்தும்_விகிதம் = 0;
    ஒவ்வொரு ஒரு_படி இல் படிகள் {
        (தொடர்_ஆண்டுகள் >= ஒரு_படி["ஆண்டு"]) எனில் {
            பொருந்தும்_விகிதம் = ஒரு_படி["விகிதம்"];
        }
    }
    திரும்பு {"விகிதம்": பொருந்தும்_விகிதம்,
              "சலுகை": வட்டமிடு(சதவீதம்(ஆண்டு_முனைமம், பொருந்தும்_விகிதம்), 2),
              "செலுத்த": வட்டமிடு(ஆண்டு_முனைமம்
                                    - சதவீதம்(ஆண்டு_முனைமம், பொருந்தும்_விகிதம்), 2)};
}

// __--- outstanding claims ---------------------------------------------------__
//
// __நிலுவைக்_கோரல்கள்(கோரல்கள்) — what is reported and not yet paid__
// நிலுவைக்_கோரல்கள்(கோரல்கள்) — தெரிவிக்கப்பட்டு இன்னும் தீர்க்கப்படாதவை
//
// __An insurer's largest liability is claims it knows about and has not settled.__
// __Summing them is arithmetic; deciding what to reserve for claims not yet__
// __reported is actuarial and is not here.__
செயல் நிலுவைக்_கோரல்கள்(கோரல்கள்) {
    கூட்டல் = 0;
    எண்ணிக்கை = 0;
    ஒவ்வொரு ஒரு_கோரல் இல் கோரல்கள் {
        (புலம்_அல்லது(ஒரு_கோரல், "தீர்ந்ததா", பொய்) == பொய்) எனில் {
            கூட்டல் = கூட்டல் + புலம்_அல்லது(ஒரு_கோரல், "மதிப்பிடப்பட்டது", 0);
            எண்ணிக்கை = எண்ணிக்கை + 1;
        }
    }
    திரும்பு {"எண்ணிக்கை": எண்ணிக்கை, "மொத்தம்": வட்டமிடு(கூட்டல், 2)};
}
