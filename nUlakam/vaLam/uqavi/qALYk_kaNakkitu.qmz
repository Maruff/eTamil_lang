// __தாளைக்_கணக்கிடு(உள்ளீடுகள், விகிதங்கள்) — cost a whole timesheet, or fail whole__
// நேரத்தாள் முழுவதற்கும் செலவைக் கணக்கிடும், அல்லது முழுமையாகத் தோல்வியுறும்

இறக்கு "../vaLam.qmz";
இறக்கு "../nEraqqAL.qmz";
இறக்கு "../paqivu.qmz";

விகிதங்கள் = [விகிதப்_பதிவு("E1", 500, "2025-04-01", "2026-03-31"),
               விகிதப்_பதிவு("E1", 600, "2026-04-01", "")];

தாள் = [நேர_உள்ளீடு("E1", "2026-03-30", "S2a", 8, மெய்),
         நேர_உள்ளீடு("E1", "2026-03-31", "S2a", 8, மெய்),
         நேர_உள்ளீடு("E1", "2026-04-01", "S2a", 8, மெய்),
         நேர_உள்ளீடு("E1", "2026-04-02", "S2b", 8, பொய்)];

கணக்கிட்டது = மதிப்பு(தாளைக்_கணக்கிடு(தாள், விகிதங்கள்));
அச்சு கணக்கிட்டது["மொத்த_மணிகள்"];
அச்சு கணக்கிட்டது["மொத்தத்_தொகை"];

// __Costing the whole sheet at the current rate would give 19,200, and at the__
// __old one 16,000. Both reconcile perfectly to the wrong number.__
// நடப்பு விகிதத்தில் எல்லாவற்றையும் கணக்கிட்டால் 19,200; பழையதில் 16,000
அச்சு 32 * 600;
அச்சு 32 * 500;

// __A sheet with one uncostable entry fails whole, rather than returning a__
// __plausible total that is short by one line.__
// ஒரு பதிவைக் கணக்கிட முடியவில்லையென்றால் தாள் முழுவதும் தோல்வியே
அச்சு தவறா(தாளைக்_கணக்கிடு(
    [நேர_உள்ளீடு("E9", "2026-04-01", "S2a", 8, மெய்)], விகிதங்கள்));
