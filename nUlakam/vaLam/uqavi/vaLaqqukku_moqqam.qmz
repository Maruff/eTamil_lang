// __வளத்துக்கு_மொத்தம்(கணக்கிட்ட_உள்ளீடுகள், வளக்_குறி) — one person's hours and cost together__
// ஒருவரின் மணிகளும் செலவும் சேர்த்து

இறக்கு "../vaLam.qmz";
இறக்கு "../nEraqqAL.qmz";
இறக்கு "../paqivu.qmz";

விகிதங்கள் = [விகிதப்_பதிவு("E1", 500, "2025-04-01", ""),
               விகிதப்_பதிவு("E2", 400, "2025-04-01", "")];
தாள் = [நேர_உள்ளீடு("E1", "2026-03-30", "S2a", 8, மெய்),
         நேர_உள்ளீடு("E2", "2026-03-30", "S2a", 8, மெய்)];
வரிசைகள் = மதிப்பு(தாளைக்_கணக்கிடு(தாள், விகிதங்கள்))["உள்ளீடுகள்"];

// __The same hours at different rates. Reporting by person rather than by task__
// __is how a cost overrun is traced to who was doing the work.__
// ஒரே மணிகள், வெவ்வேறு விகிதங்கள்
அச்சு வளத்துக்கு_மொத்தம்(வரிசைகள், "E1")["தொகை"];
அச்சு வளத்துக்கு_மொத்தம்(வரிசைகள், "E2")["தொகை"];
அச்சு வளத்துக்கு_மொத்தம்(வரிசைகள், "E1")["மணிகள்"];
