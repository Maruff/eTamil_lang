// __பணிக்கு_மொத்தம்(கணக்கிட்ட_உள்ளீடுகள், பணிக்_குறி) — the hours and money on one activity__
// ஒரு பணிக்கான மணிகளும் தொகையும்

இறக்கு "../vaLam.qmz";
இறக்கு "../nEraqqAL.qmz";
இறக்கு "../paqivu.qmz";

விகிதங்கள் = [விகிதப்_பதிவு("E1", 500, "2025-04-01", "2026-03-31"),
               விகிதப்_பதிவு("E1", 600, "2026-04-01", "")];
தாள் = [நேர_உள்ளீடு("E1", "2026-03-30", "S2a", 8, மெய்),
         நேர_உள்ளீடு("E1", "2026-03-31", "S2a", 8, மெய்),
         நேர_உள்ளீடு("E1", "2026-04-01", "S2a", 8, மெய்),
         நேர_உள்ளீடு("E1", "2026-04-02", "S2b", 8, பொய்)];
வரிசைகள் = மதிப்பு(தாளைக்_கணக்கிடு(தாள், விகிதங்கள்))["உள்ளீடுகள்"];

// __The actual cost of an activity — which is what earned-value reporting__
// __takes as given, and which has to come from somewhere.__
// ஒரு பணியின் உண்மைச் செலவு; ஈட்டிய மதிப்புக் கணக்கு இதை அப்படியே ஏற்கிறது
அச்சு பணிக்கு_மொத்தம்(வரிசைகள், "S2a")["தொகை"];
அச்சு பணிக்கு_மொத்தம்(வரிசைகள், "S2a")["மணிகள்"];
அச்சு பணிக்கு_மொத்தம்(வரிசைகள், "S2b")["தொகை"];

// __And the activities account for the whole sheet.__
// பணிகள் சேர்ந்து தாள் முழுவதையும் விளக்குகின்றன
அச்சு பணிக்கு_மொத்தம்(வரிசைகள், "S2a")["தொகை"]
      + பணிக்கு_மொத்தம்(வரிசைகள், "S2b")["தொகை"];
