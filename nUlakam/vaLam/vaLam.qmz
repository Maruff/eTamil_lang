// __nUlakam/vaLam/vaLam.qmz — வளம், resources and what they cost__
//
// __qittam/Ittu_maqippu.qmz computes cost variance from actual cost, and takes__
// __actual cost as a number somebody types in. This directory is where that__
// __number comes from.__
//
// __A resource costs money at a **rate**, and the rate is effective-dated. The__
// __same person is charged at one rate in March and another in April, and a__
// __timesheet for March costed at April's rate is wrong in a way that reconciles__
// __perfectly and is invisible in every total.__
//
// __So விகிதத்தைத்_தேடு takes the day it is being asked about and **never__
// __defaults it to today**. kaNakkiyal/vari_vikiqam.qmz refuses the same default__
// __for the same reason: a rate looked up "as of now" quietly rewrites history__
// __the first time one changes.__
//
// __Capacity is computed against a **calendar**, from nAtkAtti/, because a__
// __month's capacity is its working days and not thirty times a day's hours.__
// __February and March differ by three working days in most years, and a__
// __utilisation percentage computed on elapsed days moves every month for__
// __reasons that have nothing to do with anybody's work.__

இறக்கு "../atippatY/kaNiqam.qmz";
இறக்கு "../atippatY/poruL.qmz";
இறக்கு "../nAtkAtti/vElYnAL.qmz";

// =========================================================================
// __வளம் — the resource__
// =========================================================================
//
// வளம்_ஆக்கு(வளக்_குறி, பெயர், வள_வகை, நாள்_மணிகள்)
//
// __வள_வகை is "ஊழியர்", "இயந்திரம்", "துணை_ஒப்பந்தம்" or whatever else the__
// __entity distinguishes. It is a string and not an enumeration, because the__
// __categories that matter differ by industry and none of them changes the__
// __arithmetic — only the account the cost lands in, which is paqivu.qmz's__
// __business.__
//
// __நாள்_மணிகள் is the standard hours in a working day for this resource. A__
// __machine may run sixteen and a person eight, and capacity is meaningless__
// __without it.__
செயல் வளம்_ஆக்கு(வளக்_குறி, பெயர், வள_வகை, நாள்_மணிகள்) {
    திரும்பு {"குறி": வளக்_குறி,
              "பெயர்": பெயர்,
              "வகை": வள_வகை,
              "நாள்_மணிகள்": நாள்_மணிகள்};
}

// =========================================================================
// __விகிதம் — the rate, effective-dated__
// =========================================================================
//
// விகிதப்_பதிவு(வளக்_குறி, மணி_விகிதம், அமல்_தொடக்கம், அமல்_முடிவு)
//
// __A rate that applied from one day to another. Pass "" as அமல்_முடிவு for a__
// __rate still in force — ISO dates sort, and the empty string sorts before__
// __every date, so an open end is tested for rather than compared.__
செயல் விகிதப்_பதிவு(வளக்_குறி, மணி_விகிதம், அமல்_தொடக்கம், அமல்_முடிவு) {
    திரும்பு {"வளக்_குறி": வளக்_குறி,
              "மணி_விகிதம்": மணி_விகிதம்,
              "அமல்_தொடக்கம்": அமல்_தொடக்கம்,
              "அமல்_முடிவு": அமல்_முடிவு};
}

// விகிதத்தைத்_தேடு(விகிதங்கள், வளக்_குறி, ஒரு_நாள்)
//
// __The rate for one resource on one day. **The day is required**, and there is__
// __no form of this function that omits it.__
//
// __Where several rates match — which should not happen and does — the one with__
// __the latest start wins, because that is the most recent revision. Overlapping__
// __effective dates are a data error and this does not hide it, but it does have__
// __to answer something.__
//
// __Nothing found is a தவறு rather than zero. A resource with no rate is a__
// __resource nobody has costed, and charging its time at nothing understates a__
// __project by exactly the amount most worth knowing.__
செயல் விகிதத்தைத்_தேடு(விகிதங்கள், வளக்_குறி, ஒரு_நாள்) {
    சிறந்த_விகிதம் = 0;
    சிறந்த_தொடக்கம் = "";
    கிடைத்ததா = பொய்;

    ஒவ்வொரு ஒரு_விகிதம் இல் விகிதங்கள் {
        (ஒரு_விகிதம்["வளக்_குறி"] == வளக்_குறி
         மற்றும் ஒரு_விகிதம்["அமல்_தொடக்கம்"] <= ஒரு_நாள்) எனில் {
            முடிவு_நாள் = ஒரு_விகிதம்["அமல்_முடிவு"];
            (முடிவு_நாள் == "" அல்லது முடிவு_நாள் >= ஒரு_நாள்) எனில் {
                (இல்லை கிடைத்ததா
                 அல்லது ஒரு_விகிதம்["அமல்_தொடக்கம்"] > சிறந்த_தொடக்கம்) எனில் {
                    சிறந்த_விகிதம் = ஒரு_விகிதம்["மணி_விகிதம்"];
                    சிறந்த_தொடக்கம் = ஒரு_விகிதம்["அமல்_தொடக்கம்"];
                    கிடைத்ததா = மெய்;
                }
            }
        }
    }

    (இல்லை கிடைத்ததா) எனில் {
        திரும்பு தவறு("விகிதம் இல்லை  (no rate in force for " & வளக்_குறி
                       & " on " & ஒரு_நாள் & ")");
    }
    திரும்பு சரி(சிறந்த_விகிதம்);
}

// மேலதிக_விகிதம்(அடிப்படை_விகிதம், மடங்கு)
//
// __Overtime as a multiple of the base rate. The multiple is a parameter because__
// __it is set by statute, by contract or by custom and differs in all three.__
//
// __Overtime is a **premium on the same hour**, not a different kind of work, so__
// __the hour still counts once towards progress and costs more. Booking overtime__
// __hours as extra hours inflates progress on a cost-to-cost measure at the same__
// __time as it inflates cost, and the two errors hide each other.__
செயல் மேலதிக_விகிதம்(அடிப்படை_விகிதம், மடங்கு) {
    திரும்பு வட்டப்_பெருக்கு(அடிப்படை_விகிதம், மடங்கு);
}

// =========================================================================
// __திறன் — capacity__
// =========================================================================
//
// காலத்_திறன்(நாள்_மணிகள், தொடக்கம், முடிவு, ஒரு_நாட்காட்டி)
//
// __The hours a resource could work in a period: working days in the period__
// __times hours in a day.__
//
// __Against a calendar, not against elapsed days. A month is not thirty days of__
// __capacity and February is not twenty-eight; the answer is the working days,__
// __which differ between two months of the same length whenever a holiday falls.__
// __A utilisation percentage computed on elapsed days moves every month for__
// __reasons that have nothing to do with anybody's work, and it is always the__
// __denominator that is wrong.__
செயல் காலத்_திறன்(நாள்_மணிகள், தொடக்கம், முடிவு, ஒரு_நாட்காட்டி) {
    வேலை_நாட்கள் = வேலை_நாட்களை_எண்ணு(தொடக்கம், முடிவு, ஒரு_நாட்காட்டி);
    திரும்பு வட்டமிடு(வேலை_நாட்கள் * நாள்_மணிகள், 2);
}

// கிடைக்கும்_மணிகள்(மொத்தத்_திறன், விடுப்பு_மணிகள்)
//
// __Capacity less leave. What was actually available, which is the honest__
// __denominator for utilisation: a person on leave for a fortnight has not__
// __failed to be utilised.__
செயல் கிடைக்கும்_மணிகள்(மொத்தத்_திறன், விடுப்பு_மணிகள்) {
    திரும்பு குறையாக்_கழி(மொத்தத்_திறன், விடுப்பு_மணிகள்);
}

// =========================================================================
// __பயன்பாடு — utilisation, and the distinction that matters__
// =========================================================================
//
// பயன்பாட்டு_விகிதம்(பணிபுரிந்த_மணிகள், கிடைத்த_மணிகள்)
//
// __How much of the available time was booked to something. Answered as a__
// __percentage out of a hundred, following the rates convention.__
செயல் பயன்பாட்டு_விகிதம்(பணிபுரிந்த_மணிகள், கிடைத்த_மணிகள்) {
    (கிடைத்த_மணிகள் <= 0) எனில் {
        திரும்பு தவறு("கிடைத்த மணிகள் இல்லை  "
                       & "(no available hours to measure utilisation against)");
    }
    திரும்பு சரி(வட்டமிடு(பணிபுரிந்த_மணிகள் * 100 / கிடைத்த_மணிகள், 2));
}

// கட்டண_விகிதம்(கட்டண_மணிகள், பணிபுரிந்த_மணிகள்)
//
// __How much of the time booked was **chargeable**. A different question from__
// __utilisation and the one that pays for anything.__
//
// __A resource can be a hundred per cent utilised and nothing per cent__
// __chargeable — every hour booked, all of it to rework, internal meetings or a__
// __fixed-price job already past its budget. A business that reports only__
// __utilisation cannot see that happening, and utilisation is the figure that__
// __gets reported because it is the flattering one.__
செயல் கட்டண_விகிதம்(கட்டண_மணிகள், பணிபுரிந்த_மணிகள்) {
    (பணிபுரிந்த_மணிகள் <= 0) எனில் {
        திரும்பு தவறு("பணிபுரிந்த மணிகள் இல்லை  (no hours worked)");
    }
    திரும்பு சரி(வட்டமிடு(கட்டண_மணிகள் * 100 / பணிபுரிந்த_மணிகள், 2));
}

// வளத்தைத்_தேடு(வளங்கள், வளக்_குறி)
// __வளத்தைத்_தேடு(வளங்கள், வளக்_குறி) — find one resource by its code__
//
// __சரி with the resource, or தவறு naming the code. A timesheet line against an unknown resource has no rate, and costing it at zero would quietly understate the actual cost that everything downstream is measured against.__
செயல் வளத்தைத்_தேடு(வளங்கள், வளக்_குறி) {
    ஒவ்வொரு ஒரு_வளம் இல் வளங்கள் {
        (ஒரு_வளம்["குறி"] == வளக்_குறி) எனில் { திரும்பு சரி(ஒரு_வளம்); }
    }
    திரும்பு தவறு("வளம் இல்லை  (no such resource): " & வளக்_குறி);
}
