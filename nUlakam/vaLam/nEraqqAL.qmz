// SPDX-License-Identifier: AGPL-3.0-or-later
// Copyright (C) 2026 Mohammed Maruff (Esan Maruff) <esan@etamil.in>
// __nUlakam/vaLam/nEraqqAL.qmz — நேரத்தாள், the timesheet__
// நேரத்தாள்
//
// __This is where actual cost is born. Everything downstream — the cost variance__
// __in qittam/Ittu_maqippu.qmz, the progress in varuvAy/muZZERRam.qmz, the margin__
// __on a job — rests on hours somebody wrote down, and on the rate in force the__
// __day they worked.__
//
// __Two rules do most of the work.__
//
// __**A timesheet is costed entry by entry, at the rate in force on each entry's__
// __own date.** Costing a month's sheet at the rate current when it is processed__
// __is wrong for every entry before the last rate change, and it reconciles__
// __perfectly to the wrong number.__
//
// __**A day is validated as a whole, not entry by entry.** Six hours on one task__
// __and six on another are each unremarkable and together are twelve, and no__
// __amount of checking one entry finds it. Double-booking across activities is__
// __the commonest fault in a timesheet and the only way to see it is to sum the__
// __day.__
//
// __Unapproved time is not cost. A sheet still in draft has not been agreed by__
// __anybody, and posting it to a project makes the actual cost move backwards__
// __when it is corrected.__

இறக்கு "../atippatY/kaNiqam.qmz";
இறக்கு "../atippatY/poruL.qmz";
இறக்கு "../nAtkAtti/nAL.qmz";
இறக்கு "vaLam.qmz";

// =========================================================================
// __உள்ளீடு — one line of a timesheet__
// =========================================================================
//
// நேர_உள்ளீடு(வளக்_குறி, ஒரு_நாள், பணிக்_குறி, மணிகள், கட்டணத்துக்குரியதா)
//
// __பணிக்_குறி is whatever the cost is being collected against — an activity__
// __code from qittam/pAqY.qmz, a work package from pakuppu.qmz, or a control__
// __account. This module does not care which, and deliberately does not check__
// __it: the structure of the breakdown is qittam's business and a timesheet that__
// __refuses unknown codes cannot be entered before the plan is finished.__
// நேர_உள்ளீடு(வளக்_குறி, ஒரு_நாள், பணிக்_குறி, மணிகள், கட்டணத்துக்குரியதா) — நேரத்தாளில் ஒரு பதிவு
செயல் நேர_உள்ளீடு(வளக்_குறி, ஒரு_நாள், பணிக்_குறி, மணிகள்,
                    கட்டணத்துக்குரியதா) {
    திரும்பு {"வளக்_குறி": வளக்_குறி,
              "நாள்": ஒரு_நாள்,
              "பணிக்_குறி": பணிக்_குறி,
              "மணிகள்": மணிகள்,
              "கட்டணத்துக்குரியதா": கட்டணத்துக்குரியதா,
              "நிலைமை": "வரைவு"};
}

// =========================================================================
// __சரிபார்ப்பு — validation__
// =========================================================================
//
// உள்ளீட்டைச்_சரிபார்(ஒரு_உள்ளீடு, நாள்_உச்ச_மணிகள்)
//
// __What one entry can be checked for on its own: a real date, positive hours,__
// __and not more hours than a day holds.__
//
// __The date check matters more than it looks. A timesheet is the one document__
// __in a business that is filled in from memory, and a typed month gets the year__
// __wrong every January — an entry dated a year earlier is costed at a rate from__
// __a year earlier and lands in a closed period.__
// உள்ளீட்டைச்_சரிபார்(ஒரு_உள்ளீடு, நாள்_உச்ச_மணிகள்) — இப்பதிவு முறையானதா
செயல் உள்ளீட்டைச்_சரிபார்(ஒரு_உள்ளீடு, நாள்_உச்ச_மணிகள்) {
    (இல்லை நாள்_செல்லுபடியா(ஒரு_உள்ளீடு["நாள்"])) எனில் {
        திரும்பு தவறு("செல்லாத நாள்  (not a valid date): "
                       & சொல்லாக்கு(ஒரு_உள்ளீடு["நாள்"]));
    }
    (ஒரு_உள்ளீடு["மணிகள்"] <= 0) எனில் {
        திரும்பு தவறு("மணிகள் நேர்மறையாக இருக்க வேண்டும்  "
                       & "(hours must be positive)");
    }
    (ஒரு_உள்ளீடு["மணிகள்"] > நாள்_உச்ச_மணிகள்) எனில் {
        திரும்பு தவறு("ஒரு நாளில் இத்தனை மணிகள் இல்லை  "
                       & "(a single entry of " & சொல்லாக்கு(ஒரு_உள்ளீடு["மணிகள்"])
                       & " hours exceeds the " & சொல்லாக்கு(நாள்_உச்ச_மணிகள்)
                       & " a day holds)");
    }
    திரும்பு சரி(ஒரு_உள்ளீடு);
}

// நாள்_மொத்த_மணிகள்(உள்ளீடுகள், வளக்_குறி, ஒரு_நாள்)
// __நாள்_மொத்த_மணிகள்(உள்ளீடுகள், வளக்_குறி, ஒரு_நாள்) — one person's hours on one day__
// நாள்_மொத்த_மணிகள்(உள்ளீடுகள், வளக்_குறி, ஒரு_நாள்) — ஒருவரின் ஒரு நாள் மணிகள்
//
// __Summed across every activity they touched, which is how an over-booked day is found: eight hours split four ways still totals eight, and twelve does not become visible on any single line.__
செயல் நாள்_மொத்த_மணிகள்(உள்ளீடுகள், வளக்_குறி, ஒரு_நாள்) {
    கூட்டல் = 0;
    ஒவ்வொரு ஒரு_உள்ளீடு இல் உள்ளீடுகள் {
        (ஒரு_உள்ளீடு["வளக்_குறி"] == வளக்_குறி
         மற்றும் ஒரு_உள்ளீடு["நாள்"] == ஒரு_நாள்) எனில் {
            கூட்டல் = கூட்டல் + ஒரு_உள்ளீடு["மணிகள்"];
        }
    }
    திரும்பு வட்டமிடு(கூட்டல், 2);
}

// மிகைப்_பதிவா(உள்ளீடுகள், வளக்_குறி, ஒரு_நாள், நாள்_உச்ச_மணிகள்)
//
// __**The check that only works across entries.** Six hours on one task and six__
// __on another are each perfectly reasonable; together they are twelve, and one__
// __person did not work twelve hours on a day that holds eight.__
//
// __Every entry can pass உள்ளீட்டைச்_சரிபார் and the day still be impossible,__
// __which is why both exist. This is the error that inflates actual cost on__
// __whichever project is easiest to book to, and it is invisible in any report__
// __that groups by project rather than by person.__
// மிகைப்_பதிவா(உள்ளீடுகள், வளக்_குறி, ஒரு_நாள், நாள்_உச்ச_மணிகள்) — ஒரு நாளுக்கு உரியதை மீறிப் பதிவாகியுள்ளதா
செயல் மிகைப்_பதிவா(உள்ளீடுகள், வளக்_குறி, ஒரு_நாள், நாள்_உச்ச_மணிகள்) {
    திரும்பு நாள்_மொத்த_மணிகள்(உள்ளீடுகள், வளக்_குறி, ஒரு_நாள்)
             > நாள்_உச்ச_மணிகள்;
}

// =========================================================================
// __நிலைமை — approval__
// =========================================================================
//
// நிலை_மாற்றம்_சரியா(இருந்து, க்கு)
//
// __A timesheet moves வரைவு → சமர்ப்பித்தது → ஏற்றது, and a submitted sheet may__
// __be sent back to draft as நிராகரித்தது. Nothing goes backwards from ஏற்றது:__
// __an approved sheet is corrected by a further entry, not by editing the__
// __original, because the original has already been costed and posted.__
// நிலை_மாற்றம்_சரியா(இருந்து, க்கு) — இந்நிலை மாற்றம் முறையானதா
செயல் நிலை_மாற்றம்_சரியா(இருந்து, க்கு) {
    (இருந்து == "வரைவு" மற்றும் க்கு == "சமர்ப்பித்தது") எனில் { திரும்பு மெய்; }
    (இருந்து == "சமர்ப்பித்தது" மற்றும் க்கு == "ஏற்றது") எனில் { திரும்பு மெய்; }
    (இருந்து == "சமர்ப்பித்தது" மற்றும் க்கு == "நிராகரித்தது") எனில் {
        திரும்பு மெய்;
    }
    (இருந்து == "நிராகரித்தது" மற்றும் க்கு == "வரைவு") எனில் { திரும்பு மெய்; }
    திரும்பு பொய்;
}

// நிலையை_மாற்று(ஒரு_உள்ளீடு, புதிய_நிலைமை)
// __நிலையை_மாற்று(ஒரு_உள்ளீடு, புதிய_நிலைமை) — move a timesheet entry to a new state__
// நிலையை_மாற்று(ஒரு_உள்ளீடு, புதிய_நிலைமை) — நேரத்தாள் பதிவைப் புதிய நிலைக்கு நகர்த்தும்
//
// __Refuses a transition the workflow does not allow, and returns a new entry rather than changing the old one. This is where actual cost is born, so an approved entry that can be edited back to draft is an audit trail that says nothing.__
செயல் நிலையை_மாற்று(ஒரு_உள்ளீடு, புதிய_நிலைமை) {
    (இல்லை நிலை_மாற்றம்_சரியா(ஒரு_உள்ளீடு["நிலைமை"], புதிய_நிலைமை)) எனில் {
        திரும்பு தவறு("இந்த நிலை மாற்றம் அனுமதிக்கப்படவில்லை  "
                       & "(cannot move from " & ஒரு_உள்ளீடு["நிலைமை"]
                       & " to " & புதிய_நிலைமை & ")");
    }
    திரும்பு சரி({"வளக்_குறி": ஒரு_உள்ளீடு["வளக்_குறி"],
                  "நாள்": ஒரு_உள்ளீடு["நாள்"],
                  "பணிக்_குறி": ஒரு_உள்ளீடு["பணிக்_குறி"],
                  "மணிகள்": ஒரு_உள்ளீடு["மணிகள்"],
                  "கட்டணத்துக்குரியதா": ஒரு_உள்ளீடு["கட்டணத்துக்குரியதா"],
                  "நிலைமை": புதிய_நிலைமை});
}

// ஏற்றவை_மட்டும்(உள்ளீடுகள்)
//
// __Only approved time is cost. Everything else is somebody's intention.__
// ஏற்றவை_மட்டும்(உள்ளீடுகள்) — ஏற்றுக்கொள்ளப்பட்ட பதிவுகள் மட்டும்
செயல் ஏற்றவை_மட்டும்(உள்ளீடுகள்) {
    விடை = [];
    ஒவ்வொரு ஒரு_உள்ளீடு இல் உள்ளீடுகள் {
        (ஒரு_உள்ளீடு["நிலைமை"] == "ஏற்றது") எனில் {
            விடை = இணை(விடை, ஒரு_உள்ளீடு);
        }
    }
    திரும்பு விடை;
}

// =========================================================================
// __கணக்கிடல் — costing the sheet__
// =========================================================================
//
// உள்ளீட்டைக்_கணக்கிடு(ஒரு_உள்ளீடு, விகிதங்கள்)
//
// __Costs one entry at the rate in force **on that entry's own date**. The date__
// __comes from the entry and not from the caller, which is the only way the rule__
// __can be got right by default.__
// உள்ளீட்டைக்_கணக்கிடு(ஒரு_உள்ளீடு, விகிதங்கள்) — ஒரு பதிவின் செலவைக் கணக்கிடும்
செயல் உள்ளீட்டைக்_கணக்கிடு(ஒரு_உள்ளீடு, விகிதங்கள்) {
    விகித_விடை = விகிதத்தைத்_தேடு(விகிதங்கள், ஒரு_உள்ளீடு["வளக்_குறி"],
                                    ஒரு_உள்ளீடு["நாள்"]);
    (தவறா(விகித_விடை)) எனில் { திரும்பு விகித_விடை; }

    மணி_விகிதம் = மதிப்பு(விகித_விடை);
    திரும்பு சரி({"வளக்_குறி": ஒரு_உள்ளீடு["வளக்_குறி"],
                  "நாள்": ஒரு_உள்ளீடு["நாள்"],
                  "பணிக்_குறி": ஒரு_உள்ளீடு["பணிக்_குறி"],
                  "மணிகள்": ஒரு_உள்ளீடு["மணிகள்"],
                  "கட்டணத்துக்குரியதா": ஒரு_உள்ளீடு["கட்டணத்துக்குரியதா"],
                  "மணி_விகிதம்": மணி_விகிதம்,
                  "தொகை": வட்டமிடு(ஒரு_உள்ளீடு["மணிகள்"] * மணி_விகிதம், 2)});
}

// தாளைக்_கணக்கிடு(உள்ளீடுகள், விகிதங்கள்)
//
// __A whole sheet. Answers the costed lines and the total, and **stops at the__
// __first entry it cannot cost** rather than costing what it can and reporting a__
// __total that is silently short.__
//
// __A partial total is the worst possible answer here: it is plausible, it__
// __reconciles to the lines shown, and it is wrong by exactly the entries nobody__
// __looked at.__
// தாளைக்_கணக்கிடு(உள்ளீடுகள், விகிதங்கள்) — நேரத்தாள் முழுவதற்கும் செலவைக் கணக்கிடும்
செயல் தாளைக்_கணக்கிடு(உள்ளீடுகள், விகிதங்கள்) {
    கணக்கிட்டவை = [];
    மொத்தத்_தொகை = 0;
    மொத்த_மணிகள் = 0;

    ஒவ்வொரு ஒரு_உள்ளீடு இல் உள்ளீடுகள் {
        விடை = உள்ளீட்டைக்_கணக்கிடு(ஒரு_உள்ளீடு, விகிதங்கள்);
        (தவறா(விடை)) எனில் { திரும்பு விடை; }
        கணக்கிட்ட_உள்ளீடு = மதிப்பு(விடை);
        கணக்கிட்டவை = இணை(கணக்கிட்டவை, கணக்கிட்ட_உள்ளீடு);
        மொத்தத்_தொகை = மொத்தத்_தொகை + கணக்கிட்ட_உள்ளீடு["தொகை"];
        மொத்த_மணிகள் = மொத்த_மணிகள் + கணக்கிட்ட_உள்ளீடு["மணிகள்"];
    }

    திரும்பு சரி({"உள்ளீடுகள்": கணக்கிட்டவை,
                  "மொத்த_மணிகள்": வட்டமிடு(மொத்த_மணிகள், 2),
                  "மொத்தத்_தொகை": வட்டமிடு(மொத்தத்_தொகை, 2)});
}

// =========================================================================
// __திரட்டல் — actual cost by activity__
// =========================================================================
//
// பணிக்கு_மொத்தம்(கணக்கிட்ட_உள்ளீடுகள், பணிக்_குறி)
//
// __The actual cost of one activity — **this is AC**, the figure__
// __qittam/Ittu_maqippu.qmz takes as given. Computing it from timesheets rather__
// __than accepting it as an input is the difference between an earned value__
// __report and an earned value calculator.__
// பணிக்கு_மொத்தம்(கணக்கிட்ட_உள்ளீடுகள், பணிக்_குறி) — ஒரு பணிக்கான மொத்தம்
செயல் பணிக்கு_மொத்தம்(கணக்கிட்ட_உள்ளீடுகள், பணிக்_குறி) {
    தொகைக்_கூட்டல் = 0;
    மணிக்_கூட்டல் = 0;
    ஒவ்வொரு ஒரு_உள்ளீடு இல் கணக்கிட்ட_உள்ளீடுகள் {
        (ஒரு_உள்ளீடு["பணிக்_குறி"] == பணிக்_குறி) எனில் {
            தொகைக்_கூட்டல் = தொகைக்_கூட்டல் + ஒரு_உள்ளீடு["தொகை"];
            மணிக்_கூட்டல் = மணிக்_கூட்டல் + ஒரு_உள்ளீடு["மணிகள்"];
        }
    }
    திரும்பு {"பணிக்_குறி": பணிக்_குறி,
              "மணிகள்": வட்டமிடு(மணிக்_கூட்டல், 2),
              "தொகை": வட்டமிடு(தொகைக்_கூட்டல், 2)};
}

// கட்டண_மணிகள்(கணக்கிட்ட_உள்ளீடுகள்)
//
// __Hours booked to something chargeable, for vaLam.qmz's கட்டண_விகிதம். Counted__
// __separately from the total because the two answer different questions and a__
// __business that tracks only one of them tracks the wrong one.__
// கட்டண_மணிகள்(கணக்கிட்ட_உள்ளீடுகள்) — கட்டணத்துக்கு உரிய மணிகள்
செயல் கட்டண_மணிகள்(கணக்கிட்ட_உள்ளீடுகள்) {
    கூட்டல் = 0;
    ஒவ்வொரு ஒரு_உள்ளீடு இல் கணக்கிட்ட_உள்ளீடுகள் {
        (ஒரு_உள்ளீடு["கட்டணத்துக்குரியதா"]) எனில் {
            கூட்டல் = கூட்டல் + ஒரு_உள்ளீடு["மணிகள்"];
        }
    }
    திரும்பு வட்டமிடு(கூட்டல், 2);
}

// வளத்துக்கு_மொத்தம்(கணக்கிட்ட_உள்ளீடுகள், வளக்_குறி)
// __வளத்துக்கு_மொத்தம்(கணக்கிட்ட_உள்ளீடுகள், வளக்_குறி) — one person's hours and cost, totalled__
// வளத்துக்கு_மொத்தம்(கணக்கிட்ட_உள்ளீடுகள், வளக்_குறி) — ஒருவரின் மணிகளும் செலவும் சேர்த்து
//
// __Both figures together, because they are checked against each other: hours times the rate should be the amount, and a mismatch means a rate changed part-way through the period. Rounded only at the end, so the total is not the sum of rounded lines.__
செயல் வளத்துக்கு_மொத்தம்(கணக்கிட்ட_உள்ளீடுகள், வளக்_குறி) {
    தொகைக்_கூட்டல் = 0;
    மணிக்_கூட்டல் = 0;
    ஒவ்வொரு ஒரு_உள்ளீடு இல் கணக்கிட்ட_உள்ளீடுகள் {
        (ஒரு_உள்ளீடு["வளக்_குறி"] == வளக்_குறி) எனில் {
            தொகைக்_கூட்டல் = தொகைக்_கூட்டல் + ஒரு_உள்ளீடு["தொகை"];
            மணிக்_கூட்டல் = மணிக்_கூட்டல் + ஒரு_உள்ளீடு["மணிகள்"];
        }
    }
    திரும்பு {"வளக்_குறி": வளக்_குறி,
              "மணிகள்": வட்டமிடு(மணிக்_கூட்டல், 2),
              "தொகை": வட்டமிடு(தொகைக்_கூட்டல், 2)};
}
