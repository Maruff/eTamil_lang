// __nUlakam/itar/itar.qmz — இடர், the risk register__
//
// __qittam/kattuppAtu.qmz takes a contingency reserve as a number somebody__
// __passes in. This is where that number comes from.__
//
// __A contingency reserve covers **identified** risks and is sized from them:__
// __the expected monetary value of the register. A management reserve covers__
// __what nobody identified, cannot be sized from a register by definition, and__
// __is a policy percentage. Sizing the second from the first is the commonest__
// __error in reserve setting and it produces a management reserve that is__
// __precisely as complete as the risk workshop was.__
//
// __**An opportunity is a risk.** The register holds both, the expected value of__
// __an opportunity is positive, and a register of nothing but threats is a__
// __register somebody has only half filled in. Every function here is signed for__
// __that reason.__
//
// __Probabilities are whole numbers out of a hundred, following the rates__
// __convention everywhere else in nUlakam.__

இறக்கு "../atippatY/kaNiqam.qmz";
இறக்கு "../atippatY/poruL.qmz";

// =========================================================================
// __ஒரு இடர் — one risk__
// =========================================================================
//
// இடர்_ஆக்கு(இடர்க்_குறி, விவரம், நிகழ்தகவு, தாக்கத்_தொகை, இடர்_வகை,
//             உரிமையாளர்)
//
// __தாக்கத்_தொகை is a **positive magnitude** in both cases, and இடர்_வகை —__
// __"அச்சுறுத்தல்" or "வாய்ப்பு" — carries the direction. Keeping the sign in__
// __the kind rather than in the amount means a register can be read without__
// __knowing which convention its author used, and it makes a threat entered as__
// __a negative impact obvious instead of silently doubling back to positive.__
செயல் இடர்_ஆக்கு(இடர்க்_குறி, விவரம், நிகழ்தகவு, தாக்கத்_தொகை, இடர்_வகை,
                  உரிமையாளர்) {
    திரும்பு {"குறி": இடர்க்_குறி,
              "விவரம்": விவரம்,
              "நிகழ்தகவு": நிகழ்தகவு,
              "தாக்கம்": தாக்கத்_தொகை,
              "வகை": இடர்_வகை,
              "உரிமையாளர்": உரிமையாளர்};
}

// இடர்_செல்லுபடியா(ஒரு_இடர்)
//
// __A probability outside 0 to 100, a negative impact, or an unknown kind. The__
// __impact check matters: a threat entered with a negative impact is a threat__
// __that will be added to the reserve instead of subtracted from it.__
செயல் இடர்_செல்லுபடியா(ஒரு_இடர்) {
    (ஒரு_இடர்["நிகழ்தகவு"] < 0 அல்லது ஒரு_இடர்["நிகழ்தகவு"] > 100) எனில் {
        திரும்பு தவறு("நிகழ்தகவு 0 முதல் 100 வரை இருக்க வேண்டும்  "
                       & "(a probability must be between 0 and 100): "
                       & சொல்லாக்கு(ஒரு_இடர்["நிகழ்தகவு"]));
    }
    (ஒரு_இடர்["தாக்கம்"] < 0) எனில் {
        திரும்பு தவறு("தாக்கம் ஒரு நேர்மறை அளவாக இருக்க வேண்டும்  "
                       & "(impact is a positive magnitude; the direction is "
                       & "carried by the kind, not the sign)");
    }
    (ஒரு_இடர்["வகை"] != "அச்சுறுத்தல்" மற்றும் ஒரு_இடர்["வகை"] != "வாய்ப்பு") எனில் {
        திரும்பு தவறு("அறியப்படாத இடர் வகை  (unknown risk kind): "
                       & சொல்லாக்கு(ஒரு_இடர்["வகை"]));
    }
    திரும்பு சரி(ஒரு_இடர்);
}

// =========================================================================
// __எதிர்பார்க்கும் பண மதிப்பு — expected monetary value__
// =========================================================================
//
// __எதிர்பார்ப்பு(ஒரு_இடர்) — probability times impact, signed by kind__
//
// __Negative for a threat, positive for an opportunity, so a register sums__
// __without the caller sorting it first.__
//
// __The figure is an average over many projects and **this project will not__
// __experience it**. A risk with a 20% chance of costing ten lakh has an expected__
// __value of two lakh, and the actual outcome is either ten lakh or nothing —__
// __never two. That is what a reserve is for, and it is why a reserve sized from__
// __expected value is right for a portfolio and merely reasonable for one__
// __project.__
செயல் எதிர்பார்ப்பு(ஒரு_இடர்) {
    அளவு_மதிப்பு = வட்டமிடு(சதவீதம்(ஒரு_இடர்["தாக்கம்"],
                                      ஒரு_இடர்["நிகழ்தகவு"]), 2);
    (ஒரு_இடர்["வகை"] == "அச்சுறுத்தல்") எனில் { திரும்பு 0 - அளவு_மதிப்பு; }
    திரும்பு அளவு_மதிப்பு;
}

// __மொத்த_எதிர்பார்ப்பு(இடர்கள்) — the register's net exposure__
//
// __Threats and opportunities together. A net figure near zero does not mean a__
// __project without risk; it means the two sides are of similar size, and they__
// __will not cancel in practice because they are different events.__
செயல் மொத்த_எதிர்பார்ப்பு(இடர்கள்) {
    கூட்டல் = 0;
    ஒவ்வொரு ஒரு_இடர் இல் இடர்கள் {
        கூட்டல் = கூட்டல் + எதிர்பார்ப்பு(ஒரு_இடர்);
    }
    திரும்பு வட்டமிடு(கூட்டல், 2);
}

// வகையால்_எதிர்பார்ப்பு(இடர்கள், இடர்_வகை)
//
// __One side of the register on its own. Both are wanted: the threats size the__
// __contingency reserve, and the opportunities are what a project manager is__
// __supposed to be chasing rather than merely recording.__
செயல் வகையால்_எதிர்பார்ப்பு(இடர்கள், இடர்_வகை) {
    கூட்டல் = 0;
    ஒவ்வொரு ஒரு_இடர் இல் இடர்கள் {
        (ஒரு_இடர்["வகை"] == இடர்_வகை) எனில் {
            கூட்டல் = கூட்டல் + எதிர்பார்ப்பு(ஒரு_இடர்);
        }
    }
    திரும்பு வட்டமிடு(கூட்டல், 2);
}

// =========================================================================
// __தரவரிசை — qualitative scoring__
// =========================================================================
//
// இடர்_மதிப்பெண்(நிகழ்தகவுத்_தரம், தாக்கத்_தரம்)
//
// __The probability-and-impact matrix: two ordinal ranks, multiplied.__
//
// __**This is not arithmetic and the number it produces is not a quantity.** A__
// __rank of 5 for probability and 1 for impact scores 5, and so does 1 and 5,__
// __and they are completely different risks — one that happens constantly and__
// __costs nothing, and one that would end the project but almost certainly will__
// __not. Ranking by the product puts them side by side.__
//
// __It is kept because it is what a risk workshop can actually produce in an__
// __afternoon, and because ordering risks roughly is better than not ordering__
// __them. The components are returned alongside the score so a caller can break__
// __the tie the way the score cannot, and எதிர்பார்ப்பு is the answer wherever__
// __real money is available.__
செயல் இடர்_மதிப்பெண்(நிகழ்தகவுத்_தரம், தாக்கத்_தரம்) {
    திரும்பு {"மதிப்பெண்": நிகழ்தகவுத்_தரம் * தாக்கத்_தரம்,
              "நிகழ்தகவுத்_தரம்": நிகழ்தகவுத்_தரம்,
              "தாக்கத்_தரம்": தாக்கத்_தரம்};
}

// மதிப்பெண்_நிலைமை(மதிப்பெண், உயர்_எல்லை, நடுத்தர_எல்லை)
//
// __Banding a score into high, medium and low. The thresholds are parameters__
// __because they are a matter of appetite rather than of fact, and an__
// __organisation that treats a score of 12 as high is making a policy statement__
// __and not a measurement.__
செயல் மதிப்பெண்_நிலைமை(மதிப்பெண், உயர்_எல்லை, நடுத்தர_எல்லை) {
    (மதிப்பெண் >= உயர்_எல்லை) எனில் { திரும்பு "உயர்"; }
    (மதிப்பெண் >= நடுத்தர_எல்லை) எனில் { திரும்பு "நடுத்தரம்"; }
    திரும்பு "தாழ்";
}

// =========================================================================
// __பதிலளிப்பு — responses__
// =========================================================================
//
// பதிலளிப்பு_சரியா(இடர்_வகை, பதிலளிப்பு)
//
// __The four responses to a threat are avoid, transfer, mitigate and accept. The__
// __four to an opportunity are exploit, share, enhance and accept. They pair up__
// __— avoid with exploit, transfer with share, mitigate with enhance — and only__
// __acceptance is the same word for both.__
//
// __They are not interchangeable, and "mitigating an opportunity" is not a__
// __clumsy phrase but a contradiction: mitigation reduces probability or impact,__
// __and reducing an opportunity is the opposite of what is wanted. A register__
// __that lets any response attach to any risk collects such entries, and nobody__
// __reviewing it notices because every line has a response.__
செயல் பதிலளிப்பு_சரியா(இடர்_வகை, பதிலளிப்பு) {
    (பதிலளிப்பு == "ஏற்பு") எனில் { திரும்பு மெய்; }

    (இடர்_வகை == "அச்சுறுத்தல்") எனில் {
        திரும்பு பதிலளிப்பு == "தவிர்ப்பு" அல்லது பதிலளிப்பு == "மாற்றல்"
                 அல்லது பதிலளிப்பு == "தணிப்பு";
    }
    (இடர்_வகை == "வாய்ப்பு") எனில் {
        திரும்பு பதிலளிப்பு == "பயன்படுத்தல்" அல்லது பதிலளிப்பு == "பகிர்வு"
                 அல்லது பதிலளிப்பு == "மேம்படுத்தல்";
    }
    திரும்பு பொய்;
}

// எஞ்சிய_இடர்(ஒரு_இடர், புதிய_நிகழ்தகவு, புதிய_தாக்கம்)
//
// __What is left after a response. A response changes the probability, the__
// __impact, or both — avoidance takes the probability to nothing, insurance__
// __leaves the probability and moves the impact — and the residual is a risk in__
// __its own right that stays on the register.__
//
// __Answers the residual risk and the reduction in exposure, because the second__
// __is what the response has to be judged against.__
செயல் எஞ்சிய_இடர்(ஒரு_இடர், புதிய_நிகழ்தகவு, புதிய_தாக்கம்) {
    மீதி_இடர் = இடர்_ஆக்கு(ஒரு_இடர்["குறி"], ஒரு_இடர்["விவரம்"],
                            புதிய_நிகழ்தகவு, புதிய_தாக்கம்,
                            ஒரு_இடர்["வகை"], ஒரு_இடர்["உரிமையாளர்"]);
    முன்பு = எதிர்பார்ப்பு(ஒரு_இடர்);
    பின்பு = எதிர்பார்ப்பு(மீதி_இடர்);
    திரும்பு {"எஞ்சிய_இடர்": மீதி_இடர்,
              "முன்பு": முன்பு,
              "பின்பு": பின்பு,
              "நன்மை": வட்டமிடு(முழுமதிப்பு(முன்பு) - முழுமதிப்பு(பின்பு), 2)};
}

// பதிலளிப்பு_பயனுள்ளதா(நன்மை, பதிலளிப்புச்_செலவு)
//
// __**A response that costs more than the exposure it removes is not a__
// __response.** Spending ten lakh to remove two lakh of expected value has made__
// __the project worse by eight, and it is done constantly because the spending__
// __is visible, deliberate and feels responsible while the exposure is a__
// __probability nobody experiences.__
//
// __The comparison is against the *reduction* in exposure, not against the__
// __impact. A risk with a 5% chance of costing a crore is worth five lakh of__
// __prevention, not a crore of it.__
செயல் பதிலளிப்பு_பயனுள்ளதா(நன்மை, பதிலளிப்புச்_செலவு) {
    திரும்பு நன்மை > பதிலளிப்புச்_செலவு;
}

// பதிலளிப்பு_நிகரம்(நன்மை, பதிலளிப்புச்_செலவு)
// __பதிலளிப்பு_நிகரம்(நன்மை, பதிலளிப்புச்_செலவு) — what a risk response is worth, net__
//
// __The reduction in expected loss less what the response costs. Through வட்டக்_கழி so the subtraction rounds once: a mitigation whose net benefit is a rounding artefact should not appear to be worth doing.__
செயல் பதிலளிப்பு_நிகரம்(நன்மை, பதிலளிப்புச்_செலவு) {
    திரும்பு வட்டக்_கழி(நன்மை, பதிலளிப்புச்_செலவு);
}

// =========================================================================
// __இருப்புகள் — sizing the reserves__
// =========================================================================
//
// தற்செயல்_இருப்பைக்_கணக்கிடு(இடர்கள்)
//
// __The contingency reserve: the expected monetary value of the **threats** on__
// __the register, as a positive amount to be set aside.__
//
// __Opportunities are deliberately excluded. Netting an opportunity against a__
// __threat funds a cost that will certainly arise if the threat occurs with a__
// __benefit that may not, and the two are different events that will not oblige__
// __by happening together.__
//
// __This is the number qittam/kattuppAtu.qmz's நிதித்_தொகுதி_ஆக்கு wants for its__
// தற்செயல்_இருப்பு.
செயல் தற்செயல்_இருப்பைக்_கணக்கிடு(இடர்கள்) {
    அச்சுறுத்தல்_மொத்தம் = வகையால்_எதிர்பார்ப்பு(இடர்கள், "அச்சுறுத்தல்");
    திரும்பு வட்டமிடு(முழுமதிப்பு(அச்சுறுத்தல்_மொத்தம்), 2);
}

// மேலாண்மை_இருப்பைக்_கணக்கிடு(அடிப்படை_நிதி, கொள்கை_விகிதம்)
//
// __The management reserve, as a percentage of the baseline.__
//
// __**It is not computed from the register and cannot be.** It covers what__
// __nobody identified, and a figure derived from identified risks is exactly as__
// __complete as the risk workshop was — which is the one thing it must not__
// __depend on. So it is a policy percentage, set by whoever carries the__
// __unknown, and this function takes that percentage rather than inventing one.__
செயல் மேலாண்மை_இருப்பைக்_கணக்கிடு(அடிப்படை_நிதி, கொள்கை_விகிதம்) {
    திரும்பு வட்டப்_பங்கு(அடிப்படை_நிதி, கொள்கை_விகிதம்);
}

// =========================================================================
// __முடிவு மரம் — decision trees__
// =========================================================================
//
// கிளை_ஆக்கு(விவரம், நிகழ்தகவு, விளைவுத்_தொகை)
//
// __One branch of a decision: what happens, how likely, and what it is worth.__
செயல் கிளை_ஆக்கு(விவரம், நிகழ்தகவு, விளைவுத்_தொகை) {
    திரும்பு {"விவரம்": விவரம்,
              "நிகழ்தகவு": நிகழ்தகவு,
              "விளைவு": விளைவுத்_தொகை};
}

// கிளைகளின்_எதிர்பார்ப்பு(கிளைகள்)
//
// __The expected value of one decision path: each outcome weighted by its__
// __probability. The probabilities must total 100, and a set that does not is a__
// __தவறு rather than a scaled answer — the same refusal__
// __varuvAy/oppanqam.qmz makes, and for the same reason.__
செயல் கிளைகளின்_எதிர்பார்ப்பு(கிளைகள்) {
    (நீளம்(கிளைகள்) == 0) எனில் {
        திரும்பு தவறு("கிளைகள் இல்லை  (no branches)");
    }
    நிகழ்தகவுக்_கூட்டல் = 0;
    எடையிட்ட_கூட்டல் = 0;
    ஒவ்வொரு ஒரு_கிளை இல் கிளைகள் {
        நிகழ்தகவுக்_கூட்டல் = நிகழ்தகவுக்_கூட்டல் + ஒரு_கிளை["நிகழ்தகவு"];
        எடையிட்ட_கூட்டல் = எடையிட்ட_கூட்டல்
                            + சதவீதம்(ஒரு_கிளை["விளைவு"], ஒரு_கிளை["நிகழ்தகவு"]);
    }
    (நிகழ்தகவுக்_கூட்டல் != 100) எனில் {
        திரும்பு தவறு("நிகழ்தகவுகள் நூறாகச் சேரவில்லை  "
                       & "(the probabilities total "
                       & சொல்லாக்கு(நிகழ்தகவுக்_கூட்டல்) & ", not 100)");
    }
    திரும்பு சரி(வட்டமிடு(எடையிட்ட_கூட்டல், 2));
}

// சிறந்த_முடிவு(வாய்ப்புகள்)
//
// __The choice with the highest expected value. வாய்ப்புகள் is a list of__
// __{"பெயர்", "எதிர்பார்ப்பு", "செலவு"} — the cost of taking the option is__
// __subtracted, because a decision tree that compares outcomes without the price__
// __of entry recommends whichever option has the most expensive upside.__
//
// __Ties go to the first, and the whole ranking is returned so a caller can see__
// __how close the second was. A decision taken on an expected value that beats__
// __the alternative by one per cent is a decision taken on the estimates rather__
// __than on the merits.__
செயல் சிறந்த_முடிவு(வாய்ப்புகள்) {
    (நீளம்(வாய்ப்புகள்) == 0) எனில் {
        திரும்பு தவறு("ஒப்பிட வாய்ப்புகள் இல்லை  (no options to compare)");
    }

    தரவரிசை = [];
    சிறந்த_பெயர் = "";
    சிறந்த_நிகரம் = 0;
    முதல்_முறை = மெய்;

    ஒவ்வொரு ஒரு_வாய்ப்பு இல் வாய்ப்புகள் {
        நிகரம் = வட்டமிடு(ஒரு_வாய்ப்பு["எதிர்பார்ப்பு"] - ஒரு_வாய்ப்பு["செலவு"], 2);
        தரவரிசை = இணை(தரவரிசை, {"பெயர்": ஒரு_வாய்ப்பு["பெயர்"],
                                  "நிகரம்": நிகரம்});
        (முதல்_முறை அல்லது நிகரம் > சிறந்த_நிகரம்) எனில் {
            சிறந்த_பெயர் = ஒரு_வாய்ப்பு["பெயர்"];
            சிறந்த_நிகரம் = நிகரம்;
            முதல்_முறை = பொய்;
        }
    }
    திரும்பு சரி({"சிறந்தது": சிறந்த_பெயர்,
                  "நிகரம்": சிறந்த_நிகரம்,
                  "தரவரிசை": தரவரிசை});
}
